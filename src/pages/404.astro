---
import Layout from '../layouts/Layout.astro'

const areas = [
  { slug: 'triana', name: 'Triana' },
  { slug: 'magallanes', name: 'Magallanes' },
  { slug: 'san-agustin', name: 'San Agustin' },
  { slug: 'san-bernardo', name: 'San Bernardo' },
  { slug: 'cabulihan', name: 'Cabulihan' },
  { slug: 'lugsongan', name: 'Lugsongan' },
]
---

<Layout title="Page not found" description="The page you're looking for doesn't exist. Browse stays, rentals, and travel guides for Limasawa Island instead." noindex={true}>
  <main class="nf-wrap">
    <div class="nf-card">
      <div class="nf-code" aria-hidden="true">
        <span>4</span>
        <span class="nf-pin">
          <svg viewBox="0 0 32 32" role="img" aria-label="0">
            <circle cx="16" cy="16" r="15" fill="var(--sb-primary-light)" />
            <path d="M16 6.5c-3.6 0-6.5 2.9-6.5 6.5 0 4.6 6.5 12 6.5 12s6.5-7.4 6.5-12c0-3.6-2.9-6.5-6.5-6.5z" fill="var(--sb-primary)"/>
            <circle cx="16" cy="12.8" r="2.6" fill="#fff"/>
          </svg>
        </span>
        <span>4</span>
      </div>
      <h1>This page drifted out to sea</h1>
      <p class="nf-sub">
        The page you're looking for doesn't exist — it may have been moved, renamed,
        or the listing is no longer available. The island is small; you won't get lost for long.
      </p>
      <div class="nf-actions">
        <a href="/stays" class="btn-primary">Browse stays</a>
        <a href="/rentals" class="btn-outline">Vehicle rentals</a>
        <a href="/" class="btn-outline">Back to home</a>
      </div>
      <div class="nf-areas">
        <span class="nf-areas-label">Or jump to a popular area</span>
        <div class="nf-chips">
          {areas.map(a => <a href={`/stays/${a.slug}`} class="nf-chip">{a.name}</a>)}
          <a href="/stays/beachfront" class="nf-chip nf-chip-accent">Beachfront stays</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
.nf-wrap {
  min-height: calc(100vh - 64px);
  display: flex; align-items: center; justify-content: center;
  padding: 3rem 1.5rem;
  background:
    radial-gradient(ellipse 80% 55% at 50% -10%, var(--sb-primary-light), transparent),
    var(--sb-bg);
}
.nf-card { max-width: 620px; text-align: center; }
.nf-code {
  display: flex; align-items: center; justify-content: center; gap: 0.35rem;
  font-size: clamp(5rem, 16vw, 8.5rem); font-weight: 800; line-height: 1;
  color: var(--navy); letter-spacing: -0.04em;
  margin-bottom: 1.25rem;
}
.nf-pin { width: 0.92em; height: 0.92em; display: inline-flex; }
.nf-pin svg { width: 100%; height: 100%; animation: nf-bob 3s ease-in-out infinite; }
@keyframes nf-bob { 0%, 100% { transform: translateY(0) } 50% { transform: translateY(-6px) } }
@media (prefers-reduced-motion: reduce) { .nf-pin svg { animation: none } }
.nf-card h1 { font-size: clamp(1.4rem, 4vw, 1.9rem); color: var(--sb-text); margin: 0 0 0.75rem; }
.nf-sub { color: var(--sb-text-muted); line-height: 1.65; margin: 0 auto 1.75rem; max-width: 48ch; }
.nf-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.25rem; }
.nf-areas { border-top: 1px solid var(--sb-border); padding-top: 1.5rem; }
.nf-areas-label {
  display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--sb-text-muted); margin-bottom: 0.85rem;
}
.nf-chips { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
.nf-chip {
  display: inline-block; padding: 0.42rem 0.95rem; border-radius: 999px;
  background: #fff; border: 1px solid var(--sb-border);
  color: var(--sb-secondary); font-size: 0.85rem; font-weight: 600; text-decoration: none;
  transition: border-color .15s, color .15s, background .15s;
}
.nf-chip:hover { border-color: var(--sb-primary); color: var(--sb-primary-deeper); background: var(--sb-primary-light); }
.nf-chip-accent { background: var(--sb-primary-light); border-color: var(--sb-primary-mid); color: var(--sb-primary-deeper); }
</style>
