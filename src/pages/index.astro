---
import Layout from '../layouts/Layout.astro'
import AccommodationCard from '../components/AccommodationCard.astro'
import { getListings, getAccommodations, deriveFacets } from '../lib/api'

// All current listings, fetched at build time. Drives the facets (tiles + search).
const { listings, total } = await getListings({ perPage: 48 })
const { categories, locations } = deriveFacets(listings)

// Reshaped nodes for the ported AccommodationCard (siargao card design).
const { nodes } = await getAccommodations(48)
const featured = [...nodes]
  .sort((a, b) => (b.listingTier === 'featured' ? 1 : 0) - (a.listingTier === 'featured' ? 1 : 0))
  .slice(0, 8)

// Hero background: aerial drone shot of Limasawa (uploaded to the WP media library).
const HERO_IMG = 'https://admin.limasawabooking.com/wp-content/uploads/2026/06/limasawa-booking.webp'

// Guest options for the search select.
const guestOpts = [1, 2, 4, 6, 8, 10]

const peso = (n: number) => '₱' + Number(n).toLocaleString('en-PH')

// ── SEO ────────────────────────────────────────────────────────────────
const seoTitle = 'Limasawa Accommodations · Beachfront Resorts & Homestays'
const seoDescription =
  'Book accommodations in Limasawa Island, Southern Leyte — beachfront resorts, affordable homestays, and budget island stays. Compare prices and reserve direct.'

// Visible FAQ (also emitted as FAQPage structured data below) — written to
// cover the searches travelers actually type: affordable/cheap stays,
// beachfront, getting there, and scooter rentals (coming soon).
const faqs = [
  {
    q: 'Where can I find affordable accommodations in Limasawa?',
    a: "Limasawa Booking lists budget homestays, lodges, and whole-house rentals across the island alongside resorts. Browse all stays and sort by price to find cheap accommodations in Limasawa that fit your budget.",
  },
  {
    q: 'Are there beachfront resorts in Limasawa?',
    a: 'Yes — several beachfront resorts and beach houses on Limasawa Island are listed here, many just steps from the sand with views over the Bohol Sea.',
  },
  {
    q: 'How do I get to Limasawa Island?',
    a: 'Limasawa is reached by pumpboat from Padre Burgos, Southern Leyte (about 30–45 minutes by sea). Most hosts can help arrange your transfer and pickup.',
  },
  {
    q: 'Can I rent a scooter or motorbike in Limasawa?',
    a: 'Yes — scooter, motorbike, and bicycle rentals in Limasawa are available now. Browse rentals on Limasawa Booking to compare daily and hourly rates and book direct with local providers.',
  },
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Limasawa Booking',
    url: 'https://limasawabooking.com',
    description: seoDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]
---

<Layout title={seoTitle} description={seoDescription} image="/og/home.jpg" jsonLd={jsonLd}>
  <main>
    <!-- ───────────────── Hero + search ───────────────── -->
    <section class="hero-wrap">
      <div class="hero" style={`background-image: url(${HERO_IMG})`}>
        <div class="hero-content">
          <h1>Explore<br>Limasawa Island</h1>
          <p>Find accommodation, scooter rentals, tours and local services across Limasawa.</p>

          <form class="hero-search" id="hero-search">
            <div class="hero-search-field">
              <svg class="hsf-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <select id="hero-q" aria-label="What are you looking for?">
                <option value="/stays" selected>What are you looking for?</option>
                <option value="/stays">🏠 All accommodation</option>
                {categories.map((c) => <option value={`/stays/type/${c.slug}`}>{c.name} ({c.count})</option>)}
                <option value="/rentals">🛵 Scooter & motorbike rentals</option>
              </select>
            </div>
            <button type="submit" class="hero-search-btn" aria-label="Search">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
          </form>

          <div class="hero-stats">
            <div class="hero-stat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 5.2a3.2 3.2 0 0 1 0 5.6"/><path d="M18.5 14.2c2.2.6 3.7 2.3 3.7 4.8"/></svg>
              <div><strong>1,200+</strong><span>Monthly Visitors</span></div>
            </div>
            <span class="hero-stat-sep"></span>
            <div class="hero-stat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3.5h6V6H9z"/><path d="M9 11h6"/><path d="M9 15h6"/></svg>
              <div><strong>{total}+</strong><span>Listings</span></div>
            </div>
            <span class="hero-stat-sep"></span>
            <div class="hero-stat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.4 8.4 0 1 1 21 11.5z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/></svg>
              <div><strong>100%</strong><span>Direct Contact</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        var f = document.getElementById('hero-search')
        if (!f) return
        f.addEventListener('submit', function (e) {
          e.preventDefault()
          var sel = document.getElementById('hero-q')
          var dest = (sel && sel.value) || '/stays'
          window.location.href = dest
        })
      })()
    </script>

    <!-- ───────────────── Featured stays ───────────────── -->
    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>Featured Limasawa accommodations</h2>
          <a href="/stays" class="see-all">See all {total} →</a>
        </div>
        {featured.length === 0 ? (
          <p class="muted">Listings are being added — check back soon.</p>
        ) : (
          <div class="grid grid-4">
            {featured.map((node) => <AccommodationCard listing={node} />)}
          </div>
        )}
      </div>
    </section>

    <!-- ───────────────── Browse by category ───────────────── -->
    {categories.length > 0 && (
      <section class="section alt">
        <div class="section-inner">
          <div class="section-head"><h2>Browse by type</h2></div>
          <div class="tile-row">
            {categories.map((c) => (
              <a href={`/stays/type/${c.slug}`} class="tile" style={c.image ? `background-image: linear-gradient(180deg, rgba(13,30,43,.15), rgba(13,30,43,.7)), url(${c.image})` : ''}>
                <span class="tile-name">{c.name}</span>
                <span class="tile-count">{c.count} {c.count === 1 ? 'place' : 'places'}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────────────── Browse by location ───────────────── -->
    {locations.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <div class="section-head"><h2>Browse by location</h2></div>
          <div class="tile-row">
            {locations.map((l) => (
              <a href={`/stays/${l.slug}`} class="tile" style={l.image ? `background-image: linear-gradient(180deg, rgba(13,30,43,.15), rgba(13,30,43,.7)), url(${l.image})` : ''}>
                <span class="tile-name">{l.name}</span>
                <span class="tile-count">{l.count} {l.count === 1 ? 'place' : 'places'}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────────────── Rentals CTA ───────────────── -->
    <section class="section">
      <div class="section-inner">
        <a href="/rentals" class="rentals-band">
          <div class="rentals-band-icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 17.5h-5l-2-7H5"/><path d="M10 10.5h5l2 7"/></svg>
          </div>
          <div class="rentals-band-text">
            <h2>Get around the island</h2>
            <p>Rent a scooter, motorbike, or bicycle in Limasawa — compare daily &amp; hourly rates from local providers.</p>
          </div>
          <span class="rentals-band-cta">Browse rentals →</span>
        </a>
      </div>
    </section>

    <!-- ───────────────── Become a host CTA ───────────────── -->
    <section class="host-cta">
      <div class="host-cta-inner">
        <h2>Own a place or vehicles in Limasawa?</h2>
        <p>List your resort, homestay, or beach house — or rent out your scooters, motorbikes, and cars — and reach travelers planning their island trip.</p>
        <div class="host-cta-btns">
          <a href="/list-your-property" class="btn-light">List your property</a>
          <a href="/list-rental" class="btn-light btn-light-outline">List your rental</a>
        </div>
      </div>
    </section>

    <!-- ───────────────── About Limasawa ───────────────── -->
    <section class="section">
      <div class="section-inner about">
        <h2>About Limasawa Island</h2>
        <p>
          Limasawa is a small island municipality in Southern Leyte, Philippines, widely honored as
          the site of the first Catholic Mass in the country on Easter Sunday, 1521. Today it draws
          travelers for its quiet beaches, clear dive sites, and unhurried island pace.
        </p>
        <p>
          Whether you're after a beachfront resort, a family-run homestay, an affordable lodge near the
          parola, or a whole house for the barkada, <a href="/stays">browse all Limasawa accommodations</a>
          to find a place that fits your trip and budget.
        </p>
      </div>
    </section>

    <!-- ───────────────── FAQ (FAQPage schema in <head>) ───────────────── -->
    <section class="section alt">
      <div class="section-inner faq">
        <div class="section-head"><h2>Limasawa travel & booking FAQ</h2></div>
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .faq { max-width: 760px; }
  .faq-item { border: 1px solid var(--sb-border, #e2e8f0); border-radius: 12px; padding: 0 18px; margin-bottom: 12px; background: #fff; }
  .faq-item summary { cursor: pointer; font-weight: 700; padding: 16px 0; list-style: none; color: var(--sb-text, #1a2533); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; font-weight: 400; color: #94a3b8; font-size: 1.4em; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin: 0 0 18px; color: var(--sb-text-muted, #56657a); line-height: 1.6; }

  .rentals-band {
    display: flex; align-items: center; gap: 1.25rem;
    background: linear-gradient(120deg, #E6F9FA 0%, #F5F8FB 100%);
    border: 1px solid var(--sb-primary-mid, #BEF0F3);
    border-radius: 18px; padding: 1.5rem 1.75rem; text-decoration: none; color: var(--sb-text, #1a2533);
    transition: transform .2s, box-shadow .2s;
  }
  .rentals-band:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(39,157,163,.16); }
  .rentals-band-icon { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 14px; background: #fff; display: grid; place-items: center; color: var(--sb-primary-deeper, #279DA3); }
  .rentals-band-text { flex: 1; min-width: 0; }
  .rentals-band-text h2 { font-size: 1.25rem; font-weight: 800; margin: 0 0 .25rem; }
  .rentals-band-text p { margin: 0; color: var(--sb-text-muted, #56657a); line-height: 1.5; font-size: .95rem; }
  .rentals-band-cta { flex: 0 0 auto; font-weight: 800; color: var(--sb-primary-deeper, #279DA3); white-space: nowrap; }
  .host-cta-btns { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
  /* Doubled class so it outranks .btn-light (defined later in this file),
     which otherwise wins the color war and renders teal-on-teal. */
  .btn-light.btn-light-outline { background: transparent; border: 1.5px solid rgba(255,255,255,.7); color: #fff; }
  .btn-light.btn-light-outline:hover { background: #fff; border-color: #fff; color: var(--sb-primary-deeper); }
  @media (max-width: 640px) {
    .rentals-band { flex-direction: column; align-items: flex-start; gap: .85rem; padding: 1.25rem; }
  }
</style>

<style>
  /* hero — contained (container width, rounded), aerial photo + left overlay */
  .hero-wrap { padding: 1.5rem 1.5rem 0; }
  .hero {
    position: relative; max-width: 1200px; margin: 0 auto;
    border-radius: 24px; overflow: hidden; min-height: 480px;
    display: flex; align-items: center; color: #fff;
    background-size: cover; background-position: center;
  }
  .hero::before {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(10,42,56,.92) 0%, rgba(10,42,56,.74) 30%, rgba(10,42,56,.38) 54%, rgba(10,42,56,0) 78%);
  }
  .hero-content { position: relative; box-sizing: border-box; padding: clamp(1.75rem, 4vw, 3.5rem); max-width: 560px; width: 100%; }
  .hero-search, .hero-search * { box-sizing: border-box; }
  .hero-content h1 {
    font-family: 'DM Sans', sans-serif; font-weight: 800;
    font-size: clamp(2.3rem, 5.2vw, 3.7rem); line-height: 1.04; letter-spacing: -0.02em;
    margin: 0 0 1rem; text-shadow: 0 2px 24px rgba(0,0,0,.35);
  }
  .hero-content > p {
    font-size: clamp(1rem, 1.5vw, 1.18rem); color: #eaf3f6; line-height: 1.55;
    margin: 0 0 1.75rem; max-width: 440px; text-shadow: 0 1px 12px rgba(0,0,0,.3);
  }

  /* search */
  .hero-search { display: flex; gap: .5rem; background: #fff; border-radius: 14px; padding: .5rem; box-shadow: 0 14px 40px rgba(10,42,56,.28); max-width: 540px; }
  .hero-search-field { position: relative; flex: 1; display: flex; align-items: center; gap: .55rem; padding-left: .9rem; min-width: 0; }
  .hsf-icon { color: var(--sb-text-muted); flex: 0 0 auto; }
  .hero-search-field select {
    appearance: none; -webkit-appearance: none; border: none; background: transparent; outline: none;
    cursor: pointer; width: 100%; min-width: 0; max-width: 100%; text-overflow: ellipsis;
    font-family: inherit; font-size: 1rem; font-weight: 500;
    color: var(--sb-text); padding: .7rem 1.75rem .7rem 0;
  }
  .hero-search-field::after {
    content: ""; position: absolute; right: .55rem; top: 50%; width: 9px; height: 9px;
    border-right: 2px solid var(--sb-text-muted); border-bottom: 2px solid var(--sb-text-muted);
    transform: translateY(-65%) rotate(45deg); pointer-events: none;
  }
  .hero-search-btn {
    flex: 0 0 auto; width: 52px; border: none; border-radius: 10px;
    background: var(--sb-primary); color: #fff; cursor: pointer;
    display: grid; place-items: center; transition: background .2s;
  }
  .hero-search-btn:hover { background: var(--sb-primary-dark); }

  /* stats */
  .hero-stats { display: flex; align-items: center; gap: 1.25rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .hero-stat { display: flex; align-items: center; gap: .6rem; }
  .hero-stat svg { width: 30px; height: 30px; flex: 0 0 auto; opacity: .95; }
  .hero-stat strong { display: block; font-family: 'DM Sans', sans-serif; font-size: 1.4rem; font-weight: 800; line-height: 1; }
  .hero-stat span { font-size: .82rem; color: #cfe0e6; }
  .hero-stat-sep { width: 1px; height: 34px; background: rgba(255,255,255,.28); }

  @media (max-width: 720px) {
    .hero-wrap { padding: 1rem 1rem 0; }
    .hero { min-height: 430px; border-radius: 20px; }
    .hero::before { background: linear-gradient(180deg, rgba(10,42,56,.42) 0%, rgba(10,42,56,.78) 58%, rgba(10,42,56,.93) 100%); }
    .hero-content { max-width: 100%; padding: 1.6rem 1.35rem; }
    .hero-content > p { max-width: 100%; }
    .hero-search { max-width: 100%; }
    .hero-stat-sep { display: none; }
    .hero-stats { gap: .8rem 1.3rem; margin-top: 1.4rem; }
    .hero-stat svg { width: 26px; height: 26px; }
    .hero-stat strong { font-size: 1.2rem; }
    .hero-stat span { font-size: .72rem; color: #d6e4ea; }
  }

  /* sections */
  .section { padding: 3.5rem 1.5rem; }
  .section.alt { background: var(--sb-secondary-pale); }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.5rem; }
  .section-head h2 { font-size: 1.6rem; margin: 0; }
  .see-all { color: var(--sb-primary-deeper); font-weight: 600; text-decoration: none; font-size: .95rem; }
  .see-all:hover { text-decoration: underline; }
  .muted { color: var(--sb-text-muted); }
  .muted.sm { font-size: .85rem; }

  .grid { display: grid; gap: 1.25rem; }
  .grid-4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px)  { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px)  { .grid-4 { grid-template-columns: 1fr; } }

  /* tiles (category / location) */
  .tile-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .tile { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 150px; padding: 1rem; border-radius: var(--sb-radius); background: var(--sb-secondary) center/cover; color: #fff; text-decoration: none; overflow: hidden; transition: transform .15s, box-shadow .2s; }
  .tile:hover { transform: translateY(-2px); box-shadow: var(--sb-shadow-lg); }
  .tile-name { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.05rem; text-transform: capitalize; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
  .tile-count { font-size: .8rem; opacity: .9; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
  @media (max-width: 900px) { .tile-row { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .tile-row { grid-template-columns: repeat(2, 1fr); } }

  /* host CTA */
  .host-cta { background: linear-gradient(120deg, var(--sb-primary) 0%, var(--sb-primary-deeper) 100%); color: #fff; padding: 3.5rem 1.5rem; text-align: center; }
  .host-cta-inner { max-width: 560px; margin: 0 auto; }
  .host-cta h2 { font-size: 1.75rem; margin: 0 0 .75rem; }
  .host-cta p { font-size: 1.05rem; margin: 0 0 1.5rem; opacity: .95; line-height: 1.6; }
  .btn-light { display: inline-block; background: #fff; border: 1.5px solid #fff; color: var(--sb-primary-deeper); font-weight: 700; padding: .8rem 1.75rem; border-radius: var(--sb-radius); text-decoration: none; transition: transform .15s, box-shadow .2s, background .2s, color .2s, border-color .2s; }
  .btn-light:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,.18); }
  .btn-light:active { transform: translateY(0); box-shadow: none; }
  .btn-light:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* about */
  .about { max-width: 760px; }
  .about h2 { font-size: 1.6rem; margin: 0 0 1rem; }
  .about p { color: var(--sb-secondary); line-height: 1.8; margin: 0 0 1rem; }
  .about a { color: var(--sb-primary-deeper); font-weight: 600; }

  @media (max-width: 620px) {
    .search { flex-direction: column; gap: .25rem; }
    .search-field { border-right: none; border-bottom: 1px solid var(--sb-border); }
    .search-btn { padding: .85rem; margin: .25rem 0 0; }
  }
</style>

<style is:global>
  .stay-card { position: relative; display: block; text-decoration: none; color: var(--sb-text); background: #fff; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-lg); overflow: hidden; transition: box-shadow .2s, transform .15s; }
  .stay-card:hover { box-shadow: var(--sb-shadow-lg); transform: translateY(-2px); }
  .stay-card img { width: 100%; height: 180px; object-fit: cover; display: block; }
  .stay-card .ph { width: 100%; height: 180px; background: var(--sb-secondary-pale); }
  .stay-badge { position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,.92); color: var(--sb-primary-deeper); font-size: .7rem; font-weight: 700; padding: .2rem .5rem; border-radius: 999px; box-shadow: var(--sb-shadow); }
  .stay-card-body { padding: 1rem; }
  .stay-card-body h3 { font-size: 1rem; margin: 0 0 .25rem; }
  .stay-card-body strong { font-size: .95rem; color: var(--sb-primary-deeper); }
</style>
