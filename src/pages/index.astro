---
import Layout from '../layouts/Layout.astro'
import AccommodationCard from '../components/AccommodationCard.astro'
import { getListings, getAccommodations, deriveFacets } from '../lib/api'

// All current listings, fetched at build time. Drives the facets (tiles + search).
const { listings, total } = await getListings({ perPage: 48 })
const { categories, locations } = deriveFacets(listings)

// Reshaped nodes for the ported AccommodationCard (siargao card design).
const { nodes } = await getAccommodations(48)
const featured = [...nodes]
  .sort((a, b) => (b.listingTier === 'featured' ? 1 : 0) - (a.listingTier === 'featured' ? 1 : 0))
  .slice(0, 6)

// Hero background: a real listing photo when available, else the gradient alone.
const heroImage = featured.find((l) => l.thumb)?.thumb ?? ''

// Guest options for the search select.
const guestOpts = [1, 2, 4, 6, 8, 10]

const peso = (n: number) => '₱' + Number(n).toLocaleString('en-PH')
---

<Layout title="Find Stays in Limasawa, Philippines">
  <main>
    <!-- ───────────────── Hero + search ───────────────── -->
    <section class="hero" style={heroImage ? `background-image: linear-gradient(180deg, rgba(13,30,43,.45), rgba(13,30,43,.65)), url(${heroImage})` : ''}>
      <div class="hero-inner">
        <h1>Find your place in <span>Limasawa</span></h1>
        <p>Resorts, homestays, and island getaways on one of the Philippines' most historic islands.</p>

        <form class="search" action="/stays" method="get">
          <div class="search-field">
            <label for="s-loc">Where</label>
            <select id="s-loc" name="location">
              <option value="">Anywhere in Limasawa</option>
              {locations.map((l) => <option value={l.slug}>{l.name} ({l.count})</option>)}
            </select>
          </div>
          <div class="search-field">
            <label for="s-cat">Type</label>
            <select id="s-cat" name="category">
              <option value="">Any type</option>
              {categories.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
            </select>
          </div>
          <button type="submit" class="search-btn">Search</button>
        </form>
      </div>
    </section>

    <!-- ───────────────── Featured stays ───────────────── -->
    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>Featured stays</h2>
          <a href="/stays" class="see-all">See all {total} →</a>
        </div>
        {featured.length === 0 ? (
          <p class="muted">Listings are being added — check back soon.</p>
        ) : (
          <div class="grid grid-3">
            {featured.map((node) => <AccommodationCard listing={node} />)}
          </div>
        )}
      </div>
    </section>

    <!-- ───────────────── Browse by category ───────────────── -->
    {categories.length > 0 && (
      <section class="section alt">
        <div class="section-inner">
          <div class="section-head"><h2>Browse by type</h2></div>
          <div class="tile-row">
            {categories.map((c) => (
              <a href={`/stays?category=${c.slug}`} class="tile" style={c.image ? `background-image: linear-gradient(180deg, rgba(13,30,43,.15), rgba(13,30,43,.7)), url(${c.image})` : ''}>
                <span class="tile-name">{c.name}</span>
                <span class="tile-count">{c.count} {c.count === 1 ? 'place' : 'places'}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────────────── Browse by location ───────────────── -->
    {locations.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <div class="section-head"><h2>Browse by location</h2></div>
          <div class="tile-row">
            {locations.map((l) => (
              <a href={`/stays?location=${l.slug}`} class="tile" style={l.image ? `background-image: linear-gradient(180deg, rgba(13,30,43,.15), rgba(13,30,43,.7)), url(${l.image})` : ''}>
                <span class="tile-name">{l.name}</span>
                <span class="tile-count">{l.count} {l.count === 1 ? 'place' : 'places'}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ───────────────── Become a host CTA ───────────────── -->
    <section class="host-cta">
      <div class="host-cta-inner">
        <h2>Own a place in Limasawa?</h2>
        <p>List your resort, homestay, or beach house and reach travelers searching for the island.</p>
        <a href="/list-your-property" class="btn-light">List your property</a>
      </div>
    </section>

    <!-- ───────────────── About Limasawa ───────────────── -->
    <section class="section">
      <div class="section-inner about">
        <h2>About Limasawa Island</h2>
        <p>
          Limasawa is a small island municipality in Southern Leyte, Philippines, widely honored as
          the site of the first Catholic Mass in the country on Easter Sunday, 1521. Today it draws
          travelers for its quiet beaches, clear dive sites, and unhurried island pace.
        </p>
        <p>
          Whether you're after a beachfront resort, a family-run homestay, or a simple lodge near the
          parola, <a href="/stays">browse all stays</a> to find a place that fits your trip.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* hero */
  .hero { background: linear-gradient(135deg, var(--sb-primary-deeper) 0%, #0d3040 100%); background-size: cover; background-position: center; padding: 5.5rem 1.5rem 6rem; text-align: center; color: #fff; }
  .hero-inner { max-width: 820px; margin: 0 auto; }
  .hero h1 { font-family: 'DM Sans', sans-serif; font-size: clamp(2.2rem, 6vw, 3.4rem); margin: 0 0 1rem; letter-spacing: -0.02em; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .hero h1 span { color: var(--sb-primary-mid); }
  .hero > .hero-inner > p { font-size: 1.15rem; color: #e6f1f5; margin: 0 0 2.25rem; line-height: 1.6; text-shadow: 0 1px 12px rgba(0,0,0,.25); }

  /* search bar */
  .search { display: flex; gap: 0; background: #fff; border-radius: var(--sb-radius-lg); box-shadow: 0 12px 40px rgba(13,30,43,.22); padding: .5rem; max-width: 720px; margin: 0 auto; align-items: stretch; }
  .search-field { flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding: .5rem .9rem; text-align: left; border-right: 1px solid var(--sb-border); }
  .search-field label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--sb-text-muted); margin-bottom: .15rem; }
  .search-field select { border: none; background: transparent; font-size: .95rem; color: var(--sb-text); font-family: inherit; width: 100%; outline: none; cursor: pointer; padding: 0; }
  .search-btn { flex: none; background: var(--sb-primary); color: #fff; border: none; border-radius: var(--sb-radius); font-weight: 700; font-size: .95rem; padding: 0 1.75rem; margin-left: .25rem; cursor: pointer; transition: background .2s; }
  .search-btn:hover { background: var(--sb-primary-dark); }

  /* sections */
  .section { padding: 3.5rem 1.5rem; }
  .section.alt { background: var(--sb-secondary-pale); }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.5rem; }
  .section-head h2 { font-size: 1.6rem; margin: 0; }
  .see-all { color: var(--sb-primary-deeper); font-weight: 600; text-decoration: none; font-size: .95rem; }
  .see-all:hover { text-decoration: underline; }
  .muted { color: var(--sb-text-muted); }
  .muted.sm { font-size: .85rem; }

  .grid { display: grid; gap: 1.25rem; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 900px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid-3 { grid-template-columns: 1fr; } }

  /* tiles (category / location) */
  .tile-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .tile { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 150px; padding: 1rem; border-radius: var(--sb-radius); background: var(--sb-secondary) center/cover; color: #fff; text-decoration: none; overflow: hidden; transition: transform .15s, box-shadow .2s; }
  .tile:hover { transform: translateY(-2px); box-shadow: var(--sb-shadow-lg); }
  .tile-name { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.05rem; text-transform: capitalize; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
  .tile-count { font-size: .8rem; opacity: .9; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
  @media (max-width: 900px) { .tile-row { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .tile-row { grid-template-columns: repeat(2, 1fr); } }

  /* host CTA */
  .host-cta { background: linear-gradient(120deg, var(--sb-primary) 0%, var(--sb-primary-deeper) 100%); color: #fff; padding: 3.5rem 1.5rem; text-align: center; }
  .host-cta-inner { max-width: 560px; margin: 0 auto; }
  .host-cta h2 { font-size: 1.75rem; margin: 0 0 .75rem; }
  .host-cta p { font-size: 1.05rem; margin: 0 0 1.5rem; opacity: .95; line-height: 1.6; }
  .btn-light { display: inline-block; background: #fff; color: var(--sb-primary-deeper); font-weight: 700; padding: .8rem 1.75rem; border-radius: var(--sb-radius); text-decoration: none; transition: transform .15s, box-shadow .2s; }
  .btn-light:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }

  /* about */
  .about { max-width: 760px; }
  .about h2 { font-size: 1.6rem; margin: 0 0 1rem; }
  .about p { color: var(--sb-secondary); line-height: 1.8; margin: 0 0 1rem; }
  .about a { color: var(--sb-primary-deeper); font-weight: 600; }

  @media (max-width: 620px) {
    .search { flex-direction: column; gap: .25rem; }
    .search-field { border-right: none; border-bottom: 1px solid var(--sb-border); }
    .search-btn { padding: .85rem; margin: .25rem 0 0; }
  }
</style>

<style is:global>
  .stay-card { position: relative; display: block; text-decoration: none; color: var(--sb-text); background: #fff; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-lg); overflow: hidden; transition: box-shadow .2s, transform .15s; }
  .stay-card:hover { box-shadow: var(--sb-shadow-lg); transform: translateY(-2px); }
  .stay-card img { width: 100%; height: 180px; object-fit: cover; display: block; }
  .stay-card .ph { width: 100%; height: 180px; background: var(--sb-secondary-pale); }
  .stay-badge { position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,.92); color: var(--sb-primary-deeper); font-size: .7rem; font-weight: 700; padding: .2rem .5rem; border-radius: 999px; box-shadow: var(--sb-shadow); }
  .stay-card-body { padding: 1rem; }
  .stay-card-body h3 { font-size: 1rem; margin: 0 0 .25rem; }
  .stay-card-body strong { font-size: .95rem; color: var(--sb-primary-deeper); }
</style>
