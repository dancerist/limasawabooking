---
/**
 * Rentals archive — /rentals
 * Static shell; content fetched client-side from
 * GET /wp-json/limasawa/v1/rentals and /rental-types.
 */
import Layout from '../../layouts/Layout.astro'
import '../../styles/rental-card.css'

const WP_REST = import.meta.env.PUBLIC_WP_REST ?? 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
---

<Layout
  title="Scooter & Motorbike Rentals in Limasawa"
  description="Rent a scooter, motorbike, or bicycle in Limasawa Island. Compare daily and hourly rates from local providers and explore the island your way."
>
  <main class="rt-main">
    <section class="rt-hero">
      <div class="rt-hero-inner">
        <h1 class="rt-hero-title">Rentals in Limasawa</h1>
        <p class="rt-hero-sub">Scooters, motorbikes, and more — rent from local providers and explore the island at your own pace.</p>
      </div>
    </section>

    <nav class="rt-cat-bar" aria-label="Rental types">
      <div class="rt-cat-strip" id="rt-cat-strip">
        <button class="rt-cat-chip is-active" data-type="">All</button>
      </div>
    </nav>

    <section class="rt-grid-wrap">
      <div class="rt-result-line" id="rt-result-line">Loading…</div>
      <div class="rt-grid" id="rt-grid"></div>
      <div class="rt-empty" id="rt-empty" style="display:none">
        <h2>No rentals yet</h2>
        <p>Vehicle rentals are being added — check back soon.</p>
      </div>
    </section>

    <!-- Provider CTA -->
    <section class="rt-host-cta">
      <div class="rt-host-cta-inner">
        <h2>Rent out your scooter, motorbike, or car</h2>
        <p>Got vehicles for hire in Limasawa? List them on Limasawa Booking and reach travelers planning their island trip — free to start.</p>
        <a href="/list-rental" class="rt-host-cta-btn">List your rental</a>
      </div>
    </section>
  </main>

  <style is:global>
    .rt-main { color: #1A2533; padding-bottom: 5rem; }
    .rt-hero { background: linear-gradient(180deg, #F5F8FB 0%, #fff 100%); padding: 3.5rem 1.5rem 1.5rem; text-align: center; }
    .rt-hero-inner { max-width: 720px; margin: 0 auto; }
    .rt-hero-title { font-family: 'DM Sans', sans-serif; font-size: clamp(2rem, 5vw, 2.85rem); font-weight: 800; line-height: 1.05; margin-bottom: .75rem; }
    .rt-hero-sub { font-size: 1.05rem; color: #64748B; line-height: 1.55; }

    .rt-cat-bar { position: sticky; top: 64px; z-index: 30; background: #fff; border-bottom: 1px solid #E2EBF3; padding: .85rem 1.5rem; }
    .rt-cat-strip { max-width: 1200px; margin: 0 auto; display: flex; gap: .55rem; overflow-x: auto; scrollbar-width: none; }
    .rt-cat-strip::-webkit-scrollbar { display: none; }
    .rt-cat-chip { flex-shrink: 0; background: #fff; color: #1A2533; border: 1.5px solid #E2EBF3; border-radius: 999px; padding: .45rem 1.1rem; font-size: .85rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all .15s; }
    .rt-cat-chip:hover { border-color: #279DA3; color: #279DA3; }
    .rt-cat-chip.is-active { background: #1A2533; color: #fff; border-color: #1A2533; }

    .rt-grid-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
    .rt-result-line { font-size: .85rem; color: #64748B; margin-bottom: 1.5rem; }
    .rt-grid { display: grid; gap: 1.75rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
    .rt-empty { text-align: center; padding: 4rem 1rem; color: #64748B; }
    .rt-empty h2 { font-size: 1.25rem; font-weight: 800; color: #1A2533; margin-bottom: .5rem; }
    @media(max-width:560px) { .rt-hero { padding: 2.5rem 1.25rem 1.25rem; } .rt-grid-wrap { padding: 1.5rem 1.25rem; } }

    .rt-host-cta { background: linear-gradient(120deg, #279DA3, #1E8087); color: #fff; margin: 1rem 1.5rem 0; border-radius: 18px; }
    .rt-host-cta-inner { max-width: 760px; margin: 0 auto; padding: 2.5rem 1.5rem; text-align: center; }
    .rt-host-cta h2 { font-family: 'DM Sans', sans-serif; font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 800; margin-bottom: .6rem; }
    .rt-host-cta p { opacity: .92; line-height: 1.55; margin-bottom: 1.5rem; max-width: 560px; margin-left: auto; margin-right: auto; }
    .rt-host-cta-btn { display: inline-block; background: #fff; color: #1A2533; font-weight: 800; padding: .75rem 1.75rem; border-radius: 11px; text-decoration: none; }
    .rt-host-cta-btn:hover { background: #F0FDF4; }
  </style>

  <script define:vars={{ WP_REST }}>window.__RENTAL_API = WP_REST</script>
  <script>
    import { rentalCardHTML, rentalSkeletonHTML, rentalEsc as esc } from '../../scripts/rental-card-template.js'

    const API = window.__RENTAL_API || 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
    const grid = document.getElementById('rt-grid')
    const empty = document.getElementById('rt-empty')
    const resultLine = document.getElementById('rt-result-line')
    const catStrip = document.getElementById('rt-cat-strip')
    let state = { type: '' }

    async function loadTypes() {
      try {
        const types = await fetch(`${API}/rental-types`).then(r => r.json())
        const html = (types || []).filter(t => t.count > 0)
          .map(t => `<button class="rt-cat-chip" data-type="${esc(t.slug)}">${esc(t.name)}<span style="opacity:.5;margin-left:.4rem">${t.count}</span></button>`)
          .join('')
        catStrip.insertAdjacentHTML('beforeend', html)
        catStrip.addEventListener('click', e => {
          const btn = e.target.closest('.rt-cat-chip'); if (!btn) return
          catStrip.querySelectorAll('.rt-cat-chip').forEach(b => b.classList.toggle('is-active', b === btn))
          state.type = btn.dataset.type || ''
          loadRentals()
        })
      } catch (_) {}
    }

    async function loadRentals() {
      grid.innerHTML = rentalSkeletonHTML()
      const qs = new URLSearchParams({ per_page: '48' })
      if (state.type) qs.set('type', state.type)
      try {
        const data = await fetch(`${API}/rentals?${qs}`).then(r => r.json())
        const rentals = data.rentals || []
        if (!rentals.length) { grid.innerHTML = ''; empty.style.display = 'block'; resultLine.style.display = 'none'; return }
        empty.style.display = 'none'; resultLine.style.display = 'block'
        const noun = data.total === 1 ? 'rental' : 'rentals'
        resultLine.textContent = `${data.total} ${noun}${state.type ? ' in this category' : ''}`
        grid.innerHTML = rentals.map(rentalCardHTML).join('')
      } catch (e) {
        grid.innerHTML = `<div class="rt-empty" style="grid-column:1/-1"><h2>Could not load rentals</h2><p>${esc(e.message || 'Try again later')}</p></div>`
      }
    }

    loadTypes()
    loadRentals()
  </script>
</Layout>
