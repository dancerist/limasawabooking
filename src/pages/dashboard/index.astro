---
// /dashboard — Island Host dashboard (client-side auth)
const WP_REST = import.meta.env.PUBLIC_WP_REST ?? 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Limasawa Booking</title>
  <link rel="icon" href="/favicon.svg" type="image/webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Nunito+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    :root {
      --primary:#22ABB3;
      --primary-dark:#1C949B;
      --primary-light:#E6F9FA;
      --primary-mid:#BEF0F3;
      --primary-trans-10:rgba(34,171,179,0.10);
      --primary-trans-20:rgba(34,171,179,0.20);
      --primary-trans-50:rgba(34,171,179,0.50);

      --secondary:#4C5B6C;
      --secondary-mid:#5E6E80;
      --secondary-ultra-dark:#151A1E;

      --bg:#F5F8FB;
      --border:#E2EBF3;
      --text:#1A2533;
      --muted:#64748B;
      --white:#fff;
      --radius:12px;
      --radius-lg:16px;
      --shadow:0 2px 12px rgba(62,199,207,.07),0 1px 3px rgba(76,91,108,.06);
      --shadow-lg:0 8px 32px rgba(62,199,207,.12),0 2px 8px rgba(76,91,108,.08);
    }
    html,body { height:100%; }
    body { font-family:'Nunito Sans',system-ui,sans-serif; background:var(--bg); color:var(--text); display:flex; min-height:100vh; }
    h1,h2,h3,h4,h5,h6 { font-family:'DM Sans',system-ui,sans-serif; }

    /* ══ Sidebar ══ */
    .sidebar {
      width:250px; min-height:100vh; background:var(--secondary-ultra-dark);
      display:flex; flex-direction:column; position:sticky; top:0; height:100vh;
      flex-shrink:0; border-right:1px solid rgba(255,255,255,.05);
    }

    .sidebar-logo {
      padding:1.35rem 1.25rem;
      border-bottom:1px solid rgba(255,255,255,.07);
      display:flex; align-items:center;
    }
    .sidebar-logo img { height:32px; width:auto; }

    .sidebar-user {
      padding:1rem 1.25rem; display:flex; align-items:center; gap:.75rem;
      border-bottom:1px solid rgba(255,255,255,.07);
    }
    .user-avatar { width:38px; height:38px; border-radius:50%; object-fit:cover;
                   border:2px solid var(--primary); flex-shrink:0; }
    .user-avatar-fallback {
      width:38px; height:38px; border-radius:50%; background:var(--primary-trans-20);
      border:1.5px solid var(--primary);
      display:flex; align-items:center; justify-content:center;
      font-weight:700; font-size:.85rem; color:var(--primary); flex-shrink:0;
    }
    .user-name { font-weight:700; font-size:.85rem; color:#fff; line-height:1.2; }
    .user-role { font-size:.72rem; color:var(--primary); font-weight:500; margin-top:.15rem; opacity:.9; }

    .sidebar-nav { flex:1; padding:.5rem 0; overflow-y:auto; }
    .nav-section {
      padding:.9rem 1.25rem .3rem; font-size:.6rem; font-weight:700;
      text-transform:uppercase; letter-spacing:.12em; color:rgba(255,255,255,.22);
    }
    .nav-item {
      display:flex; align-items:center; gap:.7rem; padding:.6rem 1.25rem;
      color:rgba(255,255,255,.5); font-size:.85rem; font-weight:500;
      cursor:pointer; text-decoration:none;
      transition:background .15s,color .15s;
      border-left:2.5px solid transparent;
      margin:1px 0;
    }
    .nav-item:hover { background:rgba(255,255,255,.05); color:rgba(255,255,255,.85); }
    .nav-item.active {
      background:var(--primary-trans-10);
      color:var(--primary);
      border-left-color:var(--primary);
      font-weight:600;
    }
    .nav-item svg { flex-shrink:0; width:16px; height:16px; opacity:.8; }
    .nav-item.active svg { opacity:1; }

    .sidebar-footer {
      padding:.9rem 1.25rem;
      border-top:1px solid rgba(255,255,255,.07);
    }
    .logout-btn {
      display:flex; align-items:center; gap:.6rem;
      color:rgba(255,255,255,.35); font-size:.85rem;
      background:none; border:none; cursor:pointer;
      font-family:inherit; width:100%; padding:.45rem 0;
      transition:color .2s;
    }
    .logout-btn:hover { color:rgba(255,255,255,.75); }
    .logout-btn svg { width:16px; height:16px; }

    /* ══ Main ══ */
    .main { flex:1; display:flex; flex-direction:column; min-width:0; }

    .topbar {
      background:#fff; border-bottom:1px solid var(--border);
      padding:0 2rem; height:58px;
      display:flex; align-items:center; justify-content:space-between;
      position:sticky; top:0; z-index:10; flex-shrink:0;
    }
    .topbar-title { font-size:.95rem; font-weight:700; color:var(--text); }
    .topbar-actions { display:flex; align-items:center; gap:.75rem; }
    .btn-add {
      display:inline-flex; align-items:center; gap:.4rem;
      background:var(--primary); color:#fff; font-weight:700; font-size:.8rem;
      padding:.45rem .9rem; border-radius:8px; border:none; cursor:pointer;
      text-decoration:none; transition:background .2s,box-shadow .2s; letter-spacing:.01em;
    }
    .btn-add:hover { background:var(--primary-dark); box-shadow:0 4px 14px rgba(62,199,207,.35); }
    .btn-add svg { width:13px; height:13px; }

    .content { padding:1.75rem 2rem; flex:1; overflow-y:auto; }

    /* ══ Welcome banner ══ */
    .welcome-banner {
      background:linear-gradient(135deg, var(--secondary) 0%, #3A4A5C 100%);
      border-radius:var(--radius-lg); padding:1.4rem 1.75rem;
      display:flex; align-items:center; justify-content:space-between;
      margin-bottom:1.5rem; overflow:hidden; position:relative;
    }
    .welcome-banner::before {
      content:''; position:absolute; right:-40px; top:-40px;
      width:220px; height:220px; background:rgba(62,199,207,.07); border-radius:50%;
    }
    .welcome-banner::after {
      content:''; position:absolute; right:60px; bottom:-50px;
      width:130px; height:130px; background:rgba(62,199,207,.05); border-radius:50%;
    }
    .welcome-text h1 { font-size:1.25rem; font-weight:800; color:#fff; margin-bottom:.2rem; }
    .welcome-text p  { font-size:.85rem; color:rgba(255,255,255,.55); }
    .welcome-icon {
      width:48px; height:48px; border-radius:12px;
      background:rgba(255,255,255,.08); display:flex; align-items:center; justify-content:center;
      color:var(--primary); flex-shrink:0; position:relative; z-index:1;
    }

    /* ══ Stats grid ══ */
    .stats-grid {
      display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
      gap:.875rem; margin-bottom:1.75rem;
    }
    .stat-card {
      background:#fff; border-radius:var(--radius); padding:1rem 1.1rem;
      box-shadow:var(--shadow); border:1px solid var(--border);
      display:flex; align-items:center; gap:.8rem;
      transition:box-shadow .2s;
    }
    .stat-card:hover { box-shadow:var(--shadow-lg); }
    .stat-card.locked { position:relative; overflow:hidden; cursor:default; }
    .stat-card.locked .stat-value { filter:blur(6px); user-select:none; }
    .stat-card.locked::after {
      content:''; position:absolute; inset:0;
      background:rgba(255,255,255,.55); backdrop-filter:blur(1px);
    }
    .stat-lock-badge {
      position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
      z-index:2; display:flex; flex-direction:column; align-items:center; gap:.25rem;
      pointer-events:none;
    }
    .stat-lock-badge svg { width:15px; height:15px; color:#94A3B8; }
    .stat-lock-badge span { font-size:.6rem; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
    /* Per-listing mini stats */
    .lst-stats-row { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.4rem; padding-top:.4rem; border-top:1px solid var(--border); }
    .lst-stat-pill { display:flex; align-items:center; gap:.25rem; font-size:.68rem; color:var(--muted); background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:.2rem .45rem; }
    .lst-stat-pill strong { color:var(--text); font-weight:700; }
    .lst-stat-pill.locked-pill { opacity:.5; filter:blur(2px); pointer-events:none; }
    .stat-icon {
      width:38px; height:38px; border-radius:10px;
      display:flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .stat-icon svg { width:17px; height:17px; }
    .si-teal   { background:var(--primary-light);  color:var(--primary); }
    .si-slate  { background:#F1F5F9; color:#475569; }
    .si-indigo { background:#EEF2FF; color:#4F46E5; }
    .si-amber  { background:#FFFBEB; color:#D97706; }
    .si-green  { background:#F0FDF4; color:#16A34A; }
    .si-rose   { background:#FFF1F2; color:#E11D48; }
    .si-violet { background:#F5F3FF; color:#7C3AED; }
    .si-sky    { background:#F0F9FF; color:#0284C7; }
    .stat-body {}
    .stat-label { font-size:.7rem; color:var(--muted); font-weight:500;
                  text-transform:uppercase; letter-spacing:.04em; margin-bottom:.2rem; }
    .stat-value { font-size:1.45rem; font-weight:800; color:var(--text); line-height:1; }

    /* ══ Section header ══ */
    .section-header {
      display:flex; align-items:center; justify-content:space-between;
      margin-bottom:1rem;
    }
    .section-title { font-size:.95rem; font-weight:700; color:var(--text); }
    .btn-add-sm {
      display:inline-flex; align-items:center; gap:.35rem;
      font-size:.78rem; color:var(--primary); font-weight:600;
      text-decoration:none; padding:.35rem .75rem;
      border:1.5px solid var(--primary-mid); border-radius:8px;
      transition:background .15s;
    }
    .btn-add-sm:hover { background:var(--primary-light); }
    .btn-add-sm svg { width:12px; height:12px; }

    /* ══ Listing cards ══ */
    .listings-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1.25rem; }
    .listing-card {
      background:#fff; border-radius:var(--radius-lg); overflow:hidden;
      border:1px solid var(--border); box-shadow:var(--shadow);
      transition:box-shadow .2s,transform .2s;
    }
    .listing-card:hover { box-shadow:var(--shadow-lg); transform:translateY(-2px); }
    .listing-thumb { position:relative; aspect-ratio:16/9; overflow:hidden; background:#f1f5f9; }
    .listing-thumb img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
    .listing-card:hover .listing-thumb img { transform:scale(1.04); }
    .no-photo {
      width:100%; height:100%; display:flex; align-items:center; justify-content:center;
      color:#CBD5E1; flex-direction:column; gap:.5rem; font-size:.78rem; font-weight:500;
    }
    .no-photo svg { width:32px; height:32px; }
    .listing-status {
      position:absolute; top:.6rem; left:.6rem; padding:.2rem .55rem;
      border-radius:999px; font-size:.62rem; font-weight:700;
      text-transform:uppercase; letter-spacing:.06em;
    }
    .status-pending  { background:#FFF7ED; color:#C2410C; border:1px solid #FED7AA; }
    .status-publish  { background:#F0FDF4; color:#15803D; border:1px solid #BBF7D0; }
    .status-draft    { background:#F8FAFC; color:#64748B; border:1px solid #CBD5E1; }
    .tier-badge {
      font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
      padding:.2rem .5rem; border-radius:999px;
      position:absolute; top:.6rem; right:.6rem;
    }
    .tier-free     { background:#EFF6FF; color:#1D4ED8; border:1px solid #BFDBFE; }
    .tier-local    { background:#F0FDF4; color:#15803D; border:1px solid #BBF7D0; }
    .tier-prime    { background:#FFF7ED; color:#C2410C; border:1px solid #FED7AA; }
    .tier-featured { background:#FFFBEB; color:#92400E; border:1px solid #FDE68A; }

    .listing-body { padding:.9rem 1rem; }
    .listing-title {
      font-weight:700; font-size:.9rem; color:var(--text); margin-bottom:.3rem;
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }
    .listing-meta {
      font-size:.76rem; color:var(--muted); display:flex; gap:.6rem;
      flex-wrap:wrap; margin-bottom:.65rem; align-items:center;
    }
    .listing-meta span { display:flex; align-items:center; gap:.2rem; }
    .listing-meta svg { width:11px; height:11px; opacity:.7; }
    .listing-price { font-weight:800; color:var(--secondary); font-size:.9rem; }
    .listing-price span { font-weight:400; color:var(--muted); font-size:.78rem; }
    .listing-stats {
      display:flex; gap:.6rem; margin-top:.55rem; padding-top:.55rem;
      border-top:1px solid var(--border); flex-wrap:wrap;
    }
    .lst-stat { font-size:.7rem; color:var(--muted); display:flex; align-items:center; gap:.2rem; }
    .lst-stat strong { color:var(--text); font-weight:700; }
    .listing-actions {
      display:flex; gap:.5rem; padding:.65rem 1rem;
      border-top:1px solid var(--border); background:var(--bg);
    }
    .action-btn {
      flex:1; padding:.4rem; border-radius:8px; border:none; cursor:pointer;
      font-size:.78rem; font-weight:600; font-family:inherit; transition:background .15s;
      text-align:center; text-decoration:none; display:block;
    }
    .action-edit { background:#EFF6FF; color:#1D4ED8; }
    .action-edit:hover { background:#DBEAFE; }
    .action-view { background:var(--primary-light); color:var(--primary-dark); }
    .action-view:hover { background:var(--primary-mid); }

    /* ══ Two-column layout ══ */
    .two-col {
      display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; align-items:start;
    }
    @media(max-width:960px) { .two-col { grid-template-columns:1fr; } }

    /* ══ Panel (shared card) ══ */
    .panel {
      background:#fff; border-radius:var(--radius-lg); border:1px solid var(--border);
      box-shadow:var(--shadow); overflow:hidden;
    }
    .panel-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:.9rem 1.1rem; border-bottom:1px solid var(--border);
    }
    .panel-title { font-size:.9rem; font-weight:700; color:var(--text); }
    .panel-btn {
      display:inline-flex; align-items:center; gap:.3rem;
      font-size:.78rem; font-weight:600; color:var(--primary);
      background:none; border:1.5px solid var(--primary-mid); border-radius:7px;
      padding:.3rem .7rem; cursor:pointer; font-family:inherit;
      text-decoration:none; transition:background .15s;
    }
    .panel-btn:hover { background:var(--primary-light); }

    /* ══ Write-post form ══ */
    .write-form {
      padding:1rem 1.1rem; border-bottom:1px solid var(--border);
      background:var(--bg);
    }
    .write-form input[type=text] {
      width:100%; padding:.6rem .8rem; border:1.5px solid var(--border);
      border-radius:8px; font-size:.875rem; font-family:inherit; color:var(--text);
      outline:none; margin-bottom:.6rem; background:#fff;
      transition:border-color .2s;
    }
    .write-form input[type=text]:focus { border-color:var(--primary); }
    .write-form textarea {
      width:100%; padding:.6rem .8rem; border:1.5px solid var(--border);
      border-radius:8px; font-size:.875rem; font-family:inherit; color:var(--text);
      outline:none; resize:vertical; min-height:100px; background:#fff;
      transition:border-color .2s; margin-bottom:.75rem; line-height:1.55;
    }
    .write-form textarea:focus { border-color:var(--primary); }
    .write-form-actions { display:flex; gap:.5rem; align-items:center; }
    .btn-publish {
      padding:.5rem 1rem; background:var(--primary); color:#fff;
      border:none; border-radius:8px; font-size:.8rem; font-weight:700;
      cursor:pointer; font-family:inherit; transition:background .2s;
    }
    .btn-publish:hover { background:var(--primary-dark); }
    .btn-publish:disabled { background:#B2EDEF; cursor:not-allowed; }
    .btn-draft {
      padding:.5rem 1rem; background:var(--bg); color:var(--muted);
      border:1.5px solid var(--border); border-radius:8px; font-size:.8rem;
      font-weight:600; cursor:pointer; font-family:inherit; transition:background .2s;
    }
    .btn-draft:hover { background:#E8EEF5; }
    .btn-cancel {
      margin-left:auto; padding:.5rem; background:none; border:none;
      color:var(--muted); font-size:.8rem; cursor:pointer; font-family:inherit;
    }
    .btn-cancel:hover { color:var(--text); }
    .write-err { font-size:.78rem; color:#DC2626; margin-top:.4rem; display:none; }
    .write-err.show { display:block; }
    .write-success { font-size:.78rem; color:#15803D; margin-top:.4rem; display:none; }
    .write-success.show { display:block; }

    /* ══ Post list rows ══ */
    .post-list { }
    .post-item {
      display:flex; align-items:flex-start; gap:.85rem;
      padding:.85rem 1.1rem; border-bottom:1px solid var(--border);
      transition:background .15s;
    }
    .post-item:last-child { border-bottom:none; }
    .post-item:hover { background:#FAFCFE; }
    .post-icon {
      width:34px; height:34px; border-radius:8px; background:var(--bg);
      display:flex; align-items:center; justify-content:center;
      color:var(--muted); flex-shrink:0; margin-top:.1rem;
    }
    .post-body { flex:1; min-width:0; }
    .post-title {
      font-size:.85rem; font-weight:600; color:var(--text); line-height:1.35;
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:.25rem;
    }
    .post-meta { font-size:.72rem; color:var(--muted); display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .post-status-badge {
      font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
      padding:.1rem .45rem; border-radius:999px;
    }
    .ps-publish { background:#F0FDF4; color:#15803D; border:1px solid #BBF7D0; }
    .ps-draft   { background:#F8FAFC; color:#64748B; border:1px solid #CBD5E1; }
    .ps-pending { background:#FFF7ED; color:#C2410C; border:1px solid #FED7AA; }
    .post-edit-link {
      font-size:.72rem; color:var(--primary); font-weight:600;
      text-decoration:none; white-space:nowrap;
    }
    .post-edit-link:hover { text-decoration:underline; }
    .posts-empty {
      padding:2.5rem 1.5rem; text-align:center; color:var(--muted); font-size:.85rem;
    }

    /* ══ Listing list rows (compact) ══ */
    .listing-row {
      display:flex; align-items:center; gap:.85rem;
      padding:.8rem 1.1rem; border-bottom:1px solid var(--border);
      transition:background .15s;
    }
    .listing-row:last-child { border-bottom:none; }
    .listing-row:hover { background:#FAFCFE; }
    .listing-row-thumb {
      width:62px; height:46px; border-radius:8px; object-fit:cover;
      flex-shrink:0; background:#f1f5f9;
    }
    .listing-row-thumb-empty {
      width:62px; height:46px; border-radius:8px; background:#f1f5f9;
      display:flex; align-items:center; justify-content:center;
      color:#CBD5E1; flex-shrink:0;
    }
    .listing-row-body { flex:1; min-width:0; }
    .listing-row-title {
      font-size:.85rem; font-weight:600; color:var(--text);
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:.2rem;
    }
    .listing-row-meta { font-size:.72rem; color:var(--muted); display:flex; align-items:center; gap:.4rem; flex-wrap:wrap; }
    .listing-row-action {
      display:inline-flex; align-items:center; gap:.3rem;
      background:#fff; border:1px solid var(--border); color:var(--text);
      font-family:'DM Sans', sans-serif; font-size:.74rem; font-weight:700;
      padding:.32rem .65rem; border-radius:6px; cursor:pointer;
      transition:background .12s, border-color .12s, color .12s;
    }
    .listing-row-action:hover { background:#f9fafb; border-color:#9ca3af; }
    .listing-row-action-danger { color:#b91c1c; border-color:#fca5a5; }
    .listing-row-action-danger:hover { background:#fef2f2; border-color:#f87171; }

    .listing-row-edit {
      font-size:.72rem; color:var(--primary); font-weight:600;
      text-decoration:none; white-space:nowrap; flex-shrink:0;
    }
    .listing-row-edit:hover { text-decoration:underline; }
    .listings-empty {
      padding:2.5rem 1.5rem; text-align:center; color:var(--muted); font-size:.85rem;
    }

    /* ══ Empty state ══ */
    .empty-state {
      text-align:center; padding:3.5rem 1.5rem; background:#fff;
      border-radius:var(--radius-lg); border:2px dashed var(--border);
    }
    .empty-state .empty-icon {
      width:56px; height:56px; border-radius:14px; background:var(--primary-light);
      display:flex; align-items:center; justify-content:center;
      color:var(--primary); margin:0 auto 1.1rem;
    }
    .empty-state .empty-icon svg { width:26px; height:26px; }
    .empty-state h3 { font-size:1rem; font-weight:700; color:var(--text); margin-bottom:.4rem; }
    .empty-state p  { font-size:.85rem; color:var(--muted); margin-bottom:1.4rem; }

    /* ══ Loading skeleton ══ */
    .skeleton {
      background:linear-gradient(90deg,#f0f4f8 25%,#e5ebf2 50%,#f0f4f8 75%);
      background-size:200% 100%; animation:shimmer 1.4s infinite; border-radius:8px;
    }
    @keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

    /* ══ Orders / Billing tab ══ */
    .orders-header {
      margin-bottom:1.5rem;
    }
    .orders-header h2 { font-size:1.1rem; font-weight:800; color:var(--text); margin-bottom:.3rem; }
    .orders-header p  { font-size:.85rem; color:var(--muted); }

    .sub-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.25rem; }

    .sub-card {
      background:#fff; border-radius:var(--radius-lg); border:1px solid var(--border);
      box-shadow:var(--shadow); overflow:hidden;
      transition:box-shadow .2s;
    }
    .sub-card:hover { box-shadow:var(--shadow-lg); }

    .sub-card-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:.85rem 1rem; border-bottom:1px solid var(--border);
      background:var(--bg);
    }
    .sub-card-title {
      font-size:.85rem; font-weight:700; color:var(--text);
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:160px;
    }
    .sub-status-badge {
      font-size:.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
      padding:.22rem .55rem; border-radius:999px; white-space:nowrap; flex-shrink:0;
    }
    .ssb-paid     { background:#F0FDF4; color:#15803D; border:1px solid #BBF7D0; }
    .ssb-pending  { background:#FFF7ED; color:#C2410C; border:1px solid #FED7AA; }
    .ssb-free     { background:#EFF6FF; color:#1D4ED8; border:1px solid #BFDBFE; }
    .ssb-expired  { background:#FFF1F2; color:#E11D48; border:1px solid #FECDD3; }

    .sub-card-body { padding:.9rem 1rem; }
    .sub-free-note { font-size:.82rem; line-height:1.5; color:var(--muted); margin:.6rem 0 0; }

    .sub-plan-row {
      display:flex; align-items:center; gap:.6rem; margin-bottom:.85rem;
    }
    .sub-plan-icon {
      width:36px; height:36px; border-radius:10px; flex-shrink:0;
      display:flex; align-items:center; justify-content:center;
    }
    .sub-plan-icon svg { width:16px; height:16px; }
    .spi-free     { background:#EFF6FF; color:#1D4ED8; }
    .spi-local    { background:#F0FDF4; color:#15803D; }
    .spi-prime    { background:#FFF7ED; color:#C2410C; }
    .spi-featured { background:#FFFBEB; color:#92400E; }

    .sub-plan-name { font-size:.95rem; font-weight:800; color:var(--text); line-height:1.1; }
    .sub-plan-cycle { font-size:.72rem; color:var(--muted); font-weight:500; margin-top:.1rem; }

    .sub-details {
      display:grid; grid-template-columns:1fr 1fr; gap:.5rem .75rem; margin-bottom:.9rem;
    }
    .sub-detail-item {}
    .sub-detail-label { font-size:.62rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:.15rem; }
    .sub-detail-value { font-size:.82rem; font-weight:600; color:var(--text); }
    .sub-detail-value.muted { color:var(--muted); font-weight:400; }

    .sub-expiry-bar-wrap { margin-bottom:.9rem; }
    .sub-expiry-label { font-size:.68rem; color:var(--muted); margin-bottom:.35rem; display:flex; justify-content:space-between; }
    .sub-expiry-bar { height:5px; border-radius:99px; background:var(--border); overflow:hidden; }
    .sub-expiry-fill { height:100%; border-radius:99px; transition:width .6s; }
    .sef-ok      { background:var(--primary); }
    .sef-warn    { background:#F59E0B; }
    .sef-expired { background:#EF4444; }

    .sub-card-actions {
      display:flex; gap:.5rem; padding:.7rem 1rem;
      border-top:1px solid var(--border); background:var(--bg);
    }
    .btn-sub-renew {
      flex:1; padding:.45rem; background:var(--primary); color:#fff;
      border:none; border-radius:8px; font-size:.78rem; font-weight:700;
      cursor:pointer; font-family:inherit; transition:background .2s; text-align:center;
      text-decoration:none; display:block;
    }
    .btn-sub-renew:hover { background:var(--primary-dark); }
    .btn-sub-upgrade {
      flex:1; padding:.45rem; background:var(--primary-light); color:var(--primary-dark);
      border:1.5px solid var(--primary-mid); border-radius:8px; font-size:.78rem; font-weight:700;
      cursor:pointer; font-family:inherit; transition:background .2s; text-align:center;
      text-decoration:none; display:block;
    }
    .btn-sub-upgrade:hover { background:var(--primary-mid); }

    .orders-empty {
      text-align:center; padding:4rem 1.5rem; background:#fff;
      border-radius:var(--radius-lg); border:2px dashed var(--border);
      color:var(--muted); font-size:.875rem;
    }
    .orders-empty h3 { font-size:1rem; font-weight:700; color:var(--text); margin-bottom:.5rem; }

    .orders-notice {
      background:var(--primary-light); border:1px solid var(--primary-mid);
      border-radius:var(--radius); padding:.8rem 1rem; margin-bottom:1.25rem;
      font-size:.8rem; color:var(--primary-dark); display:flex; align-items:flex-start; gap:.6rem;
    }
    .orders-notice svg { width:15px; height:15px; flex-shrink:0; margin-top:.05rem; }

    /* ══ Renewal modal ══ */
    .modal-backdrop {
      position:fixed; inset:0; background:rgba(21,26,30,.55); backdrop-filter:blur(3px);
      z-index:1000; display:flex; align-items:center; justify-content:center; padding:1rem;
    }
    .modal-box {
      background:#fff; border-radius:var(--radius-lg); width:100%; max-width:520px;
      max-height:90vh; overflow-y:auto; box-shadow:0 24px 64px rgba(0,0,0,.22);
      animation:modal-in .18s ease;
    }
    @keyframes modal-in { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    .modal-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:1.1rem 1.25rem; border-bottom:1px solid var(--border);
    }
    .modal-title { font-size:1rem; font-weight:800; color:var(--text); }
    .modal-close {
      width:30px; height:30px; border-radius:8px; background:var(--bg); border:none;
      cursor:pointer; display:flex; align-items:center; justify-content:center;
      color:var(--muted); transition:background .15s;
    }
    .modal-close:hover { background:var(--border); color:var(--text); }
    .modal-close svg { width:15px; height:15px; }
    .modal-body { padding:1.25rem; }
    .modal-listing-name {
      font-size:.78rem; color:var(--muted); margin-bottom:1.1rem;
      padding:.5rem .75rem; background:var(--bg); border-radius:8px; border:1px solid var(--border);
    }
    .modal-listing-name strong { color:var(--text); }

    .modal-section { margin-bottom:1.1rem; }
    .modal-label {
      font-size:.7rem; font-weight:700; color:var(--muted);
      text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; display:block;
    }
    .tier-grid { display:grid; grid-template-columns:1fr 1fr; gap:.5rem; }
    .tier-opt {
      border:2px solid var(--border); border-radius:10px; padding:.6rem .75rem;
      cursor:pointer; transition:border-color .15s,background .15s;
      background:#fff;
    }
    .tier-opt:hover { border-color:var(--primary-mid); }
    .tier-opt.selected { border-color:var(--primary); background:var(--primary-light); }
    .tier-opt input { display:none; }
    .tier-opt-name { font-size:.82rem; font-weight:700; color:var(--text); }
    .tier-opt-price { font-size:.72rem; color:var(--muted); margin-top:.1rem; }
    .tier-opt.selected .tier-opt-name { color:var(--primary-dark); }
    .tier-opt.selected .tier-opt-price { color:var(--primary); }

    .billing-grid { display:flex; gap:.5rem; flex-wrap:wrap; }
    .billing-opt {
      flex:1; min-width:90px; border:2px solid var(--border); border-radius:10px;
      padding:.55rem .6rem; cursor:pointer; transition:border-color .15s,background .15s;
      background:#fff; text-align:center;
    }
    .billing-opt:hover { border-color:var(--primary-mid); }
    .billing-opt.selected { border-color:var(--primary); background:var(--primary-light); }
    .billing-opt input { display:none; }
    .billing-opt-label { font-size:.8rem; font-weight:700; color:var(--text); }
    .billing-opt-price { font-size:.7rem; color:var(--muted); margin-top:.1rem; }
    .billing-opt.selected .billing-opt-label { color:var(--primary-dark); }
    .billing-opt.selected .billing-opt-price { color:var(--primary); }
    .billing-opt-save { font-size:.6rem; color:#15803D; font-weight:700; }

    .price-summary {
      background:var(--primary-light); border:1px solid var(--primary-mid);
      border-radius:10px; padding:.75rem 1rem; display:flex; align-items:center;
      justify-content:space-between; margin-bottom:1.1rem;
    }
    .price-summary-label { font-size:.78rem; color:var(--primary-dark); font-weight:600; }
    .price-summary-amount { font-size:1.25rem; font-weight:800; color:var(--primary-dark); }

    .payment-methods { display:flex; gap:.5rem; }
    .pm-opt {
      flex:1; border:2px solid var(--border); border-radius:10px; padding:.6rem;
      cursor:pointer; transition:border-color .15s,background .15s; background:#fff;
      text-align:center;
    }
    .pm-opt:hover { border-color:var(--primary-mid); }
    .pm-opt.selected { border-color:var(--primary); background:var(--primary-light); }
    .pm-opt input { display:none; }
    .pm-opt-name { font-size:.8rem; font-weight:700; color:var(--text); }
    .pm-opt.selected .pm-opt-name { color:var(--primary-dark); }

    .qr-wrap { text-align:center; margin:.75rem 0; }
    .qr-wrap img { max-width:180px; border-radius:10px; border:1px solid var(--border); }

    .modal-input {
      width:100%; padding:.6rem .8rem; border:1.5px solid var(--border);
      border-radius:8px; font-size:.875rem; font-family:inherit; color:var(--text);
      outline:none; background:#fff; transition:border-color .2s;
    }
    .modal-input:focus { border-color:var(--primary); }
    .modal-coupon-row { display:flex; gap:.4rem; align-items:stretch; }
    .modal-coupon-row .modal-input { flex:1; min-width:0; text-transform:uppercase; }
    .btn-coupon-apply, .btn-coupon-clear {
      flex-shrink:0; padding:0 1rem; border:1px solid var(--border); border-radius:8px;
      background:#fff; color:var(--text); font-family:'DM Sans', sans-serif;
      font-weight:700; font-size:.82rem; cursor:pointer;
      transition: background .12s, border-color .12s;
    }
    .btn-coupon-apply { background:var(--primary); color:#fff; border-color:var(--primary); }
    .btn-coupon-apply:hover { background:var(--primary-dark); }
    .btn-coupon-clear:hover { background:#f1f5f9; border-color:#9ca3af; }
    .modal-coupon-status { font-size:.75rem; margin-top:.4rem; min-height:1em; }
    .modal-coupon-status.ok  { color:#047857; font-weight:600; }
    .modal-coupon-status.err { color:#b91c1c; font-weight:600; }

    .upload-zone {
      border:2px dashed var(--border); border-radius:10px; padding:1rem;
      text-align:center; cursor:pointer; transition:border-color .2s,background .2s;
      position:relative;
    }
    .upload-zone:hover { border-color:var(--primary); background:var(--primary-light); }
    .upload-zone input[type=file] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
    .upload-zone-text { font-size:.78rem; color:var(--muted); pointer-events:none; }
    .upload-zone-text strong { color:var(--primary); }
    .upload-preview { max-width:160px; border-radius:8px; margin:.5rem auto 0; display:block; }

    .modal-footer {
      padding:1rem 1.25rem; border-top:1px solid var(--border);
      display:flex; gap:.6rem; align-items:center;
    }
    .btn-modal-submit {
      flex:1; padding:.6rem; background:var(--primary); color:#fff;
      border:none; border-radius:9px; font-size:.875rem; font-weight:700;
      cursor:pointer; font-family:inherit; transition:background .2s;
    }
    .btn-modal-submit:hover { background:var(--primary-dark); }
    .btn-modal-submit:disabled { background:#B2EDEF; cursor:not-allowed; }
    .btn-modal-cancel {
      padding:.6rem 1rem; background:var(--bg); color:var(--muted);
      border:1.5px solid var(--border); border-radius:9px; font-size:.875rem;
      font-weight:600; cursor:pointer; font-family:inherit; transition:background .2s;
    }
    .btn-modal-cancel:hover { background:#E8EEF5; }
    .modal-msg { font-size:.78rem; margin-top:.5rem; display:none; }
    .modal-msg.error   { color:#DC2626; display:block; }
    .modal-msg.success { color:#15803D; display:block; }

    /* ══ Saved listings grid ══ */
    .saved-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
    }
    .saved-card .listing-thumb { aspect-ratio: 4/3; }
    .saved-card .listing-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .saved-card:hover .listing-thumb img { transform: scale(1.04); }
    .btn-unsave {
      flex: 0 0 auto; padding: .4rem .75rem;
      background: #FFF1F2; color: #E11D48; border-radius: 8px;
      border: none; font-size: .78rem; font-weight: 700;
      cursor: pointer; font-family: inherit; transition: background .15s;
      display: flex; align-items: center; gap: .3rem;
    }
    .btn-unsave:hover { background: #FFE4E6; }
    .btn-unsave:disabled { opacity: .5; cursor: not-allowed; }
    .saved-empty {
      text-align: center; padding: 4rem 1.5rem; background: #fff;
      border-radius: var(--radius-lg); border: 2px dashed var(--border);
    }
    .saved-empty .empty-heart {
      width: 60px; height: 60px; border-radius: 50%;
      background: #FFF1F2; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.1rem;
    }
    .saved-empty .empty-heart svg { width: 28px; height: 28px; }
    .saved-empty h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: .4rem; }
    .saved-empty p  { font-size: .85rem; color: var(--muted); margin-bottom: 1.4rem; }
    .saved-skeleton { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }

    /* ══ Reviews tab ══ */
    .rv-count-badge {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--primary); color: #fff;
      font-size: .65rem; font-weight: 800; font-family: 'DM Sans', sans-serif;
      min-width: 20px; height: 20px; border-radius: 999px; padding: 0 5px;
      vertical-align: middle; margin-left: .4rem;
    }
    .rv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.25rem; }
    .rv-card {
      background: #fff; border-radius: var(--radius-lg); border: 1px solid var(--border);
      box-shadow: var(--shadow); overflow: hidden;
      transition: box-shadow .2s;
    }
    .rv-card:hover { box-shadow: var(--shadow-lg); }
    .rv-card-header {
      padding: .8rem 1rem; border-bottom: 1px solid var(--border);
      background: var(--bg); display: flex; align-items: center; justify-content: space-between;
    }
    .rv-listing-name {
      font-size: .82rem; font-weight: 700; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;
    }
    .rv-source-badge {
      font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
      padding: .18rem .45rem; border-radius: 999px; flex-shrink: 0;
      background: var(--primary-light); color: var(--primary-dark); border: 1px solid var(--primary-mid);
    }
    .rv-card-body { padding: .9rem 1rem; }
    .rv-reviewer {
      display: flex; align-items: center; gap: .6rem; margin-bottom: .65rem;
    }
    .rv-reviewer-avatar {
      width: 32px; height: 32px; border-radius: 50%; background: var(--primary-trans-20);
      display: flex; align-items: center; justify-content: center;
      font-size: .72rem; font-weight: 700; color: var(--primary-dark); flex-shrink: 0;
    }
    .rv-reviewer-name { font-size: .85rem; font-weight: 700; color: var(--text); line-height: 1.2; }
    .rv-reviewer-date { font-size: .72rem; color: var(--muted); }
    .rv-stars { display: flex; gap: 2px; margin-bottom: .65rem; }
    .rv-star { color: #f59e0b; font-size: 14px; line-height: 1; }
    .rv-star.empty { color: var(--border); }
    .rv-content {
      font-size: .875rem; color: var(--text); line-height: 1.55;
      margin-bottom: .75rem;
      display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden;
    }
    .rv-stay-month { font-size: .72rem; color: var(--muted); margin-bottom: .75rem; }
    .rv-reply-section { margin-top: .75rem; }
    .rv-reply-label { font-size: .7rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .4rem; }
    .rv-reply-existing {
      font-size: .8rem; color: var(--text); background: var(--bg);
      border: 1px solid var(--border); border-radius: 8px;
      padding: .5rem .75rem; line-height: 1.5;
    }
    .rv-reply-input {
      width: 100%; padding: .5rem .75rem;
      border: 1.5px solid var(--border); border-radius: 8px;
      font-size: .875rem; font-family: inherit; color: var(--text);
      outline: none; resize: vertical; min-height: 64px; background: #fff;
      transition: border-color .2s; margin-bottom: .5rem; line-height: 1.45;
    }
    .rv-reply-input:focus { border-color: var(--primary); }
    .rv-card-actions {
      display: flex; gap: .5rem; padding: .7rem 1rem;
      border-top: 1px solid var(--border); background: var(--bg);
      flex-wrap: wrap; align-items: center;
    }
    .rv-btn-approve {
      padding: .42rem .9rem; background: #F0FDF4; color: #15803D;
      border: 1.5px solid #BBF7D0; border-radius: 8px;
      font-size: .78rem; font-weight: 700; cursor: pointer;
      font-family: inherit; transition: background .15s;
    }
    .rv-btn-approve:hover { background: #DCFCE7; }
    .rv-btn-approve:disabled { opacity: .5; cursor: not-allowed; }
    .rv-btn-reject {
      padding: .42rem .9rem; background: #FFF1F2; color: #E11D48;
      border: 1.5px solid #FECDD3; border-radius: 8px;
      font-size: .78rem; font-weight: 700; cursor: pointer;
      font-family: inherit; transition: background .15s;
    }
    .rv-btn-reject:hover { background: #FFE4E6; }
    .rv-btn-reject:disabled { opacity: .5; cursor: not-allowed; }
    .rv-btn-reply {
      padding: .42rem .9rem; background: var(--primary-light); color: var(--primary-dark);
      border: 1.5px solid var(--primary-mid); border-radius: 8px;
      font-size: .78rem; font-weight: 700; cursor: pointer;
      font-family: inherit; transition: background .15s;
    }
    .rv-btn-reply:hover { background: var(--primary-mid); }
    .rv-btn-reply:disabled { opacity: .5; cursor: not-allowed; }
    .rv-action-msg { font-size: .75rem; margin-left: auto; }
    .rv-action-msg.success { color: #15803D; }
    .rv-action-msg.error   { color: #DC2626; }
    .rv-empty {
      text-align: center; padding: 4rem 1.5rem; background: #fff;
      border-radius: var(--radius-lg); border: 2px dashed var(--border);
      color: var(--muted); font-size: .875rem;
    }
    .rv-empty h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }

    /* ══ Role gating ══ */
    /* Two roles on the frontend: guest and host. Admins are treated as
       hosts here — the admin-specific dashboard lives in WP admin. */
    body:not(.role-host) .host-only,
    body:not(.role-host) .host-only-flex { display: none !important; }
    body.role-host .guest-only { display: none !important; }

    /* ══ Become a host CTA (guest only) ══ */
    .become-host-card {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff; border-radius: var(--radius-lg); padding: 2rem 2.25rem;
      display: flex; gap: 1.5rem; align-items: center; margin-bottom: 2rem;
      box-shadow: 0 12px 32px rgba(8, 145, 178, .25);
    }
    .become-host-card .ico {
      width: 56px; height: 56px; border-radius: 14px; background: rgba(255,255,255,.18);
      display: grid; place-items: center; flex: 0 0 auto;
    }
    .become-host-card h2 { font-size: 1.25rem; font-weight: 800; margin-bottom: .35rem; }
    .become-host-card p  { font-size: .9rem; opacity: .92; line-height: 1.5; }
    .become-host-card .cta {
      background: #fff; color: var(--primary-dark); font-weight: 800;
      padding: .7rem 1.4rem; border-radius: 10px; text-decoration: none;
      font-size: .875rem; flex: 0 0 auto;
    }

    /* ══ My reviews (author-side) ══ */
    .myrv-list { display: flex; flex-direction: column; gap: 1rem; }
    .myrv-card {
      background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem; display: flex; gap: 1.25rem; align-items: flex-start;
    }
    .myrv-thumb {
      width: 96px; height: 96px; border-radius: 12px; background: #F5F8FB; flex: 0 0 auto;
      overflow: hidden; display: grid; place-items: center;
    }
    .myrv-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .myrv-body { flex: 1 1 auto; min-width: 0; }
    .myrv-listing { font-weight: 800; font-size: 1rem; color: var(--text); margin-bottom: .25rem; }
    .myrv-meta { font-size: .8rem; color: var(--muted); margin-bottom: .55rem; display: flex; flex-wrap: wrap; gap: .35rem .8rem; align-items: center; }
    .myrv-stars { color: #F59E0B; letter-spacing: 1px; }
    .myrv-content { font-size: .9rem; color: var(--text); line-height: 1.5; }
    .myrv-status {
      display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .55rem;
      border-radius: 999px; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    }
    .myrv-status-pending_email    { background: #FEF3C7; color: #92400E; }
    .myrv-status-pending_approval { background: #DBEAFE; color: #1E3A8A; }
    .myrv-status-approved         { background: #D1FAE5; color: #065F46; }
    .myrv-status-rejected         { background: #FEE2E2; color: #991B1B; }
    .myrv-actions { display: flex; gap: .5rem; margin-top: .75rem; }
    .myrv-edit-btn {
      background: #fff; border: 1.5px solid var(--text); color: var(--text); border-radius: 8px;
      padding: .4rem 1rem; font-size: .8rem; font-weight: 700; cursor: pointer;
    }
    .myrv-edit-btn:hover { background: #F5F8FB; }
    .myrv-host-reply {
      margin-top: .75rem; padding: .75rem 1rem; background: var(--primary-trans-10);
      border-left: 3px solid var(--primary); border-radius: 8px; font-size: .85rem; color: var(--text);
    }
    .myrv-host-reply strong { display: block; font-size: .75rem; color: var(--primary-dark); margin-bottom: .25rem; }

    /* ══ Account settings ══ */
    .account-card {
      background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
      padding: 2rem; max-width: 640px;
    }
    .account-row { display: flex; align-items: center; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
    .account-row:last-child { border-bottom: 0; }
    .account-row-label { font-size: .8rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; min-width: 120px; }
    .account-row-value { font-size: .95rem; color: var(--text); flex: 1; }
    .account-photo { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); display: block; }
    .account-photo-fallback {
      width: 80px; height: 80px; border-radius: 50%; background: var(--primary);
      color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 1.5rem;
    }
    .account-input {
      width: 100%; padding: .55rem .75rem; border: 1.5px solid var(--border); border-radius: 9px;
      font-size: .95rem; color: var(--text); background: #fff; box-sizing: border-box;
      transition: border-color .15s;
    }
    .account-input:focus { outline: none; border-color: var(--primary); }
    .account-input:disabled { background: #F5F8FB; color: #94A3B8; cursor: not-allowed; }
    .account-photo-edit {
      margin-top: .55rem; background: none; border: 0; color: var(--primary); font-weight: 700;
      font-size: .8rem; cursor: pointer; padding: 0; text-decoration: underline;
    }
    .account-photo-edit:hover { color: var(--primary-dark); }
    .account-save-row { display: flex; gap: .75rem; align-items: center; padding-top: 1.25rem; }
    .account-save-btn {
      background: var(--primary); color: #fff; border: 0; padding: .65rem 1.5rem;
      border-radius: 9px; font-weight: 700; font-size: .9rem; cursor: pointer;
      transition: background .15s;
    }
    .account-save-btn:hover { background: var(--primary-dark); }
    .account-save-btn:disabled { opacity: .55; cursor: not-allowed; }
    .account-msg { font-size: .85rem; color: var(--muted); }
    .account-msg.is-success { color: #16A34A; font-weight: 600; }
    .account-msg.is-error   { color: #DC2626; font-weight: 600; }

    /* ══ Profile photo upload modal ══ */
    .photo-modal-body { padding: 1.25rem 1.5rem; }
    .photo-intro { font-size: .9rem; color: var(--muted); margin-bottom: 1rem; line-height: 1.5; }
    .photo-drop-zone {
      display: block; position: relative; border: 2px dashed #CBD5E1; border-radius: 14px;
      padding: 2.5rem 1rem; text-align: center; cursor: pointer;
      transition: border-color .15s, background .15s; overflow: hidden;
    }
    .photo-drop-zone:hover { border-color: var(--primary); background: var(--primary-trans-10); }
    .photo-drop-zone input[type="file"] {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; cursor: pointer; font-size: 0;
    }
    .photo-drop-icon { color: #CBD5E1; margin: 0 auto .75rem; display: block; }
    .photo-drop-text strong { display: block; color: var(--text); font-size: 1rem; margin-bottom: .25rem; }
    .photo-drop-text span { color: var(--muted); font-size: .8rem; }
    #photo-cropper-wrap { max-width: 100%; max-height: 360px; overflow: hidden; background: #1A2533; border-radius: 12px; }
    #photo-cropper-img { display: block; max-width: 100%; }
    .cropper-view-box, .cropper-face { border-radius: 50%; }
    #photo-face-status {
      margin-top: .9rem; padding: .65rem .85rem; border-radius: 9px;
      font-size: .85rem; display: flex; align-items: center; gap: .5rem;
    }
    .face-status-checking { background: #F1F5F9; color: #475569; }
    .face-status-ok       { background: #D1FAE5; color: #065F46; }
    .face-status-warn     { background: #FEF3C7; color: #92400E; }
    .face-status-error    { background: #FEE2E2; color: #991B1B; }

    /* ══ Required-photo blocking modal ══ */
    .blocking-photo-banner {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff; padding: 1.5rem; border-radius: 12px 12px 0 0;
    }
    .blocking-photo-banner h3 { font-size: 1.1rem; font-weight: 800; margin-bottom: .35rem; }
    .blocking-photo-banner p  { font-size: .85rem; opacity: .9; line-height: 1.5; }

    /* ══ Impersonation banner (admin viewing as host) ══ */
    .impersonation-banner {
      position: sticky; top: 0; z-index: 60;
      background: #1F2937; color: #fff;
      padding: .55rem 1.25rem; display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; font-size: .85rem; box-shadow: 0 2px 8px rgba(0,0,0,.15);
    }
    .impersonation-banner .imp-info { display: flex; align-items: center; gap: .55rem; min-width: 0; }
    .impersonation-banner strong { font-weight: 800; }
    .impersonation-banner button {
      background: #fff; color: #1F2937; border: 0; border-radius: 6px;
      padding: .35rem .9rem; font-weight: 700; font-size: .8rem; cursor: pointer; flex-shrink: 0;
    }
    .impersonation-banner button:hover { background: #F3F4F6; }
    body.is-impersonating .main { padding-top: 0; }

    /* ══ Posts: rich-text editor ══ */
    .featured-img-picker {
      position: relative; display: block; border: 1.5px dashed #CBD5E1;
      border-radius: 10px; padding: 1rem; margin-bottom: .85rem; cursor: pointer;
      text-align: center; transition: border-color .15s, background .15s; overflow: hidden;
    }
    .featured-img-picker:hover { border-color: var(--primary); background: var(--primary-trans-10); }
    .featured-img-picker.has-image { padding: 0; border-style: solid; border-color: var(--border); }
    .featured-img-picker input[type="file"] { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; font-size: 0; }
    .featured-img-picker img { display: block; width: 100%; max-height: 200px; object-fit: cover; }
    .featured-img-text { color: var(--muted); font-size: .85rem; font-weight: 600; }
    .featured-img-remove { position: absolute; top: .5rem; right: .5rem; background: rgba(0,0,0,.55); color: #fff; border: 0; border-radius: 999px; width: 28px; height: 28px; cursor: pointer; display: grid; place-items: center; z-index: 2; }
    .featured-img-remove:hover { background: rgba(0,0,0,.75); }
    #editorjs-mount {
      min-height: 220px; border: 1.5px solid var(--border); border-radius: 10px;
      padding: .75rem 1rem; background: #fff; margin-bottom: .85rem; max-width: none;
    }
    #editorjs-mount:focus-within { border-color: var(--primary); }
    #editorjs-mount .codex-editor__redactor { padding-bottom: 100px !important; }
    .post-edit-trigger { background: none; border: 0; color: var(--primary); font-weight: 600; font-size: .8rem; cursor: pointer; padding: 0; }
    .post-edit-trigger:hover { color: var(--primary-dark); text-decoration: underline; }
    .post-delete-trigger { background: none; border: 0; color: #DC2626; font-weight: 600; font-size: .8rem; cursor: pointer; padding: 0; }
    .post-delete-trigger:hover { text-decoration: underline; }

    /* ══ Tier-gated posts overlay ══ */
    .posts-locked-wrap { position: relative; }
    /* When the lock is on, force enough panel height that the centered CTA
       card (~250px tall) never gets clipped — even when the blurred posts
       list inside is empty or tiny. */
    .posts-locked-wrap.is-locked { min-height: 360px; }
    .posts-locked-content { filter: blur(4px); pointer-events: none; user-select: none; }
    .posts-locked-overlay {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      padding: 1.5rem; z-index: 5;
    }
    .posts-locked-card {
      background: #fff; border: 1.5px solid var(--border); border-radius: 14px;
      padding: 1.5rem; max-width: 320px; text-align: center; box-shadow: 0 8px 24px rgba(15,23,42,.08);
    }
    .posts-locked-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--primary-trans-10); color: var(--primary); display: grid; place-items: center; margin: 0 auto .85rem; }
    .posts-locked-title { font-weight: 800; color: var(--text); font-size: 1rem; margin-bottom: .35rem; }
    .posts-locked-desc { font-size: .8rem; color: var(--muted); line-height: 1.5; margin-bottom: 1rem; }
    .posts-locked-cta { display: inline-block; background: var(--primary); color: #fff; padding: .55rem 1.25rem; border-radius: 8px; font-size: .85rem; font-weight: 700; text-decoration: none; }
    .posts-locked-cta:hover { background: var(--primary-dark); }

    /* ══ Analytics dashboard ══ */
    .analytics-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;
    }
    .analytics-header h1 { font-size: 1.5rem; font-weight: 800; color: var(--text); line-height: 1.15; margin: 0; }
    .analytics-subtitle { font-size: .875rem; color: var(--muted); margin-top: .25rem; max-width: 520px; line-height: 1.5; }

    .period-chips { display: inline-flex; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 3px; gap: 2px; }
    .period-chip {
      background: none; border: 0; padding: .5rem .9rem; font-size: .8rem; font-weight: 700;
      color: var(--muted); border-radius: 8px; cursor: pointer; transition: background .12s, color .12s;
    }
    .period-chip:hover:not(:disabled) { color: var(--text); }
    .period-chip.is-active { background: var(--primary); color: #fff; }
    .period-chip:disabled  { opacity: .5; cursor: not-allowed; }

    .onboarding-nudge {
      display:flex; align-items:center; gap:1rem;
      background:linear-gradient(120deg, var(--primary-trans-10), #fff 60%);
      border:1px solid var(--primary-trans-20); border-radius:14px;
      padding:1rem 1.25rem; margin-bottom:1.5rem;
    }
    .onb-icon {
      flex-shrink:0; width:42px; height:42px; border-radius:50%;
      background:var(--primary); color:#fff;
      display:grid; place-items:center;
    }
    .onb-body { flex:1; min-width:0; }
    .onb-title { font-family:'DM Sans', sans-serif; font-size:1rem; font-weight:800; color:var(--text); line-height:1.2; }
    .onb-sub   { font-size:.83rem; color:var(--muted); margin:.25rem 0 0; line-height:1.45; }
    .onb-actions { display:flex; gap:.5rem; flex-shrink:0; }
    .onb-btn {
      display:inline-flex; align-items:center; gap:.4rem; padding:.55rem .9rem;
      border-radius:9px; font-family:'DM Sans', sans-serif; font-weight:700;
      font-size:.82rem; text-decoration:none; transition:filter .12s, transform .12s;
    }
    .onb-btn.primary { background:var(--primary); color:#fff; }
    .onb-btn.primary:hover { filter:brightness(.92); transform:translateY(-1px); }
    .onb-btn.ghost { background:#fff; color:var(--text); border:1px solid var(--border); }
    .onb-btn.ghost:hover { border-color:var(--primary); color:var(--primary); }
    @media (max-width: 720px) {
      .onboarding-nudge { flex-direction:column; align-items:flex-start; }
      .onb-actions { width:100%; }
      .onb-actions .onb-btn { flex:1; justify-content:center; }
    }

    .my-listings-add-btn {
      display: inline-flex; align-items: center; gap: .4rem;
      background: var(--primary); color: #fff; border-radius: 10px;
      padding: .55rem .9rem; font-size: .82rem; font-weight: 700;
      text-decoration: none; transition: filter .12s, transform .12s;
    }
    .my-listings-add-btn:hover { filter: brightness(.92); transform: translateY(-1px); }
    .my-listings-add-btn svg { stroke: currentColor; }

    .kpi-grid {
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; margin-bottom: 1.75rem;
    }
    .kpi-card {
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: 1.1rem 1.15rem; transition: box-shadow .12s, transform .12s;
    }
    .kpi-card:hover { box-shadow: 0 4px 14px rgba(15,23,42,.05); }
    .kpi-label { font-size: .7rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .35rem; }
    .kpi-value { font-size: 1.7rem; font-weight: 800; color: var(--text); line-height: 1.05; }
    .kpi-delta { display: inline-flex; align-items: center; gap: .2rem; font-size: .72rem; font-weight: 700; margin-top: .35rem; }
    .kpi-delta.up   { color: #16A34A; }
    .kpi-delta.down { color: #DC2626; }
    .kpi-delta.flat { color: #94A3B8; }
    .kpi-delta-sub  { color: var(--muted); font-weight: 500; margin-left: .35rem; font-size: .68rem; }
    .kpi-card.is-locked { position: relative; overflow: hidden; }
    .kpi-card.is-locked .kpi-value { filter: blur(5px); user-select: none; }
    .kpi-card .kpi-lock-overlay {
      position: absolute; inset: 0; background: rgba(255,255,255,.55);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .25rem;
    }
    .kpi-lock-tier { font-size: .6rem; font-weight: 800; color: #94A3B8; text-transform: uppercase; letter-spacing: .06em; }

    .analytics-chart-wrap {
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: 1.25rem 1.25rem 1rem; margin-bottom: 1.75rem;
    }
    .analytics-chart-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
    .chart-title { font-size: .95rem; font-weight: 800; color: var(--text); }
    .chart-toggles { display: inline-flex; gap: 4px; background: #F5F8FB; border-radius: 8px; padding: 3px; }
    .chart-toggle { background: none; border: 0; padding: .35rem .75rem; font-size: .75rem; font-weight: 700; color: var(--muted); border-radius: 6px; cursor: pointer; }
    .chart-toggle.is-active { background: #fff; color: var(--text); box-shadow: 0 1px 3px rgba(15,23,42,.08); }
    .analytics-chart-body { position: relative; height: 280px; }
    .chart-empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); font-size: .9rem; }

    .analytics-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.75rem; }
    .analytics-card {
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: 1.25rem 1.25rem 1rem;
    }
    .analytics-card-title { font-size: .95rem; font-weight: 800; color: var(--text); margin-bottom: 1rem; }

    .breakdown-list { display: flex; flex-direction: column; gap: .75rem; }
    .breakdown-row { display: flex; align-items: center; gap: .75rem; font-size: .85rem; }
    .breakdown-label { width: 92px; flex-shrink: 0; color: var(--text); font-weight: 600; text-transform: capitalize; }
    .breakdown-bar-track { flex: 1; height: 7px; background: #F1F5F9; border-radius: 999px; overflow: hidden; }
    .breakdown-bar-fill  { height: 100%; background: var(--primary); border-radius: 999px; transition: width .35s ease; }
    .breakdown-value { width: 36px; text-align: right; font-weight: 700; color: var(--muted); font-variant-numeric: tabular-nums; }

    .top-listings-list { display: flex; flex-direction: column; }
    .top-listing-row {
      display: flex; align-items: center; gap: .75rem; padding: .6rem 0; border-bottom: 1px solid var(--border);
    }
    .top-listing-row:last-child { border-bottom: 0; }
    .top-listing-thumb { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; background: #F1F5F9; flex-shrink: 0; }
    .top-listing-name  { flex: 1; min-width: 0; }
    .top-listing-name a { color: var(--text); font-weight: 700; font-size: .85rem; text-decoration: none; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .top-listing-name a:hover { color: var(--primary); }
    .top-listing-meta { font-size: .7rem; color: var(--muted); margin-top: .15rem; }
    .top-listing-spark { width: 80px; height: 28px; flex-shrink: 0; }

    .analytics-empty { padding: 2.5rem 1rem; text-align: center; color: var(--muted); font-size: .9rem; }

    @media(max-width:1100px) {
      .kpi-grid { grid-template-columns: repeat(3, 1fr); }
      .analytics-bottom { grid-template-columns: 1fr; }
    }
    @media(max-width:560px) {
      .kpi-grid { grid-template-columns: repeat(2, 1fr); gap: .65rem; }
      .kpi-value { font-size: 1.35rem; }
    }

    /* ══ Responsive ══ */
    @media(max-width:768px) {
      .sidebar { width:56px; }
      .sidebar-logo { padding:.9rem .7rem; justify-content:center; }
      .sidebar-logo img { height:26px; }
      .sidebar-user, .user-name, .user-role, .nav-section, .nav-item span, .logout-btn span { display:none; }
      .nav-item { justify-content:center; padding:.65rem; border-left:none; }
      .nav-item.active { background:var(--primary-trans-10); border-radius:0; }
      .content { padding:1.25rem; }
      .stats-grid { grid-template-columns:repeat(2,1fr); }
      .welcome-banner { flex-direction:column; gap:1rem; align-items:flex-start; }
      .welcome-icon { display:none; }
    }
  </style>
</head>
<body>
  <div id="impersonation-banner" class="impersonation-banner" style="display:none">
    <div class="imp-info">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      <span>Viewing as <strong id="imp-name">…</strong> — actions you take will be saved to this account.</span>
    </div>
    <button type="button" onclick="doLogout()">Stop and return to admin</button>
  </div>

  <!-- ══ Sidebar ══ -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <a href="/"><img src="/favicon.svg" alt="Limasawa Booking" /></a>
    </div>

    <div class="sidebar-user">
      <div class="user-avatar-fallback" id="user-avatar-fallback" style="display:none"></div>
      <img class="user-avatar" id="user-avatar-img" src="" alt="" style="display:none" />
      <div>
        <div class="user-name" id="sidebar-name">Loading…</div>
        <div class="user-role" id="sidebar-role">Member</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <!-- Always-visible nav (guest + host) -->
      <div class="nav-section">My Account</div>
      <a class="nav-item" data-tab="saved" href="#" onclick="switchTab('saved'); return false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
        <span>Saved stays</span>
      </a>
      <a class="nav-item" data-tab="my-reviews" href="#" onclick="switchTab('my-reviews'); return false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        <span>My reviews</span>
      </a>
      <a class="nav-item" data-tab="account" href="#" onclick="switchTab('account'); return false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
        </svg>
        <span>Account</span>
      </a>

      <!-- Host-only nav -->
      <div class="nav-section host-only">Hosting</div>
      <a class="nav-item host-only" data-tab="dashboard" onclick="switchTab('dashboard'); return false" href="#" style="cursor:pointer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5"/>
          <rect x="14" y="3" width="7" height="7" rx="1.5"/>
          <rect x="14" y="14" width="7" height="7" rx="1.5"/>
          <rect x="3" y="14" width="7" height="7" rx="1.5"/>
        </svg>
        <span>Analytics</span>
      </a>
      <a class="nav-item host-only" data-tab="my-listings" onclick="switchTab('my-listings'); return false" href="#" style="cursor:pointer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9.5 12 3l9 6.5"/><path d="M5 9v11a1 1 0 0 0 1 1h4v-7h4v7h4a1 1 0 0 0 1-1V9"/>
        </svg>
        <span>My listings</span>
      </a>
      <a class="nav-item host-only" href="/list-your-property">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        <span>Add listing</span>
      </a>
      <a class="nav-item host-only" data-tab="rentals" onclick="switchTab('rentals'); return false" href="#" style="cursor:pointer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
