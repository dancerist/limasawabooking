  <!-- ══ Renewal / Upgrade modal ══ -->
  <div id="renewal-modal" class="modal-backdrop" style="display:none;" onclick="if(event.target===this)closeRenewalModal()">
    <div class="modal-box">
      <div class="modal-header">
        <span class="modal-title" id="modal-title">Renew Subscription</span>
        <button class="modal-close" onclick="closeRenewalModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="modal-listing-name">Listing: <strong id="modal-listing-name">—</strong></div>

        <!-- Tier selector -->
        <div class="modal-section">
          <span class="modal-label">Choose plan</span>
          <div class="tier-grid" id="modal-tier-grid"></div>
        </div>

        <!-- Billing cycle -->
        <div class="modal-section" id="modal-billing-section">
          <span class="modal-label">Billing cycle</span>
          <div class="billing-grid" id="modal-billing-grid"></div>
        </div>

        <!-- Price summary -->
        <div class="price-summary" id="modal-price-summary">
          <span class="price-summary-label">Total due</span>
          <span class="price-summary-amount" id="modal-price-amount">₱0</span>
        </div>

        <!-- Payment method -->
        <div class="modal-section" id="modal-payment-section">
          <span class="modal-label">Payment method</span>
          <div class="payment-methods">
            <label class="pm-opt" id="pm-gcash" onclick="selectMethod('gcash')">
              <input type="radio" name="pm" value="gcash"/>
              <div class="pm-opt-name">GCash</div>
            </label>
            <label class="pm-opt" id="pm-maya" onclick="selectMethod('maya')">
              <input type="radio" name="pm" value="maya"/>
              <div class="pm-opt-name">Maya</div>
            </label>
            <label class="pm-opt" id="pm-bpi" onclick="selectMethod('bpi')">
              <input type="radio" name="pm" value="bpi"/>
              <div class="pm-opt-name">BPI</div>
            </label>
          </div>
          <div class="qr-wrap" id="modal-qr-wrap" style="display:none;">
            <img id="modal-qr-img" src="" alt="Payment QR" />
            <p style="font-size:.72rem;color:var(--muted);margin-top:.4rem;">Scan to pay, then upload your receipt below.</p>
          </div>
        </div>

        <!-- Coupon code -->
        <div class="modal-section" id="modal-coupon-section" style="display:none;">
          <span class="modal-label">Coupon code <span style="font-weight:400;text-transform:none;font-size:.75rem;">(optional)</span></span>
          <div class="modal-coupon-row">
            <input type="text" class="modal-input" id="modal-coupon-input" placeholder="e.g. WELCOME20" autocomplete="off" />
            <button type="button" class="btn-coupon-apply" id="modal-coupon-apply">Apply</button>
            <button type="button" class="btn-coupon-clear" id="modal-coupon-clear" style="display:none;">Clear</button>
          </div>
          <div id="modal-coupon-status" class="modal-coupon-status"></div>
        </div>

        <!-- Reference number -->
        <div class="modal-section" id="modal-ref-section" style="display:none;">
          <span class="modal-label">Reference / transaction number <span style="font-weight:400;text-transform:none;font-size:.75rem;">(optional but helps us verify faster)</span></span>
          <input type="text" class="modal-input" id="modal-ref-input" placeholder="e.g. 2024123456789" />
        </div>

        <!-- Receipt upload -->
        <div class="modal-section" id="modal-receipt-section" style="display:none;">
          <span class="modal-label">Upload receipt</span>
          <div class="upload-zone" id="modal-upload-zone">
            <input type="file" id="modal-receipt-file" accept="image/*" onchange="handleReceiptUpload(event)" />
            <div class="upload-zone-text" id="upload-zone-text">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" style="display:block;margin:0 auto .4rem"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <strong>Click to upload</strong> or drag & drop<br/>
              <span style="font-size:.68rem;">PNG, JPG, WEBP — screenshot of payment confirmation</span>
            </div>
            <img id="receipt-preview" class="upload-preview" src="" alt="" style="display:none;" />
          </div>
          <div id="upload-status" style="font-size:.72rem;color:var(--muted);margin-top:.35rem;"></div>
        </div>

        <div class="modal-msg" id="modal-msg"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-cancel" onclick="closeRenewalModal()">Cancel</button>
        <button class="btn-modal-submit" id="modal-submit-btn" onclick="submitRenewal()">Submit payment</button>
      </div>
    </div>
  </div>

  <!-- ══ Profile photo upload modal ══ -->
  <div id="photo-modal" class="modal-backdrop" style="display:none;" onclick="if(event.target===this&&!_photoBlocking)closePhotoModal()">
    <div class="modal-box" style="max-width:540px">
      <div id="photo-blocking-banner" class="blocking-photo-banner" style="display:none">
        <h3>Add a profile photo to continue</h3>
        <p>A clear photo of your face helps build trust with other guests, hosts, and reviewers. You only need to do this once.</p>
      </div>
      <div class="modal-header">
        <span class="modal-title" id="photo-modal-title">Upload profile photo</span>
        <button class="modal-close" id="photo-modal-close" onclick="closePhotoModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="photo-modal-body">
        <p class="photo-intro">Pick a clear photo where your face is well-lit and visible. JPG, PNG or WebP, up to 8 MB.</p>

        <!-- Step 1: file picker -->
        <div id="photo-step-pick">
          <label class="photo-drop-zone">
            <svg class="photo-drop-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <input type="file" accept="image/jpeg,image/png,image/webp" onchange="onPhotoFileSelect(event)" />
            <div class="photo-drop-text">
              <strong>Click to choose a photo</strong>
              <span>or drag &amp; drop</span>
            </div>
          </label>
        </div>

        <!-- Step 2: cropper + face check -->
        <div id="photo-step-crop" style="display:none">
          <div id="photo-cropper-wrap">
            <img id="photo-cropper-img" />
          </div>
          <div id="photo-face-status" class="face-status-checking" style="display:none">
            <span id="photo-face-status-text">Checking photo…</span>
          </div>
          <button type="button" id="photo-pick-again-btn" class="account-photo-edit" style="margin-top:.6rem" onclick="resetPhotoModal()">Pick a different photo</button>
        </div>

        <div id="photo-error" class="account-msg is-error" style="display:none;margin-top:.75rem"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-modal-cancel" id="photo-cancel-btn" onclick="closePhotoModal()">Cancel</button>
        <button class="btn-modal-submit" id="photo-confirm-btn" onclick="confirmPhotoUpload()" disabled>Use this photo</button>
      </div>
    </div>
  </div>

  <script define:vars={{ WP_REST }}></script>
  <script is:inline>
    const API = window.WP_REST || 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
    let _currentListings = []

    function parseJWT(t) {
      try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))) } catch { return null }
    }
    function doLogout() {
      const wasImpersonating = sessionStorage.getItem('sb_impersonating') === '1'
      localStorage.removeItem('sb_token')
      localStorage.removeItem('sb_user')
      localStorage.removeItem('sb_saved')
      sessionStorage.removeItem('sb_impersonating')
      // If admin was impersonating, send them back to the WP admin dashboard
      if (wasImpersonating) {
        window.location.href = 'https://admin.limasawabooking.com/wp-admin/index.php'
        return
      }
      window.location.href = '/auth'
    }
    function formatNum(n) {
      if(!n) return '0'
      return n >= 1000 ? (n/1000).toFixed(1)+'k' : String(n)
    }
    function statusClass(s) {
      if(s==='publish') return 'status-publish'
      if(s==='pending') return 'status-pending'
      return 'status-draft'
    }
    function statusLabel(s) {
      if(s==='publish') return 'Live'
      if(s==='pending') return 'Pending'
      return 'Draft'
    }
    function tierClass(t) { return 'tier-'+(t||'free') }
    function tierLabel(t) {
      return ({free:'Free',local:'Local',prime:'Prime',featured:'Featured'})[t] || 'Free'
    }
    function paymentLabel(s) {
      return ({
        not_required: 'No payment',
        pending_verification: 'Payment pending',
        paid: 'Paid',
        failed: 'Failed',
        refunded: 'Refunded',
      })[s] || 'Payment pending'
    }

    // SVG icons for stat cards — explicit width/height required for innerHTML-injected SVGs
    const S = 'width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"'
    const ICONS = {
      eye:     `<svg ${S}><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
      home:    `<svg ${S}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
      plane:   `<svg ${S}><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>`,
      book:    `<svg ${S}><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
      message: `<svg ${S}><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
      mapPin:  `<svg ${S}><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
      share:   `<svg ${S}><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
      camera:  `<svg ${S}><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
    }

    const TIER_ORDER = ['free','pro','featured']
    const TIER_LABELS = { free:'Island Listing', pro:'Pro Host', featured:'Featured Stay' }
    // Which tier unlocks each stat key
    const STAT_TIER = {
      total_views:'free', total_listings:'free',
      whatsapp_clicks:'pro', location_clicks:'pro',
      airbnb_clicks:'pro', bookingcom_clicks:'pro',
      facebook_clicks:'pro', instagram_clicks:'pro', website_clicks:'pro',
    }
    function tierUnlocked(statKey, userMaxTier) {
      const required = TIER_ORDER.indexOf(STAT_TIER[statKey] || 'free')
      const user     = TIER_ORDER.indexOf(userMaxTier || 'free')
      return user >= required
    }

    function renderStats(stats, maxTier) {
      const items = [
        { key:'total_views',       icon:ICONS.eye,     label:'Total views',      val:stats.total_views,       cls:'si-teal' },
        { key:'total_listings',    icon:ICONS.home,    label:'Listings',         val:stats.total_listings,    cls:'si-slate' },
        { key:'whatsapp_clicks',   icon:ICONS.message, label:'WhatsApp clicks',  val:stats.whatsapp_clicks,   cls:'si-green' },
        { key:'location_clicks',   icon:ICONS.mapPin,  label:'Location clicks',  val:stats.location_clicks,   cls:'si-rose' },
        { key:'airbnb_clicks',     icon:ICONS.plane,   label:'Airbnb clicks',    val:stats.airbnb_clicks,     cls:'si-indigo' },
        { key:'bookingcom_clicks', icon:ICONS.book,    label:'Booking.com',      val:stats.bookingcom_clicks, cls:'si-amber' },
        { key:'facebook_clicks',   icon:ICONS.share,   label:'Facebook clicks',  val:stats.facebook_clicks,   cls:'si-violet' },
        { key:'instagram_clicks',  icon:ICONS.camera,  label:'Instagram clicks', val:stats.instagram_clicks,  cls:'si-sky' },
      ]
      const lockSVG = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
      return items.map(it => {
        const unlocked = tierUnlocked(it.key, maxTier)
        const reqTier  = STAT_TIER[it.key] || 'free'
        const lockBadge = !unlocked ? `<div class="stat-lock-badge">${lockSVG}<span>${TIER_LABELS[reqTier] || reqTier}+</span></div>` : ''
        return `
        <div class="stat-card${unlocked ? '' : ' locked'}">
          ${lockBadge}
          <div class="stat-icon ${it.cls}">${it.icon}</div>
          <div class="stat-body">
            <div class="stat-label">${it.label}</div>
            <div class="stat-value">${formatNum(it.val)}</div>
          </div>
        </div>`
      }).join('')
    }

    function renderListingStats(listing) {
      const tier = listing.tier || 'free'
      const stats = [
        { key:'views',            label:'Views',      val:listing.views },
        { key:'whatsapp_clicks',  label:'WhatsApp',   val:listing.whatsapp_clicks },
        { key:'location_clicks',  label:'Map',        val:listing.location_clicks },
        { key:'airbnb_clicks',    label:'Airbnb',     val:listing.airbnb_clicks },
        { key:'bookingcom_clicks',label:'Booking.com',val:listing.bookingcom_clicks },
        { key:'facebook_clicks',  label:'Facebook',   val:listing.facebook_clicks },
        { key:'instagram_clicks', label:'Instagram',  val:listing.instagram_clicks },
      ]
      // Map listing stat keys to STAT_TIER keys
      const keyMap = { views:'total_views', whatsapp_clicks:'whatsapp_clicks', location_clicks:'location_clicks',
        airbnb_clicks:'airbnb_clicks', bookingcom_clicks:'bookingcom_clicks',
        facebook_clicks:'facebook_clicks', instagram_clicks:'instagram_clicks' }
      return stats.map(s => {
        const unlocked = tierUnlocked(keyMap[s.key] || s.key, tier)
        return `<div class="lst-stat-pill${unlocked ? '' : ' locked-pill'}">
          <strong>${formatNum(s.val)}</strong>${s.label}
        </div>`
      }).join('')
    }

    // ── Compact listing rows ─────────────────────────────────────────────────
    function renderListings(listings) {
      if(!listings.length) {
        return `<div class="listings-empty">
          <p style="margin:0 0 .8rem;color:#475569;">No listings yet.</p>
          <a href="/list-your-property" class="my-listings-add-btn" style="margin-right:.4rem;">Add your first property</a>
          <a href="/stays" style="display:inline-block;margin-top:.6rem;font-size:.85rem;color:var(--primary);font-weight:600;text-decoration:none;">Have an existing listing? Find &amp; claim it &rarr;</a>
        </div>`
      }
      return listings.map(l => {
        const thumb = l.thumbnail
          ? `<img class="listing-row-thumb" src="${l.thumbnail}" alt="${l.title}" loading="lazy" />`
          : `<div class="listing-row-thumb-empty">
               <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                 <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
               </svg>
             </div>`
        const meta = [
          l.guests ? `${l.guests} guest` : '',
          l.beds   ? `${l.beds} bed`     : '',
          l.baths  ? `${l.baths} bath`   : '',
          l.daily_rate ? `&#8369;${Number(l.daily_rate).toLocaleString()}/night` : '',
        ].filter(Boolean).join(' &middot; ')
        // Pause / Unpause / Delete actions — open by status. Trash hides the
        // pause/unpause buttons (host needs admin to restore).
        const isPublished = l.status === 'publish'
        const isPaused    = l.status === 'draft' || l.status === 'pending'
        const isTrashed   = l.status === 'trash'
        const pauseBtn = !isTrashed
          ? (isPublished
              ? `<button type="button" class="listing-row-action" onclick="listingAction(${l.id}, 'pause')">Pause</button>`
              : (isPaused
                  ? `<button type="button" class="listing-row-action" onclick="listingAction(${l.id}, 'unpause')">Republish</button>`
                  : ''))
          : ''
        const deleteBtn = !isTrashed
          ? `<button type="button" class="listing-row-action listing-row-action-danger" onclick="listingAction(${l.id}, 'trash')">Delete</button>`
          : `<span style="color:#94a3b8;font-size:.78rem;">In trash &middot; contact us to restore</span>`
        return `<div class="listing-row">
          ${thumb}
          <div class="listing-row-body">
            <div class="listing-row-title">${l.title}</div>
            <div class="listing-row-meta">
              <span class="post-status-badge ${statusClass(l.status).replace('status-','ps-')}">${statusLabel(l.status)}</span>
              <span class="post-status-badge ${l.payment_status === 'paid' || l.payment_status === 'not_required' ? 'ps-publish' : 'ps-pending'}">${paymentLabel(l.payment_status)}</span>
              ${meta ? `<span>${meta}</span>` : ''}
            </div>
            <div class="listing-row-meta" style="margin-top:.2rem;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <a href="/list-your-property?edit=${l.id}" class="listing-row-edit">Edit listing</a>
              ${l.status === 'publish' && l.slug
                ? ` &middot; <a href="/stay/${l.slug}" class="listing-row-edit">View</a>`
                : ''}
            </div>
            <div class="listing-row-actions" style="margin-top:.5rem;display:flex;gap:.4rem;flex-wrap:wrap;">
              ${pauseBtn}
              ${deleteBtn}
            </div>
            <div class="lst-stats-row">${renderListingStats(l)}</div>
          </div>
        </div>`
      }).join('')
    }

    // Pause / unpause / trash a listing. Confirms destructive actions, hits
    // the /listing-action REST endpoint, then refetches /my-listings to
    // refresh both the inline list (Analytics tab) and the dedicated tab.
    async function listingAction(listingId, action) {
      const prompts = {
        pause:   'Pause this listing? It will be hidden from the public site until you republish.',
        unpause: 'Republish this listing? It will be visible to the public again.',
        trash:   'Delete this listing? This moves it to the trash. Reach out to us within 30 days if you need it restored.',
      }
      if (!confirm(prompts[action] || 'Are you sure?')) return
      const token = localStorage.getItem('sb_token')
      try {
        const res = await fetch(`${API}/listing-action`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ listing_id: listingId, action }),
        })
        const data = await res.json()
        if (!res.ok || !data.success) {
          alert(data.message || 'Could not update the listing. Please try again.')
          return
        }
        // Refetch the host's listings so both containers update
        const listRes  = await fetch(`${API}/my-listings`, { headers: { Authorization: `Bearer ${token}` } })
        const listData = await listRes.json()
        if (listData.listings) {
          _currentListings = listData.listings
          const html = renderListings(listData.listings)
          const c1 = document.getElementById('listings-container')
          const c2 = document.getElementById('my-listings-container')
          if (c1) c1.innerHTML = html
          if (c2) c2.innerHTML = html
          document.getElementById('sub-cards-container').innerHTML = renderOrders(listData.listings)
        }
      } catch (e) {
        alert('Network error. Please try again.')
      }
    }

    // ── Posts panel ──────────────────────────────────────────────────────────
    function renderPosts(posts) {
      if(!posts.length) {
        return `<div class="posts-empty">No posts yet. Share your island stories!</div>`
      }
      const SI = 'width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"'
      return posts.map(p => {
        const sc = p.status === 'publish' ? 'ps-publish' : p.status === 'pending' ? 'ps-pending' : 'ps-draft'
        const sl = p.status === 'publish' ? 'Published'  : p.status === 'pending' ? 'Pending'    : 'Draft'
        return `<div class="post-item">
          <div class="post-icon">
            <svg ${SI}><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div class="post-body">
            <div class="post-title">${escMy(p.title)}</div>
            <div class="post-meta">
              <span class="post-status-badge ${sc}">${sl}</span>
              <span>${p.date}</span>
              <button type="button" class="post-edit-trigger" onclick="openEditPost(${p.id})">Edit</button>
              ${p.status === 'publish' ? `<a href="${p.link}" target="_blank" class="post-edit-link">View</a>` : ''}
              <button type="button" class="post-delete-trigger" onclick="deletePost(${p.id})">Delete</button>
            </div>
          </div>
        </div>`
      }).join('')
    }

    // ── Write/edit-post form ──────────────────────────────────────────────────
    let _editor          = null   // EditorJS instance
    let _editingPostId   = 0      // 0 = new post, >0 = editing existing
    let _featuredImageId = 0
    let _editorLoading   = null   // promise so we don't double-load CDN scripts

    async function _loadEditorJS() {
      if (window.EditorJS && window.Header && window.NestedList && window.ImageTool && window.Quote && window.Delimiter) return
      if (_editorLoading) return _editorLoading
      const loadScript = src => new Promise((res, rej) => {
        const s = document.createElement('script')
        s.src = src; s.onload = res; s.onerror = rej
        document.head.appendChild(s)
      })
      _editorLoading = (async () => {
        // Core first
        await loadScript('https://cdn.jsdelivr.net/npm/@editorjs/editorjs@2.30.6')
        // Then plugins in parallel
        await Promise.all([
          loadScript('https://cdn.jsdelivr.net/npm/@editorjs/header@2.8.1'),
          loadScript('https://cdn.jsdelivr.net/npm/@editorjs/nested-list@1.4.3'),
          loadScript('https://cdn.jsdelivr.net/npm/@editorjs/quote@2.6.0'),
          loadScript('https://cdn.jsdelivr.net/npm/@editorjs/image@2.9.1'),
          loadScript('https://cdn.jsdelivr.net/npm/@editorjs/delimiter@1.4.1'),
        ])
      })()
      return _editorLoading
    }

    async function _initEditor(initialBlocks = null) {
      await _loadEditorJS()
      if (_editor) { try { _editor.destroy() } catch (_) {} _editor = null }
      _editor = new window.EditorJS({
        holder: 'editorjs-mount',
        placeholder: 'Tell a story… use / for headings, lists, images, and more.',
        minHeight: 200,
        data: initialBlocks || { blocks: [] },
        tools: {
          header: { class: window.Header,     inlineToolbar: ['link','bold','italic'], config: { levels: [2, 3], defaultLevel: 2 } },
          list:   { class: window.NestedList, inlineToolbar: true, config: { defaultStyle: 'unordered' } },
          quote:  { class: window.Quote,      inlineToolbar: true },
          delimiter: { class: window.Delimiter },
          image:  {
            class: window.ImageTool,
            config: {
              uploader: {
                async uploadByFile(file) {
                  const fd = new FormData()
                  fd.append('file', file)
                  fd.append('image_type', 'post_image')
                  const res = await fetch(`${API}/upload-media`, { method: 'POST', body: fd })
                  const data = await res.json()
                  if (!res.ok || !data.url) return { success: 0 }
                  return { success: 1, file: { url: data.url } }
                },
              },
            },
          },
        },
      })
    }

    // Convert EditorJS block JSON → HTML for storage in post_content
    function _blocksToHtml(saved) {
      if (!saved || !Array.isArray(saved.blocks)) return ''
      return saved.blocks.map(b => {
        const d = b.data || {}
        switch (b.type) {
          case 'header':    return `<h${d.level||2}>${d.text||''}</h${d.level||2}>`
          case 'paragraph': return `<p>${d.text||''}</p>`
          case 'list': {
            const tag = d.style === 'ordered' ? 'ol' : 'ul'
            const renderItems = items => `<${tag}>${(items||[]).map(it => `<li>${typeof it === 'string' ? it : (it.content||'')}${it.items && it.items.length ? renderItems(it.items) : ''}</li>`).join('')}</${tag}>`
            return renderItems(d.items)
          }
          case 'quote':     return `<blockquote><p>${d.text||''}</p>${d.caption ? `<cite>${d.caption}</cite>` : ''}</blockquote>`
          case 'delimiter': return '<hr/>'
          case 'image':     return `<figure><img src="${d.file?.url||''}" alt="${d.caption||''}"/>${d.caption ? `<figcaption>${d.caption}</figcaption>` : ''}</figure>`
          default:          return ''
        }
      }).join('\n')
    }

    async function showWriteForm() {
      document.getElementById('write-form').style.display = 'block'
      document.getElementById('write-post-btn').style.display = 'none'
      document.getElementById('post-title').focus()
      _editingPostId = 0
      _featuredImageId = 0
      removePostFeaturedImageUI()
      try { await _initEditor() } catch (e) {
        document.getElementById('write-err').textContent = 'Could not load editor. Refresh and try again.'
        document.getElementById('write-err').classList.add('show')
      }
    }

    function hideWriteForm() {
      document.getElementById('write-form').style.display = 'none'
      document.getElementById('write-post-btn').style.display = 'inline-flex'
      document.getElementById('post-title').value = ''
      document.getElementById('write-err').classList.remove('show')
      document.getElementById('write-success').classList.remove('show')
      _editingPostId = 0
      _featuredImageId = 0
      removePostFeaturedImageUI()
      if (_editor) { try { _editor.destroy() } catch (_) {} _editor = null }
    }

    async function onPostFeaturedImage(ev) {
      const file = ev.target.files?.[0]
      if (!file) return
      if (file.size > 8 * 1024 * 1024) { alert('Image too large (max 8 MB)'); ev.target.value = ''; return }
      const text = document.getElementById('featured-img-text')
      text.textContent = 'Uploading…'
      try {
        const fd = new FormData()
        fd.append('file', file)
        fd.append('image_type', 'post_featured')
        const res  = await fetch(`${API}/upload-media`, { method: 'POST', body: fd })
        const data = await res.json()
        if (!res.ok || !data.url) throw new Error(data.message || 'Upload failed')
        _featuredImageId = data.attachment_id
        const img = document.getElementById('featured-img-preview')
        img.src = data.url; img.style.display = 'block'
        text.style.display = 'none'
        document.getElementById('featured-img-remove').style.display = 'grid'
        document.getElementById('featured-img-picker').classList.add('has-image')
      } catch (e) {
        text.textContent = '＋ Add a featured image'
        alert(e.message || 'Upload failed')
      }
    }

    function removePostFeaturedImage(ev) {
      ev.preventDefault(); ev.stopPropagation()
      _featuredImageId = 0
      removePostFeaturedImageUI()
    }
    function removePostFeaturedImageUI() {
      const img = document.getElementById('featured-img-preview')
      const text = document.getElementById('featured-img-text')
      const rm  = document.getElementById('featured-img-remove')
      const wrap = document.getElementById('featured-img-picker')
      if (img) { img.src = ''; img.style.display = 'none' }
      if (text) { text.style.display = ''; text.textContent = '＋ Add a featured image' }
      if (rm)   rm.style.display = 'none'
      if (wrap) {
        wrap.classList.remove('has-image')
        const file = wrap.querySelector('input[type="file"]')
        if (file) file.value = ''
      }
    }

    async function openEditPost(id) {
      // Open the form first so the editor mount exists
      document.getElementById('write-form').style.display = 'block'
      document.getElementById('write-post-btn').style.display = 'none'
      const errEl = document.getElementById('write-err')
      errEl.classList.remove('show')
      const token = localStorage.getItem('sb_token')
      try {
        const res = await fetch(`${API}/post/${id}`, { headers: { Authorization: `Bearer ${token}` } })
        const data = await res.json()
        if (!res.ok) throw new Error(data.message || 'Could not load post')
        _editingPostId = data.id
        document.getElementById('post-title').value = data.title || ''
        // Featured image
        if (data.featuredImageId) {
          _featuredImageId = data.featuredImageId
          const img = document.getElementById('featured-img-preview')
          img.src = data.featuredImageUrl || ''; img.style.display = 'block'
          document.getElementById('featured-img-text').style.display = 'none'
          document.getElementById('featured-img-remove').style.display = 'grid'
          document.getElementById('featured-img-picker').classList.add('has-image')
        } else {
          _featuredImageId = 0
          removePostFeaturedImageUI()
        }
        // Editor: prefer stored blocks, fall back to a single paragraph from HTML
        const initial = data.contentBlocks
          ? data.contentBlocks
          : (data.content ? { blocks: [{ type: 'paragraph', data: { text: String(data.content).replace(/<[^>]+>/g, ' ').trim() } }] } : null)
        await _initEditor(initial)
      } catch (e) {
        errEl.textContent = e.message; errEl.classList.add('show')
      }
    }

    async function deletePost(id) {
      if (!confirm('Delete this post? It will be moved to trash.')) return
      const token = localStorage.getItem('sb_token')
      try {
        const res = await fetch(`${API}/post/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } })
        if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.message || 'Delete failed') }
        loadPosts(token)
      } catch (e) {
        alert(e.message || 'Could not delete')
      }
    }

    async function submitPost(status) {
      const title = document.getElementById('post-title').value.trim()
      const errEl = document.getElementById('write-err')
      const okEl  = document.getElementById('write-success')
      errEl.classList.remove('show'); okEl.classList.remove('show')
      if (!title) { errEl.textContent = 'Please add a title.'; errEl.classList.add('show'); return }
      if (!_editor) { errEl.textContent = 'Editor not ready yet.'; errEl.classList.add('show'); return }

      const token = localStorage.getItem('sb_token')
      const btnId = status === 'publish' ? 'btn-do-publish' : 'btn-do-draft'
      const btn   = document.getElementById(btnId)
      btn.disabled = true; btn.textContent = 'Saving…'
      try {
        const saved = await _editor.save()
        const html  = _blocksToHtml(saved)
        const body  = {
          title, status,
          content:         html,
          contentBlocks:   saved,
          featuredImageId: _featuredImageId || 0,
        }
        const url = _editingPostId ? `${API}/post/${_editingPostId}` : `${API}/create-post`
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        })
        const data = await res.json()
        if (!res.ok || data.success === false) throw new Error(data.message || 'Could not save post')
        okEl.textContent = _editingPostId
          ? (status === 'publish' ? 'Post updated!' : 'Draft saved!')
          : (status === 'publish' ? 'Post published!' : 'Draft saved!')
        okEl.classList.add('show')
        setTimeout(() => { hideWriteForm(); loadPosts(token) }, 1000)
      } catch (e) {
        errEl.textContent = e.message || 'Network error.'; errEl.classList.add('show')
        btn.disabled = false; btn.textContent = status === 'publish' ? 'Publish' : 'Save draft'
      }
    }

    async function loadPosts(token) {
      try {
        const res  = await fetch(`${API}/my-posts`, { headers:{ 'Authorization':`Bearer ${token}` } })
        const data = await res.json()
        document.getElementById('posts-list').innerHTML = renderPosts(data.posts || [])
      } catch(e) {
        document.getElementById('posts-list').innerHTML = `<div class="posts-empty">Could not load posts.</div>`
      }
    }

    // ── Tab switching ─────────────────────────────────────────────────────────
    let _currentTab = 'dashboard'
    // Treat host + admin/editor accounts as hosts (backend sb_user_role returns
    // 'administrator'/'editor', never 'admin', so check all of them).
    function isHostRole(r) { return ['host', 'admin', 'administrator', 'editor'].includes(r) }

    // ── Rentals panel ──────────────────────────────────────────────────────
    async function loadRentals() {
      const c = document.getElementById('rentals-container')
      const token = localStorage.getItem('sb_token')
      try {
        const data = await fetch(`${API}/my-rentals`, { headers: { Authorization: `Bearer ${token}` } }).then(r => r.json())
        c.innerHTML = renderRentals(data.rentals || [])
      } catch (e) {
        c.innerHTML = `<div class="listings-empty" style="padding:2rem;text-align:center">Could not load rentals.</div>`
      }
    }
    function renderRentals(rentals) {
      const rEsc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]))
      if (!rentals.length) {
        return `<div class="listings-empty" style="padding:2.5rem 1.5rem;text-align:center">
          <p style="color:var(--muted);margin-bottom:.85rem">You haven't listed any rentals yet.</p>
          <a href="/list-rental" class="panel-btn" style="display:inline-block">Add your first rental</a></div>`
      }
      const peso = n => '₱' + Number(n || 0).toLocaleString('en-PH')
      const badge = s => {
        const m = { live:['#15803D','#F0FDF4','Live'], pending:['#92400E','#FFFBEB','Pending review'], paused:['#9A3412','#FFF7ED','Paused'], draft:['#475569','#F1F5F9','Draft'] }
        const [col, bg, t] = m[s] || m.draft
        return `<span style="font-size:.68rem;font-weight:700;color:${col};background:${bg};padding:.15rem .5rem;border-radius:6px">${t}</span>`
      }
      const actBtn = 'font-size:.78rem;font-weight:700;color:var(--text);background:#fff;border:1px solid var(--border);border-radius:7px;padding:.35rem .7rem;cursor:pointer;text-decoration:none'
      return rentals.map(r => `
        <div style="display:flex;align-items:center;gap:1rem;padding:.9rem 1.25rem;border-bottom:1px solid var(--border)">
          <div style="width:64px;height:48px;border-radius:8px;overflow:hidden;background:var(--primary-light);flex:0 0 auto">${r.thumb ? `<img src="${rEsc(r.thumb)}" style="width:100%;height:100%;object-fit:cover" alt="" />` : ''}</div>
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${rEsc(r.title)}</div>
            <div style="font-size:.78rem;color:var(--muted);display:flex;gap:.45rem;align-items:center;flex-wrap:wrap;margin-top:.2rem">${badge(r.status)}<span>${rEsc(r.type || '')}</span><span>·</span><span>${peso(r.daily)}/day</span></div>
          </div>
          <div style="display:flex;gap:.4rem;flex-wrap:wrap;justify-content:flex-end">
            <a href="/list-rental?edit=${r.id}" style="${actBtn}">Edit</a>
            ${r.status === 'paused'
              ? `<button onclick="rentalAction(${r.id},'unpause')" style="${actBtn}">Unpause</button>`
              : (r.status === 'live' ? `<button onclick="rentalAction(${r.id},'pause')" style="${actBtn}">Pause</button>` : '')}
            <button onclick="rentalAction(${r.id},'trash')" style="${actBtn};color:#DC2626">Delete</button>
          </div>
        </div>`).join('')
    }
    async function rentalAction(id, action) {
      if (action === 'trash' && !confirm('Delete this rental? This cannot be undone.')) return
      const token = localStorage.getItem('sb_token')
      try {
        await fetch(`${API}/rental-action`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ id, action }) })
      } catch (e) {}
      loadRentals()
    }

    function switchTab(tab) {
      // Guard: guests can't access host-only tabs (defensive — UI hides them but ?tab= URLs need check)
      const isHost = _me && isHostRole(_me.role)
      const HOST_TABS = ['dashboard', 'my-listings', 'rentals', 'orders', 'reviews']
      if (!isHost && HOST_TABS.includes(tab)) tab = 'saved'

      _currentTab = tab
      document.querySelectorAll('.nav-item[data-tab]').forEach(el => {
        el.classList.toggle('active', el.dataset.tab === tab)
      })
      const show = id => { const el = document.getElementById(id); if(el) el.style.display = 'block' }
      const hide = id => { const el = document.getElementById(id); if(el) el.style.display = 'none'  }
      hide('dashboard-content'); hide('my-listings-content'); hide('orders-content'); hide('saved-content')
      hide('reviews-content'); hide('my-reviews-content'); hide('account-content'); hide('rentals-content')

      const TITLES = {
        dashboard: 'Analytics', 'my-listings': 'My Listings', rentals: 'My Rentals', orders: 'Orders & Billing', saved: 'Saved Stays',
        reviews: 'Pending Reviews', 'my-reviews': 'My Reviews', account: 'Account',
      }
      document.getElementById('topbar-title').textContent = TITLES[tab] || 'Dashboard'

      if(tab === 'orders')            { show('orders-content') }
      else if(tab === 'my-listings')  { show('my-listings-content') }
      else if(tab === 'rentals')      { show('rentals-content');    loadRentals() }
      else if(tab === 'saved')        { show('saved-content');      loadSavedListings() }
      else if(tab === 'reviews')      { show('reviews-content');    loadReviews() }
      else if(tab === 'my-reviews')   { show('my-reviews-content'); loadMyReviews() }
      else if(tab === 'account')      { show('account-content');    renderAccount() }
      else                            { show('dashboard-content'); loadAnalytics() }
    }

    // ── My Reviews (author-side) ─────────────────────────────────────────────
    async function loadMyReviews() {
      const container = document.getElementById('my-reviews-container')
      const token = localStorage.getItem('sb_token')
      container.innerHTML = `<div class="myrv-list">${[1,2].map(()=>`<div class="skeleton" style="height:140px;border-radius:14px"></div>`).join('')}</div>`
      try {
        const res  = await fetch(`${API}/my-reviews`, { headers: { Authorization: `Bearer ${token}` } })
        const data = await res.json()
        if (!data.reviews?.length) {
          container.innerHTML = `<div class="orders-empty"><h3>No reviews yet</h3><p>After staying somewhere, share your experience by writing a review on the listing page.</p><a href="/stays" style="display:inline-block;margin-top:1rem;padding:.55rem 1.4rem;background:var(--primary);color:#fff;border-radius:9px;text-decoration:none;font-weight:700;font-size:.875rem;">Browse stays</a></div>`
          return
        }
        container.innerHTML = `<div class="myrv-list">${data.reviews.map(renderMyReviewCard).join('')}</div>`
      } catch (e) {
        container.innerHTML = `<div class="orders-empty"><h3>Could not load reviews</h3><p>${e.message || 'Try again later.'}</p></div>`
      }
    }

    function escMy(s) { return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])) }

    function renderMyReviewCard(r) {
      const STATUS_LABEL = { pending_email:'Awaiting email verification', pending_approval:'Pending host approval', approved:'Published', rejected:'Rejected' }
      const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating)
      const thumb = r.listingThumb
        ? `<img src="${escMy(r.listingThumb)}" alt="${escMy(r.listingTitle)}"/>`
        : `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`
      const reply = r.hostReply
        ? `<div class="myrv-host-reply"><strong>Host response</strong>${escMy(r.hostReply)}</div>`
        : ''
      const editBtn = r.canEdit
        ? `<button class="myrv-edit-btn" onclick="openEditMyReview(${r.id})">Edit review</button>`
        : ''
      return `<div class="myrv-card" data-id="${r.id}">
        <div class="myrv-thumb">${thumb}</div>
        <div class="myrv-body">
          <div class="myrv-listing"><a href="/stay/${escMy(r.listingSlug)}" style="color:inherit;text-decoration:none">${escMy(r.listingTitle)}</a></div>
          <div class="myrv-meta">
            <span class="myrv-stars">${stars}</span>
            ${r.stayMonth ? `<span>Stay: ${escMy(r.stayMonth)}</span>` : ''}
            <span class="myrv-status myrv-status-${r.status}">${STATUS_LABEL[r.status] || r.status}</span>
          </div>
          <div class="myrv-content">${escMy(r.content)}</div>
          ${reply}
          ${editBtn ? `<div class="myrv-actions">${editBtn}</div>` : ''}
        </div>
      </div>`
    }

    async function openEditMyReview(id) {
      const token = localStorage.getItem('sb_token')
      const card = document.querySelector(`.myrv-card[data-id="${id}"]`)
      if (!card) return
      // Inline edit form
      const data = await fetch(`${API}/my-reviews`, { headers: { Authorization: `Bearer ${token}` } }).then(r => r.json())
      const r = (data.reviews || []).find(x => x.id === id)
      if (!r) return
      const body = card.querySelector('.myrv-body')
      body.innerHTML = `
        <div class="myrv-listing">${escMy(r.listingTitle)}</div>
        <div style="margin-top:.5rem">
          <label style="font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em">Rating</label>
          <div id="edit-rv-stars" style="display:flex;gap:.25rem;margin-top:.3rem">
            ${[1,2,3,4,5].map(n=>`<button type="button" data-r="${n}" style="background:none;border:0;cursor:pointer;font-size:1.4rem;color:${n<=r.rating?'#F59E0B':'#CBD5E1'};line-height:1">★</button>`).join('')}
          </div>
        </div>
        <div style="margin-top:.75rem">
          <label style="font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em">Stay month</label>
          <input type="month" id="edit-rv-month" value="${escMy(r.stayMonth||'')}" style="margin-top:.3rem;display:block;padding:.5rem;border:1px solid var(--border);border-radius:8px;font-size:.9rem"/>
        </div>
        <div style="margin-top:.75rem">
          <label style="font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em">Review</label>
          <textarea id="edit-rv-content" rows="4" style="width:100%;margin-top:.3rem;padding:.6rem;border:1px solid var(--border);border-radius:8px;font-size:.9rem;font-family:inherit;box-sizing:border-box">${escMy(r.content)}</textarea>
        </div>
        <div id="edit-rv-err" style="color:#DC2626;font-size:.8rem;margin-top:.5rem;display:none"></div>
        <div class="myrv-actions">
          <button class="myrv-edit-btn" style="background:var(--primary);color:#fff;border-color:var(--primary)" onclick="submitEditMyReview(${id})">Save changes</button>
          <button class="myrv-edit-btn" onclick="loadMyReviews()">Cancel</button>
        </div>`
      let pickedRating = r.rating
      body.querySelectorAll('#edit-rv-stars button').forEach(btn => {
        btn.addEventListener('click', () => {
          pickedRating = parseInt(btn.dataset.r)
          body.querySelectorAll('#edit-rv-stars button').forEach(b => {
            b.style.color = parseInt(b.dataset.r) <= pickedRating ? '#F59E0B' : '#CBD5E1'
          })
        })
      })
      window.__editRvPicked = () => pickedRating
    }

    async function submitEditMyReview(id) {
      const token   = localStorage.getItem('sb_token')
      const rating  = window.__editRvPicked ? window.__editRvPicked() : 0
      const content = document.getElementById('edit-rv-content').value.trim()
      const month   = document.getElementById('edit-rv-month').value
      const err     = document.getElementById('edit-rv-err')
      err.style.display = 'none'
      if (rating < 1 || rating > 5) { err.textContent = 'Pick a rating.'; err.style.display = 'block'; return }
      if (content.length < 20)      { err.textContent = 'At least 20 characters.'; err.style.display = 'block'; return }
      try {
        const res = await fetch(`${API}/reviews/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ rating, content, stayMonth: month }),
        })
        const data = await res.json()
        if (!res.ok) throw new Error(data.message || 'Save failed')
        loadMyReviews()
      } catch (e) {
        err.textContent = e.message; err.style.display = 'block'
      }
    }

