    // Track whether the form has unsaved changes
    function onAccountFieldChange() {
      const u = _me; if (!u) return
      const dirty = (
        document.getElementById('acc-name')?.value.trim()    !== (u.name    || u.username || '') ||
        document.getElementById('acc-email')?.value.trim()   !== (u.email   || '') ||
        document.getElementById('acc-contact')?.value.trim() !== (u.contact || '')
      )
      const btn = document.getElementById('acc-save-btn')
      if (btn) btn.disabled = !dirty
      const msg = document.getElementById('acc-msg')
      if (msg) { msg.textContent = ''; msg.className = 'account-msg' }
    }

    async function saveAccountChanges() {
      const btn = document.getElementById('acc-save-btn')
      const msg = document.getElementById('acc-msg')
      const token = localStorage.getItem('sb_token')
      btn.disabled = true; btn.textContent = 'Saving…'
      msg.textContent = ''; msg.className = 'account-msg'
      const body = {
        name:    document.getElementById('acc-name').value.trim(),
        email:   document.getElementById('acc-email').value.trim(),
        contact: document.getElementById('acc-contact').value.trim(),
      }
      try {
        const res = await fetch(`${API}/me`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        })
        const data = await res.json()
        if (!res.ok) throw new Error(data.message || 'Save failed')
        _me = data.user; window.__sbMe = data.user
        msg.textContent = '✓ Saved'; msg.className = 'account-msg is-success'
        // Refresh sidebar header
        paintUserHeader(data.user)
        btn.textContent = 'Save changes'
      } catch (e) {
        msg.textContent = e.message || 'Could not save'; msg.className = 'account-msg is-error'
        btn.disabled = false; btn.textContent = 'Save changes'
      }
    }

    // ── Analytics dashboard ───────────────────────────────────────────────────
    let _analyticsState = { period: 7, metric: 'views', data: null }
    let _chartInstance  = null
    let _chartJsLoading = null
    let _analyticsLoading = false

    const TIER_RANK = { free:0, pro:1, featured:2, admin:3 }
    const PERIOD_MIN_TIER = { 7: 'free', 30: 'pro', 90: 'pro', 365: 'featured' }
    // Which KPI cards each tier sees (everything else is locked + blurred).
    // All paid tiers (pro+) see the full performance picture; only Featured
    // unlocks the 1-year rolling window.
    const KPI_TIER_REQUIREMENTS = {
      views:    'free',
      ctr:      'pro',
      clicks:   'pro',
      bookings: 'pro',
      map:      'pro',
      rating:   'free',
    }

    async function _loadChartJs() {
      if (window.Chart) return window.Chart
      if (_chartJsLoading) return _chartJsLoading
      _chartJsLoading = new Promise((res, rej) => {
        const s = document.createElement('script')
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js'
        s.onload = () => res(window.Chart); s.onerror = rej
        document.head.appendChild(s)
      })
      return _chartJsLoading
    }

    function _formatNumber(n) {
      n = Number(n) || 0
      if (n >= 1000) return (n/1000).toFixed(n >= 10000 ? 0 : 1) + 'k'
      return String(n)
    }
    function _calcDelta(cur, prev) {
      cur = Number(cur)||0; prev = Number(prev)||0
      if (prev === 0) {
        if (cur === 0) return { dir: 'flat', label: '0%', raw: 0 }
        return { dir: 'up', label: 'New', raw: 100 }
      }
      const pct = ((cur - prev) / prev) * 100
      const dir = pct > 0.5 ? 'up' : pct < -0.5 ? 'down' : 'flat'
      const sign = pct > 0 ? '+' : ''
      return { dir, label: `${sign}${pct.toFixed(0)}%`, raw: pct }
    }
    const ARROW_UP   = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>'
    const ARROW_DN   = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="7" x2="17" y2="17"/><polyline points="17 7 17 17 7 17"/></svg>'
    const ARROW_FLAT = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>'
    function _deltaArrow(dir) { return dir === 'up' ? ARROW_UP : dir === 'down' ? ARROW_DN : ARROW_FLAT }

    function _userTierRank() {
      const t = _analyticsState.data?.tier || 'free'
      return TIER_RANK[t] ?? 0
    }

    function _renderKpiCards(cur, prev) {
      const ctr = cur.views > 0 ? (cur.clicks / cur.views) * 100 : 0
      const prevCtr = prev.views > 0 ? (prev.clicks / prev.views) * 100 : 0
      const cards = [
        { key: 'views',    label: 'Views',          val: _formatNumber(cur.views),    delta: _calcDelta(cur.views, prev.views) },
        { key: 'ctr',      label: 'CTR',            val: `${ctr.toFixed(1)}%`,        delta: _calcDelta(ctr, prevCtr) },
        { key: 'clicks',   label: 'Total clicks',   val: _formatNumber(cur.clicks),   delta: _calcDelta(cur.clicks, prev.clicks) },
        { key: 'bookings', label: 'Booking clicks', val: _formatNumber(cur.bookings), delta: _calcDelta(cur.bookings, prev.bookings) },
        { key: 'map',      label: 'Map clicks',     val: _formatNumber(cur.map),      delta: _calcDelta(cur.map, prev.map) },
        { key: 'rating',   label: 'Avg rating',     val: cur.rating > 0 ? cur.rating.toFixed(1) : '—', delta: null },
      ]
      const userRank = _userTierRank()
      document.getElementById('kpi-grid').innerHTML = cards.map(c => {
        const reqTier = KPI_TIER_REQUIREMENTS[c.key] || 'free'
        const reqRank = TIER_RANK[reqTier] || 0
        const locked = userRank < reqRank
        const deltaHtml = c.delta
          ? `<div class="kpi-delta ${c.delta.dir}">${_deltaArrow(c.delta.dir)} ${c.delta.label}<span class="kpi-delta-sub">vs previous</span></div>`
          : `<div class="kpi-delta flat"><span class="kpi-delta-sub">based on reviews</span></div>`
        const lockHtml = locked
          ? `<div class="kpi-lock-overlay"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span class="kpi-lock-tier">${reqTier}+ tier</span></div>`
          : ''
        return `<div class="kpi-card${locked ? ' is-locked' : ''}">
          <div class="kpi-label">${c.label}</div>
          <div class="kpi-value">${c.val}</div>
          ${deltaHtml}
          ${lockHtml}
        </div>`
      }).join('')
    }

    async function _renderChart(series) {
      const Chart = await _loadChartJs()
      const labels = series.map(s => {
        const [y,m,d] = s.date.split('-')
        return `${m}/${d}`
      })
      const metric = _analyticsState.metric
      const data = series.map(s => s[metric] || 0)
      const totalActivity = data.reduce((a,b) => a+b, 0)
      document.getElementById('chart-empty').style.display = totalActivity === 0 ? 'grid' : 'none'

      const canvas = document.getElementById('analytics-chart')
      if (!canvas) return
      // Theme colors
      const colors = metric === 'views'
        ? { stroke: '#7C3AED', fill: 'rgba(124, 58, 237, 0.10)' }
        : { stroke: '#F59E0B', fill: 'rgba(245, 158, 11, 0.12)' }
      if (_chartInstance) { _chartInstance.destroy(); _chartInstance = null }
      _chartInstance = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: metric === 'views' ? 'Views' : 'Clicks',
            data,
            borderColor: colors.stroke,
            backgroundColor: colors.fill,
            borderWidth: 2.5,
            tension: 0.35,
            fill: true,
            pointRadius: data.length > 60 ? 0 : 3,
            pointHoverRadius: 5,
            pointBackgroundColor: colors.stroke,
          }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: {
            backgroundColor: '#1A2533', padding: 10, titleFont: { weight: '700' }, bodyFont: { size: 12 },
            displayColors: false,
          } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#94A3B8', font: { size: 10 }, maxRotation: 0, autoSkipPadding: 14 } },
            y: { beginAtZero: true, grid: { color: '#F1F5F9', drawBorder: false }, ticks: { color: '#94A3B8', font: { size: 10 }, precision: 0 } },
          },
        },
      })
    }

    function _renderBreakdown(breakdown) {
      const labels = {
        airbnb: 'Airbnb', bookingcom: 'Booking.com', whatsapp: 'WhatsApp',
        direct: 'Direct', website: 'Website', facebook: 'Facebook',
        instagram: 'Instagram', location: 'Map / Location',
      }
      const items = Object.entries(breakdown || {})
        .filter(([k]) => k !== 'location') // map shown separately in KPIs
        .sort((a,b) => b[1] - a[1])
      const max = items.reduce((m, [,v]) => Math.max(m, v), 0) || 1
      const html = items.length
        ? items.map(([k, v]) => `<div class="breakdown-row">
            <div class="breakdown-label">${labels[k] || k}</div>
            <div class="breakdown-bar-track"><div class="breakdown-bar-fill" style="width:${(v/max)*100}%"></div></div>
            <div class="breakdown-value">${v}</div>
          </div>`).join('')
        : '<div class="analytics-empty" style="padding:1.5rem 0">No clicks recorded in this period.</div>'
      document.getElementById('breakdown-list').innerHTML = html
    }

    function _renderSources(sources) {
      const labels = {
        direct: 'Direct', google: 'Google', instagram: 'Instagram', facebook: 'Facebook',
        twitter: 'Twitter / X', tiktok: 'TikTok', youtube: 'YouTube', linkedin: 'LinkedIn',
        reddit: 'Reddit', pinterest: 'Pinterest', threads: 'Threads', snapchat: 'Snapchat',
        whatsapp: 'WhatsApp', telegram: 'Telegram', bing: 'Bing', yahoo: 'Yahoo',
        duckduckgo: 'DuckDuckGo', other: 'Other sites',
      }
      const entries = Object.entries(sources || {}).filter(([,v]) => v > 0).sort((a,b) => b[1] - a[1])
      if (!entries.length) {
        document.getElementById('sources-list').innerHTML = '<div class="analytics-empty" style="padding:1.5rem 0">No tracked traffic in this period yet. Sources are recorded when guests arrive on listing pages — direct visits, Google, Instagram, etc.</div>'
        return
      }
      const max = entries[0][1] || 1
      document.getElementById('sources-list').innerHTML = entries.map(([k, v]) => {
        const label = k.startsWith('utm_') ? `Campaign · ${k.slice(4)}` : (labels[k] || k)
        return `<div class="breakdown-row">
          <div class="breakdown-label" style="width:140px">${label}</div>
          <div class="breakdown-bar-track"><div class="breakdown-bar-fill" style="width:${(v/max)*100}%"></div></div>
          <div class="breakdown-value">${v}</div>
        </div>`
      }).join('')
    }

    function _renderTopListings(top) {
      if (!top || !top.length) {
        document.getElementById('top-listings-list').innerHTML = '<div class="analytics-empty" style="padding:1.5rem 0">No tracked listings yet.</div>'
        return
      }
      document.getElementById('top-listings-list').innerHTML = top.map(l => {
        const sparkSvg = _sparklineSvg(l.sparkline || [])
        const thumb = l.thumb
          ? `<img class="top-listing-thumb" src="${escMy(l.thumb)}" alt="" loading="lazy"/>`
          : `<div class="top-listing-thumb"></div>`
        return `<div class="top-listing-row">
          ${thumb}
          <div class="top-listing-name">
            <a href="/stay/${escMy(l.slug)}" target="_blank">${escMy(l.title)}</a>
            <div class="top-listing-meta">${l.views} views · ${l.clicks} clicks</div>
          </div>
          ${sparkSvg}
        </div>`
      }).join('')
    }

    function _sparklineSvg(values) {
      if (!values.length) return ''
      const w = 80, h = 28, pad = 2
      const max = Math.max(...values, 1)
      const step = (w - pad*2) / Math.max(values.length - 1, 1)
      const pts = values.map((v, i) => {
        const x = pad + i * step
        const y = h - pad - (v/max) * (h - pad*2)
        return `${x.toFixed(1)},${y.toFixed(1)}`
      }).join(' ')
      return `<svg class="top-listing-spark" viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
        <polyline points="${pts}" fill="none" stroke="var(--primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>`
    }

    async function loadAnalytics() {
      if (_analyticsLoading) return
      _analyticsLoading = true
      const token = localStorage.getItem('sb_token')
      try {
        const res  = await fetch(`${API}/host-stats?period_days=${_analyticsState.period}`, {
          headers: { Authorization: `Bearer ${token}` },
        })
        const data = await res.json()
        if (!res.ok || !data.success) throw new Error(data.message || 'Could not load stats')
        _analyticsState.data = data
        _applyTierGatesToPeriodChips()
        _renderKpiCards(data.current, data.previous)
        _renderBreakdown(data.breakdown)
        _renderSources(data.sources)
        _renderTopListings(data.top_listings)
        _renderChart(data.series)
      } catch (e) {
        console.warn('analytics load failed', e)
        const grid = document.getElementById('kpi-grid')
        if (grid) grid.innerHTML = `<div class="analytics-empty" style="grid-column: 1 / -1">Could not load analytics. <button class="post-edit-trigger" onclick="loadAnalytics()">Retry</button></div>`
      } finally {
        _analyticsLoading = false
      }
    }

    function _applyTierGatesToPeriodChips() {
      const userRank = _userTierRank()
      document.querySelectorAll('#period-chips .period-chip').forEach(btn => {
        const days = parseInt(btn.dataset.period)
        const reqTier = PERIOD_MIN_TIER[days] || 'free'
        const allowed = userRank >= TIER_RANK[reqTier]
        btn.disabled = !allowed
        btn.title = allowed ? `Last ${days} days` : `Requires ${reqTier} tier or higher`
      })
    }

    function setAnalyticsPeriod(days) {
      const userRank = _userTierRank()
      const reqTier = PERIOD_MIN_TIER[days] || 'free'
      if (userRank < TIER_RANK[reqTier]) return
      _analyticsState.period = days
      document.querySelectorAll('#period-chips .period-chip').forEach(b => {
        b.classList.toggle('is-active', parseInt(b.dataset.period) === days)
      })
      loadAnalytics()
    }

    function setChartMetric(metric) {
      _analyticsState.metric = metric
      document.querySelectorAll('.chart-toggle').forEach(b => {
        b.classList.toggle('is-active', b.dataset.metric === metric)
      })
      if (_analyticsState.data) _renderChart(_analyticsState.data.series)
    }

    // ── Profile photo modal ───────────────────────────────────────────────────
    let _cropper = null
    let _photoBlocking = false
    let _photoFaceWarned = 0  // increments each time we warn — allow override after second attempt

    async function _loadCropper() {
      if (window.Cropper) return window.Cropper
      await Promise.all([
        new Promise((res, rej) => {
          const link = document.createElement('link')
          link.rel = 'stylesheet'
          link.href = 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css'
          link.onload = res; link.onerror = rej
          document.head.appendChild(link)
        }),
        new Promise((res, rej) => {
          const s = document.createElement('script')
          s.src = 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js'
          s.onload = res; s.onerror = rej
          document.head.appendChild(s)
        }),
      ])
      return window.Cropper
    }

    async function _loadFaceApi() {
      if (window.faceapi && window.faceapi.nets.tinyFaceDetector.params) return window.faceapi
      if (!window.faceapi) {
        await new Promise((res, rej) => {
          const s = document.createElement('script')
          s.src = 'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js'
          s.onload = res; s.onerror = rej
          document.head.appendChild(s)
        })
      }
      // load tiny face detector model from a public CDN mirror of the weights
      await window.faceapi.nets.tinyFaceDetector.loadFromUri('https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights')
      return window.faceapi
    }

    function openPhotoModal(blocking = false) {
      _photoBlocking = blocking
      const modal   = document.getElementById('photo-modal')
      const banner  = document.getElementById('photo-blocking-banner')
      const closeBtn= document.getElementById('photo-modal-close')
      const cancel  = document.getElementById('photo-cancel-btn')
      banner.style.display   = blocking ? 'block' : 'none'
      closeBtn.style.display = blocking ? 'none'  : 'inline-flex'
      cancel.style.display   = blocking ? 'none'  : 'inline-flex'
      resetPhotoModal()
      modal.style.display = 'flex'
    }

    function closePhotoModal() {
      if (_photoBlocking) return  // can't close blocking modal
      document.getElementById('photo-modal').style.display = 'none'
      resetPhotoModal()
    }

    function resetPhotoModal() {
      document.getElementById('photo-step-pick').style.display = 'block'
      document.getElementById('photo-step-crop').style.display = 'none'
      document.getElementById('photo-face-status').style.display = 'none'
      document.getElementById('photo-error').style.display = 'none'
      document.getElementById('photo-confirm-btn').disabled = true
      document.getElementById('photo-confirm-btn').textContent = 'Use this photo'
      _photoFaceWarned = 0
      if (_cropper) { _cropper.destroy(); _cropper = null }
      const file = document.querySelector('#photo-step-pick input[type="file"]')
      if (file) file.value = ''
    }

    async function onPhotoFileSelect(ev) {
      const file = ev.target.files?.[0]
      if (!file) return
      if (file.size > 8 * 1024 * 1024) { _photoErr('File is too large (max 8 MB)'); return }
      if (!['image/jpeg','image/png','image/webp'].includes(file.type)) { _photoErr('Use JPG, PNG, or WebP'); return }
      const url = URL.createObjectURL(file)
      // Show the cropper step
      document.getElementById('photo-step-pick').style.display = 'none'
      document.getElementById('photo-step-crop').style.display = 'block'
      try {
        const Cropper = await _loadCropper()
        const img = document.getElementById('photo-cropper-img')
        img.src = url
        // Wait for image to load before initializing cropper
        await new Promise(res => { img.onload = res })
        if (_cropper) _cropper.destroy()
        _cropper = new Cropper(img, {
          aspectRatio: 1, viewMode: 1, dragMode: 'move',
          autoCropArea: 1, background: false, cropBoxResizable: true,
          guides: false, center: true, movable: true, rotatable: false,
          scalable: false, zoomable: true,
        })
        document.getElementById('photo-confirm-btn').disabled = false
        // Run face check on the original image
        runFaceCheck(img)
      } catch (e) {
        _photoErr('Could not load the photo editor. Try again.')
        console.error(e)
      }
    }

    async function runFaceCheck(imgEl) {
      const status = document.getElementById('photo-face-status')
      const txt    = document.getElementById('photo-face-status-text')
      status.style.display = 'flex'
      status.className = 'face-status-checking'
      txt.textContent = 'Checking photo for a face…'
      try {
        status.className = 'face-status-ok'; txt.innerHTML = '\u2713 Photo selected.'; return // limasawa: face check dropped
        const faceapi = await _loadFaceApi()
        const detection = await faceapi.detectSingleFace(imgEl, new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 }))
        if (detection) {
          status.className = 'face-status-ok'
          txt.innerHTML = '✓ Looks good — we can see your face clearly.'
        } else {
          _photoFaceWarned++
          status.className = 'face-status-warn'
          txt.innerHTML = _photoFaceWarned >= 2
            ? '⚠ Still no face detected — you can proceed if you\'re sure this is the right photo.'
            : '⚠ We couldn\'t see a clear face. Try a closer shot in good lighting, or upload anyway if this is correct.'
        }
      } catch (e) {
        // Face detection is a soft check — if it fails, allow upload
        status.className = 'face-status-error'
        txt.textContent = 'Could not run face check, but you can still upload.'
        console.warn('face-api failed:', e)
      }
    }

    async function confirmPhotoUpload() {
      if (!_cropper) return
      const btn = document.getElementById('photo-confirm-btn')
      btn.disabled = true; btn.textContent = 'Uploading…'
      _photoClearErr()
      try {
        const blob = await new Promise((res, rej) => {
          _cropper.getCroppedCanvas({ width: 512, height: 512, imageSmoothingQuality: 'high' })
            .toBlob(b => b ? res(b) : rej(new Error('Crop failed')), 'image/jpeg', 0.9)
        })
        const fd = new FormData()
        fd.append('file', blob, 'profile.jpg')
        fd.append('image_type', 'profile_photo')
        const upload = await fetch(`${API}/upload-media`, { method: 'POST', body: fd })
        const upJson = await upload.json()
        if (!upload.ok) throw new Error(upJson.message || 'Upload failed')
        const photoId  = upJson.attachment_id
        const photoUrl = upJson.url
        // Save to user via POST /me
        const token = localStorage.getItem('sb_token')
        const saveRes = await fetch(`${API}/me`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ profilePhotoId: photoId }),
        })
        const saveData = await saveRes.json()
        if (!saveRes.ok) throw new Error(saveData.message || 'Could not save photo')
        _me = saveData.user; window.__sbMe = saveData.user
        // Update visible avatar in sidebar + Account tab
        paintUserHeader(saveData.user)
        const accImg = document.getElementById('account-photo-img')
        if (accImg && accImg.tagName === 'IMG') accImg.src = photoUrl
        else if (accImg) {
          const newImg = document.createElement('img')
          newImg.id = 'account-photo-img'; newImg.className = 'account-photo'; newImg.src = photoUrl
          accImg.replaceWith(newImg)
        }
        _photoBlocking = false
        document.getElementById('photo-modal').style.display = 'none'
        resetPhotoModal()
      } catch (e) {
        _photoErr(e.message || 'Something went wrong')
        btn.disabled = false; btn.textContent = 'Use this photo'
      }
    }

    function _photoErr(msg) {
      const el = document.getElementById('photo-error')
      el.textContent = msg; el.style.display = 'block'
    }
    function _photoClearErr() {
      document.getElementById('photo-error').style.display = 'none'
    }

    // Show the blocking profile-photo modal only for hosts who own at least
    // one listing and haven't set a profile photo yet. Skips:
    //  - guests (no listings) — their saved-stays flow doesn't need an avatar
    //  - claimants whose claim isn't approved yet — adding friction before
    //    we've handed them a listing is hostile
    //  - hosts who already inherited a photo from their claimed listing's
    //    accommodation_host_picture (seeded server-side on claim approval)
    function maybeShowProfilePhotoBlocker() {
      // limasawa: profile photo is optional — no forced upload gate.
      return
    }

    // ── Saved listings ────────────────────────────────────────────────────────
    let _savedMerged = false   // ensure localStorage merge runs only once per session

    async function mergeLocalSavedToServer(token) {
      if (_savedMerged) return
      _savedMerged = true
      try {
        const local = JSON.parse(localStorage.getItem('sb_saved') || '[]')
        if (!Array.isArray(local) || !local.length) return
        await fetch(`${API}/save-listing`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ slugs: local }),
        })
        // Keep localStorage too (so anonymous browsing on the same device still shows hearts)
      } catch (_) {}
    }

    async function loadSavedListings() {
      const container = document.getElementById('saved-cards-container')
      container.innerHTML = `<div class="saved-skeleton">
        ${[1,2,3].map(() => `<div class="skeleton" style="height:280px;border-radius:16px;"></div>`).join('')}
      </div>`

      const token = localStorage.getItem('sb_token')
      await mergeLocalSavedToServer(token)
      try {
        const res  = await fetch(`${API}/my-saved`, { headers: { Authorization: `Bearer ${token}` } })
        const data = await res.json()
        const listings = data.listings || []
        if(!listings.length) {
          container.innerHTML = renderSavedEmpty()
        } else {
          container.innerHTML = `<div class="saved-grid">${listings.map(renderSavedCard).join('')}</div>`
        }
      } catch(e) {
        container.innerHTML = `<div class="saved-empty"><h3>Could not load saved listings</h3><p>${e.message || 'Please try again.'}</p></div>`
      }
    }

    function renderSavedEmpty() {
      return `<div class="saved-empty">
        <div class="empty-heart">
          <svg viewBox="0 0 24 24" fill="#E11D48" stroke="#E11D48" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </div>
        <h3>No saved listings yet</h3>
        <p>Tap the ♥ on any listing to save it here.</p>
        <a href="/" style="display:inline-block;margin-top:1rem;padding:.55rem 1.4rem;background:var(--primary);color:#fff;border-radius:9px;text-decoration:none;font-weight:700;font-size:.875rem;">Browse listings</a>
      </div>`
    }

    function renderSavedCard(l) {
      // REST /my-saved shape: { slug, title, thumb, price, monthly }
      const slug    = l.slug
      const thumb   = l.thumb
      const price   = l.price
      const monthly = l.monthly

      const thumbHtml = thumb
        ? `<img src="${thumb}" alt="${l.title}" loading="lazy" />`
        : `<div class="no-photo">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
               <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
             </svg>
           </div>`

      return `<div class="listing-card saved-card" data-slug="${slug}">
        <div class="listing-thumb">${thumbHtml}</div>
        <div class="listing-body">
          <div class="listing-title">${l.title}</div>
          ${price ? `<div class="listing-price">&#8369;${Number(price).toLocaleString()}<span>/night</span>${monthly ? `&nbsp;&middot;&nbsp;<span>&#8369;${Number(monthly).toLocaleString()}/mo</span>` : ''}</div>` : ''}
        </div>
        <div class="listing-actions">
          <a href="/stay/${slug}" class="action-btn action-view">View listing</a>
          <button class="btn-unsave" onclick="unsaveListing('${slug}', this)" title="Remove from saved">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            Remove
          </button>
        </div>
      </div>`
    }

    async function unsaveListing(slug, btn) {
      btn.disabled = true
      btn.textContent = '…'
      const token = localStorage.getItem('sb_token')
      try {
        await fetch(`${API}/save-listing`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ slug }),
        })
        // Sync localStorage too
        try {
          const saved = new Set(JSON.parse(localStorage.getItem('sb_saved') || '[]'))
          saved.delete(slug)
          localStorage.setItem('sb_saved', JSON.stringify([...saved]))
        } catch {}
        const card = document.querySelector(`.saved-card[data-slug="${slug}"]`)
        if(card) { card.style.opacity = '0'; card.style.transition = 'opacity .2s'; setTimeout(() => card.remove(), 220) }
        setTimeout(() => {
          const grid = document.querySelector('.saved-grid')
          if(grid && !grid.querySelector('.saved-card')) {
            document.getElementById('saved-cards-container').innerHTML = renderSavedEmpty()
          }
        }, 300)
      } catch(e) {
        btn.disabled = false
        btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg> Remove`
      }
    }

    // ── Reviews tab ──────────────────────────────────────────────────────────
    async function loadReviews() {
      const container = document.getElementById('reviews-container')
      container.innerHTML = `<div class="orders-empty"><h3>Loading reviews…</h3></div>`
      const token = localStorage.getItem('sb_token')
      if(!token) {
        container.innerHTML = `<div class="rv-empty"><h3>Not authenticated</h3><p>Please sign in to view reviews.</p></div>`
        return
      }
      try {
        const res  = await fetch(`${API}/reviews/pending`, { headers:{ Authorization:`Bearer ${token}` } })
        const data = await res.json()
        if(!res.ok) throw new Error(data.message || 'Could not load reviews')
        const pending = Array.isArray(data.pending) ? data.pending : []
        // Update count badge
        const badge = document.getElementById('reviews-count-badge')
        if(badge) {
          badge.textContent = pending.length
          badge.style.display = pending.length > 0 ? 'inline-flex' : 'none'
        }
        container.innerHTML = renderReviews(pending)
        // Wire action buttons
        container.querySelectorAll('[data-rv-approve]').forEach(btn => {
          btn.addEventListener('click', () => reviewAction('approve', btn))
        })
        container.querySelectorAll('[data-rv-reject]').forEach(btn => {
          btn.addEventListener('click', () => reviewAction('reject', btn))
        })
        container.querySelectorAll('[data-rv-reply-toggle]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.rvReplyToggle
            const section = document.getElementById(`rv-reply-section-${id}`)
            if(section) section.style.display = section.style.display === 'none' ? 'block' : 'none'
          })
        })
        container.querySelectorAll('[data-rv-reply-submit]').forEach(btn => {
          btn.addEventListener('click', () => reviewReply(btn))
        })
      } catch(e) {
        container.innerHTML = `<div class="rv-empty"><h3>Could not load reviews</h3><p>${e.message || 'Please try again.'}</p></div>`
      }
    }

    async function reviewAction(action, btn) {
      const id = btn.dataset['rv' + (action === 'approve' ? 'Approve' : 'Reject')]
      const card = document.getElementById(`rv-card-${id}`)
      const msgEl = card?.querySelector('.rv-action-msg')
      const token = localStorage.getItem('sb_token')
      btn.disabled = true
      const sibling = card?.querySelector(action === 'approve' ? '[data-rv-reject]' : '[data-rv-approve]')
      if(sibling) sibling.disabled = true
      try {
        const res  = await fetch(`${API}/reviews/${id}/${action}`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` }
        })
        const data = await res.json()
        if(data.success) {
          if(msgEl) { msgEl.className = 'rv-action-msg success'; msgEl.textContent = action === 'approve' ? 'Approved!' : 'Rejected' }
          // Fade out the card after a short delay
          setTimeout(() => {
            if(card) { card.style.opacity = '0'; card.style.transition = 'opacity .25s'; setTimeout(() => card.remove(), 260) }
            // Update badge count
            const badge = document.getElementById('reviews-count-badge')
            if(badge) {
              const n = Math.max(0, parseInt(badge.textContent || '0') - 1)
              badge.textContent = n
              if(n === 0) badge.style.display = 'none'
            }
            // Show empty if nothing left
            const grid = document.querySelector('.rv-grid')
            if(grid && !grid.querySelector('.rv-card')) {
              document.getElementById('reviews-container').innerHTML = renderReviews([])
            }
          }, 900)
        } else {
          if(msgEl) { msgEl.className = 'rv-action-msg error'; msgEl.textContent = data.message || 'Failed' }
          btn.disabled = false
          if(sibling) sibling.disabled = false
        }
      } catch(e) {
        if(msgEl) { msgEl.className = 'rv-action-msg error'; msgEl.textContent = 'Network error' }
        btn.disabled = false
        if(sibling) sibling.disabled = false
      }
    }

    async function reviewReply(btn) {
      const id = btn.dataset.rvReplySubmit
      const card = document.getElementById(`rv-card-${id}`)
      const input = document.getElementById(`rv-reply-input-${id}`)
      const msgEl = card?.querySelector('.rv-action-msg')
      const token = localStorage.getItem('sb_token')
      const reply = input?.value.trim()
      if(!reply) { if(msgEl) { msgEl.className = 'rv-action-msg error'; msgEl.textContent = 'Reply cannot be empty.' }; return }
      btn.disabled = true; btn.textContent = 'Saving…'
      try {
        const res  = await fetch(`${API}/reviews/${id}/reply`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ reply })
        })
        const data = await res.json()
        if(data.success) {
          if(msgEl) { msgEl.className = 'rv-action-msg success'; msgEl.textContent = 'Reply saved!' }
          // Replace the input with the saved reply text
          const section = document.getElementById(`rv-reply-section-${id}`)
          if(section) {
            section.innerHTML = `<div class="rv-reply-label">Your reply</div><div class="rv-reply-existing">${escHtml(reply)}</div>`
          }
        } else {
          if(msgEl) { msgEl.className = 'rv-action-msg error'; msgEl.textContent = data.message || 'Could not save reply.' }
          btn.disabled = false; btn.textContent = 'Send reply'
        }
      } catch(e) {
        if(msgEl) { msgEl.className = 'rv-action-msg error'; msgEl.textContent = 'Network error.' }
        btn.disabled = false; btn.textContent = 'Send reply'
      }
    }

    function escHtml(s) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    }

    function renderStars(rating) {
      const r = Math.round(rating * 2) / 2   // round to nearest 0.5
      return [1,2,3,4,5].map(i => `<span class="rv-star${i <= r ? '' : ' empty'}">★</span>`).join('')
    }

    function renderReviews(pending) {
      if(!pending.length) {
        return `<div class="rv-empty">
          <h3>No pending reviews</h3>
          <p>All reviews have been actioned. New guest reviews will appear here.</p>
        </div>`
      }
      return `<div class="rv-grid">${pending.map(rv => {
        const initials = (rv.author || 'G').split(' ').map(n=>n[0]||'').slice(0,2).join('').toUpperCase()
        const hasReply = rv.hostReply && rv.hostReply.trim()
        return `<div class="rv-card" id="rv-card-${rv.id}">
          <div class="rv-card-header">
            <span class="rv-listing-name" title="${escHtml(rv.listingTitle)}">${escHtml(rv.listingTitle)}</span>
            ${rv.source ? `<span class="rv-source-badge">${escHtml(rv.source)}</span>` : ''}
          </div>
          <div class="rv-card-body">
            <div class="rv-reviewer">
              <div class="rv-reviewer-avatar">${escHtml(initials)}</div>
              <div>
                <div class="rv-reviewer-name">${escHtml(rv.author)}</div>
                <div class="rv-reviewer-date">${escHtml(rv.date || '')}</div>
              </div>
            </div>
            <div class="rv-stars">${renderStars(rv.rating)}</div>
            <div class="rv-content">${escHtml(rv.content)}</div>
            ${rv.stayMonth ? `<div class="rv-stay-month">Stay: ${escHtml(rv.stayMonth)}</div>` : ''}
            ${hasReply
              ? `<div class="rv-reply-section" id="rv-reply-section-${rv.id}">
                  <div class="rv-reply-label">Your reply</div>
                  <div class="rv-reply-existing">${escHtml(rv.hostReply)}</div>
                </div>`
              : `<div class="rv-reply-section" id="rv-reply-section-${rv.id}" style="display:none;">
                  <div class="rv-reply-label">Your reply</div>
                  <textarea class="rv-reply-input" id="rv-reply-input-${rv.id}" placeholder="Write a reply to this guest…"></textarea>
                  <button class="rv-btn-reply" data-rv-reply-submit="${rv.id}">Send reply</button>
                </div>`
            }
          </div>
          <div class="rv-card-actions">
            <button class="rv-btn-approve" data-rv-approve="${rv.id}">Approve</button>
            <button class="rv-btn-reject"  data-rv-reject="${rv.id}">Reject</button>
            ${!hasReply ? `<button class="rv-btn-reply" data-rv-reply-toggle="${rv.id}">Reply</button>` : ''}
            <span class="rv-action-msg"></span>
          </div>
        </div>`
      }).join('')}</div>`
    }

    // ── Orders / Billing renderer ─────────────────────────────────────────────
    const TIER_PLAN_NAMES = { free:'Island Listing', pro:'Pro Host', featured:'Featured Stay' }
    const BILLING_LABELS  = { monthly:'Monthly', yearly:'Yearly' }
    // Yearly = 10× monthly (2 months free).
    const TIER_PRICES = {
      free:     { monthly:0,   yearly:0    },
      pro:      { monthly:399, yearly:3990 },
      featured: { monthly:999, yearly:9990 },
    }

    function formatDate(dateStr) {
      if(!dateStr) return '—'
      const d = new Date(dateStr)
      if(isNaN(d)) return '—'
      return d.toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' })
    }

    function expiryProgress(expiresAt, billingPeriod) {
      if(!expiresAt) return null
      const now     = Date.now()
      const expires = new Date(expiresAt).getTime()
      if(isNaN(expires)) return null
      const days     = { monthly:30, yearly:365 }[billingPeriod] || 30
      const total    = days * 24 * 60 * 60 * 1000
      const elapsed  = total - (expires - now)
      const pct      = Math.max(0, Math.min(100, Math.round((elapsed / total) * 100)))
      const remaining = Math.max(0, Math.ceil((expires - now) / (24*60*60*1000)))
      return { pct, remaining, expired: expires < now }
    }

    function renderSubCard(l) {
      const tier        = l.tier || 'free'
      const isFree      = tier === 'free'
      const planName    = TIER_PLAN_NAMES[tier] || tier
      const cycle       = BILLING_LABELS[l.billing_period] || '—'
      const ps          = l.payment_status || (isFree ? 'not_required' : 'pending_verification')
      const amount      = l.payment_amount || 0

      // Status badge
      let ssb = 'ssb-free', statusTxt = 'No payment required'
      if      (ps === 'paid')                 { ssb = 'ssb-paid';    statusTxt = 'Active'   }
      else if (ps === 'pending_verification') { ssb = 'ssb-pending'; statusTxt = 'Pending'  }
      else if (ps === 'expired')              { ssb = 'ssb-expired'; statusTxt = 'Expired'  }

      // Plan icon colour
      const spiCls = { free:'spi-free', local:'spi-local', prime:'spi-prime', featured:'spi-featured' }[tier] || 'spi-free'

      // Expiry bar
      let expiryHtml = ''
      if(!isFree && ps === 'paid' && l.expires_at) {
        const prog = expiryProgress(l.expires_at, l.billing_period)
        if(prog) {
          const fillCls = prog.expired ? 'sef-expired' : prog.remaining <= 7 ? 'sef-warn' : 'sef-ok'
          const label   = prog.expired ? 'Subscription expired' : `${prog.remaining} day${prog.remaining!==1?'s':''} remaining`
          expiryHtml = `<div class="sub-expiry-bar-wrap">
            <div class="sub-expiry-label"><span>${label}</span><span>${formatDate(l.expires_at)}</span></div>
            <div class="sub-expiry-bar"><div class="sub-expiry-fill ${fillCls}" style="width:${prog.pct}%"></div></div>
          </div>`
        }
      }

      // Action buttons — use data attributes so we can pass listing into modal
      const listingJson = encodeURIComponent(JSON.stringify(l))
      let actionsHtml = ''
      if(isFree) {
        actionsHtml = `<button class="btn-sub-upgrade" onclick='openRenewalModal(${JSON.stringify(l)})'>Upgrade plan</button>`
      } else if(ps === 'paid') {
        const prog = l.expires_at ? expiryProgress(l.expires_at, l.billing_period) : null
        const showRenew = !prog || prog.remaining <= 14 || prog.expired
        actionsHtml = showRenew
          ? `<button class="btn-sub-renew"    onclick='openRenewalModal(${JSON.stringify(l)})'>Renew subscription</button>
             <button class="btn-sub-upgrade"  onclick='openRenewalModal(${JSON.stringify(l)}, true)'>Upgrade plan</button>`
          : `<button class="btn-sub-upgrade"  onclick='openRenewalModal(${JSON.stringify(l)}, true)'>Upgrade plan</button>`
      } else if(ps === 'pending_verification') {
        actionsHtml = `<span style="font-size:.78rem;color:var(--muted);padding:.45rem .5rem;">Payment under review — we&#39;ll activate within 24h</span>`
      } else {
        actionsHtml = `<button class="btn-sub-renew" onclick='openRenewalModal(${JSON.stringify(l)})'>Submit payment</button>`
      }

      const paidAtHtml   = l.paid_at    ? formatDate(l.paid_at)    : '—'
      const expiresHtml  = l.expires_at ? formatDate(l.expires_at) : '—'
      const methodHtml   = l.payment_method
        ? l.payment_method.charAt(0).toUpperCase() + l.payment_method.slice(1)
        : '—'
      const amountHtml   = amount > 0 ? `&#8369;${Number(amount).toLocaleString()}` : '—'

      return `<div class="sub-card">
        <div class="sub-card-header">
          <span class="sub-card-title" title="${l.title}">${l.title}</span>
          <span class="sub-status-badge ${ssb}">${statusTxt}</span>
        </div>
        <div class="sub-card-body">
          <div class="sub-plan-row">
            <div class="sub-plan-icon ${spiCls}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>
            <div>
              <div class="sub-plan-name">${planName}</div>
              <div class="sub-plan-cycle">${isFree ? 'Free plan' : `${cycle} billing`}</div>
            </div>
          </div>
          ${isFree ? `
          <p class="sub-free-note">Your listing stays live on the Island Listing plan with no expiry. Upgrade any time for more photos, full analytics, and ranking boost.</p>
          ` : `
          <div class="sub-details">
            <div class="sub-detail-item">
              <div class="sub-detail-label">Amount paid</div>
              <div class="sub-detail-value">${amountHtml}</div>
            </div>
            <div class="sub-detail-item">
              <div class="sub-detail-label">Payment method</div>
              <div class="sub-detail-value ${methodHtml==='—'?'muted':''}">${methodHtml}</div>
            </div>
            <div class="sub-detail-item">
              <div class="sub-detail-label">Paid on</div>
              <div class="sub-detail-value ${paidAtHtml==='—'?'muted':''}">${paidAtHtml}</div>
            </div>
            <div class="sub-detail-item">
              <div class="sub-detail-label">Expires</div>
              <div class="sub-detail-value ${expiresHtml==='—'?'muted':''}">${expiresHtml}</div>
            </div>
          </div>
          ${expiryHtml}
          `}
        </div>
        <div class="sub-card-actions">${actionsHtml}</div>
      </div>`
    }

    function renderOrders(listings) {
      if(!listings || !listings.length) {
        return `<div class="orders-empty">
          <h3>No listings yet</h3>
          <p>Add your first property to see billing details here.</p>
        </div>`
      }
      return `<div class="sub-cards">${listings.map(renderSubCard).join('')}</div>`
    }

    // ── Renewal / Upgrade modal ───────────────────────────────────────────────
    const QR_URLS = {
      gcash: 'https://admin.limasawabooking.com/wp-content/uploads/2026/05/gcash-number.webp',
      maya:  'https://admin.limasawabooking.com/wp-content/uploads/2026/05/maya-number.webp',
      bpi:   'https://admin.limasawabooking.com/wp-content/uploads/2026/05/bpi-number.webp',
    }
    const MODAL_TIER_PRICES = {
      free:     { monthly:0,   yearly:0    },
      pro:      { monthly:399, yearly:3990 },
      featured: { monthly:999, yearly:9990 },
    }
    const MODAL_TIER_NAMES = { free:'Island Listing', pro:'Pro Host', featured:'Featured Stay' }
    const BILLING_CYCLE_LABELS = { monthly:'Monthly', yearly:'Yearly' }

    let _modalListing  = null
    let _modalTier     = 'free'
    let _modalBilling  = 'monthly'
    let _modalMethod   = ''
    let _modalReceiptId = 0
    let _modalUploading = false
    let _modalCoupon   = null  // { code, discount, new_total } when applied

    // Pre-coupon price (after the multi-listing 50% discount, if applicable)
    function _modalPriceBase() {
      const base = MODAL_TIER_PRICES[_modalTier]?.[_modalBilling] ?? 0
      const others = (_currentListings || []).filter(l => l.id !== _modalListing?.id)
      return others.length >= 1 ? Math.floor(base * 0.5) : base
    }

    // Final price the host actually pays — includes coupon if one is applied
    function _modalPrice() {
      const base = _modalPriceBase()
      if (_modalCoupon && _modalCoupon.new_total != null) {
        return Math.max(0, Math.floor(_modalCoupon.new_total))
      }
      return base
    }

    function openRenewalModal(listing, forceUpgrade = false) {
      _modalListing   = listing
      _modalTier      = listing.tier || 'free'
      // Normalize legacy billing periods (e.g. 'six_months' from old listings
      // before we collapsed to monthly+yearly). Any unknown value falls back
      // to 'monthly' so the backend whitelist won't reject the submit.
      const rawBilling = listing.billing_period || 'monthly'
      _modalBilling   = ['monthly','yearly'].includes(rawBilling)
        ? rawBilling
        : (rawBilling === 'six_months' ? 'yearly' : 'monthly')
      _modalMethod    = ''
      _modalReceiptId = 0
      _modalUploading = false
      // Reset coupon state on every open
      _modalCoupon    = null
      const couponInput  = document.getElementById('modal-coupon-input')
      const couponStatus = document.getElementById('modal-coupon-status')
      const couponClear  = document.getElementById('modal-coupon-clear')
      if (couponInput)  { couponInput.value = ''; couponInput.disabled = false }
      if (couponStatus) { couponStatus.textContent = ''; couponStatus.className = 'modal-coupon-status' }
      if (couponClear)  couponClear.style.display = 'none'

      document.getElementById('modal-title').textContent = forceUpgrade ? 'Upgrade Plan' : 'Renew / Upgrade Subscription'
      document.getElementById('modal-listing-name').textContent = listing.title

      _buildTierGrid()
      _buildBillingGrid()
      _updatePriceSummary()
      _resetPaymentFields()

      const msgEl = document.getElementById('modal-msg')
      msgEl.className = 'modal-msg'; msgEl.textContent = ''
      document.getElementById('modal-submit-btn').disabled = false
      document.getElementById('modal-submit-btn').textContent = 'Submit payment'

      document.getElementById('renewal-modal').style.display = 'flex'
      document.body.style.overflow = 'hidden'
    }

    function closeRenewalModal() {
      document.getElementById('renewal-modal').style.display = 'none'
      document.body.style.overflow = ''
    }

    function _buildTierGrid() {
      const tiers = ['free','pro','featured']
      document.getElementById('modal-tier-grid').innerHTML = tiers.map(t => {
        const price = MODAL_TIER_PRICES[t]?.monthly ?? 0
        const priceLabel = price === 0 ? 'Free forever' : `from ₱${price.toLocaleString()}/mo`
        return `<label class="tier-opt${_modalTier===t?' selected':''}" onclick="_selectTier('${t}')">
          <input type="radio" name="modal-tier" value="${t}" ${_modalTier===t?'checked':''}/>
          <div class="tier-opt-name">${MODAL_TIER_NAMES[t]}</div>
          <div class="tier-opt-price">${priceLabel}</div>
        </label>`
      }).join('')
    }

    function _buildBillingGrid() {
      const cycles = [
        { key:'monthly', label:'Monthly', savePct:null },
        { key:'yearly',  label:'Yearly',  savePct:17 },
      ]
      const isFree = _modalTier === 'free'
      document.getElementById('modal-billing-section').style.display = isFree ? 'none' : ''
      document.getElementById('modal-billing-grid').innerHTML = cycles.map(c => {
        const price = MODAL_TIER_PRICES[_modalTier]?.[c.key] ?? 0
        const saveEl = c.savePct ? `<div class="billing-opt-save">Save ${c.savePct}%</div>` : ''
        return `<label class="billing-opt${_modalBilling===c.key?' selected':''}" onclick="_selectBilling('${c.key}')">
          <input type="radio" name="modal-billing" value="${c.key}" ${_modalBilling===c.key?'checked':''}/>
          <div class="billing-opt-label">${c.label}</div>
          <div class="billing-opt-price">${price===0?'Free':`₱${price.toLocaleString()}`}${saveEl}</div>
        </label>`
      }).join('')
    }

    function _selectTier(t) {
      _modalTier = t
      _buildTierGrid()
      _buildBillingGrid()
      _updatePriceSummary()
      _resetPaymentFields()
    }

    function _selectBilling(b) {
      _modalBilling = b
      document.querySelectorAll('.billing-opt').forEach(el => {
        el.classList.toggle('selected', el.querySelector('input').value === b)
      })
      _updatePriceSummary()
    }

    function _updatePriceSummary() {
      const base  = _modalPriceBase()
      const price = _modalPrice()
      const sumEl = document.getElementById('modal-price-summary')
      const amtEl = document.getElementById('modal-price-amount')
      const couponSection = document.getElementById('modal-coupon-section')
      if(_modalTier === 'free' || base === 0) {
        sumEl.style.display = 'none'
        document.getElementById('modal-payment-section').style.display = 'none'
        document.getElementById('modal-ref-section').style.display = 'none'
        document.getElementById('modal-receipt-section').style.display = 'none'
        if (couponSection) couponSection.style.display = 'none'
        document.getElementById('modal-submit-btn').textContent = 'Save changes'
      } else {
        sumEl.style.display = 'flex'
        // If a coupon is applied, show strikethrough base + new total
        if (_modalCoupon && price < base) {
          amtEl.innerHTML = `<span style="text-decoration:line-through;color:#94a3b8;font-weight:600;font-size:.85em;margin-right:.4em">₱${base.toLocaleString()}</span>₱${price.toLocaleString()}`
        } else {
          amtEl.textContent = `₱${price.toLocaleString()}`
        }
        document.getElementById('modal-payment-section').style.display = ''
        if (couponSection) couponSection.style.display = ''
        document.getElementById('modal-submit-btn').textContent = 'Submit payment'
      }
    }

    function _resetPaymentFields() {
      _modalMethod    = ''
      _modalReceiptId = 0
      document.querySelectorAll('.pm-opt').forEach(el => el.classList.remove('selected'))
      document.getElementById('modal-qr-wrap').style.display = 'none'
      document.getElementById('modal-ref-section').style.display = 'none'
      document.getElementById('modal-receipt-section').style.display = 'none'
      document.getElementById('modal-ref-input').value = ''
      document.getElementById('upload-status').textContent = ''
      document.getElementById('upload-zone-text').style.display = ''
      const prev = document.getElementById('receipt-preview')
      prev.src = ''; prev.style.display = 'none'
      document.getElementById('modal-receipt-file').value = ''
    }

    // Apply a coupon code: hits /coupon/validate with the current base price,
    // updates _modalCoupon on success, refreshes the price summary.
    async function applyCouponInModal() {
      const input  = document.getElementById('modal-coupon-input')
      const status = document.getElementById('modal-coupon-status')
      const clearBtn = document.getElementById('modal-coupon-clear')
      const code = (input.value || '').trim()
      if (!code) {
        status.textContent = 'Enter a coupon code first.'
        status.className   = 'modal-coupon-status err'
        return
      }
      const base = _modalPriceBase()
      try {
        const url = `${API}/coupon/validate?code=${encodeURIComponent(code)}&tier=${encodeURIComponent(_modalTier)}&billing=${encodeURIComponent(_modalBilling)}&amount=${encodeURIComponent(base)}`
        const res = await fetch(url, { credentials: 'omit' })
        const data = await res.json()
        if (!data || !data.valid) {
          _modalCoupon = null
          status.textContent = (data && data.message) || 'Coupon could not be applied.'
          status.className   = 'modal-coupon-status err'
          if (clearBtn) clearBtn.style.display = 'none'
        } else {
          _modalCoupon = { code: data.code, discount: data.discount, new_total: data.new_total }
          const off = data.type === 'percentage' ? `${data.value}% off` : `₱${data.value.toLocaleString()} off`
          status.textContent = `${data.code} applied — ${off}, you save ₱${Number(data.discount).toLocaleString()}.`
          status.className   = 'modal-coupon-status ok'
          if (clearBtn) clearBtn.style.display = ''
          input.disabled = true
        }
        _updatePriceSummary()
      } catch (e) {
        status.textContent = 'Network error. Please try again.'
        status.className   = 'modal-coupon-status err'
      }
    }
    function clearCouponInModal() {
      _modalCoupon = null
      const input  = document.getElementById('modal-coupon-input')
      const status = document.getElementById('modal-coupon-status')
      const clearBtn = document.getElementById('modal-coupon-clear')
      if (input)  { input.disabled = false; input.value = ''; }
      if (status) { status.textContent = ''; status.className = 'modal-coupon-status' }
      if (clearBtn) clearBtn.style.display = 'none'
      _updatePriceSummary()
    }

    function selectMethod(method) {
      _modalMethod = method
      document.querySelectorAll('.pm-opt').forEach(el => {
        el.classList.toggle('selected', el.id === `pm-${method}`)
      })
      const qrWrap = document.getElementById('modal-qr-wrap')
      const qrImg  = document.getElementById('modal-qr-img')
      if(QR_URLS[method]) {
        qrImg.src = QR_URLS[method]; qrWrap.style.display = 'block'
      } else {
        qrWrap.style.display = 'none'
      }
      document.getElementById('modal-ref-section').style.display = 'block'
      document.getElementById('modal-receipt-section').style.display = 'block'
    }

    async function handleReceiptUpload(event) {
      const file = event.target.files[0]
      if(!file) return
      const statusEl = document.getElementById('upload-status')
      const prevEl   = document.getElementById('receipt-preview')
      const zoneText = document.getElementById('upload-zone-text')
      statusEl.textContent = 'Uploading…'
      _modalUploading = true

      // Show local preview immediately
      const reader = new FileReader()
      reader.onload = e => { prevEl.src = e.target.result; prevEl.style.display = 'block'; zoneText.style.display = 'none' }
      reader.readAsDataURL(file)

      try {
        const token = localStorage.getItem('sb_token')
        const formData = new FormData()
        formData.append('file', file)
        formData.append('property_name', _modalListing?.title || 'renewal')
        formData.append('image_type', 'payment_receipt')

        const res  = await fetch(`${API}/upload-media`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` },
          body: formData,
        })
        const data = await res.json()
        if(data.success && data.attachment_id) {
          _modalReceiptId = data.attachment_id
          statusEl.textContent = '✓ Receipt uploaded'
          statusEl.style.color = '#15803D'
        } else {
          statusEl.textContent = 'Upload failed — ' + (data.message || 'try again')
          statusEl.style.color = '#DC2626'
        }
      } catch(e) {
        statusEl.textContent = 'Upload failed — network error'
        statusEl.style.color = '#DC2626'
      } finally {
        _modalUploading = false
      }
    }

    async function submitRenewal() {
      const msgEl = document.getElementById('modal-msg')
      const btn   = document.getElementById('modal-submit-btn')
      msgEl.className = 'modal-msg'; msgEl.textContent = ''

      if(_modalUploading) {
        msgEl.className = 'modal-msg error'
        msgEl.textContent = 'Receipt is still uploading, please wait…'
        return
      }

      const isFree  = _modalTier === 'free'
      const price   = _modalPrice()
      const needsPay = !isFree && price > 0

      if(needsPay && !_modalMethod) {
        msgEl.className = 'modal-msg error'
        msgEl.textContent = 'Please select a payment method.'
        return
      }

      btn.disabled = true
      btn.textContent = 'Submitting…'

      try {
        const token = localStorage.getItem('sb_token')
        // Server is the source of truth for the discounted amount; we send
        // the pre-coupon base so the backend can re-validate and re-apply
        // the coupon. (Avoids client-side price tampering.)
        const submitAmount = _modalCoupon ? _modalPriceBase() : price
        const body = {
          listing_id:         _modalListing.id,
          tier:               _modalTier,
          // Free tier has no real billing — send 'monthly' as a stable default
          // so the backend whitelist passes regardless of the listing's prior
          // (possibly legacy) billing_period meta.
          billing_period:     isFree ? 'monthly' : _modalBilling,
          payment_method:     _modalMethod,
          payment_reference:  document.getElementById('modal-ref-input').value.trim(),
          payment_receipt_id: _modalReceiptId,
          payment_amount:     submitAmount,
          coupon_code:        _modalCoupon ? _modalCoupon.code : '',
        }
        const res  = await fetch(`${API}/renew-subscription`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        })
        const data = await res.json()
        if(data.success) {
          msgEl.className = 'modal-msg success'
          msgEl.textContent = data.message || 'Done!'
          // Refresh the orders tab data after 1.5s and close
          setTimeout(async () => {
            closeRenewalModal()
            const listRes  = await fetch(`${API}/my-listings`, { headers:{ Authorization:`Bearer ${token}` } })
            const listData = await listRes.json()
            if(listData.listings) {
              _currentListings = listData.listings
              document.getElementById('sub-cards-container').innerHTML = renderOrders(listData.listings)
              const listingsHtml2 = renderListings(listData.listings)
              document.getElementById('listings-container').innerHTML    = listingsHtml2
              const mlc = document.getElementById('my-listings-container')
              if (mlc) mlc.innerHTML = listingsHtml2
            }
          }, 1500)
        } else {
          msgEl.className = 'modal-msg error'
          msgEl.textContent = data.message || 'Something went wrong. Please try again.'
          btn.disabled = false
          btn.textContent = needsPay ? 'Submit payment' : 'Save changes'
        }
      } catch(e) {
        msgEl.className = 'modal-msg error'
        msgEl.textContent = 'Network error. Please try again.'
        btn.disabled = false
        btn.textContent = needsPay ? 'Submit payment' : 'Save changes'
      }
    }

    // ── Boot ──────────────────────────────────────────────────────────────────
    let _me = null   // shared user object

    function applyRole(role) {
      // Admins see the host UI on the frontend — admin-specific dashboard
      // lives in WP admin. Anyone who isn't host/admin is treated as a guest.
      document.body.classList.remove('role-guest', 'role-host')
      const isHostLike = isHostRole(role)
      document.body.classList.add(isHostLike ? 'role-host' : 'role-guest')
      const roleEl = document.getElementById('sidebar-role')
      if (roleEl) roleEl.textContent = isHostLike ? 'Host' : 'Guest'
    }

    // Coupon apply/clear button wiring (modal markup is static so we attach
    // these once at boot — they keep working as the modal opens/closes).
    document.addEventListener('DOMContentLoaded', () => {
      const apply = document.getElementById('modal-coupon-apply')
      const clear = document.getElementById('modal-coupon-clear')
      const input = document.getElementById('modal-coupon-input')
      if (apply) apply.addEventListener('click', applyCouponInModal)
      if (clear) clear.addEventListener('click', clearCouponInModal)
      if (input) input.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); applyCouponInModal() }
      })
    })

    function paintUserHeader(u) {
      const displayName = u.name || u.username || 'User'
      document.getElementById('sidebar-name').textContent = displayName
      const wh = document.getElementById('welcome-heading')
      if (wh) wh.textContent = `Welcome back, ${displayName}`
      const initials = displayName.split(' ').map(n => n[0] || '').slice(0, 2).join('').toUpperCase()
      const img = document.getElementById('user-avatar-img')
      const fb  = document.getElementById('user-avatar-fallback')
      if (u.avatar && !u.avatar.includes('gravatar')) {
        img.src = u.avatar; img.style.display = 'block'; fb.style.display = 'none'
      } else {
        fb.textContent = initials; fb.style.display = 'flex'; img.style.display = 'none'
      }
    }

    async function loadDashboard() {
      const params = new URLSearchParams(location.search)
      const handoffToken = params.get('token')
      const via = params.get('via')
      if(handoffToken) {
        localStorage.setItem('sb_token', handoffToken)
        if (via === 'admin') {
          // Mark this session as an admin impersonation so the banner can show
          // and Sign-out can return to the WP admin dashboard.
          sessionStorage.setItem('sb_impersonating', '1')
        }
        params.delete('token'); params.delete('via')
        const clean = `${location.pathname}${params.toString() ? `?${params}` : ''}${location.hash}`
        history.replaceState(null, '', clean)
      }

      const token = localStorage.getItem('sb_token')
      const payload = token ? parseJWT(token) : null
      if(!payload || payload.exp < Date.now()/1000) {
        window.location.href = '/auth?redirect=/dashboard'
        return
      }

      // 1) Fetch /me first to determine role
      let meData
      try {
        const meRes = await fetch(`${API}/me`, { headers:{ 'Authorization': `Bearer ${token}` } })
        if (meRes.status === 401) { doLogout(); return }
        meData = await meRes.json()
      } catch (e) {
        document.getElementById('loading-state').innerHTML =
          `<div style="text-align:center; padding:3rem; color:#64748B;"><p>Failed to reach server. <button onclick="loadDashboard()" style="color:var(--primary);background:none;border:none;cursor:pointer;font-weight:600;">Retry</button></p></div>`
        return
      }
      if (!meData?.user) { doLogout(); return }

      const u = meData.user
      _me = u
      window.__sbMe = u
      applyRole(u.role || 'guest')
      paintUserHeader(u)

      // Show impersonation banner if admin handed us off via 'View as'
      if (sessionStorage.getItem('sb_impersonating') === '1') {
        document.body.classList.add('is-impersonating')
        const banner = document.getElementById('impersonation-banner')
        const name   = document.getElementById('imp-name')
        if (banner) banner.style.display = 'flex'
        if (name)   name.textContent = u.name || u.username || 'this user'
      }

      const isHost = isHostRole(u.role)
      const wantedTab = new URLSearchParams(location.search).get('tab')
      // Default tab: dashboard for hosts, saved for guests
      const initialTab = wantedTab || (isHost ? 'dashboard' : 'saved')

      // 2) For hosts, fetch listings/posts in parallel; for guests skip those
      if (isHost) {
        try {
          const [listRes, postsRes] = await Promise.all([
            fetch(`${API}/my-listings`, { headers:{ 'Authorization': `Bearer ${token}` } }),
            fetch(`${API}/my-posts`,    { headers:{ 'Authorization': `Bearer ${token}` } }),
          ])
          const data      = await listRes.json()
          const postsData = await postsRes.json()
          const listings = data.listings || []
          _currentListings = listings
          const maxTier = listings.reduce((best, l) => (
            TIER_ORDER.indexOf(l.tier || 'free') > TIER_ORDER.indexOf(best) ? (l.tier || 'free') : best
          ), 'free')
          document.getElementById('stats-grid').innerHTML          = renderStats(data.stats || {}, maxTier)
          const listingsHtml = renderListings(listings)
          document.getElementById('listings-container').innerHTML    = listingsHtml
          document.getElementById('my-listings-container').innerHTML = listingsHtml
          document.getElementById('posts-list').innerHTML          = renderPosts(postsData.posts || [])
          document.getElementById('sub-cards-container').innerHTML = renderOrders(listings)
          // Onboarding nudge — only show when host has zero listings
          const onb = document.getElementById('onboarding-nudge')
          if (onb) onb.style.display = listings.length === 0 ? 'flex' : 'none'
          // Tier-gate the posts panel — admin treated like a host here.
          const postsAllowed = ['pro','featured'].includes(maxTier)
          const panel   = document.getElementById('posts-panel')
          const overlay = document.getElementById('posts-locked-overlay')
          const inner   = document.getElementById('posts-panel-inner')
          if (overlay && inner) {
            overlay.style.display = postsAllowed ? 'none' : 'flex'
            inner.classList.toggle('posts-locked-content', !postsAllowed)
            if (panel) panel.classList.toggle('is-locked', !postsAllowed)
          }
        } catch (e) {
          // Don't fail entire dashboard — host data unavailable, fall back to guest experience
          console.warn('Host data fetch failed', e)
        }
      }

      document.getElementById('loading-state').style.display = 'none'
      switchTab(initialTab)

      // Required profile photo — show blocking modal if user hasn't uploaded one yet
      maybeShowProfilePhotoBlocker()

      // Success toast after editing a listing
      const savedSlug = new URLSearchParams(location.search).get('listing_saved')
      if (savedSlug) {
        const url = new URL(location.href); url.searchParams.delete('listing_saved')
        history.replaceState(null, '', url.toString())
        const toast = document.createElement('div')
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#16A34A;color:#fff;padding:.75rem 1.5rem;border-radius:10px;font-weight:700;font-size:.9rem;box-shadow:0 6px 20px rgba(0,0,0,.15);z-index:9999;display:flex;gap:.5rem;align-items:center'
        toast.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Listing saved successfully'
        document.body.appendChild(toast)
        setTimeout(() => { toast.style.transition = 'opacity .3s'; toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300) }, 3000)
      }
    }

    loadDashboard()
  </script>
</body>
</html>
