---
/**
 * List a rental — /list-rental  (create) and /list-rental?edit=ID (edit).
 * Dedicated simple form (rentals have far fewer fields than accommodations).
 * Auth-gated; submits to /submit-rental, edits via /rental-edit + /update-rental.
 */
import Layout from '../layouts/Layout.astro'

const WP_REST = import.meta.env.PUBLIC_WP_REST ?? 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
---

<Layout title="List your rental" description="List your scooter, motorbike, or car rental on Limasawa Booking." noindex={true}>
  <main class="lr-main">
    <!-- Auth wall -->
    <div class="lr-authwall" id="lr-authwall" style="display:none">
      <h1>List your rental</h1>
      <p>Please sign in as a host to list a scooter, motorbike, or car rental in Limasawa.</p>
      <a class="lr-btn-primary" href="/auth?redirect=/list-rental">Sign in / Register</a>
    </div>

    <!-- Success -->
    <div class="lr-success" id="lr-success" style="display:none">
      <div class="lr-success-icon">✓</div>
      <h1>Rental submitted!</h1>
      <p>Your rental is now pending review. We'll publish it shortly — you can track it in your dashboard.</p>
      <a class="lr-btn-primary" href="/dashboard?tab=rentals">Go to dashboard</a>
    </div>

    <!-- Form -->
    <form class="lr-form" id="lr-form" style="display:none">
      <header class="lr-head">
        <a href="/dashboard?tab=rentals" class="lr-back">← Dashboard</a>
        <h1 id="lr-title">List your rental</h1>
        <p id="lr-sub">Add a scooter, motorbike, bicycle, or car for travelers to rent in Limasawa.</p>
      </header>

      <div class="lr-field" id="lr-plan-field">
        <label>Choose your plan</label>
        <div class="lr-discount-banner" id="lr-discount-banner" style="display:none">
          🎉 Returning host — <strong>50% off</strong> any paid plan applied automatically.
        </div>
        <div class="lr-plans">
          <label class="lr-plan is-selected">
            <input type="radio" name="tier" value="free" checked />
            <span class="lr-plan-name">Free</span>
            <span class="lr-plan-price">₱0</span>
            <span class="lr-plan-perk">List 1 vehicle</span>
          </label>
          <label class="lr-plan">
            <input type="radio" name="tier" value="pro" />
            <span class="lr-plan-name">Verified</span>
            <span class="lr-plan-price">₱99<small>/mo</small></span>
            <span class="lr-plan-perk">Up to 3 listings · Verified badge · ranks above free</span>
          </label>
          <label class="lr-plan">
            <input type="radio" name="tier" value="featured" />
            <span class="lr-plan-name">Featured</span>
            <span class="lr-plan-price">₱149<small>/mo</small></span>
            <span class="lr-plan-perk">Unlimited listings · top placement · Featured badge</span>
          </label>
        </div>
        <div class="lr-billing" id="lr-billing" style="display:none">
          <button type="button" class="lr-bill-opt is-active" data-bill="monthly">Monthly</button>
          <button type="button" class="lr-bill-opt" data-bill="yearly">Yearly <small>(2 months free)</small></button>
        </div>
      </div>

      <div class="lr-field">
        <label for="f-title">Listing title <span>*</span></label>
        <input id="f-title" class="lr-input" placeholder="e.g. Honda Click 125 Scooter Rental" required />
      </div>

      <div class="lr-row">
        <div class="lr-field">
          <label for="f-type">Vehicle type <span>*</span></label>
          <select id="f-type" class="lr-input" required>
            <option value="">Select…</option>
            <option value="scooter">Scooter</option>
            <option value="motorbike">Motorbike</option>
            <option value="car">Car</option>
            <option value="van">Van</option>
            <option value="boat">Boat</option>
            <option value="jet-ski">Jet Ski</option>
            <option value="bicycle">Bicycle</option>
            <option value="tricycle">Tricycle</option>
          </select>
        </div>
        <div class="lr-field">
          <label for="f-barangay">Barangay <span>*</span></label>
          <select id="f-barangay" class="lr-input" required>
            <option value="">Select…</option>
            <option value="39">Cabulihan</option>
            <option value="40">Lugsongan</option>
            <option value="41">Magallanes</option>
            <option value="42">San Agustin</option>
            <option value="43">San Bernardo</option>
            <option value="44">Triana</option>
          </select>
        </div>
      </div>

      <div class="lr-row">
        <div class="lr-field">
          <label for="f-daily">Rate (₱) <span>*</span></label>
          <input id="f-daily" class="lr-input" type="number" min="0" placeholder="700" required />
        </div>
        <div class="lr-field">
          <label for="f-unit">Charged per <span>*</span></label>
          <select id="f-unit" class="lr-input">
            <option value="day">per day</option>
            <option value="hour">per hour</option>
            <option value="trip">per trip</option>
            <option value="person">per person</option>
          </select>
        </div>
      </div>

      <div class="lr-row">
        <div class="lr-field">
          <label for="f-hourly">Also available hourly (₱)</label>
          <input id="f-hourly" class="lr-input" type="number" min="0" placeholder="100" />
        </div>
        <div class="lr-field">
          <label for="f-deposit">Deposit (₱)</label>
          <input id="f-deposit" class="lr-input" type="number" min="0" placeholder="1000" />
        </div>
      </div>

      <div class="lr-field">
        <label for="f-inclusions">What's included / notes</label>
        <textarea id="f-inclusions" class="lr-input" rows="2" placeholder="e.g. Helmet included. Fuel not included. Valid ID required as deposit."></textarea>
      </div>

      <div class="lr-field">
        <label for="f-desc">Description</label>
        <textarea id="f-desc" class="lr-input" rows="4" placeholder="Describe the vehicle, condition, and anything renters should know."></textarea>
      </div>

      <div class="lr-row">
        <div class="lr-field">
          <label for="f-provider">Provider / business name</label>
          <input id="f-provider" class="lr-input" placeholder="e.g. Island Rides Limasawa" />
        </div>
        <div class="lr-field">
          <label for="f-contact">Contact number</label>
          <input id="f-contact" class="lr-input" placeholder="e.g. 0917 123 4567" />
        </div>
      </div>

      <div class="lr-field">
        <label>Photos</label>
        <div class="lr-photos" id="lr-photos"></div>
        <label class="lr-upload" id="lr-upload-label">
          <input type="file" id="f-photos" accept="image/*" multiple hidden />
          <span id="lr-upload-text">+ Add photos</span>
        </label>
      </div>

      <div class="lr-field" id="lr-payment" style="display:none">
        <label>Payment</label>
        <div class="lr-pay-box">
          <p class="lr-pay-amount">Amount due: <strong id="lr-amount">₱99</strong> <span id="lr-bill-label" style="color:#64748B;font-weight:400">/ monthly</span></p>
          <p class="lr-pay-instr">Pay via GCash, Maya, or BPI, then enter your reference and upload the receipt. We'll verify and activate your plan — your rental goes live once approved.</p>
          <select id="f-method" class="lr-input"><option value="">Payment method…</option><option value="gcash">GCash</option><option value="maya">Maya</option><option value="bpi">BPI transfer</option></select>
          <div id="lr-pay-details" class="lr-pay-details" style="display:none"></div>
          <input id="f-ref" class="lr-input" placeholder="Payment reference / confirmation no." style="margin-top:.6rem" />
          <div style="margin-top:.6rem">
            <div class="lr-photos" id="lr-receipt-thumb"></div>
            <label class="lr-upload"><input type="file" id="f-receipt" accept="image/*" hidden /><span id="lr-receipt-text">+ Upload receipt</span></label>
          </div>
        </div>
      </div>

      <div class="lr-error" id="lr-error" hidden></div>
      <div class="lr-actions">
        <button type="submit" class="lr-btn-primary" id="lr-submit">Submit rental</button>
      </div>
    </form>
  </main>

  <style is:global>
    .lr-main { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem 5rem; color: #1A2533; }
    .lr-authwall, .lr-success { text-align: center; padding: 4rem 1rem; }
    .lr-authwall h1, .lr-success h1 { font-family: 'DM Sans', sans-serif; font-size: 1.8rem; font-weight: 800; margin-bottom: .75rem; }
    .lr-authwall p, .lr-success p { color: #64748B; margin-bottom: 1.5rem; line-height: 1.6; }
    .lr-success-icon { width: 64px; height: 64px; border-radius: 50%; background: #E6F9FA; color: #22ABB3; font-size: 2rem; display: grid; place-items: center; margin: 0 auto 1.25rem; font-weight: 800; }

    .lr-head { margin-bottom: 2rem; }
    .lr-back { color: #64748B; text-decoration: none; font-weight: 700; font-size: .85rem; }
    .lr-back:hover { color: #22ABB3; }
    .lr-head h1 { font-family: 'DM Sans', sans-serif; font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; margin: .75rem 0 .35rem; }
    .lr-head p { color: #64748B; line-height: 1.5; }

    .lr-field { margin-bottom: 1.25rem; }
    .lr-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .lr-row-3 { grid-template-columns: 1fr 1fr 1fr; }
    .lr-field label { display: block; font-weight: 700; font-size: .85rem; margin-bottom: .4rem; }
    .lr-field label span { color: #DC2626; }
    .lr-input { width: 100%; border: 1.5px solid #E2EBF3; border-radius: 10px; padding: .7rem .85rem; font-size: .95rem; font-family: inherit; background: #fff; box-sizing: border-box; outline: none; transition: border-color .15s; }
    .lr-input:focus { border-color: #22ABB3; box-shadow: 0 0 0 3px rgba(39,157,163,.12); }
    textarea.lr-input { resize: vertical; }

    .lr-photos { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .6rem; }
    .lr-photo { position: relative; width: 84px; height: 84px; border-radius: 10px; overflow: hidden; background: #F5F8FB; }
    .lr-photo img { width: 100%; height: 100%; object-fit: cover; }
    .lr-photo button { position: absolute; top: 3px; right: 3px; width: 20px; height: 20px; border-radius: 50%; border: 0; background: rgba(0,0,0,.6); color: #fff; cursor: pointer; font-size: 13px; line-height: 1; }
    .lr-upload { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 1.1rem; border: 1.5px dashed #BEF0F3; border-radius: 10px; color: #22ABB3; font-weight: 700; font-size: .88rem; cursor: pointer; background: #F8FEFE; }
    .lr-upload:hover { border-color: #22ABB3; }

    .lr-error { background: #FEF2F2; border: 1px solid #FECACA; color: #B91C1C; padding: .7rem .9rem; border-radius: 10px; font-size: .88rem; margin-bottom: 1rem; }
    .lr-actions { margin-top: 1.5rem; }
    .lr-btn-primary { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 2rem; background: #22ABB3; color: #fff; border: 0; border-radius: 11px; font-weight: 800; font-size: .95rem; cursor: pointer; text-decoration: none; }
    .lr-btn-primary:hover { background: #1E8087; }
    .lr-btn-primary:disabled { opacity: .6; cursor: not-allowed; }
    @media (max-width: 560px) { .lr-row, .lr-row-3 { grid-template-columns: 1fr; } }

    /* Plan selector */
    .lr-discount-banner { background: #F0FDF4; border: 1px solid #BBF7D0; color: #15803D; border-radius: 10px; padding: .6rem .85rem; font-size: .85rem; margin-bottom: .75rem; }
    .lr-plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; }
    .lr-plan { display: flex; flex-direction: column; gap: .25rem; border: 1.5px solid #E2EBF3; border-radius: 12px; padding: .85rem .9rem; cursor: pointer; transition: all .15s; position: relative; }
    .lr-plan input { position: absolute; opacity: 0; }
    .lr-plan:hover { border-color: #BEF0F3; }
    .lr-plan.is-selected { border-color: #22ABB3; background: #F8FEFE; box-shadow: 0 0 0 3px rgba(39,157,163,.1); }
    .lr-plan-name { font-weight: 800; font-size: .95rem; }
    .lr-plan-price { font-weight: 800; color: #22ABB3; font-size: 1.05rem; }
    .lr-plan-price small { font-weight: 500; color: #64748B; font-size: .7rem; }
    .lr-plan-perk { font-size: .73rem; color: #64748B; line-height: 1.35; }
    .lr-billing { display: flex; gap: .5rem; margin-top: .7rem; }
    .lr-bill-opt { border: 1.5px solid #E2EBF3; background: #fff; border-radius: 9px; padding: .45rem .9rem; font-size: .82rem; font-weight: 700; cursor: pointer; color: #1A2533; }
    .lr-bill-opt small { font-weight: 500; color: #64748B; }
    .lr-bill-opt.is-active { border-color: #22ABB3; background: #F8FEFE; color: #22ABB3; }
    .lr-pay-box { border: 1.5px solid #E2EBF3; border-radius: 12px; padding: 1rem; background: #F8FAFC; }
    .lr-pay-amount { font-size: 1rem; margin: 0 0 .35rem; }
    .lr-pay-instr { font-size: .82rem; color: #64748B; line-height: 1.5; margin: 0 0 .75rem; }
    .lr-pay-details { margin: .6rem 0; border: 1px solid #E2EBF3; border-radius: 10px; padding: .8rem; background: #fff; text-align: center; }
    .lr-pay-details img { width: min(220px, 100%); border-radius: 10px; display: block; margin: .5rem auto 0; }
    .lr-pay-row { display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; padding: .15rem 0; }
    .lr-pay-row span { color: #64748B; } .lr-pay-row strong { color: #1A2533; }
    @media (max-width: 560px) { .lr-plans { grid-template-columns: 1fr; } }
  </style>

  <script define:vars={{ WP_REST }}>window.__LR_API = WP_REST</script>
  <script>
    const API = window.__LR_API || 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
    const $ = id => document.getElementById(id)
    const token = localStorage.getItem('sb_token')

    function parseJWT(t) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))) } catch { return null } }
    const payload = token ? parseJWT(token) : null
    const valid = payload && payload.exp > Date.now() / 1000

    if (!valid) { $('lr-authwall').style.display = 'block' }
    else { $('lr-form').style.display = 'block'; init() }

    let galleryIds = []
    const editId = parseInt(new URLSearchParams(location.search).get('edit') || '0')

    // ── Plan / payment state ──
    const TIER_PRICES = { pro: { monthly: 99, yearly: 990 }, featured: { monthly: 149, yearly: 1490 } }
    let selectedTier = 'free', billing = 'monthly', receiptId = 0, eligibleDiscount = false
    const peso = n => '₱' + Number(n || 0).toLocaleString('en-PH')

    // Returning-host 50% discount: eligible if the host already has any listing
    // (accommodation or rental). Display only — the server is authoritative.
    async function checkDiscount() {
      try {
        const [r, l] = await Promise.all([
          fetch(`${API}/my-rentals`, { headers: { Authorization: `Bearer ${token}` } }).then(x => x.json()).catch(() => ({})),
          fetch(`${API}/my-listings`, { headers: { Authorization: `Bearer ${token}` } }).then(x => x.json()).catch(() => ({})),
        ])
        const count = ((r.rentals || []).length) + ((l.listings || []).length)
        if (count > 0) {
          eligibleDiscount = true
          $('lr-discount-banner').style.display = 'block'
          document.querySelectorAll('.lr-plan').forEach(p => {
            const t = p.querySelector('input').value
            if (t === 'free') return
            const base = TIER_PRICES[t].monthly
            const el = p.querySelector('.lr-plan-price')
            if (el) el.innerHTML = `<s style="opacity:.5;font-weight:500">₱${base.toLocaleString()}</s> ₱${Math.floor(base * 0.5).toLocaleString()}<small>/mo</small>`
          })
          refreshPlanUI()
        }
      } catch (_) {}
    }

    function refreshPlanUI() {
      document.querySelectorAll('.lr-plan').forEach(p => p.classList.toggle('is-selected', p.querySelector('input').value === selectedTier))
      const paid = selectedTier !== 'free'
      $('lr-billing').style.display = paid ? 'flex' : 'none'
      $('lr-payment').style.display = paid ? 'block' : 'none'
      $('lr-submit').textContent = paid ? 'Submit for review' : 'Submit rental'
      if (paid) {
        let amt = TIER_PRICES[selectedTier]?.[billing] || 0
        if (eligibleDiscount) amt = Math.floor(amt * 0.5)
        $('lr-amount').textContent = peso(amt)
        $('lr-bill-label').textContent = '/ ' + billing + (eligibleDiscount ? ' · 50% off' : '')
      }
    }
    function wirePlan() {
      document.querySelectorAll('.lr-plan input[name="tier"]').forEach(r => {
        r.addEventListener('change', () => { selectedTier = r.value; refreshPlanUI() })
      })
      document.querySelectorAll('.lr-bill-opt').forEach(b => {
        b.addEventListener('click', () => {
          billing = b.dataset.bill
          document.querySelectorAll('.lr-bill-opt').forEach(x => x.classList.toggle('is-active', x === b))
          refreshPlanUI()
        })
      })
      $('f-receipt').addEventListener('change', async e => {
        const file = e.target.files[0]; if (!file) return
        $('lr-receipt-text').textContent = 'Uploading…'
        const fd = new FormData(); fd.append('file', file); fd.append('image_type', 'payment_receipt')
        try {
          const res = await fetch(`${API}/upload-media`, { method: 'POST', headers: { Authorization: `Bearer ${token}` }, body: fd }).then(r => r.json())
          if (res.success && res.attachment_id) {
            receiptId = res.attachment_id
            $('lr-receipt-thumb').innerHTML = `<div class="lr-photo"><img src="${res.url}" alt="" /></div>`
          }
        } catch (_) {}
        $('lr-receipt-text').textContent = receiptId ? '✓ Receipt uploaded' : '+ Upload receipt'
        e.target.value = ''
      })
      // Show the matching account details + QR when a payment method is picked.
      const PAY = {
        gcash: { name: 'Nico Lanugon', number: '09260367249', qr: 'https://admin.limasawabooking.com/wp-content/uploads/2026/05/gcash-number.webp' },
        maya:  { name: 'Nico Lanugon', number: '09260367249', qr: 'https://admin.limasawabooking.com/wp-content/uploads/2026/05/maya-number.webp' },
        bpi:   { name: 'Nico Lanugon', number: '5739059781', qr: 'https://admin.limasawabooking.com/wp-content/uploads/2026/05/bpi-number.webp' },
      }
      $('f-method').addEventListener('change', () => {
        const m = PAY[$('f-method').value]; const box = $('lr-pay-details')
        if (!m) { box.style.display = 'none'; return }
        box.style.display = 'block'
        box.innerHTML = `<div class="lr-pay-row"><span>Account name</span><strong>${m.name}</strong></div>`
          + `<div class="lr-pay-row"><span>Account number</span><strong>${m.number}</strong></div>`
          + `<img src="${m.qr}" alt="Payment QR" loading="lazy" onerror="this.style.display='none'" />`
      })
    }

    async function init() {
      // Vehicle types are static <option>s in the markup (scooter…jet-ski).
      // prefill provider name from username
      if (payload?.data?.user?.username && !editId) $('f-provider').value = payload.data.user.username

      wirePlan()
      if (editId) loadForEdit()
      else checkDiscount()
    }

    async function loadForEdit() {
      $('lr-title').textContent = 'Edit rental'
      $('lr-sub').textContent = 'Update your rental details.'
      $('lr-submit').textContent = 'Save changes'
      // Tier/payment aren't changed during an edit — hide those sections.
      $('lr-plan-field').style.display = 'none'
      $('lr-payment').style.display = 'none'
      try {
        const d = await fetch(`${API}/rental-edit/${editId}`, { headers: { Authorization: `Bearer ${token}` } }).then(r => r.json())
        if (!d || d.success === false) throw new Error(d?.message || 'Could not load rental')
        $('f-title').value = d.title || ''
        $('f-type').value = d.type || ''
        $('f-barangay').value = d.barangayId || ''
        $('f-daily').value = d.dailyRate || ''
        $('f-unit').value = d.rateUnit || 'day'
        $('f-hourly').value = d.hourlyRate || ''
        $('f-deposit').value = d.deposit || ''
        $('f-inclusions').value = d.inclusions || ''
        $('f-desc').value = d.description || ''
        $('f-provider').value = d.providerName || ''
        $('f-contact').value = d.providerContact || ''
        galleryIds = (d.galleryIds || []).slice()
        ;(d.galleryUrls || []).forEach((url, i) => addThumb(url, galleryIds[i]))
      } catch (e) {
        showError(e.message || 'Could not load this rental.')
      }
    }

    function addThumb(url, id) {
      const wrap = document.createElement('div')
      wrap.className = 'lr-photo'
      wrap.dataset.id = id
      wrap.innerHTML = `<img src="${url}" alt="" /><button type="button" aria-label="Remove">×</button>`
      wrap.querySelector('button').onclick = () => { galleryIds = galleryIds.filter(x => x != id); wrap.remove() }
      $('lr-photos').appendChild(wrap)
    }

    $('f-photos').addEventListener('change', async e => {
      const files = [...e.target.files]
      $('lr-upload-text').textContent = 'Uploading…'
      for (const file of files) {
        const fd = new FormData()
        fd.append('file', file); fd.append('image_type', 'rental')
        try {
          const res = await fetch(`${API}/upload-media`, { method: 'POST', headers: { Authorization: `Bearer ${token}` }, body: fd }).then(r => r.json())
          if (res.success && res.attachment_id) { galleryIds.push(res.attachment_id); addThumb(res.url, res.attachment_id) }
        } catch (_) {}
      }
      $('lr-upload-text').textContent = '+ Add photos'
      e.target.value = ''
    })

    function showError(msg) { const el = $('lr-error'); el.textContent = msg; el.hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }) }

    $('lr-form').addEventListener('submit', async e => {
      e.preventDefault()
      $('lr-error').hidden = true
      const title = $('f-title').value.trim()
      const type = $('f-type').value
      const barangayId = parseInt($('f-barangay').value || '0')
      const daily = parseFloat($('f-daily').value || '0')
      if (!title || !type || !barangayId || !daily) { showError('Please fill in the required fields (title, type, barangay, rate).'); return }
      const paid = !editId && selectedTier !== 'free'
      if (paid && (!$('f-method').value || !$('f-ref').value.trim())) {
        showError('For a paid plan, choose a payment method and enter your payment reference.'); return
      }
      const body = {
        title, type, barangayId,
        dailyRate: daily,
        rateUnit: $('f-unit').value || 'day',
        hourlyRate: parseFloat($('f-hourly').value || '0'),
        deposit: parseFloat($('f-deposit').value || '0'),
        inclusions: $('f-inclusions').value.trim(),
        description: $('f-desc').value.trim(),
        providerName: $('f-provider').value.trim(),
        providerContact: $('f-contact').value.trim(),
        galleryIds,
      }
      if (!editId) {
        body.tier = selectedTier
        body.billingPeriod = billing
        body.paymentMethod = $('f-method').value
        body.paymentReference = $('f-ref').value.trim()
        body.paymentReceiptId = receiptId
      }
      const btn = $('lr-submit'); btn.disabled = true; btn.textContent = editId ? 'Saving…' : 'Submitting…'
      try {
        const url = editId ? `${API}/update-rental/${editId}` : `${API}/submit-rental`
        const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify(body) }).then(r => r.json())
        if (!res.success) throw new Error(res.message || 'Something went wrong.')
        if (editId) { location.href = '/dashboard?tab=rentals' }
        else { $('lr-form').style.display = 'none'; $('lr-success').style.display = 'block' }
      } catch (e) {
        showError(e.message || 'Could not submit. Please try again.')
        btn.disabled = false; btn.textContent = editId ? 'Save changes' : 'Submit rental'
      }
    })
  </script>
</Layout>
