          <button type="button" class="payment-method-card text-left" data-method="gcash" onclick="selectPaymentMethod(this)">
            <p class="font-bold mb-1" style="color:#1a1a1a">GCash</p>
            <p class="text-xs" style="color:#6b7280">09260367249<br>Nico Lanugon</p>
          </button>
          <button type="button" class="payment-method-card text-left" data-method="maya" onclick="selectPaymentMethod(this)">
            <p class="font-bold mb-1" style="color:#1a1a1a">Maya</p>
            <p class="text-xs" style="color:#6b7280">09260367249<br>Nico Lanugon</p>
          </button>
          <button type="button" class="payment-method-card text-left" data-method="bank_transfer" onclick="selectPaymentMethod(this)">
            <p class="font-bold mb-1" style="color:#1a1a1a">BPI transfer</p>
            <p class="text-xs" style="color:#6b7280">5739059781<br>Nico Lanugon</p>
          </button>
        </div>

        <div id="payment-qr-gcash" class="payment-qr">
          <img src="https://admin.limasawabooking.com/wp-content/uploads/2026/05/gcash-number.webp" alt="GCash QR for Nico Lanugon" />
        </div>
        <div id="payment-qr-maya" class="payment-qr">
          <img src="https://admin.limasawabooking.com/wp-content/uploads/2026/05/maya-number.webp" alt="Maya QR for Nico Lanugon" />
        </div>
        <div id="payment-qr-bank_transfer" class="payment-qr">
          <img src="https://admin.limasawabooking.com/wp-content/uploads/2026/05/bpi-number.webp" alt="BPI InstaPay QR for Nico Lanugon" />
          <div class="rounded-lg p-3 mt-3 text-xs" style="background:#f9fafb;color:#374151;border:1px solid #e5e7eb">
            <div class="flex justify-between gap-4"><span>Account name</span><strong>Nico Lanugon</strong></div>
            <div class="flex justify-between gap-4 mt-1"><span>Account number</span><strong>5739059781</strong></div>
            <p class="mt-1.5" style="color:#6b7280">Scan via InstaPay, or transfer manually using the details above.</p>
          </div>
        </div>

        <!-- Coupon code — shown when payment is required -->
        <div id="payment-coupon-wrap" class="mt-5" style="max-width:360px;">
          <label class="text-xs font-semibold uppercase tracking-wide block mb-1" style="color:#9ca3af">
            Coupon code <span style="font-weight:400;text-transform:none;font-size:.75rem;">(optional)</span>
          </label>
          <div class="flex gap-2">
            <input id="input-paymentCoupon" class="form-input" type="text" placeholder="e.g. WELCOME20"
              autocomplete="off" style="flex:1;text-transform:uppercase;" oninput="onCouponInput()" />
            <button type="button" id="btn-coupon-apply" class="ok-btn" style="padding:.55rem 1rem;font-size:.85rem"
              onclick="applyListingCoupon()">Apply</button>
            <button type="button" id="btn-coupon-clear" class="skip-link" style="display:none;padding:.55rem .5rem;font-size:.85rem"
              onclick="clearListingCoupon()">Clear</button>
          </div>
          <p id="payment-coupon-status" class="text-xs mt-1.5" style="min-height:1em"></p>
        </div>

        <!-- Reference number — shown after method is selected -->
        <div id="payment-reference-wrap" style="display:none;" class="mt-5">
          <label class="text-xs font-semibold uppercase tracking-wide block mb-1" style="color:#9ca3af">
            Reference / transaction number <span style="font-weight:400;text-transform:none;font-size:.75rem;">(optional but helps us verify faster)</span>
          </label>
          <input id="input-paymentReference" class="form-input" type="text" placeholder="e.g. 2024123456789"
            style="max-width:360px;"
            oninput="data.paymentReference = this.value.trim()" />
        </div>

        <div class="mt-5">
          <label class="text-xs font-semibold uppercase tracking-wide block mb-2" style="color:#9ca3af">Upload payment receipt</label>
          <div class="drop-zone" id="payment-receipt-drop" onclick="document.getElementById('payment-receipt-input').click()">
            <input type="file" id="payment-receipt-input" accept="image/jpeg,image/png,image/webp" onchange="onPaymentReceiptSelect(this.files)" onclick="event.stopPropagation()" />
            <div id="payment-receipt-empty">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2" style="color:#9ca3af"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <p class="text-sm font-medium" style="color:#6b7280">Click to upload receipt screenshot</p>
              <p class="text-xs mt-1" style="color:#9ca3af">JPG, PNG or WebP · Max 8 MB</p>
            </div>
            <div id="payment-receipt-preview" class="hidden">
              <img id="payment-receipt-img" src="" alt="Payment receipt preview" style="max-height:170px;object-fit:contain;margin:0 auto;border-radius:10px;" />
              <p id="payment-receipt-name" class="text-xs mt-2" style="color:#9ca3af"></p>
            </div>
            <div id="payment-receipt-uploading" class="hidden py-4">
              <div class="upload-spinner mx-auto"></div>
              <p class="text-xs mt-2" style="color:#9ca3af">Uploading…</p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4 mt-6">
          <button id="payment-next" class="ok-btn" disabled onclick="confirmPayment()">
            Continue <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <span id="payment-help" class="text-xs" style="color:#9ca3af">Select a method and upload receipt.</span>
        </div>
      </div>
    </div>

    <!-- ── 19: Review ── -->
    <div class="step" data-step="review">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Review</span>
        </div>
        <h2 class="text-2xl font-bold mb-1" style="color:#1a1a1a">Almost there — review your listing</h2>
        <p class="text-sm mb-5" style="color:#9ca3af">Everything look good? Submit and we&rsquo;ll review within 24 hours.</p>
        <div id="review-content" class="rounded-xl p-4 mb-5 overflow-y-auto" style="background:white;max-height:40vh;border:1px solid #e5e7eb"></div>
        <div class="flex gap-3">
          <button id="submit-btn" class="ok-btn flex-1 justify-center py-3.5" onclick="submitListing()">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Submit listing
          </button>
        </div>
        <p class="text-xs mt-3" style="color:#9ca3af">Your listing will be reviewed before going live. We may contact you on WhatsApp.</p>
      </div>
    </div>

    <!-- ── 20: Success ── -->
    <div class="step" data-step="success">
      <div class="text-center max-w-md">
        <div class="mb-5 flex justify-center">
          <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background:var(--primary-light)">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <h2 class="text-3xl font-bold mb-2" style="color:#1a1a1a">Listing submitted!</h2>
        <p class="text-base mb-8" style="color:#6b7280">Your listing is now pending review. We&rsquo;ll reach out on WhatsApp within 24 hours once it&rsquo;s approved and live.</p>
        <a href="/" class="ok-btn inline-flex">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          Back to listings
        </a>
      </div>
    </div>

  </div><!-- /steps-wrapper -->
</div><!-- /app -->

<script define:vars={{ MUNICIPALITIES, categories, allAmenityTerms, GOOGLE_MAPS_KEY, WP_REST }}>
  // ── FAQ amenities (maps ACF sub-field key → display label) ─────────────
  const FAQ_AMENITIES = [
    { key: 'faq_wifi',                                    label: 'WiFi'                    },
    { key: 'faq_air_conditioning',                        label: 'Air conditioning'         },
    { key: 'faq_kitchen',                                 label: 'Kitchen'                 },
    { key: 'faq_free_parking_on_premises',                label: 'Free parking'            },
    { key: 'faq_beach_access',                            label: 'Beach access'            },
    { key: 'faq_pets_allowed',                            label: 'Pets allowed'            },
    { key: 'faq_dedicated_workspace',                     label: 'Dedicated workspace'     },
    { key: 'faq_generator',                               label: 'Generator'               },
    { key: 'faq_hot_cold_shower',                         label: 'Hot & cold shower'       },
    { key: 'faq_exterior_security_cameras_on_property',   label: 'Security cameras'        },
  ]

  // ── State ──────────────────────────────────────────────────────────────
  const TIER_ORDER = ['free','pro','featured']
  const TIER_LABELS = { free:'Island Listing', pro:'Pro Host', featured:'Featured Stay' }
  const BILLING_LABELS = { monthly:'Monthly', yearly:'Yearly' }
  // Yearly = 10× monthly (2 months free).
  const TIER_PRICES = {
    free:     { monthly: 0 },
    pro:      { monthly: 399, yearly: 3990 },
    featured: { monthly: 999, yearly: 9990 },
  }

  // Build a quick lookup: municipalityId → barangay list
  const BARANGAYS_BY_MUNI = {}
  MUNICIPALITIES.forEach(m => { BARANGAYS_BY_MUNI[m.id] = m.barangays })

  const data = {
    tier:'', hostName:'', hostPhone:'', propertyName:'',
    billingPeriod: 'monthly',
    paymentAmount: 0, paymentCurrency: 'PHP',
    paymentStatus: 'not_required', paymentProvider: 'manual', paymentMethod: '',
    paymentReference: '', paymentReceiptId: 0, paymentReceiptUrl: '',
    couponCode: '', couponDiscount: 0, couponNewTotal: 0,
    accommodationCategory:'', placeType:'',
    municipalityId: 0, municipalityName: '',
    barangayId: 0, barangayName: '',
    guests:1, bedrooms:0, beds:0, bathrooms:0,
    dailyRate:'', monthlyRate:'', description:'',
    pricingMode:'flat',           // 'flat' | 'rooms' | 'per_pax'
    roomTypes:[],                 // [{ name, capacity, rate, note }]
    additionalBedRate:'',
    perPax:{ baseRate:'', basePax:'', extraPerPax:'', maxPax:'' },
    bookingLink:'', airbnbLink:'', bookingComLink:'',
    websiteLink:'', facebookLink:'', instagramLink:'',
    addServices: false,
    services: [],       // [{ name, description }]
    faqAmenities: {},   // { faq_wifi: true, faq_kitchen: true, … }
    extraAmenities: [], // free-text / taxonomy additions
    hostPhotoId: 0, hostPhotoUrl: '',
    galleryIds: [], galleryUrls: [],
    address1: '',
    mapLocation: { lat: null, lng: null, address: '' },
    longDescription: '',
    hasGenerator: null,   // true | false | null (unanswered)
    generatorSchedule: '',
  }

  // Photo limits per tier
  const PHOTO_LIMITS = { free: 5, local: 15, prime: Infinity, featured: Infinity }

  // All step IDs in order
  const ALL_STEPS = [
    'welcome','tier','billing','hostName','hostPhone','hostPhoto','propertyName',
    'accommodationCategory','placeType','municipality','barangay','mapLocation',
    'guests','capacity','pricingMode','dailyRate','monthlyRate','roomTypes','perPax',
    'description','longDescription',
    'bookingLink','airbnbLink','bookingComLink','socialLinks','services',
    'amenities','generator','gallery','payment','review','success',
  ]
  // Steps that require local+ tier
  const TIER_MIN = { airbnbLink:'pro', bookingComLink:'pro', socialLinks:'pro', services:'pro' }

  let stepIndex = 0  // index into ALL_STEPS

  // ── Helpers ────────────────────────────────────────────────────────────
  function currentStepId() { return ALL_STEPS[stepIndex] }

  function visibleSteps() {
    const tierIdx = TIER_ORDER.indexOf(data.tier)
    return ALL_STEPS.filter(id => {
      // Edit mode: skip welcome, tier, billing, payment, success steps
      if (data._editMode) {
        if (['welcome','tier','billing','payment','success'].includes(id)) return false
      }
      if ((id === 'billing' || id === 'payment') && data.tier === 'free') return false
      // Pricing-mode gating: only show the rate steps matching the chosen mode.
      const mode = data.pricingMode || 'flat'
      if ((id === 'dailyRate' || id === 'monthlyRate') && mode !== 'flat') return false
      if (id === 'roomTypes' && mode !== 'rooms') return false
      if (id === 'perPax' && mode !== 'per_pax') return false
      const min = TIER_MIN[id]
      if (!min) return true
      return tierIdx >= TIER_ORDER.indexOf(min)
    })
  }

  // Computable steps for progress (excluding welcome + success)
  function progressSteps() {
    return visibleSteps().filter(id => id !== 'welcome' && id !== 'success')
  }

  function updateProgress() {
    const steps = progressSteps()
    const idx = steps.indexOf(currentStepId())
    if (idx < 0) { document.getElementById('progress-fill').style.width = '0%'; return }
    const pct = Math.round(((idx + 1) / steps.length) * 100)
    document.getElementById('progress-fill').style.width = pct + '%'
    // In edit mode, hide step counter (the section dropdown shows where you are)
    if (data._editMode) {
      document.getElementById('step-counter').textContent = ''
      // Sync the dropdown's selected option to the current step
      const sel = document.getElementById('edit-jump-select')
      if (sel) sel.value = currentStepId()
      return
    }
    document.getElementById('step-counter').textContent =
      currentStepId() === 'review' ? 'Review' : `${idx + 1} / ${steps.length}`
  }

  function showBackBtn(show) {
    const btn = document.getElementById('back-btn')
    btn.style.opacity = show ? '1' : '0'
    btn.style.pointerEvents = show ? 'auto' : 'none'
  }

  // ── Navigation ─────────────────────────────────────────────────────────
  function goToStep(id) {
    const toEl = document.querySelector(`[data-step="${id}"]`)
    if (!toEl) return
    // Deactivate ALL currently active steps
    document.querySelectorAll('.step.active').forEach(el => {
      el.classList.add('exiting')
      el.classList.remove('active')
    })
    setTimeout(() => {
      document.querySelectorAll('.step.exiting').forEach(el => el.classList.remove('exiting'))
      toEl.classList.add('active')
      const inp = toEl.querySelector('input,textarea')
      if (inp) setTimeout(() => inp.focus(), 60)
    }, 270)
    stepIndex = ALL_STEPS.indexOf(id)
    updateProgress()
    showBackBtn(id !== 'welcome' && id !== 'success')
    // Multi-listing discount check when reaching tier step
    if (id === 'tier') checkMultiListingDiscount()
    if (id === 'billing') renderBillingOptions()
    if (id === 'payment') renderPaymentStep()
    if (id === 'roomTypes') ensureRoomTypesUI()
    if (id === 'perPax') hydratePerPaxUI()
    if (id === 'pricingMode') {
      document.querySelectorAll('[data-step="pricingMode"] .choice-chip').forEach(c =>
        c.classList.toggle('selected', c.dataset.value === (data.pricingMode || 'flat')))
    }
  }

  function nextStep() {
    const vis = visibleSteps()
    const cur = currentStepId()
    const idx = vis.indexOf(cur)
    if (idx < vis.length - 1) goToStep(vis[idx + 1])
  }

  function prevStep() {
    const vis = visibleSteps()
    const cur = currentStepId()
    const idx = vis.indexOf(cur)
    if (idx > 0) goToStep(vis[idx - 1])
  }

  function skipStep() { nextStep() }

  // ── Input helpers ──────────────────────────────────────────────────────
  function advanceText(field, optional = false) {
    const el = document.getElementById('input-' + field)
    const val = el ? el.value.trim() : ''
    if (!optional && !val) { el && el.focus(); shakeInput(el); return }
    data[field] = val
    nextStep()
  }

  function shakeInput(el) {
    if (!el) return
    el.style.borderColor = '#ef4444'
    el.classList.add('shake')
    setTimeout(() => { el.style.borderColor = ''; el.classList.remove('shake') }, 600)
  }

  function selectTier(card) {
    document.querySelectorAll('.tier-card').forEach(c => c.classList.remove('selected'))
    card.classList.add('selected')
    data.tier = card.dataset.tier
    data.billingPeriod = data.tier === 'free' ? 'monthly' : (data.billingPeriod || 'monthly')
    updatePaymentAmount()
    document.getElementById('tier-next').disabled = false
  }

  function formatPeso(amount) {
    return `₱${Number(amount || 0).toLocaleString()}`
  }

  // Pre-coupon price (base + multi-listing 50% if applicable). The coupon is
  // applied on top of this in finalPrice() below.
  function basePrice(tier, period) {
    const base = TIER_PRICES[tier]?.[period] ?? 0
    return data._multiListingDiscount && base > 0 ? Math.floor(base * 0.5) : base
  }

  // Final price after coupon. Used for display and submit.
  function effectivePrice(tier, period) {
    const base = basePrice(tier, period)
    if (data.couponCode && data.couponNewTotal > 0 && base > 0) {
      return Math.max(0, Math.floor(data.couponNewTotal))
    }
    return base
  }

  function updatePaymentAmount() {
    data.paymentAmount = effectivePrice(data.tier, data.billingPeriod)
    data.paymentStatus = data.paymentAmount > 0 ? 'pending_verification' : 'not_required'
    data.paymentCurrency = 'PHP'
    data.paymentProvider = data.paymentAmount > 0 ? 'manual' : ''
    // Live-update the review summary if rendered
    const summary = document.getElementById('payment-summary')
    if (summary) summary.textContent = `${formatPeso(data.paymentAmount)} · ${TIER_LABELS[data.tier]} · ${BILLING_LABELS[data.billingPeriod]}`
  }

  // Coupon: live-validate against /coupon/validate
  function onCouponInput() {
    // Typing invalidates any previously-applied coupon
    const status = document.getElementById('payment-coupon-status')
    if (data.couponCode) {
      data.couponCode = ''
      data.couponDiscount = 0
      data.couponNewTotal = 0
      updatePaymentAmount()
    }
    const clearBtn = document.getElementById('btn-coupon-clear')
    if (clearBtn) clearBtn.style.display = 'none'
    const input = document.getElementById('input-paymentCoupon')
    if (input) input.disabled = false
    if (status) { status.textContent = ''; status.style.color = '' }
  }

  async function applyListingCoupon() {
    const input = document.getElementById('input-paymentCoupon')
    const status = document.getElementById('payment-coupon-status')
    const clearBtn = document.getElementById('btn-coupon-clear')
    const code = (input?.value || '').trim()
    if (!code) {
      status.textContent = 'Enter a coupon code first.'
      status.style.color = '#dc2626'
      return
    }
    const base = basePrice(data.tier, data.billingPeriod)
    if (base <= 0) {
      status.textContent = 'Pick a paid plan first.'
      status.style.color = '#dc2626'
      return
    }
    try {
      const url = `${WP_REST}/coupon/validate?code=${encodeURIComponent(code)}&tier=${encodeURIComponent(data.tier)}&billing=${encodeURIComponent(data.billingPeriod)}&amount=${encodeURIComponent(base)}`
      const res = await fetch(url)
      const result = await res.json()
      if (!result || !result.valid) {
        data.couponCode = ''; data.couponDiscount = 0; data.couponNewTotal = 0
        status.textContent = (result && result.message) || 'Coupon could not be applied.'
        status.style.color = '#dc2626'
        if (clearBtn) clearBtn.style.display = 'none'
        if (input) input.disabled = false
      } else {
        data.couponCode     = result.code
        data.couponDiscount = result.discount
        data.couponNewTotal = result.new_total
        const off = result.type === 'percentage' ? `${result.value}% off` : `₱${Number(result.value).toLocaleString()} off`
        status.textContent = `${result.code} applied — ${off}, you save ₱${Number(result.discount).toLocaleString()}.`
        status.style.color = '#15803D'
        if (clearBtn) clearBtn.style.display = ''
        if (input) input.disabled = true
      }
      updatePaymentAmount()
    } catch (e) {
      status.textContent = 'Network error. Please try again.'
      status.style.color = '#dc2626'
    }
  }
  function clearListingCoupon() {
    data.couponCode = ''; data.couponDiscount = 0; data.couponNewTotal = 0
    const input = document.getElementById('input-paymentCoupon')
    const status = document.getElementById('payment-coupon-status')
    const clearBtn = document.getElementById('btn-coupon-clear')
    if (input) { input.disabled = false; input.value = '' }
    if (status) { status.textContent = ''; status.style.color = '' }
    if (clearBtn) clearBtn.style.display = 'none'
    updatePaymentAmount()
  }

  function renderBillingOptions() {
    updatePaymentAmount()
    const wrap = document.getElementById('billing-options')
    const next = document.getElementById('billing-next')
    const sub = document.getElementById('billing-subtext')
    if (!wrap || data.tier === 'free') return
    const options = [
      { key: 'monthly', note: 'Pay month to month' },
      { key: 'yearly',  note: 'Save 2 months' },
    ]
    sub.textContent = `${TIER_LABELS[data.tier]} billing. Additional listings get 50% off.`
    wrap.innerHTML = options.map(({ key, note }) => {
      const base  = TIER_PRICES[data.tier][key]
      const price = effectivePrice(data.tier, key)
      const multiListing = data._multiListingDiscount && base > 0
      const strike = multiListing
        ? `<span style="text-decoration:line-through;opacity:.5;font-size:.75em;display:block;color:#9ca3af">${formatPeso(base)}</span>`
        : ''
      const badge = multiListing
        ? `<span class="text-xs" style="color:#15803D">50% off (additional listing)</span>`
        : ''
      return `<button type="button" class="billing-card text-left ${data.billingPeriod === key ? 'selected' : ''}" data-period="${key}" onclick="selectBillingPeriod(this)">
        <span class="text-sm font-bold block" style="color:#1a1a1a">${BILLING_LABELS[key]}</span>
        ${strike}
        <span class="text-2xl font-extrabold block mt-1" style="color:#1a1a1a">${formatPeso(price)}</span>
        <span class="text-xs block mt-1" style="color:#6b7280">${note}</span>
        ${badge}
      </button>`
    }).join('')
    next.disabled = !data.billingPeriod
  }

  function selectBillingPeriod(card) {
    document.querySelectorAll('.billing-card').forEach(c => c.classList.remove('selected'))
    card.classList.add('selected')
    data.billingPeriod = card.dataset.period
    updatePaymentAmount()
    document.getElementById('billing-next').disabled = false
  }

  function selectChoice(chip, field, autoAdvance = false) {
    // Deselect siblings in same step
    chip.closest('.step').querySelectorAll('.choice-chip').forEach(c => c.classList.remove('selected'))
    chip.classList.add('selected')
    data[field] = chip.dataset.value
    if (autoAdvance) setTimeout(() => nextStep(), 220)
  }

  function adjustCounter(field, delta) {
    const min = field === 'guests' ? 1 : 0
    const max = 50
    data[field] = Math.max(min, Math.min(max, (data[field] || 0) + delta))
    const el = document.getElementById('val-' + field)
    if (el) el.textContent = data[field]
  }

  // ── Room-types repeater ──────────────────────────────────────────────────
  function roomRowHTML() {
    return `<div class="rt-row" style="border:1px solid #e5e7eb;border-radius:12px;padding:14px">
      <div class="flex items-center gap-2">
        <input class="form-input rt-name" placeholder="Room name (e.g. Barkada Room)" />
        <button type="button" title="Remove" onclick="removeRoomType(this)" style="flex:0 0 auto;width:34px;height:34px;border-radius:9px;border:1px solid #e5e7eb;background:#fff;color:#9ca3af;cursor:pointer;font-size:18px;line-height:1">&times;</button>
      </div>
      <div class="grid grid-cols-2 gap-2 mt-2">
        <input class="form-input rt-capacity" type="number" min="0" placeholder="Good for (pax)" />
        <div class="flex items-center gap-1"><span style="color:#9ca3af">&#8369;</span><input class="form-input rt-rate" type="number" min="0" placeholder="Rate / night" /></div>
      </div>
      <input class="form-input rt-note mt-2" placeholder="Short note (optional)" />
    </div>`
  }
  function addRoomType(prefill) {
    const list = document.getElementById('room-types-list')
    if (!list) return
    const wrap = document.createElement('div')
    wrap.innerHTML = roomRowHTML()
    const row = wrap.firstElementChild
    list.appendChild(row)
    if (prefill) {
      row.querySelector('.rt-name').value     = prefill.name || ''
      row.querySelector('.rt-capacity').value = prefill.capacity || ''
      row.querySelector('.rt-rate').value     = prefill.rate || ''
      row.querySelector('.rt-note').value     = prefill.note || ''
    }
  }
  function removeRoomType(btn) {
    const list = document.getElementById('room-types-list')
    const row  = btn.closest('.rt-row')
    if (!row || !list) return
    if (list.querySelectorAll('.rt-row').length > 1) row.remove()
    else row.querySelectorAll('input').forEach(i => { i.value = '' })  // keep ≥1 row
  }
  function ensureRoomTypesUI() {
    const list = document.getElementById('room-types-list')
    if (!list) return
    list.innerHTML = ''
    if (Array.isArray(data.roomTypes) && data.roomTypes.length) data.roomTypes.forEach(rt => addRoomType(rt))
    else addRoomType()
    const bed = document.getElementById('input-additionalBedRate')
    if (bed) bed.value = data.additionalBedRate || ''
  }
  function readRoomTypes() {
    return Array.from(document.querySelectorAll('#room-types-list .rt-row')).map(r => ({
      name:     r.querySelector('.rt-name').value.trim(),
      capacity: parseInt(r.querySelector('.rt-capacity').value, 10) || 0,
      rate:     parseFloat(r.querySelector('.rt-rate').value) || 0,
      note:     r.querySelector('.rt-note').value.trim(),
    })).filter(rt => rt.name || rt.rate)
  }
  function confirmRoomTypes() {
    const rooms = readRoomTypes()
    if (!rooms.length || !rooms.some(r => r.rate > 0)) {
      const first = document.querySelector('#room-types-list .rt-rate')
      shakeInput(first); if (first) first.focus(); return
    }
    data.roomTypes = rooms
    data.additionalBedRate = (document.getElementById('input-additionalBedRate')?.value || '').trim()
    nextStep()
  }

  // ── Per-pax tiered rate ──────────────────────────────────────────────────
  function ppVal(id, int) {
    const v = document.getElementById('input-pp-' + id)?.value
    return int ? (parseInt(v, 10) || 0) : (parseFloat(v) || 0)
  }
  function hydratePerPaxUI() {
    const p = data.perPax || {}
    const set = (id, v) => { const el = document.getElementById('input-pp-' + id); if (el) el.value = v || '' }
    set('baseRate', p.baseRate); set('basePax', p.basePax); set('extraPerPax', p.extraPerPax); set('maxPax', p.maxPax)
    updatePerPaxPreview()
  }
  function updatePerPaxPreview() {
    const el = document.getElementById('pp-preview')
    if (!el) return
    const base = ppVal('baseRate'), basePax = ppVal('basePax', true), extra = ppVal('extraPerPax'), max = ppVal('maxPax', true)
    if (!base) { el.textContent = ''; return }
    let s = `₱${base.toLocaleString()} / night for up to ${basePax || '?'} pax`
    if (extra) s += `, then +₱${extra.toLocaleString()} per extra guest`
    if (max) s += ` (max ${max} pax)`
    el.textContent = s + '.'
  }
  function confirmPerPax() {
    const base = ppVal('baseRate'), basePax = ppVal('basePax', true)
    if (!base)    { const el = document.getElementById('input-pp-baseRate'); shakeInput(el); if (el) el.focus(); return }
    if (!basePax) { const el = document.getElementById('input-pp-basePax');  shakeInput(el); if (el) el.focus(); return }
    data.perPax = { baseRate: base, basePax, extraPerPax: ppVal('extraPerPax'), maxPax: ppVal('maxPax', true) }
    nextStep()
  }

  // ── Media upload ───────────────────────────────────────────────────────

  const UPLOAD_URL = `${WP_REST}/upload-media`

  // folder_id is shared across all uploads in this session
  // so all images for the same listing land in the same HappyFiles folder
  let _sessionFolderId = 0

  async function uploadMedia(file, imageType = 'gallery') {
    const fd = new FormData()
    fd.append('file', file)
    if (data.propertyName) fd.append('property_name', data.propertyName)
    fd.append('image_type', imageType)
    if (_sessionFolderId) fd.append('folder_id', String(_sessionFolderId))
    const res = await fetch(UPLOAD_URL, { method: 'POST', body: fd })
    const json = await res.json()
    if (!json.success) throw new Error(json.message || 'Upload failed')
    // Store folder_id for subsequent uploads in this session
    if (json.folder_id) _sessionFolderId = json.folder_id
    return { id: json.attachment_id, url: json.url }
  }

  // ── Host photo ─────────────────────────────────────────────────────────

  async function onHostPhotoSelect(files) {
    const file = files[0]
    if (!file) return
    if (file.size > 8 * 1024 * 1024) { alert('Max file size is 8 MB'); return }

    // Show local preview immediately
    const reader = new FileReader()
    reader.onload = e => {
      document.getElementById('host-photo-img').src = e.target.result
      document.getElementById('host-photo-name').textContent = file.name
      document.getElementById('host-photo-empty').classList.add('hidden')
      document.getElementById('host-photo-preview').classList.add('hidden')
      document.getElementById('host-photo-uploading').classList.remove('hidden')
      document.getElementById('host-photo-drop').classList.add('has-media')
    }
    reader.readAsDataURL(file)

    try {
      const { id, url } = await uploadMedia(file, 'host_photo')
      data.hostPhotoId  = id
      data.hostPhotoUrl = url
      document.getElementById('host-photo-uploading').classList.add('hidden')
      document.getElementById('host-photo-preview').classList.remove('hidden')
    } catch (err) {
      alert('Upload failed: ' + err.message)
      document.getElementById('host-photo-uploading').classList.add('hidden')
      document.getElementById('host-photo-empty').classList.remove('hidden')
      document.getElementById('host-photo-drop').classList.remove('has-media')
      data.hostPhotoId = 0
    }
  }

  function confirmHostPhoto() { nextStep() }

  // ── Payment receipt ───────────────────────────────────────────────────
  function renderPaymentStep() {
    updatePaymentAmount()
    const summary = document.getElementById('payment-summary')
    const note = document.getElementById('payment-discount-note')
    if (summary) summary.textContent = `${formatPeso(data.paymentAmount)} · ${TIER_LABELS[data.tier]} · ${BILLING_LABELS[data.billingPeriod]}`
    if (note) note.textContent = data._multiListingDiscount ? '50% succeeding-listing discount applied.' : ''
    validatePaymentStep()
  }

  function selectPaymentMethod(card) {
    document.querySelectorAll('.payment-method-card').forEach(c => c.classList.remove('selected'))
    document.querySelectorAll('.payment-qr').forEach(c => c.classList.remove('active'))
    card.classList.add('selected')
    data.paymentMethod = card.dataset.method
    const qr = document.getElementById(`payment-qr-${data.paymentMethod}`)
    if (qr) qr.classList.add('active')
    // Show reference number field
    const refWrap = document.getElementById('payment-reference-wrap')
    if (refWrap) refWrap.style.display = 'block'
    validatePaymentStep()
  }

  function validatePaymentStep() {
    const btn = document.getElementById('payment-next')
    const help = document.getElementById('payment-help')
    if (!btn) return
    const ready = data.paymentAmount <= 0 || (data.paymentMethod && data.paymentReceiptId)
    btn.disabled = !ready
    if (help) {
      help.textContent = ready
        ? 'Receipt uploaded. Continue to review.'
        : 'Select a payment method and upload your receipt.'
    }
  }

  async function onPaymentReceiptSelect(files) {
    const file = files[0]
    if (!file) return
    if (file.size > 8 * 1024 * 1024) { alert('Max file size is 8 MB'); return }

    const reader = new FileReader()
    reader.onload = e => {
      document.getElementById('payment-receipt-img').src = e.target.result
      document.getElementById('payment-receipt-name').textContent = file.name
      document.getElementById('payment-receipt-empty').classList.add('hidden')
      document.getElementById('payment-receipt-preview').classList.add('hidden')
      document.getElementById('payment-receipt-uploading').classList.remove('hidden')
      document.getElementById('payment-receipt-drop').classList.add('has-media')
    }
    reader.readAsDataURL(file)

    try {
      const { id, url } = await uploadMedia(file, 'payment_receipt')
      data.paymentReceiptId = id
      data.paymentReceiptUrl = url
      document.getElementById('payment-receipt-uploading').classList.add('hidden')
      document.getElementById('payment-receipt-preview').classList.remove('hidden')
      validatePaymentStep()
    } catch (err) {
      alert('Receipt upload failed: ' + err.message)
      document.getElementById('payment-receipt-uploading').classList.add('hidden')
      document.getElementById('payment-receipt-empty').classList.remove('hidden')
      document.getElementById('payment-receipt-drop').classList.remove('has-media')
      data.paymentReceiptId = 0
      data.paymentReceiptUrl = ''
      validatePaymentStep()
    }
  }

  function confirmPayment() {
    if (data.paymentAmount > 0 && (!data.paymentMethod || !data.paymentReceiptId)) {
      alert('Please select a payment method and upload your receipt.')
      return
    }
    nextStep()
  }

  // ── Gallery ────────────────────────────────────────────────────────────

  function galleryLimit() {
    const l = PHOTO_LIMITS[data.tier] ?? 5
    return l === Infinity ? Infinity : l
  }

  function updateGalleryUI() {
    const limit  = galleryLimit()
    const count  = data.galleryIds.length
    const badge  = document.getElementById('gallery-limit-badge')
    const cntEl  = document.getElementById('gallery-count')
    const dropEl = document.getElementById('gallery-drop')

    if (badge) {
      badge.textContent = limit === Infinity
        ? 'Unlimited photos'
        : `Up to ${limit} photo${limit !== 1 ? 's' : ''} on your plan`
    }
    if (cntEl) cntEl.textContent = count ? `${count} photo${count !== 1 ? 's' : ''} added` : ''
    if (dropEl) {
      dropEl.style.display = (limit !== Infinity && count >= limit) ? 'none' : ''
    }
  }

  function renderGalleryThumb(url, idx, uploading = false) {
    const grid = document.getElementById('gallery-grid')
    const div  = document.createElement('div')
    div.className = 'gallery-thumb' + (uploading ? ' gallery-thumb-uploading' : '')
    div.id = 'gallery-thumb-' + idx
    if (uploading) {
      div.innerHTML = '<div class="upload-spinner"></div>'
    } else {
      div.innerHTML = `<img src="${url}" alt="Photo ${idx + 1}" loading="lazy" />`
        + `<button type="button" class="gallery-thumb-remove" onclick="removeGalleryPhoto(${idx})" aria-label="Remove">`
        + `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`
        + `</button>`
    }
    grid.appendChild(div)
  }

  function rebuildGalleryGrid() {
    const grid = document.getElementById('gallery-grid')
    if (!grid) return
    grid.innerHTML = ''
    data.galleryUrls.forEach((url, i) => renderGalleryThumb(url, i))
    updateGalleryUI()
  }

  async function processGalleryFiles(files) {
    const limit  = galleryLimit()
    const slots  = limit === Infinity ? files.length : Math.min(files.length, limit - data.galleryIds.length)
    if (slots <= 0) return

    for (let i = 0; i < slots; i++) {
      const file = files[i]
      if (!file || file.size > 8 * 1024 * 1024) continue

      // Temp index for this upload
      const idx = data.galleryIds.length
      data.galleryIds.push(null)   // placeholder
      data.galleryUrls.push(null)

      // Show local preview + spinner while uploading
      const reader = new FileReader()
      reader.onload = e => {
        const thumb = document.getElementById('gallery-thumb-' + idx)
        if (thumb) {
          thumb.classList.remove('gallery-thumb-uploading')
          thumb.innerHTML = `<img src="${e.target.result}" alt="" loading="lazy" />`
            + `<button type="button" class="gallery-thumb-remove" onclick="removeGalleryPhoto(${idx})" aria-label="Remove">`
            + `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>`
        }
      }
      reader.readAsDataURL(file)
      renderGalleryThumb('', idx, true)

      try {
        const { id, url } = await uploadMedia(file)
        data.galleryIds[idx]  = id
        data.galleryUrls[idx] = url
      } catch (err) {
        // Remove placeholder on failure
        data.galleryIds.splice(idx, 1)
        data.galleryUrls.splice(idx, 1)
        const thumb = document.getElementById('gallery-thumb-' + idx)
        if (thumb) thumb.remove()
        rebuildGalleryGrid()
      }
      updateGalleryUI()
    }
  }

  function onGallerySelect(files) { processGalleryFiles(Array.from(files)) }
  function onGalleryDrop(e) {
    e.preventDefault()
    e.currentTarget.classList.remove('drag-over')
    processGalleryFiles(Array.from(e.dataTransfer.files))
  }

  function removeGalleryPhoto(idx) {
    data.galleryIds.splice(idx, 1)
    data.galleryUrls.splice(idx, 1)
    rebuildGalleryGrid()
  }

  // Initialise gallery step UI when it becomes active
  const galleryObs = new MutationObserver(() => {
    if (document.querySelector('[data-step="gallery"].active')) updateGalleryUI()
  })

  // ── Municipality + Barangay ────────────────────────────────────────────

  function selectMunicipality(chip) {
    chip.closest('.step').querySelectorAll('.choice-chip').forEach(c => c.classList.remove('selected'))
    chip.classList.add('selected')
    data.municipalityId   = Number(chip.dataset.locId)
    data.municipalityName = chip.dataset.value
    // Reset any previously chosen barangay when municipality changes
    data.barangayId   = 0
    data.barangayName = ''
    setTimeout(() => {
      goToStep('barangay')
      // Update subtext and reset search box after step transition
      setTimeout(() => {
        const sub = document.getElementById('barangay-subtext')
        if (sub) sub.textContent = `Search or pick a barangay in ${data.municipalityName}.`
        resetBarangayUI()
      }, 300)
    }, 220)
  }

  function resetBarangayUI() {
    const inp = document.getElementById('barangay-search')
    if (inp) inp.value = ''
    const box = document.getElementById('barangay-search-box')
    if (box) box.style.borderColor = '#e5e7eb'
    const drop = document.getElementById('barangay-dropdown')
    if (drop) { drop.innerHTML = ''; drop.classList.add('hidden') }
    const sel = document.getElementById('barangay-selected')
    if (sel) sel.classList.add('hidden')
    const clear = document.getElementById('barangay-clear')
    if (clear) clear.classList.add('hidden')
  }

  function onBarangaySearch(query) {
    const drop = document.getElementById('barangay-dropdown')
    const box  = document.getElementById('barangay-search-box')
    const barangays = BARANGAYS_BY_MUNI[data.municipalityId] || []

    if (!query.trim()) {
      drop.classList.add('hidden')
      box.style.borderColor = '#e5e7eb'
      // Clear selection if user blanks out the field
      data.barangayId   = 0
      data.barangayName = ''
      const sel = document.getElementById('barangay-selected')
      if (sel) sel.classList.add('hidden')
      return
    }

    box.style.borderColor = 'var(--primary)'
    const q = query.trim().toLowerCase()
    const matches = barangays.filter(b => b.name.toLowerCase().includes(q))

    if (matches.length === 0) {
      drop.innerHTML = `<div class="px-4 py-3 text-sm" style="color:#9ca3af">No barangay found</div>`
      drop.classList.remove('hidden')
      return
    }

    drop.innerHTML = matches.map(b =>
      `<div class="px-4 py-2.5 text-sm cursor-pointer hover:bg-gray-50 transition-colors" style="color:#1a1a1a"
        onclick="pickBarangay(${b.id}, '${b.name.replace(/'/g, "\\'")}')">${b.name}</div>`
    ).join('')
    drop.classList.remove('hidden')
  }

  function onBarangayKeydown(e) {
    if (e.key === 'Escape') {
      document.getElementById('barangay-dropdown').classList.add('hidden')
    }
    if (e.key === 'Enter') {
      e.preventDefault()
      // Pick the first match if any
      const first = document.querySelector('#barangay-dropdown div[onclick]')
      if (first) first.click()
    }
  }

  function pickBarangay(id, name) {
    data.barangayId   = id
    data.barangayName = name

    // Update search input
    const inp = document.getElementById('barangay-search')
    if (inp) inp.value = name

    // Show selected indicator
    const sel  = document.getElementById('barangay-selected')
    const span = document.getElementById('barangay-selected-name')
    if (sel && span) { span.textContent = name; sel.classList.remove('hidden') }

    // Show clear button
    const clear = document.getElementById('barangay-clear')
    if (clear) clear.classList.remove('hidden')

    // Close dropdown
    const drop = document.getElementById('barangay-dropdown')
    if (drop) drop.classList.add('hidden')
    const box = document.getElementById('barangay-search-box')
    if (box) box.style.borderColor = 'var(--primary)'
  }

  function clearBarangay() {
    data.barangayId   = 0
    data.barangayName = ''
    const inp = document.getElementById('barangay-search')
    if (inp) { inp.value = ''; inp.focus() }
    const sel = document.getElementById('barangay-selected')
    if (sel) sel.classList.add('hidden')
    const clear = document.getElementById('barangay-clear')
    if (clear) clear.classList.add('hidden')
    const box = document.getElementById('barangay-search-box')
    if (box) box.style.borderColor = '#e5e7eb'
  }

  function confirmBarangay() {
    // Barangay is optional — advance regardless
    nextStep()
  }

  function skipBarangay() {
    data.barangayId   = 0
    data.barangayName = ''
    nextStep()
  }

  // Close barangay dropdown when clicking outside
  document.addEventListener('click', e => {
    const box  = document.getElementById('barangay-search-box')
    const drop = document.getElementById('barangay-dropdown')
    if (box && drop && !box.contains(e.target) && !drop.contains(e.target)) {
      drop.classList.add('hidden')
    }
  })

  // ── Amenities ──────────────────────────────────────────────────────────

  function renderFaqPills() {
    const grid = document.getElementById('faq-amenities-grid')
    if (!grid || grid.children.length) return // already rendered
    grid.innerHTML = FAQ_AMENITIES.map(({ key, label }) => {
      const sel = data.faqAmenities[key] ? 'amenity-chip selected' : 'amenity-chip'
      return `<button type="button" class="${sel}" data-faq-key="${key}" onclick="toggleFaqAmenity('${key}')">${label}</button>`
    }).join('')
  }

  function toggleFaqAmenity(key) {
    data.faqAmenities[key] = !data.faqAmenities[key]
    const btn = document.querySelector(`[data-faq-key="${key}"]`)
    if (btn) btn.classList.toggle('selected', !!data.faqAmenities[key])
    updateAmenityCount()
  }

  function updateAmenityCount() {
    const faqCount = Object.values(data.faqAmenities).filter(Boolean).length
    const total = faqCount + data.extraAmenities.length
    const cnt = document.getElementById('amenity-count')
    if (cnt) cnt.textContent = total ? `${total} selected` : ''
  }

  // Search against allAmenityTerms
  function onAmenitySearch(query) {
    const dropdown = document.getElementById('amenity-dropdown')
    const box = document.getElementById('amenity-search-box')
    if (!query.trim()) {
      dropdown.classList.add('hidden')
      dropdown.innerHTML = ''
      box.style.borderColor = '#e5e7eb'
      return
    }
    box.style.borderColor = 'var(--primary)'
    const q = query.trim().toLowerCase()
    const matches = allAmenityTerms
      .filter(t => t.toLowerCase().includes(q))
      .filter(t => !data.extraAmenities.includes(t))
      .slice(0, 14)

    // Check if query is a novel entry (not in taxonomy)
    const exactMatch = allAmenityTerms.some(t => t.toLowerCase() === q)
    const alreadyAdded = data.extraAmenities.some(t => t.toLowerCase() === q)

    let html = matches.map(t =>
      `<div class="px-4 py-2.5 text-sm cursor-pointer hover:bg-gray-50 transition-colors" style="color:#1a1a1a" onclick="addAmenity('${t.replace(/'/g, "\\'")}')">${t}</div>`
    ).join('')

    if (!exactMatch && !alreadyAdded) {
      html += `<div class="px-4 py-2.5 text-sm cursor-pointer border-t flex items-center gap-2 hover:bg-gray-50" style="color:var(--primary);border-color:#e5e7eb" onclick="addAmenity('${query.trim().replace(/'/g, "\\'")}')">`
        + `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`
        + `Add &ldquo;${query.trim()}&rdquo;`
        + `</div>`
    }

    if (html) {
      dropdown.innerHTML = html
      dropdown.classList.remove('hidden')
    } else {
      dropdown.classList.add('hidden')
    }
  }

  function onAmenityKeydown(e) {
    if (e.key === 'Enter') {
      e.preventDefault()
      const val = e.target.value.trim()
      if (val) addAmenity(val)
    }
    if (e.key === 'Escape') {
      document.getElementById('amenity-dropdown').classList.add('hidden')
    }
  }

  function addAmenity(name) {
    const trimmed = name.trim()
    if (!trimmed || data.extraAmenities.includes(trimmed)) return
    data.extraAmenities.push(trimmed)

    // Render tag
    const container = document.getElementById('added-amenities')
    const tag = document.createElement('div')
    tag.className = 'amenity-chip selected flex items-center gap-1.5'
    tag.dataset.extra = trimmed
    tag.innerHTML = `${trimmed}<button type="button" onclick="removeAddedAmenity('${trimmed.replace(/'/g, "\\'")}')" style="line-height:1;color:inherit;opacity:0.7" aria-label="Remove">`
      + `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`
      + `</button>`
    container.appendChild(tag)

    // Clear search
    const input = document.getElementById('amenity-search')
    if (input) input.value = ''
    document.getElementById('amenity-dropdown').classList.add('hidden')
    document.getElementById('amenity-search-box').style.borderColor = '#e5e7eb'

    updateAmenityCount()
  }

  function removeAddedAmenity(name) {
    data.extraAmenities = data.extraAmenities.filter(a => a !== name)
    const container = document.getElementById('added-amenities')
    const tag = container.querySelector(`[data-extra="${name}"]`)
    if (tag) tag.remove()
    updateAmenityCount()
  }

  // ── Map / pin location ──────────────────────────────────────────────────

  let _map = null
  let _marker = null
  let _mapSearchTimer = null
  const LIMASAWA_CENTER = [9.9333, 125.0667]

  function initMap() {
    if (_map) return  // already initialised
    if (!window.L) return  // Leaflet not loaded yet

    _map = L.map('map-container').setView(LIMASAWA_CENTER, 13)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(_map)

    // Custom teal marker icon
    const icon = L.divIcon({
      className: '',
      html: `<div style="width:28px;height:28px;background:var(--primary);border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 6px rgba(0,0,0,0.3)"></div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 28],
    })

    _marker = L.marker(LIMASAWA_CENTER, { draggable: true, icon }).addTo(_map)

    _marker.on('dragend', () => {
      const pos = _marker.getLatLng()
      data.mapLocation.lat = pos.lat
      data.mapLocation.lng = pos.lng
      // DON'T override address text — user dragged the pin manually
      updateMapCoords()
      document.getElementById('map-container').classList.add('active-map')
    })

    _map.on('click', e => {
      _marker.setLatLng(e.latlng)
      data.mapLocation.lat = e.latlng.lat
      data.mapLocation.lng = e.latlng.lng
      updateMapCoords()
      document.getElementById('map-container').classList.add('active-map')
    })
  }

  function updateMapCoords() {
    const el = document.getElementById('map-coords')
    if (el && data.mapLocation.lat) {
      el.textContent = `Pin: ${data.mapLocation.lat.toFixed(6)}, ${data.mapLocation.lng.toFixed(6)}`
    }
  }

  async function _searchGooglePlaces(query) {
    // Google Places Text Search (New) — same engine as WP backend ACF map
    const res = await fetch('https://places.googleapis.com/v1/places:searchText', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Goog-Api-Key': GOOGLE_MAPS_KEY,
        'X-Goog-FieldMask': 'places.displayName,places.formattedAddress,places.location',
      },
      body: JSON.stringify({
        textQuery: query,
        locationBias: {
          circle: {
            center: { latitude: 9.855, longitude: 126.054 },
            radius: 50000,
          },
        },
        maxResultCount: 6,
        languageCode: 'en',
      }),
    })
    const json = await res.json()
    if (json.error) {
      // Surface Google's actual error message so we can fix key/restrictions
      const err = new Error(json.error.message || 'Places API error')
      err.code   = json.error.code
      err.status = json.error.status
      throw err
    }
    return (json.places || []).map(p => ({
      name:   p.displayName?.text  || query,
      detail: p.formattedAddress   || '',
      lat:    p.location?.latitude,
      lon:    p.location?.longitude,
    }))
  }

  // Fallback: OpenStreetMap Nominatim (no API key, no referrer restrictions)
  async function _searchNominatim(query) {
    const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query + ' Limasawa Philippines')}&limit=6&countrycodes=ph`
    const res = await fetch(url, { headers: { 'Accept-Language': 'en' } })
    if (!res.ok) return []
    const arr = await res.json()
    return (arr || []).map(p => ({
      name:   p.display_name?.split(',')[0] || query,
      detail: p.display_name || '',
      lat:    parseFloat(p.lat),
      lon:    parseFloat(p.lon),
    }))
  }

  function onMapSearch(query) {
    clearTimeout(_mapSearchTimer)
    const results = document.getElementById('map-search-results')
    if (!query.trim()) { results.classList.add('hidden'); return }

    _mapSearchTimer = setTimeout(async () => {
      results.innerHTML = `<div class="map-search-result" style="color:#9ca3af">Searching…</div>`
      results.classList.remove('hidden')
      let hits = []
      let googleErr = null
      try {
        hits = await _searchGooglePlaces(query)
      } catch (err) {
        googleErr = err
        console.warn('[map] Google Places failed, falling back to OSM:', err.code, err.status, err.message)
      }
      // Fallback to OSM if Google returned 0 results or errored out
      if (!hits.length) {
        try { hits = await _searchNominatim(query) } catch (e) { console.warn('[map] OSM fallback failed:', e) }
      }
      if (!hits.length) {
        const msg = googleErr
          ? `Search unavailable (${googleErr.status || googleErr.code || 'error'}). Click the map to place your pin.`
          : 'No results — click the map to place your pin manually.'
        results.innerHTML = `<div class="map-search-result" style="color:#9ca3af">${msg}</div>`
        return
      }
      results.innerHTML = hits.map(h =>
        `<div class="map-search-result" onclick="pickMapResult(${h.lat},${h.lon},'${(h.name + (h.detail ? ', ' + h.detail : '')).replace(/'/g,"\\'")}')">
          <strong>${h.name}</strong>
          ${h.detail ? `<small>${h.detail}</small>` : ''}
        </div>`
      ).join('')
    }, 400)
  }

  function pickMapResult(lat, lng, address) {
    const latlng = [parseFloat(lat), parseFloat(lng)]
    _map.setView(latlng, 16)
    _marker.setLatLng(latlng)
    data.mapLocation.lat     = latlng[0]
    data.mapLocation.lng     = latlng[1]
    data.mapLocation.address = address
    document.getElementById('map-search-results').classList.add('hidden')
    document.getElementById('map-search').value = ''
    document.getElementById('map-container').classList.add('active-map')
    updateMapCoords()
  }

  function confirmMapLocation() {
    data.address1 = (document.getElementById('input-address1') || {}).value?.trim() || ''
    nextStep()
  }

  // Load Leaflet lazily when map step activates
  function loadLeaflet(cb) {
    if (window.L) { cb(); return }
    const link = document.createElement('link')
    link.rel = 'stylesheet'
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
    document.head.appendChild(link)
    const script = document.createElement('script')
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
    script.onload = cb
    document.head.appendChild(script)
  }

  const mapStepObs = new MutationObserver(() => {
    if (document.querySelector('[data-step="mapLocation"].active')) {
      loadLeaflet(() => { setTimeout(() => {
        initMap()
        if (_map) {
          _map.invalidateSize()
          // Edit mode: if we have a saved pin, recentre the map + marker on it
          // so the user immediately sees where they previously dropped it.
          const savedLat = data.mapLocation && data.mapLocation.lat
          const savedLng = data.mapLocation && data.mapLocation.lng
          if (savedLat && savedLng && _marker) {
            const ll = [Number(savedLat), Number(savedLng)]
            _marker.setLatLng(ll)
            _map.setView(ll, 16)
            updateMapCoords()
            const c = document.getElementById('map-container')
            if (c) c.classList.add('active-map')
          }
        }
      }, 100) })
    }
  })

  // ── Quill rich-text editor (long description) ────────────────────────────
  let _quill = null
  function loadQuill(cb) {
    if (window.Quill) { cb(); return }
    const script = document.createElement('script')
    script.src = 'https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js'
    script.onload = cb
    document.head.appendChild(script)
  }
  function initQuill() {
    if (_quill) return
    const mount = document.getElementById('quill-longDescription')
    if (!mount) return
    _quill = new window.Quill(mount, {
      theme: 'snow',
      placeholder: mount.dataset.placeholder || '',
      modules: {
        toolbar: '#quill-toolbar',
        // Ctrl/Cmd+Enter is handled by the page-level keydown listener (advanceLongDescription).
      },
    })
    // Restore prior value if user hits Back to this step
    if (data.longDescription) _quill.root.innerHTML = data.longDescription
  }
  const quillStepObs = new MutationObserver(() => {
    if (document.querySelector('[data-step="longDescription"].active')) {
      loadQuill(() => { initQuill() })
    }
  })

  // Close map search results when clicking outside
  document.addEventListener('click', e => {
    const box = document.getElementById('map-search-box')
    const res = document.getElementById('map-search-results')
    if (box && res && !box.contains(e.target) && !res.contains(e.target)) res.classList.add('hidden')
  })

  // ── Long description ────────────────────────────────────────────────────

  function advanceLongDescription() {
    // Pull HTML from Quill (rich text). Fall back to '' if the editor never mounted.
    let html = ''
    if (_quill) {
      // Quill leaves an empty paragraph in the DOM when blank — treat that as empty.
      const isEmpty = _quill.getText().trim() === ''
      html = isEmpty ? '' : _quill.root.innerHTML.trim()
    }
    data.longDescription = html
    nextStep()
  }

  // ── Generator ───────────────────────────────────────────────────────────

  function selectGenerator(btn) {
    document.querySelectorAll('.gen-opt').forEach(b => b.classList.remove('selected'))
    btn.classList.add('selected')
    const isYes = btn.dataset.gen === 'yes'
    data.hasGenerator = isYes
    const wrap = document.getElementById('generator-schedule-wrap')
    if (wrap) {
      wrap.classList.toggle('hidden', !isYes)
      if (isYes) {
        setTimeout(() => document.getElementById('input-generatorSchedule')?.focus(), 60)
      }
    }
  }

  function confirmGenerator() {
    data.generatorSchedule = data.hasGenerator
      ? (document.getElementById('input-generatorSchedule') || {}).value?.trim() || ''
      : ''
    nextStep()
  }

  function saveSocialLinks() {
    data.websiteLink  = (document.getElementById('input-websiteLink')  || {}).value || ''
    data.facebookLink = (document.getElementById('input-facebookLink') || {}).value || ''
    data.instagramLink= (document.getElementById('input-instagramLink')|| {}).value || ''
    nextStep()
  }

  // ── Services ───────────────────────────────────────────────────────────
  function setServicesToggle(hasServices) {
    data.addServices = hasServices
    document.getElementById('services-yes-btn').classList.toggle('selected', hasServices)
    document.getElementById('services-no-btn').classList.toggle('selected', !hasServices)
    if (hasServices) {
      document.getElementById('services-editor').style.display = 'block'
      if (data.services.length === 0) addService()
      renderServicesList()
    } else {
      document.getElementById('services-editor').style.display = 'none'
      data.services = []
    }
    if (!hasServices) nextStep()
  }

  function renderServicesList() {
    const el = document.getElementById('services-list')
    if (!data.services.length) { el.innerHTML = ''; return }
    el.innerHTML = data.services.map((s, i) => `
      <div class="service-row" style="background:#fff;border:1.5px solid #e5e7eb;border-radius:12px;padding:1rem;position:relative;">
        <button onclick="removeService(${i})" style="position:absolute;top:.6rem;right:.6rem;background:none;border:none;cursor:pointer;color:#9ca3af;line-height:1;" title="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="mb-2">
          <label class="text-xs font-semibold uppercase tracking-wide block mb-1" style="color:#9ca3af">Service name</label>
          <input class="form-input" type="text" placeholder="e.g. Scooter rental" value="${s.name || ''}"
            oninput="updateService(${i},'name',this.value)" />
        </div>
        <div>
          <label class="text-xs font-semibold uppercase tracking-wide block mb-1" style="color:#9ca3af">Short description <span style="font-weight:400;text-transform:none;">(optional)</span></label>
          <input class="form-input" type="text" placeholder="e.g. ₱500/day, available on request" value="${s.description || ''}"
            oninput="updateService(${i},'description',this.value)" />
        </div>
      </div>`).join('')
  }

  function addService() {
    data.services.push({ name: '', description: '' })
    renderServicesList()
    // focus the new name input
    const inputs = document.querySelectorAll('#services-list .form-input')
    if (inputs.length) inputs[inputs.length - 2]?.focus()
  }

  function removeService(i) {
    data.services.splice(i, 1)
    renderServicesList()
  }

  function updateService(i, field, val) {
    if (data.services[i]) data.services[i][field] = val
  }

  function saveServices() {
    // filter out empty entries
    data.services = data.services.filter(s => s.name.trim())
    if (data.addServices && data.services.length === 0) {
      // user said yes but added nothing — treat as skip
      data.addServices = false
    }
    nextStep()
  }

  // ── Multi-listing discount ─────────────────────────────────────────────
  async function checkMultiListingDiscount() {
    const token = localStorage.getItem('sb_token')
    if (!token) return
    try {
      const res = await fetch(`${WP_REST}/my-listings`, { headers: { Authorization: `Bearer ${token}` } })
      const json = await res.json()
      const count = (json.listings || []).length
      if (count > 0) {
        // Has existing listings — show discount banner + update prices
        data._multiListingDiscount = true
        const banner = document.getElementById('multi-listing-banner')
        if (banner) banner.style.display = 'flex'
        // Multi-listing 50% off — inject a strikethrough next to the discounted
        // price using the same .tier-price-now / .yr-now spans (we add the
        // strike inline since the base markup no longer carries one).
        // Math.floor so a base of 399 renders as ₱199 (not ₱200) and 999 as
        // ₱499. Cleaner-looking prices for the half-off display.
        const tiers = ['pro','featured']
        for (const tier of tiers) {
          const base = TIER_PRICES[tier]?.monthly ?? 0
          const disc = Math.floor(base * 0.5)
          const wrap = document.getElementById(`price-${tier}`)
          if (wrap) {
            const nowEl = wrap.querySelector('.tier-price-now')
            if (nowEl) {
              nowEl.innerHTML = `<span class="tier-strike-inline">&#8369;${base.toLocaleString()}</span>&#8369;${disc.toLocaleString()}`
            }
          }
          const baseYr = TIER_PRICES[tier]?.yearly ?? 0
          const yrWrap = document.getElementById(`price-${tier}-year`)
          if (yrWrap) {
            const yrNow = yrWrap.querySelector('.yr-now')
            if (yrNow) {
              yrNow.innerHTML = `<span class="yr-strike-inline">&#8369;${baseYr.toLocaleString()}</span>&#8369;${Math.floor(baseYr * 0.5).toLocaleString()}`
            }
          }
        }
        updatePaymentAmount()
      }
    } catch { /* silent — just skip discount check */ }
  }

  // ── Entry point ────────────────────────────────────────────────────────
  function startForm() { goToStep('tier') }

  // ── Review ─────────────────────────────────────────────────────────────
  function buildReview() {
    const rows = [
      ['Plan',        TIER_LABELS[data.tier] || '—'],
      ['Billing',     data.tier === 'free' ? 'Free' : `${BILLING_LABELS[data.billingPeriod]} · ${formatPeso(data.paymentAmount)}`],
      ...(data.couponCode && data.couponDiscount > 0
          ? [['Coupon', `${data.couponCode} · −₱${Number(data.couponDiscount).toLocaleString()}`]]
          : []),
      ['Payment',     data.paymentAmount > 0 ? `${data.paymentMethod ? data.paymentMethod.replace('_',' ') : '—'} · receipt ${data.paymentReceiptId ? 'uploaded' : 'missing'}` : 'Not required'],
      ['Host name',   data.hostName   || '—'],
      ['Phone',       data.hostPhone  || '—'],
      ['Property',    data.propertyName || '—'],
      ['Category',    data.accommodationCategory || '—'],
      ['Space type',  data.placeType  || '—'],
      ['Municipality',data.municipalityName || '—'],
      ['Barangay',    data.barangayName   || '—'],
      ['Guests',      data.guests],
      ['Bedrooms',    data.bedrooms],
      ['Beds',        data.beds],
      ['Bathrooms',   data.bathrooms],
      ...(data.pricingMode === 'rooms'
          ? [['Room types', (data.roomTypes || []).length
              ? data.roomTypes.map(r => `${r.name || 'Room'}${r.capacity ? ` (${r.capacity}p)` : ''} · ₱${Number(r.rate || 0).toLocaleString()}`).join('<br>')
              : '—'],
             ...(data.additionalBedRate ? [['Additional bed', '₱' + data.additionalBedRate]] : [])]
          : data.pricingMode === 'per_pax'
          ? [['Per-pax rate', data.perPax && data.perPax.baseRate
              ? `₱${Number(data.perPax.baseRate).toLocaleString()} / up to ${data.perPax.basePax || '?'} pax`
                + (data.perPax.extraPerPax ? `, +₱${Number(data.perPax.extraPerPax).toLocaleString()}/pax` : '')
                + (data.perPax.maxPax ? ` (max ${data.perPax.maxPax})` : '')
              : '—']]
          : [['Nightly rate','₱' + (data.dailyRate || '—')],
             ['Monthly rate', data.monthlyRate ? '₱' + data.monthlyRate : '—']]),
      ['Description', data.description || '—'],
      ['Full desc.',  (() => {
        if (!data.longDescription) return '—'
        // Strip HTML tags for the review summary — keeps the preview readable
        const txt = data.longDescription.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
        return txt.slice(0, 80) + (txt.length > 80 ? '…' : '')
      })()],
      ['Generator',   data.hasGenerator === true ? 'Yes' : data.hasGenerator === false ? 'No' : '—'],
      ['Booking link',data.bookingLink || '—'],
      ['Airbnb',      data.airbnbLink  || '—'],
      ['Booking.com', data.bookingComLink || '—'],
      ['Website',     data.websiteLink || '—'],
      ['Facebook',    data.facebookLink|| '—'],
      ['Instagram',   data.instagramLink || '—'],
      ['Address',     data.address1 || '—'],
      ['Map pin',     data.mapLocation.lat ? `${data.mapLocation.lat.toFixed(5)}, ${data.mapLocation.lng.toFixed(5)}` : '—'],
      ['Host photo',  data.hostPhotoId ? 'Uploaded' : '—'],
      ['Gallery',     data.galleryIds.filter(Boolean).length ? `${data.galleryIds.filter(Boolean).length} photo(s)` : '—'],
      ['Amenities',   (() => {
        const faqSelected = FAQ_AMENITIES.filter(f => data.faqAmenities[f.key]).map(f => f.label)
        const all = [...faqSelected, ...data.extraAmenities]
        return all.length ? all.join(', ') : '—'
      })()],
    ]
    const el = document.getElementById('review-content')
    if (!el) return
    el.innerHTML = rows.map(([label, val]) =>
      `<div class="review-row"><span class="review-label">${label}</span><span class="review-value">${val}</span></div>`
    ).join('')
  }

  // ── Submit ─────────────────────────────────────────────────────────────
  async function submitListing() {
    const btn = document.getElementById('submit-btn')
    const isEdit = !!data._editMode
    btn.disabled = true
    btn.innerHTML = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> ' + (isEdit ? 'Saving...' : 'Submitting...')
    try {
      // Strip internal underscore-prefixed fields before sending
      const payload = Object.fromEntries(Object.entries(data).filter(([k]) => !k.startsWith('_')))
      // If a coupon is applied, send the PRE-coupon base amount so the backend
      // (snippet #38) can re-validate the coupon and recompute the discount —
      // server is the source of truth, no client-side price tampering.
      if (data.couponCode && data.couponNewTotal > 0) {
        payload.paymentAmount = basePrice(data.tier, data.billingPeriod)
      }
      const url = isEdit ? `${WP_REST}/update-listing/${data._editMode}` : `${WP_REST}/submit-listing`
      const res = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(data._authToken ? { 'Authorization': `Bearer ${data._authToken}` } : {}),
        },
        body: JSON.stringify(payload),
      })
      const json = await res.json()
      if (json.success) {
        if (isEdit) {
          // Bounce back to dashboard with a success flag the dashboard can pick up
          window.location.href = '/dashboard?listing_saved=' + encodeURIComponent(json.slug || data._editMode)
          return
        }
        goToStep('success')
        fireConfetti()
      } else {
        alert('Something went wrong: ' + (json.message || 'Unknown error'))
        btn.disabled = false
        btn.innerHTML = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> ' + (isEdit ? 'Save changes' : 'Submit listing')
      }
    } catch {
      alert('Network error. Please try again.')
      btn.disabled = false
      btn.innerHTML = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> ' + (isEdit ? 'Save changes' : 'Submit listing')
    }
  }

  // ── Keyboard ───────────────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    const id = currentStepId()
    if (e.key === 'Enter') {
      // Multi-line steps: plain Enter must keep its native behaviour (newline / Quill list-item).
      // Only Ctrl/Cmd+Enter advances on these.
      if (id === 'description' || id === 'longDescription') { if (!e.ctrlKey) return }
      e.preventDefault()
      const textSteps = ['hostName','hostPhone','propertyName','dailyRate','monthlyRate','bookingLink','airbnbLink','bookingComLink']
      const optionalSteps = ['monthlyRate','bookingLink','airbnbLink','bookingComLink']
      if (id === 'barangay') confirmBarangay()
      else if (id === 'mapLocation') confirmMapLocation()
      else if (id === 'longDescription') { if (!e.ctrlKey) return; advanceLongDescription() }
      else if (textSteps.includes(id)) advanceText(id, optionalSteps.includes(id))
      else if (id === 'description') { if (!e.ctrlKey) return; advanceText('description') }
      else if (id === 'socialLinks') saveSocialLinks()
      else if (id === 'roomTypes') confirmRoomTypes()
      else if (id === 'perPax') confirmPerPax()
      else if (id === 'generator') confirmGenerator()
      else if (id === 'payment') confirmPayment()
      else if (['guests','capacity','amenities','gallery'].includes(id)) nextStep()
    }
    if (e.key === 'Backspace' && !e.target.matches('input,textarea')) {
      const nonBack = ['welcome','success','tier']
      if (!nonBack.includes(id)) prevStep()
    }
  })

  // ── Back button ────────────────────────────────────────────────────────
  document.getElementById('back-btn').addEventListener('click', () => {
    // In edit mode, the Back button goes to the dashboard (linear nav doesn't
    // make sense when you can jump to any section via the dropdown).
    if (data._editMode) { window.location.href = '/dashboard'; return }
    const nonBack = ['welcome','success']
    if (!nonBack.includes(currentStepId())) prevStep()
  })

  // Push current data values into all visible form inputs (used in edit mode
  // so users see what's already saved instead of empty fields).
  function prefillInputsFromData() {
    const map = {
      'input-hostName':          data.hostName,
      'input-hostPhone':         data.hostPhone,
      'input-propertyName':      data.propertyName,
      'input-address1':          data.address1,
      'input-dailyRate':         data.dailyRate,
      'input-monthlyRate':       data.monthlyRate,
      'input-description':       data.description,
      'input-bookingLink':       data.bookingLink,
      'input-airbnbLink':        data.airbnbLink,
      'input-bookingComLink':    data.bookingComLink,
      'input-websiteLink':       data.websiteLink,
      'input-facebookLink':      data.facebookLink,
      'input-instagramLink':     data.instagramLink,
      'input-generatorSchedule': data.generatorSchedule,
    }
    Object.entries(map).forEach(([id, val]) => {
      const el = document.getElementById(id)
      if (el && val !== undefined && val !== null) el.value = val
    })
  }

  // Edit-mode hydration: reflect every saved value in the matching UI control.
  // Called once after the listing payload is merged into `data`. Each block is
  // defensive (no-ops cleanly when the value is empty) so the same call can run
  // for partial listings without breaking later steps.
  function hydrateEditModeUI() {
    // 1. accommodationCategory chip
    if (data.accommodationCategory) {
      document.querySelectorAll('[data-step="accommodationCategory"] .choice-chip').forEach(c => {
        c.classList.toggle('selected', c.dataset.value === data.accommodationCategory)
      })
    }

    // 2. placeType chip
    if (data.placeType) {
      document.querySelectorAll('[data-step="placeType"] .choice-chip').forEach(c => {
        c.classList.toggle('selected', c.dataset.value === data.placeType)
      })
    }

    // 3. Municipality chip + populate barangay options for that muni
    if (data.municipalityId || data.municipalityName) {
      let muniChip = null
      document.querySelectorAll('[data-step="municipality"] .choice-chip').forEach(c => {
        const matches = (data.municipalityId && Number(c.dataset.locId) === Number(data.municipalityId))
          || (data.municipalityName && c.dataset.value === data.municipalityName)
        c.classList.toggle('selected', matches)
        if (matches) muniChip = c
      })
      // Run the existing handler so its side-effects (loading barangays) fire
      if (muniChip && typeof selectMunicipality === 'function') {
        try { selectMunicipality(muniChip) } catch (_) {}
      }
    }

    // 4. Barangay — show pre-filled name + selected indicator
    if (data.barangayName) {
      const inp     = document.getElementById('barangay-search')
      const selWrap = document.getElementById('barangay-selected')
      const selName = document.getElementById('barangay-selected-name')
      const clear   = document.getElementById('barangay-clear')
      if (inp)     inp.value = data.barangayName
      if (selWrap) selWrap.classList.remove('hidden')
      if (selName) selName.textContent = data.barangayName
      if (clear)   clear.classList.remove('hidden')
    }

    // 5. Map pin — drop marker at saved location once Leaflet is ready
    //    (the actual placement happens in mapStepObs / initMap when the step
    //    becomes active; we just make sure data.mapLocation has lat/lng.)

    // 6. Services Yes/No + render existing services
    if (data.addServices === true || (Array.isArray(data.services) && data.services.length > 0)) {
      data.addServices = true
      const yesBtn = document.getElementById('services-yes-btn')
      const noBtn  = document.getElementById('services-no-btn')
      if (yesBtn) yesBtn.classList.add('selected')
      if (noBtn)  noBtn.classList.remove('selected')
      const editor = document.getElementById('services-editor')
      if (editor) editor.style.display = 'block'
      renderServicesList()
    } else if (data.addServices === false) {
      const yesBtn = document.getElementById('services-yes-btn')
      const noBtn  = document.getElementById('services-no-btn')
      if (yesBtn) yesBtn.classList.remove('selected')
      if (noBtn)  noBtn.classList.add('selected')
    }

    // 7. Generator Yes/No + schedule textarea visibility
    if (data.hasGenerator === true || data.hasGenerator === false) {
      const yesBtn = document.querySelector('.gen-opt[data-gen="yes"]')
      const noBtn  = document.querySelector('.gen-opt[data-gen="no"]')
      const wrap   = document.getElementById('generator-schedule-wrap')
      if (yesBtn) yesBtn.classList.toggle('selected', !!data.hasGenerator)
      if (noBtn)  noBtn.classList.toggle('selected', !data.hasGenerator)
      if (wrap)   wrap.classList.toggle('hidden', !data.hasGenerator)
    }

    // 8. Extra amenities — render the chips. (FAQ pills self-render from
    //    data.faqAmenities the first time the amenities step becomes active.)
    if (Array.isArray(data.extraAmenities) && data.extraAmenities.length) {
      const container = document.getElementById('added-amenities')
      if (container) {
        container.innerHTML = ''
        data.extraAmenities.forEach(name => {
          const tag = document.createElement('div')
          tag.className = 'amenity-chip selected flex items-center gap-1.5'
          tag.dataset.extra = name
          const safeName = String(name).replace(/'/g, "\\'")
          tag.innerHTML = `${name}<button type="button" onclick="removeAddedAmenity('${safeName}')" style="line-height:1;color:inherit;opacity:0.7" aria-label="Remove">`
            + `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`
            + `</button>`
          container.appendChild(tag)
        })
        if (typeof updateAmenityCount === 'function') updateAmenityCount()
      }
    }

    // 9. Gallery — render saved thumbs (galleryUrls comes from REST as URLs only;
    //    galleryIds are the WP attachment IDs we'll keep intact on resubmit).
    if (Array.isArray(data.galleryUrls) && data.galleryUrls.length) {
      // Filter out any null/empty entries defensively
      data.galleryUrls = data.galleryUrls.filter(u => u)
      data.galleryIds  = (data.galleryIds || []).filter(id => id)
      if (typeof rebuildGalleryGrid === 'function') rebuildGalleryGrid()
    }

    // 10. Quill long-description (rich text). The Quill instance only mounts
    //     when the longDescription step becomes active, so we stash the HTML
    //     and apply it inside its observer below.
  }

  // ── Wire review step ───────────────────────────────────────────────────
  const reviewObs = new MutationObserver(() => {
    if (document.querySelector('[data-step="review"].active')) buildReview()
  })
  reviewObs.observe(document.querySelector('[data-step="review"]'), { attributes: true, attributeFilter: ['class'] })

  // ── Wire amenities step ────────────────────────────────────────────────
  const amenitiesObs = new MutationObserver(() => {
    if (document.querySelector('[data-step="amenities"].active')) renderFaqPills()
  })
  amenitiesObs.observe(document.querySelector('[data-step="amenities"]'), { attributes: true, attributeFilter: ['class'] })

  // ── Wire gallery step ──────────────────────────────────────────────────
  galleryObs.observe(document.querySelector('[data-step="gallery"]'), { attributes: true, attributeFilter: ['class'] })

  // ── Wire map step ──────────────────────────────────────────────────────
  mapStepObs.observe(document.querySelector('[data-step="mapLocation"]'), { attributes: true, attributeFilter: ['class'] })
  quillStepObs.observe(document.querySelector('[data-step="longDescription"]'), { attributes: true, attributeFilter: ['class'] })

  // Close dropdown when clicking outside
  document.addEventListener('click', e => {
    const box = document.getElementById('amenity-search-box')
    const dropdown = document.getElementById('amenity-dropdown')
    if (box && dropdown && !box.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add('hidden')
      box.style.borderColor = '#e5e7eb'
    }
  })

  // ── Init counter displays ──────────────────────────────────────────────
  ;['guests','bedrooms','beds','bathrooms'].forEach(k => {
    const el = document.getElementById('val-' + k)
    if (el) el.textContent = data[k]
  })

  // ── Auth wall + edit-mode bootstrap ────────────────────────────────────
  ;(async function() {
    function parseJWT(t) {
      try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))) } catch { return null }
    }
    const token = localStorage.getItem('sb_token')
    const payload = token ? parseJWT(token) : null
    const valid = payload && payload.exp > Date.now()/1000
    if(!valid) {
      document.getElementById('auth-wall').style.display = 'block'
      document.getElementById('welcome-content').style.display = 'none'
      return
    }

    document.getElementById('welcome-content').style.display = 'block'
    document.getElementById('auth-wall').style.display = 'none'
    const name = payload.data?.user?.username || ''
    if(name) {
      const hint = document.getElementById('welcome-user-hint')
      if(hint) hint.textContent = `Signed in as ${name}`
    }
    if(payload.data?.user?.username) data.hostName = payload.data.user.username
    data._authToken = token

    // Edit mode: ?edit=ID — fetch existing listing and prefill, then jump in
    const editId = parseInt(new URLSearchParams(location.search).get('edit') || '0')
    if (!editId) return

    // Show a lightweight loading state inside the welcome step
    const welcome = document.getElementById('welcome-content')
    if (welcome) {
      welcome.innerHTML = `<div style="text-align:center;padding:3rem 1.5rem">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin" style="margin:0 auto 1rem;display:block"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <p style="color:#6b7280;font-size:.95rem">Loading your listing for editing…</p>
      </div>`
    }

    try {
      const res = await fetch(`${WP_REST}/listing-edit/${editId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      })
      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        throw new Error(err.message || `Server returned ${res.status}`)
      }
      const existing = await res.json()
      // Merge into data, preserving _authToken and adding edit flags
      Object.keys(existing).forEach(k => {
        if (existing[k] !== null && existing[k] !== undefined) data[k] = existing[k]
      })
      data._editMode = editId
      data._editSlug = existing.slug || ''
      // Update review-step copy + button text
      const reviewHeading = document.querySelector('[data-step="review"] h2')
      const reviewSub     = document.querySelector('[data-step="review"] p.text-sm')
      const reviewFoot    = document.querySelector('[data-step="review"] p.text-xs')
      const submitBtn     = document.getElementById('submit-btn')
      if (reviewHeading) reviewHeading.textContent = 'Review your changes'
      if (reviewSub)     reviewSub.textContent     = 'Your edits go live immediately — no re-approval needed.'
      if (reviewFoot)    reviewFoot.textContent    = 'Tip: any changes to gallery photos refresh the live page within a minute.'
      if (submitBtn) {
        submitBtn.innerHTML = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Save changes'
      }
      // Reveal edit toolbar: jump-to-section + save button
      const toolbar = document.getElementById('edit-toolbar')
      const jumpSel = document.getElementById('edit-jump-select')
      if (toolbar) toolbar.classList.remove('hidden')
      // Add top padding to steps wrapper to prevent toolbar overlap
      const wrapper = document.getElementById('steps-wrapper')
      if (wrapper) wrapper.style.paddingTop = '52px'
      // Repurpose the top-left "Back" button as "Dashboard" so the click handler
      // (which checks data._editMode and navigates to /dashboard) makes sense.
      const backBtn = document.getElementById('back-btn')
      if (backBtn) {
        backBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg> Dashboard'
        backBtn.style.opacity = '1'
        backBtn.style.pointerEvents = 'auto'
      }
      // Push existing values into all visible form inputs
      prefillInputsFromData()
      // Hydrate every step's UI controls from the saved data (chips, toggles,
      // gallery thumbs, amenity tags, etc.) so users see what they already
      // entered instead of empty fields.
      hydrateEditModeUI()
      const STEP_LABELS = {
        hostName:'Host name', hostPhone:'Host phone', hostPhoto:'Host photo',
        propertyName:'Property name', accommodationCategory:'Property type',
        placeType:'Place type', municipality:'Municipality', barangay:'Barangay',
        mapLocation:'Map location', guests:'Number of guests', capacity:'Bedrooms / beds / baths',
        dailyRate:'Daily rate', monthlyRate:'Monthly rate',
        description:'Short description', longDescription:'Full description',
        bookingLink:'Direct booking link', airbnbLink:'Airbnb link', bookingComLink:'Booking.com link',
        socialLinks:'Website & social', services:'Services',
        amenities:'Amenities', generator:'Generator',
        gallery:'Photos', review:'Review & save',
      }
      if (jumpSel) {
        const opts = visibleSteps()
          .filter(id => STEP_LABELS[id])
          .map(id => `<option value="${id}">${STEP_LABELS[id]}</option>`)
          .join('')
        jumpSel.innerHTML = opts
        jumpSel.addEventListener('change', () => {
          const target = jumpSel.value
          if (target) goToStep(target)
        })
      }
      // Start at Host name (the very first form step). The dropdown reflects
      // the current step and updates whenever the user navigates between steps.
      goToStep('hostName')
      if (jumpSel) jumpSel.value = 'hostName'
    } catch (e) {
      welcome.innerHTML = `<div style="text-align:center;padding:3rem 1.5rem">
        <p style="color:#dc2626;font-weight:600;margin-bottom:.5rem">Could not load this listing</p>
        <p style="color:#6b7280;font-size:.875rem;margin-bottom:1.5rem">${(e && e.message) || 'Please try again.'}</p>
        <a href="/dashboard" style="display:inline-block;background:var(--primary);color:#fff;padding:.6rem 1.4rem;border-radius:9px;text-decoration:none;font-weight:600;font-size:.875rem">Back to dashboard</a>
      </div>`
    }
  })()

  // ── Expose to global scope (needed for inline onclick= handlers) ───────
  Object.assign(window, {
    startForm, goToStep, nextStep, prevStep, skipStep,
    selectTier, selectBillingPeriod, selectChoice, adjustCounter,
    onHostPhotoSelect, confirmHostPhoto,
    selectPaymentMethod, onPaymentReceiptSelect, confirmPayment,
    onGallerySelect, onGalleryDrop, removeGalleryPhoto,
    selectMunicipality, onBarangaySearch, onBarangayKeydown, pickBarangay, clearBarangay, confirmBarangay, skipBarangay,
    onMapSearch, pickMapResult, confirmMapLocation,
    advanceLongDescription,
    selectGenerator, confirmGenerator,
    toggleFaqAmenity, onAmenitySearch, onAmenityKeydown, addAmenity, removeAddedAmenity,
    saveSocialLinks, setServicesToggle, addService, removeService, updateService, saveServices,
    submitListing, advanceText,
    applyListingCoupon, clearListingCoupon, onCouponInput,
  })
</script>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
<script is:inline>
  function fireConfetti() {
    const opts = { spread: 60, startVelocity: 55, ticks: 200, zIndex: 9999 }

    // left cannon
    confetti({ ...opts, particleCount: 120, angle: 60, origin: { x: 0, y: 0.65 } })
    // right cannon
    confetti({ ...opts, particleCount: 120, angle: 120, origin: { x: 1, y: 0.65 } })

    // second burst after a short delay for extra wow
    setTimeout(() => {
      confetti({ ...opts, particleCount: 80, angle: 70, origin: { x: 0, y: 0.7 }, startVelocity: 40 })
      confetti({ ...opts, particleCount: 80, angle: 110, origin: { x: 1, y: 0.7 }, startVelocity: 40 })
    }, 300)
  }
</script>

</body>
</html>
