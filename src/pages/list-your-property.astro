              <span class="tier-price-period">forever</span>
            </div>
            <div class="tier-yearly-row" style="visibility:hidden">
              <span class="yr-label">Yearly</span><span class="yr-now">—</span>
            </div>

            <ul class="tier-includes">
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Listing on the directory + map</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Up to 8 photos</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>1 booking link (WhatsApp or phone)</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Total views stats</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Direct guest contact &middot; no fees, ever</li>
            </ul>
          </div>

          <!-- ───────── Pro Host (early-bird) ───────── -->
          <div class="tier-card" data-tier="pro" onclick="selectTier(this)">
            <div class="tier-head">
              <span class="tier-name">Pro Host</span>
              <span class="tier-popular">Most popular</span>
            </div>
            <p class="tier-tagline">Best for active hosts running 1&ndash;3 properties.</p>

            <div class="tier-price-row" id="price-pro">
              <span class="tier-price-now">&#8369;399</span>
              <span class="tier-price-period">/ month</span>
            </div>
            <div class="tier-yearly-row" id="price-pro-year">
              <span class="yr-label">Yearly</span>
              <span class="yr-now">&#8369;3,990</span>
            </div>

            <ul class="tier-includes">
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Everything in Island Listing</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Up to 25 photos</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Full analytics &mdash; every click type</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>All booking + social channels</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Services tab (rentals, transfers, lessons)</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Verified badge</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Blog post privileges</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Modest ranking boost in search</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Priority email support</li>
            </ul>
          </div>

          <!-- ───────── Featured Stay (early-bird) ───────── -->
          <div class="tier-card featured" data-tier="featured" onclick="selectTier(this)">
            <div class="tier-head"><span class="tier-name">Featured Stay</span></div>
            <p class="tier-tagline">Best for premium villas competing for visibility.</p>

            <div class="tier-price-row" id="price-featured">
              <span class="tier-price-now">&#8369;999</span>
              <span class="tier-price-period">/ month</span>
            </div>
            <div class="tier-yearly-row" id="price-featured-year">
              <span class="yr-label">Yearly</span>
              <span class="yr-now">&#8369;9,990</span>
            </div>

            <ul class="tier-includes">
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Everything in Pro Host</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Unlimited photos</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Featured badge on every card</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Top placement in search + filters</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Homepage carousel slot (limited)</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Quarterly IG / FB shoutout</li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Blog post privileges</li>
            </ul>
          </div>
        </div>
        <div class="flex justify-end mt-5">
          <button id="tier-next" class="ok-btn" disabled onclick="nextStep()">
            Continue
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── 1b: Billing ── -->
    <div class="step" data-step="billing">
      <div class="w-full max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--primary)">Billing</p>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Choose billing period</h2>
        <p id="billing-subtext" class="text-sm mb-5" style="color:#9ca3af">Longer terms include the built-in savings.</p>
        <div id="billing-options" class="grid grid-cols-1 sm:grid-cols-3 gap-3"></div>
        <div class="flex justify-end mt-5">
          <button id="billing-next" class="ok-btn" disabled onclick="nextStep()">
            Continue
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── 2: Host name ── -->
    <div class="step" data-step="hostName">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">About you</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">What&rsquo;s your name?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">This is the name guests will see on your listing.</p>
        <input id="input-hostName" class="form-input" type="text" placeholder="Your full name" autocomplete="name" />
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="advanceText('hostName')">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <span class="text-xs" style="color:#9ca3af">press <kbd class="px-1.5 py-0.5 rounded text-xs border" style="border-color:#e5e7eb">Enter</kbd></span>
        </div>
      </div>
    </div>

    <!-- ── 3: Host phone ── -->
    <div class="step" data-step="hostPhone">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.61 5.06 2 2 0 0 1 3.6 2.87h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.4a16 16 0 0 0 5.69 5.69l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Contact</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Your WhatsApp number?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">Guests and our team will use this to reach you.</p>
        <input id="input-hostPhone" class="form-input" type="tel" placeholder="+63 900 000 0000" autocomplete="tel" />
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="advanceText('hostPhone')">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <span class="text-xs" style="color:#9ca3af">press <kbd class="px-1.5 py-0.5 rounded text-xs border" style="border-color:#e5e7eb">Enter</kbd></span>
        </div>
      </div>
    </div>

    <!-- ── 3b: Host photo ── -->
    <div class="step" data-step="hostPhoto">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Profile photo</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Add your profile photo</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">Optional. Guests trust listings with a real host photo.</p>

        <div class="drop-zone" id="host-photo-drop" onclick="document.getElementById('host-photo-input').click()">
          <input type="file" id="host-photo-input" accept="image/jpeg,image/png,image/webp" onchange="onHostPhotoSelect(this.files)" onclick="event.stopPropagation()" />
          <div id="host-photo-empty">
            <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#9ca3af"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            </div>
            <p class="text-sm font-medium" style="color:#6b7280">Click to upload a photo</p>
            <p class="text-xs mt-1" style="color:#9ca3af">JPG, PNG or WebP · Max 8 MB</p>
          </div>
          <div id="host-photo-preview" class="hidden">
            <img id="host-photo-img" src="" alt="Host photo" class="host-photo-preview" />
            <p id="host-photo-name" class="text-xs mt-2" style="color:#9ca3af"></p>
          </div>
          <div id="host-photo-uploading" class="hidden py-4">
            <div class="upload-spinner mx-auto"></div>
            <p class="text-xs mt-2" style="color:#9ca3af">Uploading…</p>
          </div>
        </div>

        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="confirmHostPhoto()">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <button class="skip-link" onclick="skipStep()">Skip</button>
        </div>
      </div>
    </div>

    <!-- ── 4: Property name ── -->
    <div class="step" data-step="propertyName">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Your property</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">What is your property called?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">The name that appears on your listing.</p>
        <input id="input-propertyName" class="form-input" type="text" placeholder="e.g. Sunset Villa Limasawa" />
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="advanceText('propertyName')">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <span class="text-xs" style="color:#9ca3af">press <kbd class="px-1.5 py-0.5 rounded text-xs border" style="border-color:#e5e7eb">Enter</kbd></span>
        </div>
      </div>
    </div>

    <!-- ── 5: Category ── -->
    <div class="step" data-step="accommodationCategory">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/><path d="M3 9V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Type</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">What type of accommodation?</h2>
        <p class="text-sm mb-5" style="color:#9ca3af">Pick the category that best describes your property.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="category-grid">
          {categories.map(cat => (
            <div class="choice-chip" data-value={cat} onclick="selectChoice(this,'accommodationCategory',true)">{cat}</div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── 6: Place type ── -->
    <div class="step" data-step="placeType">
      <div class="w-full max-w-lg">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Space</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">What will guests have?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">Choose what type of space guests get access to.</p>
        <div class="flex flex-col gap-3">
          {[
            { label: 'Entire place', value: 'Entire Place' },
            { label: 'Private room', value: 'A private room' },
            { label: 'Shared room',  value: 'A shared room'  },
          ].map(opt => (
            <div class="choice-chip flex items-center gap-3" data-value={opt.value} onclick="selectChoice(this,'placeType',true)">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--primary-light)">
                {opt.value === 'Entire Place'    && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>}
                {opt.value === 'A private room'  && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M10 8V5a2 2 0 1 1 4 0v3"/></svg>}
                {opt.value === 'A shared room'   && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              </div>
              <span>{opt.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── 7: Municipality ── -->
    <div class="step" data-step="municipality">
      <div class="w-full max-w-lg">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Location</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Which municipality?</h2>
        <p class="text-sm mb-5" style="color:#9ca3af">Where is your property located?</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {MUNICIPALITIES.map(m => (
            <div class="choice-chip" data-value={m.name} data-loc-id={m.id} onclick="selectMunicipality(this)">{m.name}</div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── 8: Barangay ── -->
    <div class="step" data-step="barangay">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20A14.5 14.5 0 0 0 12 2"/><path d="M2 12h20"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Location</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Which barangay?</h2>
        <p id="barangay-subtext" class="text-sm mb-5" style="color:#9ca3af">Search or pick your barangay.</p>

        <!-- Search box -->
        <div class="relative">
          <div class="flex items-center gap-2 rounded-xl border-2 px-3 py-2.5 transition-colors" style="border-color:#e5e7eb;background:white" id="barangay-search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#9ca3af;flex-shrink:0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              id="barangay-search"
              type="text"
              placeholder="Search barangay..."
              class="flex-1 bg-transparent outline-none text-sm"
              style="color:#1a1a1a"
              oninput="onBarangaySearch(this.value)"
              onkeydown="onBarangayKeydown(event)"
              autocomplete="off"
            />
            <button id="barangay-clear" type="button" class="hidden" onclick="clearBarangay()" style="color:#9ca3af;line-height:1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <!-- Dropdown -->
          <div id="barangay-dropdown"
            class="absolute left-0 right-0 mt-1 rounded-xl border shadow-lg overflow-y-auto z-50 hidden"
            style="background:white;border-color:#e5e7eb;top:100%;max-height:240px">
          </div>
        </div>

        <!-- Selected barangay display -->
        <div id="barangay-selected" class="hidden mt-3 flex items-center gap-2 text-sm font-medium" style="color:var(--primary)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span id="barangay-selected-name"></span>
        </div>

        <div class="flex items-center gap-4 mt-6">
          <button id="barangay-ok" class="ok-btn" onclick="confirmBarangay()">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <button class="skip-link" onclick="skipBarangay()">Skip</button>
        </div>
      </div>
    </div>

    <!-- ── 8b: Map location ── -->
    <div class="step" data-step="mapLocation">
      <div class="w-full max-w-2xl overflow-y-auto" style="max-height:calc(100vh - 8rem)">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Pin location</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Where exactly is it?</h2>
        <p class="text-sm mb-4" style="color:#9ca3af">Search for your business or landmark. If it doesn&rsquo;t appear, just click the map to drop the pin manually — drag to fine-tune. Moving the pin won&rsquo;t change your address field.</p>

        <!-- Landmark text field -->
        <div class="mb-3">
          <label class="text-xs font-semibold uppercase tracking-wide block mb-1" style="color:#9ca3af">Landmark / address</label>
          <input id="input-address1" class="form-input" type="text" placeholder="e.g. Kermit Surf Resort, Cloud 9 area" />
        </div>

        <!-- Map search -->
        <div class="relative mb-3" style="z-index:2000">
          <div class="flex items-center gap-2 rounded-xl border-2 px-3 py-2.5" style="border-color:#e5e7eb;background:white" id="map-search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#9ca3af;flex-shrink:0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="map-search" type="text" placeholder="Search on map (optional)..." class="flex-1 bg-transparent outline-none text-sm" style="color:#1a1a1a" oninput="onMapSearch(this.value)" autocomplete="off" />
          </div>
          <div id="map-search-results" class="absolute left-0 right-0 mt-1 rounded-xl border shadow-lg hidden overflow-hidden" style="background:white;border-color:#e5e7eb;top:100%;z-index:2000"></div>
        </div>

        <!-- Leaflet map -->
        <div id="map-container"></div>
        <p id="map-coords" class="text-xs mt-2" style="color:#9ca3af"></p>

        <div class="flex items-center gap-4 mt-5">
          <button class="ok-btn" onclick="confirmMapLocation()">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <button class="skip-link" onclick="skipStep()">Skip</button>
        </div>
      </div>
    </div>

    <!-- ── 9: Guests ── -->
    <div class="step" data-step="guests">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Capacity</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">How many guests?</h2>
        <p class="text-sm mb-8" style="color:#9ca3af">Maximum number of guests allowed.</p>
        <div class="flex items-center gap-4">
          <button class="counter-btn" onclick="adjustCounter('guests',-1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <span class="counter-val text-4xl font-bold" id="val-guests" style="color:#1a1a1a">1</span>
          <button class="counter-btn" onclick="adjustCounter('guests',1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
        <div class="mt-8">
          <button class="ok-btn" onclick="nextStep()">
            Continue <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── 10: Capacity (beds / bathrooms) ── -->
    <div class="step" data-step="capacity">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Rooms</span>
        </div>
        <h2 class="text-3xl font-bold mb-8" style="color:#1a1a1a">Rooms and beds</h2>
        <div class="space-y-6">
          {[
            { key:'bedrooms', label:'Bedrooms', icon:'bedroom' },
            { key:'beds',     label:'Beds',     icon:'bed'     },
            { key:'bathrooms',label:'Bathrooms',icon:'bath'    },
          ].map(({key,label}) => (
            <div class="flex items-center justify-between">
              <span class="text-base font-medium" style="color:#374151">{label}</span>
              <div class="flex items-center gap-4">
                <button class="counter-btn" onclick={`adjustCounter('${key}',-1)`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <span class="counter-val" id={`val-${key}`} style="color:#1a1a1a">0</span>
                <button class="counter-btn" onclick={`adjustCounter('${key}',1)`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <button class="ok-btn" onclick="nextStep()">
            Continue <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── Pricing mode chooser ── -->
    <div class="step" data-step="pricingMode">
      <div class="w-full max-w-lg">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/><path d="M12 18V6"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Pricing</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">How do you price this place?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">Pick the option that matches how you charge guests.</p>
        <div class="flex flex-col gap-3">
          <div class="choice-chip flex items-start gap-3" data-value="flat" onclick="selectChoice(this,'pricingMode',true)">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--primary-light)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div><span class="font-semibold">One rate for the whole place</span><p class="text-xs mt-0.5" style="color:#9ca3af">A single nightly (and optional monthly) price.</p></div>
          </div>
          <div class="choice-chip flex items-start gap-3" data-value="rooms" onclick="selectChoice(this,'pricingMode',true)">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--primary-light)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/></svg>
            </div>
            <div><span class="font-semibold">Different room types</span><p class="text-xs mt-0.5" style="color:#9ca3af">e.g. Barkada ₱3,999 · Family ₱2,500 · Couple ₱1,999.</p></div>
          </div>
          <div class="choice-chip flex items-start gap-3" data-value="per_pax" onclick="selectChoice(this,'pricingMode',true)">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:var(--primary-light)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
            </div>
            <div><span class="font-semibold">Per-pax tiered rate</span><p class="text-xs mt-0.5" style="color:#9ca3af">e.g. ₱3,400 up to 4 pax, +₱350 per extra guest.</p></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Room types repeater ── -->
    <div class="step" data-step="roomTypes">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Room types</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Your room types &amp; rates</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">Add each room type with its nightly rate. The cheapest shows as your &ldquo;from&rdquo; price.</p>
        <div id="room-types-list" class="flex flex-col gap-4"></div>
        <button type="button" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold" style="color:var(--primary)" onclick="addRoomType()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add room type
        </button>
        <div class="mt-6">
          <label class="text-sm font-semibold" style="color:#374151">Additional bed rate <span class="font-normal" style="color:#9ca3af">(optional)</span></label>
          <div class="flex items-center gap-2 mt-1">
            <span class="text-xl font-bold" style="color:#9ca3af">&#8369;</span>
            <input id="input-additionalBedRate" class="form-input" type="number" min="0" placeholder="300" />
          </div>
        </div>
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="confirmRoomTypes()">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── Per-pax tiered rate ── -->
    <div class="step" data-step="perPax">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Per-pax rate</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Set your per-pax pricing</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">A base rate covering a number of guests, plus a per-guest add-on.</p>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-sm font-semibold" style="color:#374151">Base rate / night</label>
            <div class="flex items-center gap-1 mt-1"><span class="text-lg font-bold" style="color:#9ca3af">&#8369;</span>
              <input id="input-pp-baseRate" class="form-input" type="number" min="0" placeholder="3400" oninput="updatePerPaxPreview()" /></div>
          </div>
          <div>
            <label class="text-sm font-semibold" style="color:#374151">Base pax included</label>
            <input id="input-pp-basePax" class="form-input mt-1" type="number" min="1" placeholder="4" oninput="updatePerPaxPreview()" />
          </div>
          <div>
            <label class="text-sm font-semibold" style="color:#374151">Extra per pax</label>
            <div class="flex items-center gap-1 mt-1"><span class="text-lg font-bold" style="color:#9ca3af">&#8369;</span>
              <input id="input-pp-extraPerPax" class="form-input" type="number" min="0" placeholder="350" oninput="updatePerPaxPreview()" /></div>
          </div>
          <div>
            <label class="text-sm font-semibold" style="color:#374151">Maximum pax</label>
            <input id="input-pp-maxPax" class="form-input mt-1" type="number" min="1" placeholder="11" oninput="updatePerPaxPreview()" />
          </div>
        </div>
        <p id="pp-preview" class="text-sm mt-4" style="color:var(--primary)"></p>
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="confirmPerPax()">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── 11: Daily rate ── -->
    <div class="step" data-step="dailyRate">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/><path d="M12 18V6"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Pricing</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Nightly rate?</h2>
        <p class="text-sm mb-6" style="color:#9ca3af">In Philippine Pesos (PHP).</p>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-bold" style="color:#9ca3af">&#8369;</span>
          <input id="input-dailyRate" class="form-input" type="number" min="0" placeholder="1500" style="font-size:1.5rem" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="advanceText('dailyRate')">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <span class="text-xs" style="color:#9ca3af">press <kbd class="px-1.5 py-0.5 rounded text-xs border" style="border-color:#e5e7eb">Enter</kbd></span>
        </div>
      </div>
    </div>

    <!-- ── 12: Monthly rate (optional) ── -->
    <div class="step" data-step="monthlyRate">
      <div class="w-full max-w-xl">
        <div class="flex items-center gap-2 mb-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span class="text-xs font-semibold uppercase tracking-widest" style="color:var(--primary)">Pricing</span>
        </div>
        <h2 class="text-3xl font-bold mb-1" style="color:#1a1a1a">Monthly rate? <span class="text-lg font-normal" style="color:#9ca3af">optional</span></h2>
        <p class="text-sm mb-6" style="color:#9ca3af">For long-stay guests. Leave blank if you don&rsquo;t offer monthly pricing.</p>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-bold" style="color:#9ca3af">&#8369;</span>
          <input id="input-monthlyRate" class="form-input" type="number" min="0" placeholder="25000" style="font-size:1.5rem" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <button class="ok-btn" onclick="advanceText('monthlyRate',true)">
            OK <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <button class="skip-link" onclick="skipStep()">Skip</button>
        </div>
      </div>
    </div>

    <!-- ── 13: Description ── -->
    <div class="step" data-step="description">
      <div class="w-full max-w-xl">
