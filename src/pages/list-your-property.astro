---
import { MUNICIPALITIES } from '../lib/locations'
import '../styles/global.css'
const GOOGLE_MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? ''
const WP_REST = import.meta.env.PUBLIC_WP_REST ?? 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
const categories = ['Apartment','Homestay','Hotel','Hut','Lodging']
const allAmenityTerms = ["Air conditioning", "Backyard", "Barbecue utensils", "BBQ grill", "Beach access", "Beach view", "Bed linens", "Bidet", "Body soap", "Building staff", "Cleaning available during stay", "Coffee", "Conditioner", "Dedicated workspace", "Essentials", "Extra pillows and blankets", "Fire extinguisher", "First aid kit", "Free parking on premises", "Kitchen", "Long term stays allowed", "Outdoor dining area", "Outdoor shower", "Pets allowed", "Private entrance", "Resort access", "Safe", "Self check-in", "Shampoo", "Smoking allowed", "TV", "Waterfront"]
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>List Your Property — Limasawa Booking</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260502" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=20260502" />
  <link rel="shortcut icon" href="/favicon.ico?v=20260502" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260502" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Nunito+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --primary: #3EC7CF; --primary-dark: #32B5BC; --primary-light: #E6F9FA;
      --primary-trans-10: rgba(62,199,207,0.10); --primary-trans-50: rgba(62,199,207,0.50);
      --secondary: #4C5B6C; --bg: #F5F8FB;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Nunito Sans', system-ui, sans-serif; background: var(--bg); }
    h1,h2,h3,h4,h5,h6 { font-family: 'DM Sans', system-ui, sans-serif; }

    /* Steps */
    .step {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 5rem 1.5rem 5rem;
      opacity: 0; transform: translateY(60px);
      transition: opacity 0.45s cubic-bezier(0.4,0,0.2,1), transform 0.45s cubic-bezier(0.4,0,0.2,1);
      pointer-events: none;
    }
    .step.active {
      opacity: 1; transform: translateY(0); pointer-events: auto;
    }
    .step.exiting {
      opacity: 0; transform: translateY(-40px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    /* Input base */
    .form-input {
      width: 100%; max-width: 540px;
      background: transparent; border: none; border-bottom: 2px solid #d1d5db;
      padding: 0.6rem 0; font-size: 1.25rem; color: #1a1a1a;
      outline: none; transition: border-color 0.2s;
    }
    .form-input:focus { border-color: var(--primary); }
    .form-input::placeholder { color: #9ca3af; }

    /* Choice chips */
    .choice-chip {
      cursor: pointer; border: 2px solid #e5e7eb; border-radius: 12px;
      padding: 0.85rem 1.25rem; text-align: left; background: white;
      transition: border-color 0.15s, background 0.15s, color 0.15s;
      font-size: 0.95rem; color: #374151;
    }
    .choice-chip:hover { border-color: var(--primary); }
    .choice-chip.selected { border-color: var(--primary); background: var(--primary-light); color: var(--primary); font-weight: 600; }

    .choice-btn {
      padding: .75rem 1rem; border: 2px solid #e5e7eb; border-radius: 12px;
      background: #fff; font-size: .95rem; font-weight: 600; color: #374151;
      cursor: pointer; transition: border-color .2s, background .2s, color .2s;
      font-family: inherit; text-align: center;
    }
    .choice-btn:hover { border-color: var(--primary); color: var(--primary); }
    .choice-btn.selected { border-color: var(--primary); background: var(--primary-light); color: var(--primary); }

    /* Counter */
    .counter-btn {
      width: 36px; height: 36px; border-radius: 50%; border: 2px solid #e5e7eb;
      background: white; cursor: pointer; font-size: 1.2rem; color: #374151;
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.15s, color 0.15s;
    }
    .counter-btn:hover { border-color: var(--primary); color: var(--primary); }
    .counter-val { width: 2.5rem; text-align: center; font-size: 1.1rem; font-weight: 600; }

    /* Amenity chips */
    .amenity-chip {
      cursor: pointer; border: 1.5px solid #e5e7eb; border-radius: 100px;
      padding: 0.5rem 1rem; font-size: 0.875rem; color: #374151; background: white;
      transition: border-color 0.15s, background 0.15s, color 0.15s; white-space: nowrap;
    }
    .amenity-chip.selected { border-color: var(--primary); background: var(--primary-light); color: var(--primary); font-weight: 600; }

    /* Tier cards */
    .tier-card {
      border: 2px solid #e5e7eb; border-radius: 18px; padding: 1.6rem 1.5rem;
      cursor: pointer; background: white; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
      display: flex; flex-direction: column; min-height: 100%;
    }
    .tier-card:hover { border-color: var(--primary); box-shadow: 0 6px 20px rgba(42,114,101,0.12); transform: translateY(-2px); }
    .tier-card.selected { border-color: var(--primary); background: var(--primary-light); }
    .tier-card.featured { border-color: var(--primary-dark); background: var(--primary-dark); color: white; }
    .tier-card.featured.selected { box-shadow: 0 8px 26px rgba(42,114,101,0.38); }

    /* Header: name + "Most popular" pill */
    .tier-head { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.4rem; }
    .tier-name { font-family:'DM Sans',sans-serif; font-size:1.1rem; font-weight:800; color:#1a1a1a; line-height:1; }
    .tier-card.featured .tier-name { color:#fff; }
    .tier-popular { font-size:.65rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; padding:.2rem .55rem; border-radius:999px; background:var(--primary-light); color:var(--primary); }
    .tier-card.featured .tier-popular { background:rgba(255,255,255,.15); color:#fff; }

    /* "Best for" tagline */
    .tier-tagline { font-size:.78rem; line-height:1.4; color:#6b7280; margin-bottom:.85rem; min-height:2.2em; }
    .tier-card.featured .tier-tagline { color:rgba(255,255,255,.85); }

    /* Price block — vertical stack, dominant final price */
    .tier-price-row { display:flex; align-items:baseline; gap:.45rem; margin-bottom:.15rem; line-height:1; flex-wrap:wrap; }
    .tier-price-now { font-size:2rem; font-weight:800; color:#1a1a1a; letter-spacing:-0.02em; }
    .tier-card.featured .tier-price-now { color:#fff; }

    /* Inline strikethrough used by the multi-listing 50%-off render. Defaults
       to muted grey on the white cards; switches to a translucent white on
       the Featured card so it stays readable on the dark teal background. */
    .tier-strike-inline { text-decoration:line-through; font-weight:600; opacity:.55; color:#9ca3af; margin-right:.35em; font-size:.55em; }
    .tier-card.featured .tier-strike-inline { color:rgba(255,255,255,.7); opacity:.8; }
    .yr-strike-inline { text-decoration:line-through; font-weight:600; opacity:.55; color:#9ca3af; margin-right:.4em; }
    .tier-card.featured .yr-strike-inline { color:rgba(255,255,255,.7); opacity:.8; }
    .tier-price-period { font-size:.85rem; font-weight:500; color:#9ca3af; margin-left:.1rem; }
    .tier-card.featured .tier-price-period { color:rgba(255,255,255,.7); }

    /* Yearly sub-row */
    .tier-yearly-row {
      display:flex; align-items:baseline; gap:.4rem; padding:.35rem 0 .85rem;
      font-size:.78rem; color:#6b7280; border-bottom:1px solid #f1f5f9; margin-bottom:.85rem;
    }
    .tier-card.featured .tier-yearly-row { color:rgba(255,255,255,.78); border-bottom-color:rgba(255,255,255,.15); }
    .tier-yearly-row .yr-label { font-weight:600; }
    .tier-yearly-row .yr-now { font-weight:700; color:#1a1a1a; }
    .tier-card.featured .tier-yearly-row .yr-now { color:#fff; }

    /* Inclusions list */
    .tier-includes { list-style:none; padding:0; margin:0 0 .25rem; flex:1; display:flex; flex-direction:column; gap:.45rem; }
    .tier-includes li { font-size:.83rem; line-height:1.4; color:#4b5563; display:flex; align-items:flex-start; gap:.5rem; }
    .tier-card.featured .tier-includes li { color:rgba(255,255,255,.92); }
    .tier-includes li svg { flex-shrink:0; margin-top:2px; color:var(--primary); }
    .tier-card.featured .tier-includes li svg { color:#fff; }

    /* Legacy support — kept for callers that still target this in JS */
    .price-line { display: flex; justify-content: space-between; gap: .75rem; font-size: .78rem; line-height: 1.4; }
    .price-line strong { color: #1a1a1a; }
    .tier-card.featured .price-line strong { color: #fff; }
    .tier-card.featured .price-line { color: rgba(255,255,255,.82); }

    .billing-card,
    .payment-method-card {
      border: 2px solid #e5e7eb; border-radius: 14px; background: #fff;
      padding: 1rem; cursor: pointer; transition: border-color .15s, background .15s, box-shadow .15s;
    }
    .billing-card:hover,
    .payment-method-card:hover { border-color: var(--primary); }
    .billing-card.selected,
    .payment-method-card.selected { border-color: var(--primary); background: var(--primary-light); box-shadow: 0 8px 22px rgba(42,114,101,.10); }
    .payment-qr {
      display: none; margin-top: 1rem; padding: 1rem; border: 1px solid #e5e7eb;
      border-radius: 14px; background: #fff;
    }
    .payment-qr.active { display: block; }
    .payment-qr img { width: min(260px, 100%); max-height: 320px; object-fit: contain; margin: 0 auto; display: block; border-radius: 12px; }

    /* OK button */
    .ok-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--primary); color: white; border: none; border-radius: 8px;
      padding: 0.75rem 1.5rem; font-size: 0.95rem; font-weight: 600; cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
    }
    .ok-btn:hover { opacity: 0.9; transform: translateY(-1px); }
    .ok-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    /* Skip link */
    .skip-link {
      color: #9ca3af; font-size: 0.85rem; cursor: pointer; text-decoration: underline;
      text-underline-offset: 3px; background: none; border: none; padding: 0;
    }
    .skip-link:hover { color: #6b7280; }

    /* Review rows */
    .review-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 0.6rem 0; border-bottom: 1px solid #e5e7eb; gap: 1rem; }
    .review-label { font-size: 0.8rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; min-width: 110px; }
    .review-value { font-size: 0.95rem; color: #1a1a1a; text-align: right; word-break: break-all; }

    /* Progress bar fill */
    #progress-fill { transition: width 0.5s cubic-bezier(0.4,0,0.2,1); }

    /* Drop zone */
    .drop-zone {
      border: 2px dashed #e5e7eb; border-radius: 16px;
      padding: 2rem 1.5rem; text-align: center; cursor: pointer;
      transition: border-color 0.2s, background 0.2s; background: white;
      position: relative;
    }
    .drop-zone:hover, .drop-zone.drag-over { border-color: var(--primary); background: var(--primary-light); }
    .drop-zone.has-media { border-style: solid; border-color: var(--primary); padding: 0.75rem; }
    .drop-zone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }

    /* Host photo preview */
    .host-photo-preview {
      width: 96px; height: 96px; border-radius: 50%; object-fit: cover;
      border: 3px solid var(--primary); display: block; margin: 0 auto;
    }

    /* Gallery grid */
    .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 1rem; }
    @media (min-width: 640px) { .gallery-grid { grid-template-columns: repeat(4, 1fr); } }
    .gallery-thumb { position: relative; aspect-ratio: 4/3; border-radius: 10px; overflow: hidden; background: #f3f4f6; }
    .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .gallery-thumb-remove {
      position: absolute; top: 5px; right: 5px; width: 22px; height: 22px; border-radius: 50%;
      background: rgba(0,0,0,0.55); border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center; color: white;
      transition: background 0.15s;
    }
    .gallery-thumb-remove:hover { background: rgba(239,68,68,0.85); }
    .gallery-thumb-uploading { display: flex; align-items: center; justify-content: center; background: #f3f4f6; }

    /* Map step */
    #map-container { height: 280px; border-radius: 14px; overflow: hidden; border: 2px solid #e5e7eb; background: #f3f4f6; }
    #map-container.active-map { border-color: var(--primary); }
    .map-search-result { padding: 0.65rem 1rem; font-size: 0.875rem; cursor: pointer; color: #1a1a1a; border-bottom: 1px solid #f3f4f6; }
    .map-search-result:hover { background: #f9fafb; }
    .map-search-result:last-child { border-bottom: none; }
    .map-search-result strong { display: block; font-weight: 600; }
    .map-search-result small { color: #9ca3af; font-size: 0.78rem; }

    /* Generator toggle */
    .generator-toggle { display: flex; gap: 0.75rem; }
    .gen-opt {
      flex: 1; border: 2px solid #e5e7eb; border-radius: 12px; padding: 0.9rem 1rem;
      cursor: pointer; background: white; text-align: center; font-size: 0.95rem;
      font-weight: 500; color: #374151; transition: border-color 0.15s, background 0.15s;
    }
    .gen-opt:hover { border-color: var(--primary); }
    .gen-opt.selected { border-color: var(--primary); background: var(--primary-light); color: var(--primary); font-weight: 600; }

    /* Spinner */
    @keyframes _spin { to { transform: rotate(360deg); } }
    .upload-spinner {
      width: 22px; height: 22px; border: 2.5px solid #e5e7eb;
      border-top-color: var(--primary); border-radius: 50%;
      animation: _spin 0.7s linear infinite;
    }

    @media (max-width: 640px) {
      body {
        background: var(--bg);
        overscroll-behavior: none;
      }

      #app {
        background: var(--bg) !important;
      }

      #app > .absolute.top-0 {
        padding-top: env(safe-area-inset-top);
        background: rgba(245, 248, 251, .94);
        border-bottom: 1px solid rgba(226, 235, 243, .9);
        backdrop-filter: blur(14px);
      }

      #app > .absolute.top-0 .h-1 {
        height: 3px;
      }

      #app > .absolute.top-0 .flex.items-center {
        min-height: 48px;
        padding: 9px 18px 10px;
      }

      #back-btn,
      #step-counter,
      #app > .absolute.top-0 a {
        font-size: 14px !important;
        line-height: 1;
      }

      #app > .absolute.top-0 a {
        max-width: 44vw;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .step {
        justify-content: center;
        align-items: stretch;
        padding: calc(92px + env(safe-area-inset-top)) 18px calc(34px + env(safe-area-inset-bottom));
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }

      .step > .w-full {
        max-width: none;
      }

      .step[data-step="tier"],
      .step[data-step="billing"],
      .step[data-step="accommodationCategory"],
      .step[data-step="placeType"],
      .step[data-step="municipality"],
      .step[data-step="barangay"],
      .step[data-step="mapLocation"],
      .step[data-step="amenities"],
      .step[data-step="gallery"],
      .step[data-step="payment"],
      .step[data-step="review"] {
        justify-content: flex-start;
      }

      .step h1,
      .step h2 {
        font-size: 24px !important;
        line-height: 1.12 !important;
        letter-spacing: 0;
      }

      .step h1 {
        font-size: 28px !important;
      }

      .step p {
        line-height: 1.45;
      }

      .step[data-step="tier"] > .w-full > p:first-child,
      .step[data-step="billing"] > .w-full > p:first-child {
        display: none;
      }

      .step[data-step="tier"] h2,
      .step[data-step="billing"] h2 {
        margin-top: 4px !important;
        margin-bottom: 4px !important;
      }

      .step[data-step="tier"] h2 + p,
      .step[data-step="billing"] h2 + p {
        margin-bottom: 12px !important;
        font-size: 13px !important;
      }

      .tier-card {
        border-width: 1.5px;
        border-radius: 14px;
        padding: 16px 18px;
      }

      .tier-card p.font-bold {
        font-size: 16px !important;
        margin-bottom: 4px !important;
      }

      .tier-card .text-2xl {
        font-size: 28px !important;
        line-height: 1.05 !important;
        margin-bottom: 12px !important;
      }

      .tier-card .text-sm,
      .tier-card .text-xs {
        font-size: 13px !important;
      }

      .tier-card ul {
        gap: 4px;
      }

      .tier-card li {
        line-height: 1.25;
      }

      .price-line {
        font-size: 13px;
        line-height: 1.35;
      }

      .billing-card,
      .payment-method-card,
      .choice-chip,
      .choice-btn {
        border-width: 1.5px;
        border-radius: 14px;
      }

      .step[data-step="tier"] .grid,
      .step[data-step="billing"] .grid {
        gap: 12px !important;
      }

      .step[data-step="tier"] .flex.justify-end,
      .step[data-step="billing"] .flex.justify-end {
        position: static;
        margin: 16px 0 0;
        padding: 0 0 calc(10px + env(safe-area-inset-bottom));
        background: transparent;
      }

      .step[data-step="tier"] .ok-btn,
      .step[data-step="billing"] .ok-btn {
        width: 100%;
        justify-content: center;
        min-height: 48px;
      }

      .form-input {
        font-size: 20px;
      }

      .drop-zone {
        padding: 1.4rem 1rem;
      }

      #map-container {
        height: min(300px, 42vh);
      }

      #amenity-dropdown {
        max-height: min(282px, 36vh);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--primary) #eef3f7;
      }

      #amenity-dropdown::-webkit-scrollbar {
        width: 7px;
      }

      #amenity-dropdown::-webkit-scrollbar-track {
        background: #eef3f7;
        border-radius: 999px;
      }

      #amenity-dropdown::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 999px;
      }
    }

    /* ── Quill rich-text editor (Long description step) ─────────────────── */
    /* Minimal styling so Quill matches the form's look */
    #quill-longDescription {
      min-height: 220px;
      border: 2px solid #e5e7eb;
      border-top: none;
      border-radius: 0 0 10px 10px;
      background: #fff;
    }
    #quill-toolbar {
      border: 2px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      border-radius: 10px 10px 0 0;
      background: #f9fafb;
    }
    .ql-editor {
      font-size: 0.975rem;
      line-height: 1.65;
      padding: 0.85rem 1rem;
      min-height: 200px;
    }
    .ql-editor.ql-blank::before {
      font-style: normal;
      color: #9ca3af;
      font-size: 0.975rem;
    }
    .ql-editor h2 { font-size: 1.4rem; font-weight: 700; margin: 0.6rem 0 0.4rem; }
    .ql-editor h3 { font-size: 1.15rem; font-weight: 700; margin: 0.5rem 0 0.3rem; }
  </style>

  <!-- Quill 2.0 — rich text editor for the Long description step -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
</head>

<body>
<div id="app" class="fixed inset-0 overflow-hidden" style="background: var(--cream);">

  <!-- Top bar -->
  <div class="absolute top-0 left-0 right-0 z-50">
    <!-- Progress bar -->
    <div class="h-1" style="background:#e5e7eb">
      <div id="progress-fill" class="h-full" style="background:var(--primary);width:0%"></div>
    </div>
    <!-- Nav: 3-column grid keeps the middle (logo) screen-centered -->
    <div class="px-5 pt-3 pb-2" style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center">
      <button id="back-btn"
        class="flex items-center gap-1 text-sm font-medium opacity-0 pointer-events-none transition-opacity justify-self-start"
        style="color:#6b7280"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back
      </button>
      <a href="/" class="text-sm font-semibold" style="color:var(--primary)">Limasawa Booking</a>
      <span id="step-counter" class="text-sm justify-self-end" style="color:#9ca3af"></span>
    </div>
    <!-- Edit-mode toolbar: jump-to-section + save changes (hidden by default, shown when ?edit=ID) -->
    <div id="edit-toolbar" class="hidden border-b" style="background:#fff;border-color:#e5e7eb">
      <div class="flex items-center gap-2 px-5 py-2 max-w-3xl mx-auto">
        <label for="edit-jump-select" class="text-xs font-semibold uppercase tracking-widest" style="color:#6b7280;flex-shrink:0">Jump to:</label>
        <select id="edit-jump-select"
          class="flex-1 px-3 py-2 text-sm rounded-md border"
          style="border-color:#d1d5db;background:#fff;color:#1a1a1a;cursor:pointer">
        </select>
        <button id="edit-save-btn" type="button"
          class="ok-btn flex items-center gap-1.5 px-4 py-2 text-sm whitespace-nowrap"
          onclick="submitListing()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Save changes
