        <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="/auth?redirect=/list-your-home" style="display:inline-flex;align-items:center;gap:0.5rem;background:var(--primary);color:#fff;font-weight:700;font-size:1rem;padding:0.85rem 2rem;border-radius:12px;text-decoration:none;transition:background 0.2s;"
