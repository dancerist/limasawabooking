---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Browse Stays — Limasawa Booking" showFooter={false}>
  <div class="stays-shell">
    <div class="stays-list" id="stays-list">
      <div class="stays-header">
        <h1>All Stays</h1>
      </div>
      <div class="stays-grid" id="stays-grid">
        <p class="empty-msg">Loading listings…</p>
      </div>
    </div>
    <div class="stays-map" id="stays-map">
      <p style="padding:2rem;color:var(--sb-text-muted)">Map coming soon.</p>
    </div>
  </div>
</Layout>

<style>
.stays-shell { display: flex; height: calc(100vh - 64px); overflow: hidden; }
.stays-list { flex: 0 0 480px; overflow-y: auto; padding: 1.5rem; border-right: 1px solid var(--sb-border); }
.stays-header { margin-bottom: 1rem; }
.stays-header h1 { font-size: 1.5rem; }
.stays-grid { display: flex; flex-direction: column; gap: 1rem; }
.stays-map { flex: 1; background: var(--sb-secondary-pale); }
.empty-msg { color: var(--sb-text-muted); }
@media (max-width: 768px) {
  .stays-shell { flex-direction: column; height: auto; }
  .stays-list { flex: none; border-right: none; border-bottom: 1px solid var(--sb-border); }
  .stays-map { display: none; }
}
</style>

<script>
  const REST = 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
  const grid = document.getElementById('stays-grid')!

  async function load() {
    try {
      const res = await fetch(`${REST}/listings?page=1&per_page=24`)
      if (!res.ok) throw new Error(res.statusText)
      const data = await res.json()
      const listings = Array.isArray(data.listings) ? data.listings : []
      if (!listings.length) { grid.innerHTML = '<p class="empty-msg">No listings yet.</p>'; return }
      grid.innerHTML = listings.map((l: any) => `
        <a href="/stay/${l.slug}" class="stay-card">
          ${l.thumb ? `<img src="${l.thumb}" alt="${l.title}" loading="lazy"/>` : '<div class="stay-card-img-placeholder"></div>'}
          <div class="stay-card-body">
            <h3>${l.title}</h3>
            <p>${l.muniName || ''}</p>
            ${l.price ? `<strong>₱${Number(l.price).toLocaleString()} / night</strong>` : ''}
          </div>
        </a>
      `).join('')
    } catch {
      grid.innerHTML = '<p class="empty-msg">Could not load listings.</p>'
    }
  }

  load()
</script>

<style is:global>
.stay-card { display:block;text-decoration:none;color:var(--sb-text);background:#fff;border:1px solid var(--sb-border);border-radius:var(--sb-radius-lg);overflow:hidden;transition:box-shadow .2s; }
.stay-card:hover { box-shadow:var(--sb-shadow-lg); }
.stay-card img { width:100%;height:180px;object-fit:cover; }
.stay-card-img-placeholder { width:100%;height:180px;background:var(--sb-secondary-pale); }
.stay-card-body { padding:1rem; }
.stay-card-body h3 { font-size:1rem;margin:0 0 .25rem; }
.stay-card-body p { font-size:.85rem;color:var(--sb-text-muted);margin:0 0 .5rem; }
.stay-card-body strong { font-size:.95rem;color:var(--sb-primary); }
</style>
