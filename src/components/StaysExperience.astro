---
interface Props {
  location?: string;       // location taxonomy slug to pre-apply (e.g. "general-luna")
  locationName?: string;   // display name for the location (e.g. "General Luna")
}
const { location = '', locationName = '' } = Astro.props;
const WP_REST = import.meta.env.PUBLIC_WP_REST ?? 'https://admin.limasawabooking.com/wp-json/limasawa/v1';
const GMAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? '';
---

{location && (
  <script is:inline set:html={`window.__sbInitialLocation = ${JSON.stringify({ slug: location, name: locationName })};`} />
)}


<!-- ═══ TOPBAR ═══════════════════════════════════════════════════════════ -->
<nav class="st-nav" id="st-nav">
  <div class="st-nav-inner">
    <button class="st-mobile-back" id="st-mobile-back" aria-label="Back">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/>
      </svg>
    </button>

    <a href="/" class="st-logo">
      <div class="st-brand">
        <span class="st-wordmark">Limasawa Booking</span>
        <span class="st-beta" aria-label="Beta version">BETA</span>
      </div>
    </a>

    <!-- Category pill strip — "All" is static; the rest are injected from /taxonomies -->
    <div class="st-cats" id="st-cats">
      <button class="st-cat active" data-cat="">All</button>
    </div>

    <button class="st-mobile-summary" id="st-mobile-summary" type="button">
      <span id="st-mobile-title">Homes in map area</span>
      <small id="st-mobile-subtitle">Limasawa Island</small>
    </button>

    <button class="st-filter-btn" id="st-filter-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
      </svg>
      Filters
      <span class="st-filter-count" id="st-filter-count" hidden>0</span>
    </button>
  </div>
</nav>

<!-- ═══ MAIN SPLIT ═══════════════════════════════════════════════════════ -->
<div class="st-shell">

  <!-- Left: scrollable listings -->
  <div class="st-list-panel" id="st-list-panel">
    <div class="st-result-bar">
      <span id="st-count">Loading…</span>
    </div>
    <div class="st-grid" id="st-grid"></div>
    <div class="st-page-actions" id="st-page-actions" hidden>
      <button class="st-load-more" id="st-load-more">Load more</button>
    </div>
    <div class="st-empty" id="st-empty" hidden>
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <h3>No places match your filters</h3>
      <p>Try adjusting or clearing your filters.</p>
      <button onclick="clearAllFilters()">Clear filters</button>
    </div>
  </div>

  <!-- Right: sticky map -->
  <div class="st-map-panel">
    <div id="map"></div>

    <!-- Map listing popup -->
    <div id="map-popup" class="mp-card" hidden>
      <a id="mp-card-link" href="#" class="mp-card-inner">
        <div class="mp-card-img-wrap">
          <!-- Gallery slider (slides injected by showMapPopup) -->
          <div class="sb-track" id="mp-track"></div>

          <!-- Arrows -->
          <button class="sb-arrow sb-prev" id="mp-prev" data-hidden aria-label="Previous photo">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="sb-arrow sb-next" id="mp-next" data-hidden aria-label="Next photo">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <!-- Dots -->
          <div class="sb-dots" id="mp-dots-wrap" hidden>
            <div class="sb-dots-clip"><div class="sb-dots-track" id="mp-dots"></div></div>
          </div>

          <div class="ac-badges" id="mp-card-badges"></div>

          <!-- Heart + close sit together top-right, same as listing card -->
          <div class="mp-card-actions">
            <button class="mp-card-heart" id="mp-card-heart" aria-label="Save"
              onclick="event.preventDefault();event.stopPropagation();mpToggleHeart()">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </button>
            <button class="mp-card-close" id="mp-card-close" aria-label="Close"
              onclick="event.preventDefault();event.stopPropagation();closeMapPopup()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

        </div>
        <div class="mp-card-body">
          <!-- Host avatar (straddles image/body boundary, mirrors AccommodationCard).
               Lives in .mp-card-body — not .mp-card-img-wrap — because the image
               wrap has overflow:hidden which clips the bottom half of the avatar. -->
          <div class="mp-card-avatar" id="mp-card-avatar"></div>
          <div class="mp-card-sub" id="mp-card-sub"></div>
          <div class="mp-card-title" id="mp-card-title"></div>
          <div class="mp-card-stats" id="mp-card-stats"></div>
          <div class="mp-card-price" id="mp-card-price"></div>
        </div>
      </a>
    </div>
  </div>
</div>

<button class="st-map-fab" id="st-map-toggle" type="button">
  Map
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3Z"/><path d="M9 3v15"/><path d="M15 6v15"/>
  </svg>
</button>

<button class="st-list-fab" id="st-list-toggle" type="button">
  Show list
</button>

<!-- ═══ FILTER OVERLAY ════════════════════════════════════════════════════ -->
<div class="fd-backdrop" id="fd-backdrop" hidden></div>
<div class="fd" id="fd" hidden role="dialog" aria-label="Filters">
  <div class="fd-head">
    <button class="fd-close" id="fd-close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <span class="fd-title">Filters</span>
    <div></div>
  </div>
  <div class="fd-body">

    <!-- Type of place -->
    <section class="fd-section">
      <h3 class="fd-sh">Type of place</h3>
      <div class="fd-type-row">
        <button class="fd-type active" data-type="">Any type</button>
        <button class="fd-type" data-type="room">Room</button>
        <button class="fd-type" data-type="entire">Entire home</button>
      </div>
    </section>

    <!-- Stay preferences -->
    <section class="fd-section fd-section-compact">
      <h3 class="fd-sh">Stay preferences</h3>
      <button class="fd-nomad" id="fd-nomad" type="button" data-badge="digital-nomad">
        <span>Digital nomad friendly</span>
        <small>Wifi, workspace, long-stay friendly</small>
      </button>
    </section>

    <!-- Rate mode -->
    <section class="fd-section fd-section-compact">
      <h3 class="fd-sh">Rate type</h3>
      <div class="fd-rate-row" aria-label="Rate type">
        <button class="fd-rate active" type="button" data-rate-mode="daily">Daily rate</button>
        <button class="fd-rate" type="button" data-rate-mode="monthly">Monthly rate</button>
      </div>
    </section>

    <!-- Rating -->
    <section class="fd-section fd-section-compact">
      <h3 class="fd-sh">Guest rating</h3>
      <div class="fd-rating-row">
        <button class="fd-rating-pill active" data-rating="0">Any</button>
        <button class="fd-rating-pill" data-rating="3">3★+</button>
        <button class="fd-rating-pill" data-rating="4">4★+</button>
        <button class="fd-rating-pill" data-rating="4.5">4.5★+</button>
      </div>
    </section>

    <!-- Price range -->
    <section class="fd-section">
      <h3 class="fd-sh">Price range</h3>
      <p class="fd-sh-sub" id="fd-price-sub">Nightly price in Philippine Peso</p>
      <div class="fd-quick-rates" aria-label="Quick rate filters">
        <button class="fd-quick-rate active" type="button" data-rate-band="any">Any rate</button>
        <button class="fd-quick-rate" type="button" data-rate-band="under-1500">Below ₱1,500</button>
        <button class="fd-quick-rate" type="button" data-rate-band="1500-5000">₱1,500 - ₱5,000</button>
        <button class="fd-quick-rate" type="button" data-rate-band="over-5000">Over ₱5,000</button>
      </div>
      <div class="fd-histogram" id="fd-histogram">
        <svg id="fd-hist-svg" width="100%" height="72" preserveAspectRatio="none"></svg>
      </div>
      <div class="fd-slider-wrap">
        <div class="fd-slider-track" id="fd-slider-track"></div>
        <input type="range" class="fd-range" id="fd-range-min" min="0" max="100" value="0" />
        <input type="range" class="fd-range" id="fd-range-max" min="0" max="100" value="100" />
      </div>
      <div class="fd-price-labels">
        <div class="fd-price-box">
          <span class="fd-price-lbl">Min</span>
          <span class="fd-price-val" id="fd-price-min-lbl">₱0</span>
        </div>
        <div class="fd-price-box fd-price-box-r">
          <span class="fd-price-lbl">Max</span>
          <span class="fd-price-val" id="fd-price-max-lbl">₱0+</span>
        </div>
      </div>
    </section>

    <!-- Accommodation type — pills injected from /taxonomies -->
    <section class="fd-section">
      <h3 class="fd-sh">Accommodation type</h3>
      <div class="fd-accom-pills" id="fd-accom-pills"></div>
    </section>

    <!-- Rooms and beds -->
    <section class="fd-section">
      <h3 class="fd-sh">Rooms and beds</h3>
      {[['Bedrooms','beds'],['Beds','bed-count'],['Bathrooms','baths']].map(([label, key]) => (
        <div class="fd-stepper-row">
          <span class="fd-stepper-label">{label}</span>
          <div class="fd-stepper">
            <button class="fd-step-btn" data-step-key={key} data-step-dir="-1">−</button>
            <span class="fd-step-val" id={`step-${key}`}>Any</span>
            <button class="fd-step-btn" data-step-key={key} data-step-dir="1">+</button>
          </div>
        </div>
      ))}
    </section>

    <!-- Amenities — pills + checkboxes injected from /taxonomies, kept in sync -->
    <section class="fd-section">
      <h3 class="fd-sh">Amenities</h3>
      <div class="fd-faq-pills" id="fd-amen-pills"></div>
      <div class="fd-amen-group">
        <div class="fd-amen-checks" id="fd-amen-checks"></div>
      </div>
    </section>

  </div>
  <div class="fd-foot">
    <button class="fd-clear" onclick="clearAllFilters()">Clear all</button>
    <button class="fd-apply" id="fd-apply">Show places</button>
  </div>
</div>

<!-- Google Maps JS API (loaded async) + MarkerClusterer. window.__gmapsReady
     resolves once the API is ready; boot() awaits it before initMap(). -->
<script src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js" is:inline></script>
<script is:inline define:vars={{ GMAPS_KEY }}>
  if (GMAPS_KEY) {
    window.__gmapsReady = new Promise(function (resolve) { window.__initGmaps = resolve })
    var gms = document.createElement('script')
    gms.src = 'https://maps.googleapis.com/maps/api/js?key=' + GMAPS_KEY + '&loading=async&callback=__initGmaps'
    gms.async = true
    document.head.appendChild(gms)
  }
</script>

<style is:global>
  /* ── Reset & tokens ───────────────────────────────── */
  :root {
    --ink: #1a2533; --ink-2: #4c5b6c; --ink-3: #64748b;
    --cyan: #25cece; --cyan-hover: #1eb8b8; --cyan-light: #e6f9fa;
    --sl-200: #e2ebf3; --sl-100: #f5f8fb;
    --nav-h: 64px;
  }

  /* ── Topbar ───────────────────────────────────────── */
  .st-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 300;
    height: var(--nav-h); background: #fff;
    border-bottom: 1px solid var(--sl-200);
  }
  .st-nav-inner {
    max-width: 100%; height: 100%;
    display: flex; align-items: center; gap: 16px;
    padding: 0 20px;
  }
  .st-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
  .st-logo-img { height: 30px; width: auto; }
  .st-brand    { display: flex; align-items: center; gap: 8px; line-height: 1; }
  .st-wordmark { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 16px; color: var(--ink); letter-spacing: -.01em; }
  .st-beta {
    font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 9px;
    letter-spacing: .12em; text-transform: uppercase; color: var(--cyan);
    background: rgba(37, 206, 206, .14);
    padding: 3px 6px; border-radius: 4px; line-height: 1;
  }
  .st-mobile-back,
  .st-mobile-summary,
  .st-map-fab,
  .st-list-fab { display: none; }

  .st-cats {
    flex: 1; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none;
    padding: 0 4px;
  }
  .st-cats::-webkit-scrollbar { display: none; }
  .st-cat {
    flex-shrink: 0; padding: 7px 16px; border-radius: 9999px;
    border: 1.5px solid var(--sl-200); background: #fff;
    font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500;
    color: var(--ink-2); cursor: pointer; transition: all 140ms; white-space: nowrap;
  }
  .st-cat:hover { border-color: var(--ink-2); color: var(--ink); }
  .st-cat.active { background: var(--ink); border-color: var(--ink); color: #fff; }

  .st-filter-btn {
    flex-shrink: 0; display: flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 9999px;
    border: 1.5px solid var(--sl-200); background: #fff;
    font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600;
    color: var(--ink); cursor: pointer; transition: all 140ms;
    position: relative;
  }
  .st-filter-btn:hover { border-color: var(--ink); }
  .st-filter-count {
    position: absolute; top: -6px; right: -6px;
    background: var(--ink); color: #fff;
    width: 18px; height: 18px; border-radius: 50%;
    font-size: 10px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .st-filter-count[hidden] { display: none; }

  .st-filter-btn svg {
    flex-shrink: 0;
  }

  /* ── Shell ────────────────────────────────────────── */
  .st-shell {
    display: flex; height: calc(100vh - var(--nav-h));
    margin-top: var(--nav-h); overflow: hidden;
  }

  /* ── List panel ───────────────────────────────────── */
  .st-list-panel {
    width: 55%; flex-shrink: 0;
    overflow-y: auto; padding: 20px 24px 40px;
  }
  .st-result-bar {
    font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700;
    color: var(--ink); margin-bottom: 18px; padding-bottom: 14px;
    border-bottom: 1px solid var(--sl-200);
  }
  .st-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .st-page-actions {
    display: flex; justify-content: center; padding: 28px 0 4px;
  }
  .st-page-actions[hidden] { display: none; }
  .st-load-more {
    border: 1.5px solid var(--ink); background: var(--ink); color: #fff;
    border-radius: 9999px; padding: 11px 24px;
    font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700;
    cursor: pointer; transition: background 140ms, transform 140ms;
  }
  .st-load-more:hover { background: #0d1e2b; transform: translateY(-1px); }
  .st-load-more:disabled { opacity: .55; cursor: wait; transform: none; }
  .st-empty {
    text-align: center; padding: 4rem 2rem;
    color: var(--ink-3);
  }
  .st-empty[hidden] { display: none; }
  .st-empty svg { margin: 0 auto 1rem; display: block; color: var(--sl-200); }
  .st-empty h3 { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: var(--ink); margin-bottom: .4rem; }
  .st-empty p  { font-size: .875rem; margin-bottom: 1.25rem; }
  .st-empty button {
    padding: .55rem 1.4rem; background: var(--ink); color: #fff; border: none;
    border-radius: 9999px; font-family: 'DM Sans', sans-serif; font-weight: 600;
    font-size: .875rem; cursor: pointer;
  }

  /* ── Listing card ─────────────────────────────────── */
  /* All .ac-* / .sb-* card styles live in src/styles/card.css (imported via global.css). */

  /* ── Map panel ────────────────────────────────────── */
  .st-map-panel { flex: 1; position: relative; }
  #map { width: 100%; height: 100%; }

  /* Leaflet price marker */
  .mp-pin {
    background: #fff; border: 1.5px solid rgba(0,0,0,.15);
    border-radius: 20px; padding: 5px 11px;
    font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 700;
    color: var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,.15);
    white-space: nowrap; cursor: pointer; transition: all 120ms;
    transform: translateZ(0);
  }
  .mp-pin:hover, .mp-pin.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .marker-cluster-small,
  .marker-cluster-medium,
  .marker-cluster-large { background: rgba(37,206,206,.18); }
  .marker-cluster-small div,
  .marker-cluster-medium div,
  .marker-cluster-large div {
    background: var(--ink); color: #fff;
    font-family: 'DM Sans', sans-serif; font-weight: 800;
  }

  /* ── Map popup card ───────────────────────────────── */
  .mp-card {
    position: absolute;
    width: 260px; z-index: 1200;
    background: #fff; border-radius: 16px;
    box-shadow: 0 8px 32px rgba(13,30,43,.22), 0 2px 8px rgba(13,30,43,.1);
    overflow: hidden;
    animation: mp-pop 180ms cubic-bezier(.22,.68,0,1.2);
  }
  .mp-card[hidden] { display: none; }
  @keyframes mp-pop {
    from { opacity: 0; transform: scale(.94) translateY(6px); }
    to   { opacity: 1; transform: scale(1)   translateY(0); }
  }

  .mp-card-inner { display: block; text-decoration: none; color: inherit; cursor: pointer; }

  .mp-card-img-wrap {
    position: relative; aspect-ratio: 4/3; overflow: hidden;
    background: #f3f4f6; border-radius: 16px 16px 0 0;
  }
  .mp-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 280ms; }
  .mp-card-inner:hover .mp-card-img-wrap img { transform: scale(1.04); }
  /* Popup slider — show arrows on hover, scale images */
  .mp-card-img-wrap:hover .sb-arrow { opacity: 1; pointer-events: auto; }
  .mp-card-inner:hover .sb-slide img { transform: scale(1.04); }

  /* Heart + close grouped top-right, matching listing card style */
  .mp-card-actions {
    position: absolute; top: 10px; right: 10px; z-index: 10;
    display: flex; gap: 6px;
  }
  .mp-card-heart,
  .mp-card-close {
    width: 32px; height: 32px; border-radius: 50%; border: none;
    background: rgba(255,255,255,.92); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: #6b7280; box-shadow: 0 1px 4px rgba(0,0,0,.18); transition: all 160ms;
  }
  .mp-card-heart:hover { color: #e53e3e; transform: scale(1.1); }
  .mp-card-close:hover { background: #fff; color: #111827; }
  .mp-card-heart.saved { color: #e53e3e; }
  .mp-card-heart.saved svg { fill: #e53e3e; stroke: #e53e3e; }

  /* Host avatar — straddles image/body boundary on the left.
     Anchored to the top of .mp-card-body (which is position:relative and has
     no overflow:hidden) so the avatar isn't clipped like it was when it lived
     inside .mp-card-img-wrap. */
  .mp-card-avatar {
    position: absolute; top: 0; left: 14px;
    transform: translateY(-50%);
    z-index: 8;
  }
  .mp-card-avatar .mp-av-rel { position: relative; width: 44px; height: 44px; }
  .mp-card-avatar .mp-av {
    width: 44px; height: 44px; border-radius: 50%;
    border: 2.5px solid #fff; background: #e5e7eb; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    color: #6b7280; font-size: 12px; font-weight: 700;
    box-shadow: 0 1px 4px rgba(0,0,0,.12);
  }
  .mp-card-avatar .mp-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mp-card-avatar .mp-av-verified {
    position: absolute; bottom: -2px; right: -2px;
    width: 16px; height: 16px; border-radius: 50%; background: #3b82f6;
    border: 2px solid #fff; display: flex; align-items: center; justify-content: center;
  }

  .mp-card-body { position: relative; padding: 32px 14px 14px; }
  .mp-card-sub  { font-size: 12px; color: #6b7280; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mp-card-title {
    font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 14px;
    color: #111827; line-height: 1.35;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    margin-bottom: 8px;
  }
  .mp-card-stats { font-size: 12px; color: #6b7280; display: flex; align-items: center; gap: 6px; margin-bottom: 10px; }
  .mp-card-price { display: flex; justify-content: flex-end; }
