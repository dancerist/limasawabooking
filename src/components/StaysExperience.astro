        row.className = 'fd-check-row'
        row.innerHTML = `<input type="checkbox" class="fd-amen-cb" value="${slug}" /><span>${escapeHtml(label)}</span>`
        const cb = row.querySelector('.fd-amen-cb')
        cb.addEventListener('change', () => applySlug(slug, cb.checked))
        grid.appendChild(row)
        slugToControls.set(slug, { ...(slugToControls.get(slug) || {}), cb })
      })
      block.appendChild(grid)
      amenChecks.appendChild(block)
    })
  }
}

function paramsForCards(page = 1, opts = {}) {
  const params = new URLSearchParams({ page: String(page), per_page: String(PER_PAGE) })
  const shouldUseBounds = !opts.skipBounds && (!isMobileStays() || mobileView === 'map' || opts.forceBounds)
  const bounds = shouldUseBounds ? (opts.bounds ?? mapInstance?.getBounds()) : null
  if (bounds) {
    params.set('bounds', [
      bounds.getSouthWest().lat(),
      bounds.getSouthWest().lng(),
      bounds.getNorthEast().lat(),
      bounds.getNorthEast().lng(),
    ].join(','))
  }

  if (F.cat) params.set('category', F.cat)
  if (F.type) params.set('type', F.type)
  if (F.cats.size) params.set('cats', [...F.cats].join(','))
  if (F.badge) params.set('badge', F.badge)
  if (F.rateMode) params.set('rate_mode', F.rateMode)
  if (F.priceMin > 0) params.set('price_min', String(F.priceMin))
  if (F.priceMax < Infinity) params.set('price_max', String(F.priceMax))
  const minBeds = Math.max(F.beds, F.bedCount)
  if (minBeds > 0) params.set('beds', String(minBeds))
  if (F.baths > 0) params.set('baths', String(F.baths))
  if (F.amenities.size) params.set('amenities', [...F.amenities].join(','))
  if (F.minRating > 0) params.set('min_rating', String(F.minRating))
  if (F.location) params.set('location', F.location)

  return params
}

function paramsForListingIndex(opts = {}) {
  const params = paramsForCards(1, opts)
  params.delete('page')
  params.set('per_page', '48')
  params.delete('badge')
  params.delete('rate_mode')
  if (F.rateMode === 'monthly') {
    params.delete('price_min')
    params.delete('price_max')
  }
  return params
}

function needsClientIndexFallback() {
  return Boolean(F.badge || F.rateMode === 'monthly')
}

function cacheKeyForParams(params) {
  const clone = new URLSearchParams(params)
  clone.delete('page')
  return clone.toString()
}

async function fetchListingIndex(opts = {}, signal) {
  const baseParams = paramsForListingIndex(opts)
  const key = cacheKeyForParams(baseParams)
  if (listingIndexCache.has(key)) return listingIndexCache.get(key)

  const firstPageParams = new URLSearchParams(baseParams)
  firstPageParams.set('page', '1')
  const firstPage = await fetchJson(`${WP_REST_BASE}/listings?${firstPageParams}`, { signal })
  const listings = Array.isArray(firstPage.listings) ? [...firstPage.listings] : []
  const pages = Number(firstPage.pages || 1)

  for (let page = 2; page <= pages; page++) {
    const pageParams = new URLSearchParams(baseParams)
    pageParams.set('page', String(page))
    const data = await fetchJson(`${WP_REST_BASE}/listings?${pageParams}`, { signal })
    if (Array.isArray(data.listings)) listings.push(...data.listings)
  }

  listingIndexCache.set(key, listings)
  return listings
}

function setLoading(isLoading, append = false) {
  const grid = document.getElementById('st-grid')
  const count = document.getElementById('st-count')
  const btn = document.getElementById('st-load-more')
  if (btn) btn.disabled = isLoading
  if (!isLoading || append) return
  count.textContent = 'Loading places…'
  grid.innerHTML = Array.from({ length: 9 }, () => `
    <div class="ac-skel">
      <div class="ac-skel-img"></div>
      <div class="ac-skel-body">
        <div class="ac-skel-line"></div>
        <div class="ac-skel-line"></div>
        <div class="ac-skel-line"></div>
      </div>
    </div>
  `).join('')
}

async function fetchCards(page = 1, opts = {}) {
  const append = !!opts.append
  if (fetchController) fetchController.abort()
  const controller = new AbortController()
  fetchController = controller
  setLoading(true, append)

  try {
    const params = paramsForCards(page, opts)
    const data = await fetchJson(`${WP_REST_BASE}/listings?${params}`, { signal: controller.signal })
    let listings = Array.isArray(data.listings) ? data.listings : []
    const hasServerFilters = data.server_filters === true

    if (!hasServerFilters && needsClientIndexFallback()) {
      const allListings = await fetchListingIndex(opts, controller.signal)
      const filtered = allListings.filter(matchesClientFilters)
      totalResults = filtered.length
      totalPages = totalResults > 0 ? Math.ceil(totalResults / PER_PAGE) : 0
      currentPage = page
      listings = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE)
    } else {
      currentPage = Number(data.page || page)
      totalPages = Number(data.pages || 1)
      totalResults = Number(data.total || listings.length)
    }

    listings.forEach(l => {
      if (l?.slug) cardCache.set(l.slug, l)
    })

    currentListings = append ? currentListings.concat(listings) : listings

    renderCards(currentListings)
    renderPagination()
    updateApplyButton()
  } catch (err) {
    if (err.name === 'AbortError') return
    console.error(err)
    renderCards([])
    document.getElementById('st-count').textContent = 'Could not load places'
  } finally {
    setLoading(false, append)
    if (fetchController === controller) fetchController = null
  }

  updateFilterCount()
}

function renderPagination() {
  const wrap = document.getElementById('st-page-actions')
  const btn = document.getElementById('st-load-more')
  if (!wrap || !btn) return
  wrap.hidden = currentPage >= totalPages || totalPages <= 1
  btn.textContent = currentPage < totalPages ? `Load more (${currentPage + 1} of ${totalPages})` : 'All places loaded'
}

// ─────────────────────────────────────────────────────────────────────────────
// Card rendering — see src/scripts/card-template.js for the shared template.
// ─────────────────────────────────────────────────────────────────────────────

function activeRate(l) {
  return F.rateMode === 'monthly' ? Number(l.monthly || 0) : Number(l.price || 0)
}

function matchesClientFilters(l) {
  if (F.rateMode === 'monthly' && !Number(l.monthly || 0)) return false
  if (F.badge) {
    const hasBadge = badgeLabels(l).some(badge => badgeSlug(badge).includes(F.badge))
    if (!hasBadge) return false
  }
  const rate = activeRate(l)
  if (F.priceMin > 0 && rate < F.priceMin) return false
  if (F.priceMax < Infinity && rate > F.priceMax) return false
  return true
}

function badgeSlug(label) {
  return String(label || '')
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')
}

function badgeText(badge) {
  if (!badge) return ''
  if (typeof badge === 'object') {
    return badge.label || badge.value || badge.name || badge.slug || badge.key || ''
  }
  return String(badge)
}

function badgeLabels(listing) {
  const raw = Array.isArray(listing?.badges)
    ? listing.badges
    : Array.isArray(listing?.accommodationBadges)
      ? listing.accommodationBadges
      : []

  return raw
    .map(badgeText)
    .map((badge) => badge.trim())
    .filter(Boolean)
}

// badgeChips() lives in src/scripts/card-template.js as badgeChipsHTML().
// Exposed on window.__badgeChipsHTML by the loader script above.

function renderCards(items) {
  const grid  = document.getElementById('st-grid')
  const empty = document.getElementById('st-empty')
  const count = document.getElementById('st-count')
  const showing = items.length
  const total = totalResults || showing
  count.textContent = total > showing
    ? `Showing ${showing} of ${total} place${total !== 1 ? 's' : ''} in this area`
    : `${total} place${total !== 1 ? 's' : ''} in this area`

  if (!items.length) {
    grid.innerHTML = ''
    empty.hidden = false
    return
  }
  empty.hidden = true

  const sb = window.__sb
  grid.innerHTML = items.map(l => window.__cardHTML(l, {
    saved:    sb ? sb.isSaved(l.slug) : false,
    rateMode: F.rateMode,
  })).join('')

  // Init sliders on newly rendered cards (shared logic from card-slider.js)
  window.__initSliders?.(grid)
}

