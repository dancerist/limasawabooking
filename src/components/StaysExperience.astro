  // Expose shared slider init + card template for cards injected after REST fetches.
  import { initSliders } from '../scripts/card-slider.js'
  import { cardHTML, badgeChipsHTML, escapeHtml } from '../scripts/card-template.js'
  window.__initSliders   = initSliders
  window.__cardHTML      = cardHTML
  window.__badgeChipsHTML = badgeChipsHTML
  window.__escapeHtml    = escapeHtml
</script>

<script define:vars={{ WP_REST }}>
  window.__SB_WP_REST = WP_REST
</script>

<script is:inline>
// ─────────────────────────────────────────────────────────────────────────────
// Constants & state
// ─────────────────────────────────────────────────────────────────────────────
const WP_REST_BASE = window.__SB_WP_REST || 'https://admin.limasawabooking.com/wp-json/limasawa/v1'
// Limasawa barangay fallback centroids — only used if a listing lacks a real
// ACF map pin (all current listings have one, so this is a safety net).
const MUNI_COORDS = {
  'san-bernardo': [9.9492, 125.0650],
  'san-agustin':  [9.9300, 125.0700],
  'lugsongan':    [9.9550, 125.0720],
  'magallanes':   [9.9180, 125.0820],
  'cabulihan':    [9.9420, 125.0600],
  'triana':       [9.9330, 125.0620],
}

const HIST_BUCKETS = 24
const PER_PAGE = 24
const PIN_CACHE_KEY = 'sb_pins_v1'
let mapInstance = null
let clusterer = null         // markerClusterer.MarkerClusterer
let mapProjOverlay = null    // OverlayView used only for pixel projection
let mapReady = false         // gate idle-refetch until initial load is done
let mapMoveTimer = null
let fetchController = null
let allPins = []
let cardCache = new Map()
let currentPage = 1
let totalPages = 1
let totalResults = 0
let currentListings = []
let priceMin = 0
let priceMax = 0
let mobileView = 'list'
const listingIndexCache = new Map()
let liveFilterTimer = null

function isMobileStays() {
  return window.matchMedia('(max-width: 1180px)').matches
}

function setMobileView(view) {
  mobileView = view === 'map' ? 'map' : 'list'
  document.body.classList.toggle('st-map-mode', mobileView === 'map')
  document.getElementById('st-mobile-subtitle').textContent =
    mobileView === 'map' ? 'Tap a price to preview' : 'Limasawa Island'
  if (mobileView === 'map') {
    window.setTimeout(() => {
      if (mapInstance && window.google) google.maps.event.trigger(mapInstance, 'resize')
      if (activePopupListing) positionPopup()
    }, 80)
  }
}

// Use real GPS pin from WordPress ACF google_map field; fall back to municipality centroid
function listingCoords(l) {
  if (l.lat && l.lng) return [l.lat, l.lng]
  if (l.muniSlug && MUNI_COORDS[l.muniSlug]) return MUNI_COORDS[l.muniSlug]
  return null
}

// Filter state
const F = {
  cat:       '',   // category slug
  type:      '',   // '' | 'room' | 'entire'
  cats:      new Set(),  // selected accommodation-type pills
  badge:     '',
  rateMode:  'daily',
  rateBand:  'any',
  priceMin:  0,
  priceMax:  Infinity,
  beds:      0,
  bedCount:  0,
  baths:     0,
  amenities: new Set(),
  minRating: 0,
  location:  (typeof window !== 'undefined' && window.__sbInitialLocation?.slug) || '',
}

function fmt(n) {
  if (n >= 1000) return '₱' + (n/1000).toFixed(0) + 'k'
  return '₱' + n.toLocaleString()
}

// ─────────────────────────────────────────────────────────────────────────────
// REST data
// ─────────────────────────────────────────────────────────────────────────────
function escapeHtml(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
}

async function fetchJson(url, options = {}) {
  const res = await fetch(url, options)
  if (!res.ok) throw new Error(`Request failed: ${res.status}`)
  return res.json()
}

async function fetchPins() {
  // Skip session cache when filtering by location — keeps the cache for the
  // global /stays page only (matches backend cache behavior).
  if (!F.location) {
    try {
      const cached = sessionStorage.getItem(PIN_CACHE_KEY)
      if (cached) {
        const parsed = JSON.parse(cached)
        if (Array.isArray(parsed)) return parsed
      }
    } catch (_) {}
  }

  const url = F.location
    ? `${WP_REST_BASE}/map-pins?location=${encodeURIComponent(F.location)}`
    : `${WP_REST_BASE}/map-pins`
  const pins = await fetchJson(url)
  if (!F.location) {
    try { sessionStorage.setItem(PIN_CACHE_KEY, JSON.stringify(pins)) } catch (_) {}
  }
  return Array.isArray(pins) ? pins : []
}

const TAX_CACHE_KEY = 'sb_tax_v1'
async function fetchTaxonomies() {
  try {
    const cached = sessionStorage.getItem(TAX_CACHE_KEY)
    if (cached) {
      const parsed = JSON.parse(cached)
      if (parsed && Array.isArray(parsed.categories) && Array.isArray(parsed.amenities)) return parsed
    }
  } catch (_) {}

  const tax = await fetchJson(`${WP_REST_BASE}/taxonomies`)
  const safe = {
    categories: Array.isArray(tax?.categories) ? tax.categories : [],
    amenities:  Array.isArray(tax?.amenities)  ? tax.amenities  : [],
  }
  try { sessionStorage.setItem(TAX_CACHE_KEY, JSON.stringify(safe)) } catch (_) {}
  return safe
}

/**
 * Render dynamic filter UI from the taxonomies endpoint.
 *  - Topbar category strip (#st-cats): keeps the static "All" pill, appends one per category
 *  - Filter drawer "Accommodation type" pills (#fd-accom-pills)
 *  - Filter drawer "Amenities" pills (#fd-amen-pills) and checkboxes (#fd-amen-checks)
 *
 * Pills + checkboxes use the same data source so they stay in sync; click handlers
 * for both are wired here (not in DOMContentLoaded) since the elements are dynamic.
 */
function renderDynamicFilters(tax) {
  // ── Topbar pills ────────────────────────────────────────────────────────
  const cats = document.getElementById('st-cats')
  if (cats) {
    // Remove any previously-injected pills (keep the static "All" at index 0)
    cats.querySelectorAll('.st-cat[data-cat]:not([data-cat=""])').forEach(el => el.remove())
    tax.categories.forEach(c => {
      const btn = document.createElement('button')
      btn.className = 'st-cat'
      btn.dataset.cat = c.slug
      btn.textContent = c.name
      btn.addEventListener('click', () => {
        document.querySelectorAll('.st-cat').forEach(b => b.classList.remove('active'))
        btn.classList.add('active')
        F.cat = c.slug
        F.cats.clear()
        document.querySelectorAll('.fd-pill').forEach(b => b.classList.toggle('active', false))
        fetchCards(1, { skipBounds: true })
      })
      cats.appendChild(btn)
    })
  }

  // ── Drawer accommodation-type pills ────────────────────────────────────
  const accomPills = document.getElementById('fd-accom-pills')
  if (accomPills) {
    accomPills.innerHTML = ''
    tax.categories.forEach(c => {
      const btn = document.createElement('button')
      btn.className = 'fd-pill'
      btn.dataset.catPill = c.slug
      btn.textContent = c.name
      btn.addEventListener('click', () => {
        btn.classList.toggle('active')
        if (F.cats.has(c.slug)) F.cats.delete(c.slug)
        else F.cats.add(c.slug)
        scheduleFilterResults()
      })
      accomPills.appendChild(btn)
    })
  }

  // ── Drawer amenity pills + checkboxes (curated, deduplicated) ──────────
  // FAQ pills: same 10 highlights surfaced on the listing page.
  // Grouped checkboxes: hand-picked canonical amenities, no redundant variants.
  // Anything not in this curated list is intentionally hidden — taxonomy has 180+
  // raw terms (6 variants of "AC", etc.) and dumping them all is unusable.
  const FAQ_PILLS = [
    { slug: 'wifi',                                  label: 'Wifi' },
    { slug: 'air-conditioning',                      label: 'Air conditioning' },
    { slug: 'kitchen',                               label: 'Kitchen' },
    { slug: 'free-parking-on-premises',              label: 'Free parking' },
    { slug: 'beach-access-walking-distance',         label: 'Beach access' },
    { slug: 'dedicated-workspace',                   label: 'Workspace' },
    { slug: 'pets-allowed',                          label: 'Pets allowed' },
    { slug: 'with-generator',                        label: 'Generator' },
    { slug: 'hot-shower',                            label: 'Hot shower' },
    { slug: 'exterior-security-cameras-on-property', label: 'Security cameras' },
  ]
  const AMEN_GROUPS = [
    { title: 'Essentials', items: [
      ['bed-linens',      'Bed linens'],
      ['hot-water',       'Hot water'],
      ['bidet',           'Bidet'],
      ['hangers',         'Hangers'],
      ['iron',            'Iron'],
      ['hair-dryer',      'Hair dryer'],
      ['shampoo',         'Shampoo'],
      ['body-soap',       'Body soap'],
      ['essentials',      'Essentials kit'],
    ]},
    { title: 'Kitchen & dining', items: [
      ['refrigerator',          'Refrigerator'],
      ['coffee-maker',          'Coffee maker'],
      ['rice-maker',            'Rice maker'],
      ['hot-water-kettle',      'Hot water kettle'],
      ['cooking-basics',        'Cooking basics'],
      ['dishes-and-silverware', 'Dishes & silverware'],
      ['dining-table',          'Dining table'],
      ['outdoor-dining-area',   'Outdoor dining area'],
      ['bbq-grill',             'BBQ grill'],
    ]},
    { title: 'Comfort & safety', items: [
      ['tv',                'TV'],
      ['portable-fans',     'Fan'],
      ['fire-extinguisher', 'Fire extinguisher'],
      ['first-aid-kit',     'First aid kit'],
      ['self-check-in',     'Self check-in'],
      ['private-entrance',  'Private entrance'],
    ]},
    { title: 'Outdoor & views', items: [
      ['pool',                     'Pool'],
      ['private-pool',             'Private pool'],
      ['private-patio-or-balcony', 'Private patio or balcony'],
      ['outdor-furniture',         'Outdoor furniture'],
      ['garden-view',              'Garden view'],
      ['ocean-view',               'Ocean view'],
      ['sea-view',                 'Sea view'],
      ['mountain-view',            'Mountain view'],
      ['backyard',                 'Backyard'],
    ]},
    { title: 'Family', items: [
      ['crib',                       'Crib'],
      ['high-chair',                 'High chair'],
      ['childrens-books-and-toys',   "Children's books & toys"],
      ['babysitter-recommendations', 'Babysitter recommendations'],
    ]},
    { title: 'Stay & services', items: [
      ['long-term-stays-allowed',  'Long-term stays allowed'],
      ['luggage-dropoff-allowed',  'Luggage dropoff'],
      ['host-greets-you',          'Host greets you'],
      ['laundromat-nearby',        'Laundromat nearby'],
      ['washer',                   'Washer'],
      ['drying-rack-for-clothing', 'Drying rack'],
    ]},
  ]

  const amenPills  = document.getElementById('fd-amen-pills')
  const amenChecks = document.getElementById('fd-amen-checks')
  if (amenPills && amenChecks) {
    // Only show items that actually exist in the live taxonomy — if the slug
    // is missing, the filter would return zero results anyway.
    const liveSlugs = new Set((tax.amenities || []).map(a => a.slug))
    const slugToControls = new Map() // slug -> { pill?, cb? }

    amenPills.innerHTML  = ''
    amenChecks.innerHTML = ''

    function syncSlug(slug, on) {
      const c = slugToControls.get(slug)
      if (!c) return
      if (c.pill) c.pill.classList.toggle('active', on)
      if (c.cb)   c.cb.checked = on
    }
    function applySlug(slug, on) {
      if (on) F.amenities.add(slug); else F.amenities.delete(slug)
      syncSlug(slug, on)
      scheduleFilterResults()
    }

    // FAQ pills
    FAQ_PILLS.forEach(({ slug, label }) => {
      if (!liveSlugs.has(slug)) return
      const pill = document.createElement('button')
      pill.type = 'button'
      pill.className = 'fd-faq-pill'
      pill.dataset.amen = slug
      pill.textContent = label
      pill.addEventListener('click', () => applySlug(slug, !pill.classList.contains('active')))
      amenPills.appendChild(pill)
      slugToControls.set(slug, { ...(slugToControls.get(slug) || {}), pill })
    })

    // Grouped checkboxes
    AMEN_GROUPS.forEach(g => {
      const items = g.items.filter(([slug]) => liveSlugs.has(slug))
      if (!items.length) return
      const block = document.createElement('div')
      block.className = 'fd-amen-block'
      block.innerHTML = `<div class="fd-amen-group-title">${escapeHtml(g.title)}</div>`
      const grid = document.createElement('div')
      grid.className = 'fd-amen-grid'
      items.forEach(([slug, label]) => {
