// Map
// ─────────────────────────────────────────────────────────────────────────────
function initMap() {
  mapInstance = new google.maps.Map(document.getElementById('map'), {
    center: { lat: 9.9333, lng: 125.0667 },
    zoom: 13,
    mapTypeControl: false,
    streetViewControl: false,
    fullscreenControl: false,
    clickableIcons: false,
    gestureHandling: 'greedy',
  })
  window.__stMap = mapInstance

  // Hidden overlay used purely to access the pixel projection (positionPopup).
  mapProjOverlay = new google.maps.OverlayView()
  mapProjOverlay.onAdd = function () {}
  mapProjOverlay.draw = function () {}
  mapProjOverlay.onRemove = function () {}
  mapProjOverlay.setMap(mapInstance)

  // Click empty map → close popup
  mapInstance.addListener('click', closeMapPopup)

  // Keep popup anchored to its pin while panning/zooming (fires continuously)
  mapInstance.addListener('bounds_changed', positionPopup)

  // Viewport filter — refetch when the user pans/zooms (debounced). Guarded by
  // mapReady so the initial programmatic fitBounds doesn't trigger a refetch.
  mapInstance.addListener('idle', function () {
    if (!mapReady) return
    if (isMobileStays() && mobileView !== 'map') return
    clearTimeout(mapMoveTimer)
    mapMoveTimer = setTimeout(function () {
      fetchCards(1, { forceBounds: true })
      const listPanel = document.getElementById('st-list-panel')
      if (listPanel) listPanel.scrollTop = 0
    }, 400)
  })
}

// ─────────────────────────────────────────────────────────────────────────────
// Map popup
// ─────────────────────────────────────────────────────────────────────────────
let activePopupSlug    = null
let activePopupListing = null
let mpCur   = 0
let mpTotal = 0

function mpGoTo(idx) {
  const track = document.getElementById('mp-track')
  if (!track) return
  idx = Math.max(0, Math.min(idx, mpTotal - 1))
  track.scrollTo({ left: idx * track.offsetWidth, behavior: 'smooth' })
  mpCur = idx
  document.getElementById('mp-dots')?.querySelectorAll('.sb-dot').forEach((d, i) => d.classList.toggle('active', i === idx))
  document.getElementById('mp-prev').toggleAttribute('data-hidden', idx === 0)
  document.getElementById('mp-next').toggleAttribute('data-hidden', idx >= mpTotal - 1)
}

function positionPopup() {
  if (!activePopupListing || !mapInstance) return
  const popup  = document.getElementById('map-popup')
  const mapEl  = document.getElementById('map')
  const coords = listingCoords(activePopupListing)
  if (!coords) return

  if (isMobileStays()) {
    popup.style.left = ''
    popup.style.top = ''
    return
  }

  const proj = mapProjOverlay && mapProjOverlay.getProjection ? mapProjOverlay.getProjection() : null
  if (!proj) return
  const point = proj.fromLatLngToContainerPixel(new google.maps.LatLng(coords[0], coords[1]))
  const PIN_H  = 34   // approx height of .mp-pin pill
  const GAP    = 6    // gap between pin bottom and popup top
  const popupW = 260
  const mapW   = mapEl.offsetWidth
  const mapH   = mapEl.offsetHeight

  // Center popup horizontally on pin, clamp to map edges
  let left = point.x - popupW / 2
  left = Math.max(8, Math.min(left, mapW - popupW - 8))

  // Place below pin; if not enough room, flip above
  let top = point.y + PIN_H + GAP
  const popupH = popup.offsetHeight || 300
  if (top + popupH > mapH - 8) top = point.y - popupH - GAP

  popup.style.left = left + 'px'
  popup.style.top  = top  + 'px'
}

function normalizePin(pin) {
  return {
    slug: pin.slug || '',
    price: Number(pin.price || 0),
    lat: Number(pin.lat || 0) || null,
    lng: Number(pin.lng || 0) || null,
    title: pin.title || '',
    gallery: [],
  }
}

async function listingForPin(pin) {
  if (cardCache.has(pin.slug)) return cardCache.get(pin.slug)
  const lat = Number(pin.lat)
  const lng = Number(pin.lng)
  if (lat && lng) {
    try {
      const pad = 0.00035
      const params = new URLSearchParams({
        page: '1',
        per_page: '48',
        bounds: [lat - pad, lng - pad, lat + pad, lng + pad].join(','),
      })
      const data = await fetchJson(`${WP_REST_BASE}/listings?${params}`)
      const match = (data.listings || []).find(l => l.slug === pin.slug)
      ;(data.listings || []).forEach(l => {
        if (l?.slug) cardCache.set(l.slug, l)
      })
      if (match) return match
    } catch (err) {
      console.warn('Could not hydrate pin popup', err)
    }
  }
  return normalizePin(pin)
}

async function showMapPopup(l) {
  if (isMobileStays()) setMobileView('map')
  l = await listingForPin(l)
  const popup   = document.getElementById('map-popup')
  const link    = document.getElementById('mp-card-link')
  const sub     = document.getElementById('mp-card-sub')
  const title   = document.getElementById('mp-card-title')
  const stats   = document.getElementById('mp-card-stats')
  const price   = document.getElementById('mp-card-price')
  const heart   = document.getElementById('mp-card-heart')
  const badges  = document.getElementById('mp-card-badges')

  // Gallery slider
  const images   = l.gallery?.length ? l.gallery : (l.thumb ? [l.thumb] : [])
  const mpTrack  = document.getElementById('mp-track')
  const mpDots   = document.getElementById('mp-dots')
  const mpDotsWrap = document.getElementById('mp-dots-wrap')
  mpTotal = images.length
  mpCur   = 0

  mpTrack.innerHTML = images.length
    ? images.map((src, i) => `<div class="sb-slide"><img src="${escapeHtml(src)}" alt="${escapeHtml(l.title)}" loading="${i===0?'eager':'lazy'}" /></div>`).join('')
    : `<div class="sb-slide" style="display:flex;align-items:center;justify-content:center;background:#f3f4f6;color:#d1d5db;font-size:13px;">No photo</div>`
  badges.innerHTML = window.__badgeChipsHTML(l)
  badges.hidden = !badges.innerHTML

  // Reset scroll to first slide
  mpTrack.scrollLeft = 0

  // Dots
  if (mpTotal > 1) {
    mpDots.innerHTML = images.map((_, i) => `<span class="sb-dot${i===0?' active':''}"></span>`).join('')
    mpDotsWrap.hidden = false
  } else {
    mpDotsWrap.hidden = true
  }

  // Arrows — always hide prev at start; hide next if only 1 image
  document.getElementById('mp-prev').toggleAttribute('data-hidden', true)
  document.getElementById('mp-next').toggleAttribute('data-hidden', mpTotal <= 1)

  // Link
  link.href = '/stay/' + l.slug

  // Text — keep parity with cardHTML(): top line is the property name (post title),
  // big line below is the descriptive heading (custom desc › location › sub-heading).
  const loc = [l.barName, l.muniName].filter(Boolean).join(', ')
  sub.textContent   = l.title || ''
  title.textContent = l.desc?.trim() || loc || l.subHeading || 'View this stay'

  // Stats
  const parts = []
  if (l.guests) parts.push(l.guests + ' guest' + (l.guests !== 1 ? 's' : ''))
  if (l.beds)   parts.push(l.beds   + ' bed'   + (l.beds   !== 1 ? 's' : ''))
  if (l.baths)  parts.push(l.baths  + ' bath'  + (l.baths  !== 1 ? 's' : ''))
  stats.textContent = parts.join(' · ')

  // Price
  price.innerHTML = ''
  if (l.price || l.monthly) {
    if (l.price)   price.innerHTML += `<div class="mp-card-price-night">₱${l.price.toLocaleString()}<span class="mp-card-price-sub"> / night</span></div>`
    if (l.monthly) price.innerHTML += `<div class="mp-card-price-month">₱${l.monthly.toLocaleString()} / month</div>`
  }

  // Host avatar
  const avatar = document.getElementById('mp-card-avatar')
  if (avatar) {
    const initials = (l.hostName || '').split(' ').map(n => n[0] || '').slice(0, 2).join('').toUpperCase()
    const SVG_PERSON = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>`
    const SVG_CHECK  = `<svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
    const inner = l.hostPic
      ? `<img src="${escapeHtml(l.hostPic)}" alt="${escapeHtml(l.hostName || '')}" loading="lazy"/>`
      : (initials ? `<span>${escapeHtml(initials)}</span>` : SVG_PERSON)
    avatar.innerHTML = `<div class="mp-av-rel"><div class="mp-av">${inner}</div>${l.verified ? `<div class="mp-av-verified">${SVG_CHECK}</div>` : ''}</div>`
  }

  // Heart state
  const sb = window.__sb
  heart.classList.toggle('saved', sb ? sb.isSaved(l.slug) : false)
  heart.dataset.slug = l.slug

  // Highlight active pin
  if (activePopupSlug) {
    document.querySelectorAll(`.mp-pin[data-slug="${activePopupSlug}"]`).forEach(p => p.classList.remove('active'))
  }
  activePopupSlug    = l.slug
  activePopupListing = l
  document.querySelectorAll(`.mp-pin[data-slug="${l.slug}"]`).forEach(p => p.classList.add('active'))

  // Show first so offsetHeight is available, then position
  popup.hidden = false
  document.body.classList.add('st-popup-open')
  window.setTimeout(() => {
    popup.hidden = false
    document.body.classList.add('st-popup-open')
    positionPopup()
  }, isMobileStays() ? 90 : 0)
}

function closeMapPopup() {
  document.getElementById('map-popup').hidden = true
  document.body.classList.remove('st-popup-open')
  if (activePopupSlug) {
    document.querySelectorAll(`.mp-pin[data-slug="${activePopupSlug}"]`).forEach(p => p.classList.remove('active'))
    activePopupSlug    = null
    activePopupListing = null
  }
}

window.closeMapPopup = closeMapPopup

function mpToggleHeart() {
  const heart = document.getElementById('mp-card-heart')
  const slug  = heart.dataset.slug
  const sb    = window.__sb
  if (!sb || !slug) return
  sb.toggle(slug)
}
window.mpToggleHeart = mpToggleHeart

// Sync heart state with global sb:saved-changed event
window.addEventListener('sb:saved-changed', e => {
  const heart = document.getElementById('mp-card-heart')
  if (heart && heart.dataset.slug === e.detail.slug) {
    heart.classList.toggle('saved', e.detail.saved)
  }
})

// Build an SVG price-pill icon for a classic google.maps.Marker (keeps the
// Leaflet "price pin" look without needing a cloud Map ID / AdvancedMarker).
function pricePinIcon(l) {
  const label = l.price > 0 ? '₱' + Number(l.price).toLocaleString() : (l.muniName || 'View')
  const w = Math.max(46, 16 + label.length * 8)
  const h = 28
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + (h + 8) + '" viewBox="0 0 ' + w + ' ' + (h + 8) + '">' +
    '<rect x="1" y="1" width="' + (w - 2) + '" height="' + (h - 2) + '" rx="' + ((h - 2) / 2) + '" fill="#ffffff" stroke="#0d1e2b" stroke-width="1.5"/>' +
    '<path d="M' + (w / 2 - 6) + ' ' + (h - 1) + ' L' + (w / 2) + ' ' + (h + 6) + ' L' + (w / 2 + 6) + ' ' + (h - 1) + ' Z" fill="#ffffff" stroke="#0d1e2b" stroke-width="1.5"/>' +
    '<text x="' + (w / 2) + '" y="' + (h / 2 + 4) + '" text-anchor="middle" font-family="DM Sans, Arial, sans-serif" font-size="12.5" font-weight="700" fill="#0d1e2b">' + label + '</text>' +
    '</svg>'
  return {
    url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg),
    scaledSize: new google.maps.Size(w, h + 8),
    anchor: new google.maps.Point(w / 2, h + 6),
  }
}

function renderAllPins(pins) {
  if (!mapInstance || !window.google) return
  if (clusterer) clusterer.clearMarkers()

  const markers = []
  pins.forEach(pin => {
    const l = normalizePin(pin)
    const coords = listingCoords(l)
    if (!coords) return
    const marker = new google.maps.Marker({
      position: { lat: coords[0], lng: coords[1] },
      icon: pricePinIcon(l),
      title: l.title || '',
    })
    marker.addListener('click', async () => { await showMapPopup(pin) })
    markers.push(marker)
  })

  if (window.markerClusterer && window.markerClusterer.MarkerClusterer) {
    clusterer = new markerClusterer.MarkerClusterer({ map: mapInstance, markers })
  } else {
    markers.forEach(m => m.setMap(mapInstance))
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Price histogram
// ─────────────────────────────────────────────────────────────────────────────
function buildHistogram() {
  const prices = allPins.map(l => Number(l.price || 0)).filter(p => p > 0)
  if (!prices.length) return []
  const lo = priceMin || Math.min(...prices), hi = priceMax || Math.max(...prices)
  const step = (hi - lo) / HIST_BUCKETS || 1
  const buckets = Array(HIST_BUCKETS).fill(0)
  prices.forEach(p => {
    const i = Math.min(HIST_BUCKETS - 1, Math.floor((p - lo) / step))
    buckets[i]++
  })
  return buckets
}

function renderHistogram(minPct, maxPct) {
  const svg    = document.getElementById('fd-hist-svg')
  if (!svg) return
  const buckets = buildHistogram()
  const maxB    = Math.max(...buckets, 1)
  const W       = 100 / HIST_BUCKETS
  svg.innerHTML = buckets.map((b, i) => {
    const x    = i * W
    const h    = (b / maxB) * 100
    const pct  = (i / HIST_BUCKETS) * 100
    const inRange = pct >= minPct && pct < maxPct
    return `<rect class="fd-hist-bar" x="${x}%" y="${100-h}%" width="${W-.5}%" height="${h}%"
      fill="${inRange ? '#1a2533' : '#e2ebf3'}" rx="1.5"/>`
  }).join('')
}

function initPriceSlider() {
  const rMin   = document.getElementById('fd-range-min')
  const rMax   = document.getElementById('fd-range-max')
  const track  = document.getElementById('fd-slider-track')
  const lblMin = document.getElementById('fd-price-min-lbl')
  const lblMax = document.getElementById('fd-price-max-lbl')

  function update(live = false) {
    let lo = parseInt(rMin.value), hi = parseInt(rMax.value)
    if (lo > hi - 2) {
      if (document.activeElement === rMin) lo = hi - 2
      else hi = lo + 2
      rMin.value = lo; rMax.value = hi
    }
    // Update fill
    track.innerHTML = `<div class="fd-slider-fill" style="left:${lo}%;width:${hi-lo}%"></div>`
    // Update labels (map pct → real price)
    const realMin = Math.round(priceMin + (lo/100) * (priceMax - priceMin))
    const realMax = Math.round(priceMin + (hi/100) * (priceMax - priceMin))
    lblMin.textContent = '₱' + realMin.toLocaleString()
    lblMax.textContent = hi >= 99 ? '₱' + realMax.toLocaleString() + '+' : '₱' + realMax.toLocaleString()
    F.priceMin = realMin
    F.priceMax = hi >= 99 ? Infinity : realMax
    renderHistogram(lo, hi)
    if (live) {
      F.rateBand = 'custom'
      document.querySelectorAll('.fd-quick-rate').forEach(btn => btn.classList.remove('active'))
      scheduleFilterResults()
    }
  }

  rMin.oninput = () => update(true)
  rMax.oninput = () => update(true)
  update()
}

// ─────────────────────────────────────────────────────────────────────────────
// Filter drawer interactions
// ─────────────────────────────────────────────────────────────────────────────
function openFilter() {
  document.getElementById('fd').hidden = false
  document.getElementById('fd-backdrop').hidden = false
  document.body.style.overflow = 'hidden'
  updateApplyButton()
}
function closeFilter() {
  document.getElementById('fd').hidden = true
  document.getElementById('fd-backdrop').hidden = true
  document.body.style.overflow = ''
}

function updateFilterCount() {
  let n = 0
  if (F.cat) n++
  if (F.type) n++
  if (F.cats.size) n += F.cats.size
  if (F.badge) n++
  if (F.rateMode !== 'daily') n++
  if (F.rateBand !== 'any') n++
  if (F.priceMin > priceMin || F.priceMax < priceMax) n++
  if (F.beds) n++
  if (F.baths) n++
  if (F.amenities.size) n += F.amenities.size
  if (F.minRating > 0) n++
  const badge = document.getElementById('st-filter-count')
  badge.textContent = n
  badge.hidden = n === 0
}

function applyButtonLabel(count = totalResults) {
  if (!Number.isFinite(count)) return 'Show places'
  const noun = count === 1 ? 'result' : 'results'
  return `Show ${count.toLocaleString()} ${noun} found`
}

function updateApplyButton(isLoading = false) {
  const btn = document.getElementById('fd-apply')
  if (!btn) return
  btn.textContent = isLoading ? 'Checking places…' : applyButtonLabel(totalResults)
}

function fetchFilterResultsNow() {
  clearTimeout(liveFilterTimer)
  updateFilterCount()
  updateApplyButton(true)
  return fetchCards(1, { skipBounds: isMobileStays() && mobileView === 'list' })
}

function scheduleFilterResults() {
  updateFilterCount()
  updateApplyButton(true)
  clearTimeout(liveFilterTimer)
  liveFilterTimer = window.setTimeout(fetchFilterResultsNow, 60)
}

function clearAllFilters() {
  F.type = ''; F.cats.clear(); F.amenities.clear()
  F.badge = ''; F.rateMode = 'daily'; F.rateBand = 'any'
  F.priceMin = priceMin; F.priceMax = priceMax
  F.beds = 0; F.bedCount = 0; F.baths = 0
  F.minRating = 0

  // Reset UI
  document.querySelectorAll('.fd-type').forEach(b => b.classList.toggle('active', b.dataset.type === ''))
  document.querySelectorAll('.fd-rate').forEach(b => b.classList.toggle('active', b.dataset.rateMode === 'daily'))
  document.querySelectorAll('.fd-quick-rate').forEach(b => b.classList.toggle('active', b.dataset.rateBand === 'any'))
  document.querySelectorAll('.fd-rating-pill').forEach(b => b.classList.toggle('active', b.dataset.rating === '0'))
  document.getElementById('fd-nomad')?.classList.remove('active')
  document.getElementById('fd-price-sub').textContent = 'Nightly price in Philippine Peso'
  document.querySelectorAll('.fd-pill').forEach(b => b.classList.remove('active'))
  document.querySelectorAll('.fd-faq-pill').forEach(b => b.classList.remove('active'))
  document.querySelectorAll('.fd-amen-cb').forEach(cb => { cb.checked = false })
  document.querySelectorAll('[id^="step-"]').forEach(el => { el.textContent = 'Any' })
  document.querySelectorAll('.fd-step-btn[data-step-dir="-1"]').forEach(b => b.disabled = true)
  document.getElementById('fd-range-min').value = 0
  document.getElementById('fd-range-max').value = 100
  initPriceSlider()
  document.querySelectorAll('.st-cat').forEach(b => b.classList.toggle('active', b.dataset.cat === ''))
  F.cat = ''
  fetchFilterResultsNow()
}
window.clearAllFilters = clearAllFilters

function setQuickRateBand(band) {
  F.rateBand = band || 'any'
  document.querySelectorAll('.fd-quick-rate').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.rateBand === F.rateBand)
  })
  if (F.rateBand === 'under-1500') {
    F.priceMin = 0
    F.priceMax = 1499
  } else if (F.rateBand === '1500-5000') {
    F.priceMin = 1500
    F.priceMax = 5000
  } else if (F.rateBand === 'over-5000') {
    F.priceMin = 5001
    F.priceMax = Infinity
  } else {
    F.priceMin = priceMin
    F.priceMax = priceMax || Infinity
  }
  scheduleFilterResults()
}

function applyUrlFilters() {
  const params = new URLSearchParams(window.location.search)
  const cats = (params.get('cats') || params.get('category') || '').split(',').map(s => s.trim()).filter(Boolean)

  // Build the set of topbar pill slugs so we can route single-value URLs there
  const topbarSlugs = new Set(
    Array.from(document.querySelectorAll('.st-cat'))
      .map(b => b.dataset.cat)
      .filter(Boolean)
  )

  // Single `?cats=X` that matches a topbar pill → treat as topbar selection
  // (so the pill lights up). Otherwise → drawer multi-select state.
  if (cats.length === 1 && topbarSlugs.has(cats[0])) {
    F.cat = cats[0]
  } else {
    cats.forEach(slug => F.cats.add(slug))
  }

  if (params.get('badge')) F.badge = params.get('badge')
  if (params.get('rate_mode') === 'monthly') F.rateMode = 'monthly'
  // Limasawa: honor ?location=<slug> from the homepage search (siargao seeded
  // this only via the [location].astro hub pages, which limasawa doesn't have).
  if (params.get('location')) F.location = params.get('location')

  document.querySelectorAll('.fd-pill').forEach(btn => {
    btn.classList.toggle('active', F.cats.has(btn.dataset.catPill))
  })
  // Topbar pill: highlight whichever matches F.cat; "All" when nothing selected
  document.querySelectorAll('.st-cat').forEach(btn => {
    const slug = btn.dataset.cat
    const isAll = slug === ''
    const isSelected = isAll
      ? (!F.cat && !F.cats.size)
      : (slug === F.cat)
    btn.classList.toggle('active', isSelected)
  })
  document.querySelectorAll('.fd-rate').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.rateMode === F.rateMode)
  })
  document.getElementById('fd-nomad')?.classList.toggle('active', F.badge === 'digital-nomad')
  document.getElementById('fd-price-sub').textContent =
    F.rateMode === 'monthly' ? 'Monthly price in Philippine Peso' : 'Nightly price in Philippine Peso'
}

// Steppers
const stepState = { 'beds': 0, 'bed-count': 0, 'baths': 0 }
function initSteppers() {
  document.querySelectorAll('.fd-step-btn').forEach(btn => {
    const key = btn.dataset.stepKey
    const dir = parseInt(btn.dataset.stepDir)
    btn.disabled = dir === -1
    btn.addEventListener('click', () => {
      stepState[key] = Math.max(0, (stepState[key] || 0) + dir)
      const el = document.getElementById(`step-${key}`)
      el.textContent = stepState[key] === 0 ? 'Any' : stepState[key] + '+'
      document.querySelector(`[data-step-key="${key}"][data-step-dir="-1"]`).disabled = stepState[key] === 0
      if (key === 'beds')      F.beds     = stepState[key]
      if (key === 'bed-count') F.bedCount = stepState[key]
      if (key === 'baths')     F.baths    = stepState[key]
      scheduleFilterResults()
    })
  })
}

// ─────────────────────────────────────────────────────────────────────────────
// Boot
// ─────────────────────────────────────────────────────────────────────────────
async function boot() {
  if (window.__gmapsReady) {
    try { await window.__gmapsReady } catch (_) {}
    initMap()
  } else {
    const mapEl = document.getElementById('map')
    if (mapEl) mapEl.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;padding:2rem;text-align:center;color:#64748B">Map unavailable — set PUBLIC_GOOGLE_MAPS_KEY.</div>'
  }
  setLoading(true)

  // Fetch pins + taxonomies in parallel — both come from cached transients server-side
  const [pinsRes, taxRes] = await Promise.allSettled([fetchPins(), fetchTaxonomies()])

  if (pinsRes.status === 'fulfilled') {
    allPins = pinsRes.value
    const prices = allPins.map(p => Number(p.price || 0)).filter(p => p > 0)
    priceMin = prices.length ? Math.min(...prices) : 0
    priceMax = prices.length ? Math.max(...prices) : 0
    F.priceMin = priceMin
    F.priceMax = priceMax || Infinity
    renderAllPins(allPins)
    // Fit the map to all pins so the initial viewport frames Limasawa's listings
    // (the small island means the default center+zoom may not catch every pin).
    if (allPins.length && mapInstance) {
      try {
        const b = new google.maps.LatLngBounds()
        let n = 0
        allPins.forEach(p => {
          const la = Number(p.lat), ln = Number(p.lng)
          if (Number.isFinite(la) && Number.isFinite(ln)) { b.extend({ lat: la, lng: ln }); n++ }
        })
        if (n === 1) { mapInstance.setCenter(b.getCenter()); mapInstance.setZoom(15) }
        else if (n > 1) { mapInstance.fitBounds(b, 40) }
      } catch (e) { console.warn('fitBounds failed', e) }
    }
  } else {
    console.error(pinsRes.reason)
    document.getElementById('st-count').textContent = 'Could not load map pins'
  }

  if (taxRes.status === 'fulfilled') {
    renderDynamicFilters(taxRes.value)
    // Apply URL filters now that pills exist (so the right one can be marked active)
    applyUrlFilters()
  } else {
    console.error(taxRes.reason)
  }

  initPriceSlider()
  initSteppers()
  await fetchCards(1, { skipBounds: isMobileStays() })
  // Now that the initial load is done, let map pans/zooms drive refetches.
  mapReady = true
}

document.addEventListener('DOMContentLoaded', () => {
  setMobileView('list')
  // applyUrlFilters() runs inside boot() — after dynamic pills are rendered.

  // Static "All" pill (other category pills are wired in renderDynamicFilters)
  document.querySelectorAll('.st-cat[data-cat=""]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.st-cat').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      F.cat = ''
      F.cats.clear()
      document.querySelectorAll('.fd-pill').forEach(b => b.classList.remove('active'))
      fetchCards(1, { skipBounds: true })
    })
  })

  document.getElementById('st-load-more')?.addEventListener('click', () => {
    if (currentPage < totalPages) fetchCards(currentPage + 1, { append: true })
  })

  document.getElementById('st-map-toggle')?.addEventListener('click', () => {
    closeMapPopup()
    setMobileView('map')
    fetchCards(1, { forceBounds: true })
  })

  document.getElementById('st-list-toggle')?.addEventListener('click', () => {
    closeMapPopup()
    setMobileView('list')
  })

  document.getElementById('st-mobile-back')?.addEventListener('click', () => {
    if (isMobileStays() && mobileView === 'map') {
      closeMapPopup()
      setMobileView('list')
      return
    }
    window.location.href = '/'
  })

  document.getElementById('st-mobile-summary')?.addEventListener('click', () => {
    if (isMobileStays() && mobileView === 'list') {
      closeMapPopup()
      setMobileView('map')
      fetchCards(1, { forceBounds: true })
    }
  })

  window.addEventListener('resize', () => {
    if (!isMobileStays()) {
      document.body.classList.remove('st-map-mode')
      window.setTimeout(() => { if (mapInstance && window.google) google.maps.event.trigger(mapInstance, 'resize') }, 80)
    } else {
      setMobileView(mobileView)
    }
  })

  // Popup slider arrows
  document.getElementById('mp-prev')?.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); mpGoTo(mpCur - 1) })
  document.getElementById('mp-next')?.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); mpGoTo(mpCur + 1) })
  const mpTrackEl = document.getElementById('mp-track')
  if (mpTrackEl) {
    let mpRaf = 0
    mpTrackEl.addEventListener('scroll', () => {
      cancelAnimationFrame(mpRaf)
      mpRaf = requestAnimationFrame(() => {
        const idx = Math.round(mpTrackEl.scrollLeft / (mpTrackEl.offsetWidth || 1))
        if (idx !== mpCur) {
          mpCur = idx
          document.getElementById('mp-dots')?.querySelectorAll('.sb-dot').forEach((d, i) => d.classList.toggle('active', i === idx))
          document.getElementById('mp-prev').toggleAttribute('data-hidden', idx === 0)
          document.getElementById('mp-next').toggleAttribute('data-hidden', idx >= mpTotal - 1)
        }
      })
    }, { passive: true })
  }

  // Filter drawer open/close
  document.getElementById('st-filter-btn').addEventListener('click', openFilter)
  document.getElementById('fd-close').addEventListener('click', closeFilter)
  document.getElementById('fd-backdrop').addEventListener('click', closeFilter)
  document.getElementById('fd-apply').addEventListener('click', () => {
    closeFilter()
  })

  // Type-of-place
  document.querySelectorAll('.fd-type').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fd-type').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      F.type = btn.dataset.type
      scheduleFilterResults()
    })
  })

  document.getElementById('fd-nomad')?.addEventListener('click', e => {
    const btn = e.currentTarget
    F.badge = F.badge === 'digital-nomad' ? '' : 'digital-nomad'
    btn.classList.toggle('active', F.badge === 'digital-nomad')
    scheduleFilterResults()
  })

  document.querySelectorAll('.fd-rate').forEach(btn => {
    btn.addEventListener('click', () => {
      F.rateMode = btn.dataset.rateMode === 'monthly' ? 'monthly' : 'daily'
      document.querySelectorAll('.fd-rate').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      document.getElementById('fd-price-sub').textContent =
        F.rateMode === 'monthly' ? 'Monthly price in Philippine Peso' : 'Nightly price in Philippine Peso'
      scheduleFilterResults()
    })
  })

  document.querySelectorAll('.fd-quick-rate').forEach(btn => {
    btn.addEventListener('click', () => {
      setQuickRateBand(btn.dataset.rateBand)
    })
  })

  // Rating pills
  document.querySelectorAll('.fd-rating-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fd-rating-pill').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      F.minRating = parseFloat(btn.dataset.rating) || 0
      scheduleFilterResults()
    })
  })

  // Drawer pills + amenity pills/checkboxes are wired inside renderDynamicFilters()
  // because the elements are injected dynamically from the /taxonomies endpoint.

  // Escape key
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !document.getElementById('fd').hidden) closeFilter()
  })

  boot()
})
</script>

