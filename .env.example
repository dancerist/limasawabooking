# WordPress REST API base (limasawa/v1). Defaults to the production admin subdomain.
PUBLIC_WP_REST=https://admin.limasawabooking.com/wp-json/limasawa/v1

# Google Maps JavaScript API key — used by /stays and /stay/[slug] to plot listing pins.
# Create one at https://console.cloud.google.com/ (enable "Maps JavaScript API", billing required),
# then restrict it to the limasawabooking.com domains. Without it, maps degrade to a placeholder.
PUBLIC_GOOGLE_MAPS_KEY=
